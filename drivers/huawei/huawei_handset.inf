[ComPort.NT]
Include=mdmcpq.inf
Needs=FakeModemCopyFileSection
AddReg=ComPort.NT.AddReg

[ComPort.NT.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,usbser.sys
HKR,,EnumPropPages32,,"MsPorts.dll,PortsPageProvider"

[ComPort.NT.Services]
AddService = usbser, 0x00000002, Service_Inst

[Service_Inst]
