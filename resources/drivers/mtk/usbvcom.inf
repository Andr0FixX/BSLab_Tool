; ==============================================================================
; MediaTek USB VCOM Port Driver (Preloader, BROM, DA, & META Mode)
; High-Speed CDC-ACM & Virtual Serial Port for Windows 10 & 11 (64-bit / 32-bit)
; Supported Chipsets: MT6580, MT6737, MT6753, MT6765, MT6768, MT6785, MT6833, MT6877, MT6983
; Hardware IDs: VID_0E8D&PID_2000, PID_0003, PID_2001, PID_2006, PID_2007, PID_2026, PID_2040
; ==============================================================================

[Version]
Signature="$WINDOWS NT$"
Class=Ports
ClassGuid={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=05/20/2026,3.5.2401.0
CatalogFile=usbvcom.cat

[Manufacturer]
%ManufacturerName%=MediaTek,NTx86,NTamd64

