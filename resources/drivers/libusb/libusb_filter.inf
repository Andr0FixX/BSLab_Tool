; ==============================================================================
; LibUSB-win32 Generic USB Filter Driver Configuration
; ==============================================================================

[Version]
Signature = "$WINDOWS NT$"
Class = "USBDevice"
ClassGUID = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider = "libusb-win32"
DriverVer = 01/18/2022, 1.2.6.0
CatalogFile = libusb_filter.cat

[Manufacturer]
%ManufacturerName% = Devices, NTx86, NTamd64

[Devices.NTx86]
%DeviceDesc% = LIBUSB_DEV, USB\VID_0E8D&PID_0003
%DeviceDesc% = LIBUSB_DEV, USB\VID_0E8D&PID_2000

[Devices.NTamd64]
%DeviceDesc% = LIBUSB_DEV, USB\VID_0E8D&PID_0003
%DeviceDesc% = LIBUSB_DEV, USB\VID_0E8D&PID_2000

[LIBUSB_DEV.NT]
Include = winusb.inf
Needs   = WINUSB.NT

[LIBUSB_DEV.NT.Services]
Include = winusb.inf
AddService = WinUSB, 0x00000002, WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName     = %WinUSB_SvcDesc%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[Strings]
ManufacturerName = "LibUSB Win32 Project"
DeviceDesc       = "MediaTek / Qualcomm LibUSB Endpoint Filter"
WinUSB_SvcDesc   = "WinUSB Filter Driver"
