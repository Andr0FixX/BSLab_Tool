                }



                if (LedGlobalCom != null) LedGlobalCom.Fill = greenBrush;

                if (GlowGlobalCom != null) GlowGlobalCom.Color = greenGlow;

                if (TxtGlobalCom != null)

                {

                    TxtGlobalCom.Text = $"COM: {res.ComPort}";

                    TxtGlobalCom.Foreground = greenBrush;

                }



                if (LedStatusCom != null) LedStatusCom.Fill = greenBrush;

                if (TxtStatusCom != null)

                {

