        private void LoadDefaultGptPartitions()
        {
            _partitions.Clear();
            bool qc = IsQualcommMode;
            if (qc)
            {
                _partitions.Add(new GptPartitionModel { Index = 1, Name = "boot", StartLba = 0x00008000, SectorCount = 131072, SizeBytes = 67108864, SizeStr = "64 MB", Filesystem = "raw (kernel)", Status = "SECURE_BOOT [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 2, Name = "dtbo", StartLba = 0x00028000, SectorCount = 16384, SizeBytes = 8388608, SizeStr = "8 MB", Filesystem = "raw (dtb)", Status = "VERIFIED [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 3, Name = "init_boot", StartLba = 0x0002C000, SectorCount = 32768, SizeBytes = 16777216, SizeStr = "16 MB", Filesystem = "raw (ramdisk)", Status = "AVB 2.0 [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 4, Name = "recovery", StartLba = 0x00034000, SectorCount = 131072, SizeBytes = 67108864, SizeStr = "64 MB", Filesystem = "raw (AOSP)", Status = "RECOVERY [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 5, Name = "vbmeta", StartLba = 0x00054000, SectorCount = 16384, SizeBytes = 8388608, SizeStr = "8 MB", Filesystem = "avb_key", Status = "AVB SIGNED", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 6, Name = "modemst1", StartLba = 0x00058000, SectorCount = 6144, SizeBytes = 3145728, SizeStr = "3 MB", Filesystem = "raw (EFS1)", Status = "PROTECTED [IMEI1]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 7, Name = "modemst2", StartLba = 0x00059800, SectorCount = 6144, SizeBytes = 3145728, SizeStr = "3 MB", Filesystem = "raw (EFS2)", Status = "PROTECTED [IMEI2]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 8, Name = "fsg", StartLba = 0x0005B000, SectorCount = 6144, SizeBytes = 3145728, SizeStr = "3 MB", Filesystem = "raw (RF Golden)", Status = "CALIBRATION [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 9, Name = "fsc", StartLba = 0x0005C800, SectorCount = 2048, SizeBytes = 1048576, SizeStr = "1 MB", Filesystem = "raw (Cookies)", Status = "SECURITY [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 10, Name = "persist", StartLba = 0x0005D000, SectorCount = 98304, SizeBytes = 50331648, SizeStr = "48 MB", Filesystem = "ext4", Status = "CAL_PERSIST [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 11, Name = "devinfo", StartLba = 0x00075000, SectorCount = 2048, SizeBytes = 1048576, SizeStr = "1 MB", Filesystem = "raw (BL Config)", Status = "LOCKED [SECURE]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 12, Name = "super", StartLba = 0x00075800, SectorCount = 19922944, SizeBytes = 10200547328, SizeStr = "9.5 GB", Filesystem = "ext4 (dynamic)", Status = "SYSTEM_VENDOR", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 13, Name = "userdata", StartLba = 0x01375800, SectorCount = 217686016, SizeBytes = 111455240192, SizeStr = "103.8 GB", Filesystem = "f2fs (encrypted)", Status = "USER_STORAGE", IsChecked = false });
                _partitions.Add(new GptPartitionModel { Index = 14, Name = "metadata", StartLba = 0x0E300000, SectorCount = 32768, SizeBytes = 16777216, SizeStr = "16 MB", Filesystem = "raw (meta)", Status = "CRYPTO_KEY", IsChecked = true });
            }
            else
            {
                _partitions.Add(new GptPartitionModel { Index = 1, Name = "boot", StartLba = 0x00008000, SectorCount = 131072, SizeBytes = 67108864, SizeStr = "64 MB", Filesystem = "raw (kernel)", Status = "SECURE_BOOT [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 2, Name = "dtbo", StartLba = 0x00028000, SectorCount = 16384, SizeBytes = 8388608, SizeStr = "8 MB", Filesystem = "raw (dtb)", Status = "VERIFIED [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 3, Name = "init_boot", StartLba = 0x0002C000, SectorCount = 32768, SizeBytes = 16777216, SizeStr = "16 MB", Filesystem = "raw (ramdisk)", Status = "AVB 2.0 [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 4, Name = "recovery", StartLba = 0x00034000, SectorCount = 131072, SizeBytes = 67108864, SizeStr = "64 MB", Filesystem = "raw (AOSP)", Status = "RECOVERY [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 5, Name = "vbmeta", StartLba = 0x00054000, SectorCount = 16384, SizeBytes = 8388608, SizeStr = "8 MB", Filesystem = "avb_key", Status = "AVB SIGNED", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 6, Name = "nvram", StartLba = 0x00058000, SectorCount = 32768, SizeBytes = 16777216, SizeStr = "16 MB", Filesystem = "raw (nv)", Status = "CALIBRATION [NV]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 7, Name = "nvdata", StartLba = 0x00060000, SectorCount = 131072, SizeBytes = 67108864, SizeStr = "64 MB", Filesystem = "ext4 (security)", Status = "PROTECTED [IMEI]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 8, Name = "nvcfg", StartLba = 0x00080000, SectorCount = 16384, SizeBytes = 8388608, SizeStr = "8 MB", Filesystem = "ext4 (cfg)", Status = "RADIO_CONFIG", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 9, Name = "persist", StartLba = 0x00084000, SectorCount = 98304, SizeBytes = 50331648, SizeStr = "48 MB", Filesystem = "ext4", Status = "CAL_PERSIST [OK]", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 10, Name = "proinfo", StartLba = 0x0009C000, SectorCount = 8192, SizeBytes = 4194304, SizeStr = "4 MB", Filesystem = "raw (hw id)", Status = "HARDWARE_ID", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 11, Name = "super", StartLba = 0x0009E000, SectorCount = 19293798, SizeBytes = 9878424576, SizeStr = "9.2 GB", Filesystem = "ext4 (dynamic)", Status = "SYSTEM_VENDOR", IsChecked = true });
                _partitions.Add(new GptPartitionModel { Index = 12, Name = "userdata", StartLba = 0x012FBD00, SectorCount = 219152384, SizeBytes = 112206020608, SizeStr = "104.5 GB", Filesystem = "f2fs (encrypted)", Status = "USER_STORAGE", IsChecked = false });
                _partitions.Add(new GptPartitionModel { Index = 13, Name = "metadata", StartLba = 0x0E3D1800, SectorCount = 32768, SizeBytes = 16777216, SizeStr = "16 MB", Filesystem = "raw (meta)", Status = "CRYPTO_KEY", IsChecked = true });
            }

            if (GridPartitions != null)
            {
                GridPartitions.ItemsSource = null;
                GridPartitions.ItemsSource = _partitions;
            }
            if (GridAutoHubPartitions != null)
            {
                GridAutoHubPartitions.ItemsSource = null;
                GridAutoHubPartitions.ItemsSource = _partitions;
            }
            if (TxtPartCount != null)
            {
                TxtPartCount.Text = $" ({_partitions.Count} Partitions Loaded)";
            }
        }

        
                private async Task<(bool Success, string Port)> EnsureValidHardwarePortAsync(string? portName = null, bool isMetaMode = false, int timeoutSeconds = 40)
        {
            string target = portName?.Trim() ?? "";

            // Step 1: Immediate check - is the port already present on the physical bus?
            var activePorts = GetSystemSerialPorts();
            if (activePorts != null && activePorts.Length > 0)
            {
                if (!string.IsNullOrEmpty(target) && activePorts.Contains(target, StringComparer.OrdinalIgnoreCase))
                {
                    return (true, target);
                }
                if (string.IsNullOrEmpty(target) && activePorts.Length == 1)
                {
                    string p = activePorts[0];
                    Dispatcher.Invoke(() =>
                    {
                        if (isMetaMode && TxtMetaPort != null) TxtMetaPort.Text = p;
                        else if (!isMetaMode && TxtPort != null) TxtPort.Text = p;
                    });
                    return (true, p);
                }
            }

            // Step 2: Not present right now. Engage Active 40-Second Listening Radar!
            _isOperationCancelled = false;
            AppendLog("══════════════════════════════════════════════════════════════");
            AppendLog($"[*] HARDWARE BUS RADAR: LISTENING FOR {(isMetaMode ? "META MODE" : (IsQualcommMode ? "QUALCOMM EDL 9008" : "MEDIATEK BROM / PRELOADER"))}");
            AppendLog("══════════════════════════════════════════════════════════════");
            AppendLog("[*] Workshop Instruction: Ensure phone is completely powered OFF.");
            AppendLog("[*]                      : Press & HOLD [Volume Down] (or Vol+ & Vol-) and INSERT USB cable.");
            AppendLog($"[*] Radar Window        : {timeoutSeconds} Seconds Active Listening (Click [ABORT] to cancel)...");

            var initialPorts = new HashSet<string>(activePorts ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase);

            int totalTicks = timeoutSeconds * 4; // 250ms intervals
            for (int tick = 0; tick < totalTicks; tick++)
            {
                if (_isOperationCancelled)
                {
                    AppendLog("[ABORT] Hardware connection listening aborted by technician.");
                    SetMtkProgress(0, "Cancelled");
                    return (false, "");
                }

                int remaining = timeoutSeconds - (tick / 4);
                if (tick % 4 == 0) // every 1 second
                {
                    SetMtkProgress(20, $"Listening for USB Port... ({remaining}s)");
                }

                // Check active COM ports from registry
                var currentPorts = GetSystemSerialPorts();
                if (currentPorts != null && currentPorts.Length > 0)
                {
                    // Priority 1: New port arrived
                    foreach (var p in currentPorts)
                    {
                        if (!initialPorts.Contains(p))
                        {
                            Dispatcher.Invoke(() =>
                            {
                                if (isMetaMode && TxtMetaPort != null) TxtMetaPort.Text = p;
                                else if (!isMetaMode && TxtPort != null) TxtPort.Text = p;
                            });
                            AppendLog("[+] ════════════ LIVE HARDWARE CONNECTED ════════════");
                            AppendLog($"[+] Live Hardware Port Detected : {p} (New Arrival)");
                            AppendLog($"[+] Connection Captured in      : {(tick * 0.25):F1} seconds");
                            AppendLog("[+] Status                      : READY & SYNCED");
                            AppendLog("[+] ═════════════════════════════════════════════════");
                            SetMtkProgress(35, $"Connected on {p}");
                            return (true, p);
                        }
                    }

                    // Priority 2: Target port was specified and is now detected
                    if (!string.IsNullOrEmpty(target) && currentPorts.Contains(target, StringComparer.OrdinalIgnoreCase))
                    {
                        Dispatcher.Invoke(() =>
                        {
                            if (isMetaMode && TxtMetaPort != null) TxtMetaPort.Text = target;
                            else if (!isMetaMode && TxtPort != null) TxtPort.Text = target;
                        });
                        AppendLog($"[+] Live Hardware Port Connected : {target}");
                        SetMtkProgress(35, $"Connected on {target}");
                        return (true, target);
                    }

                    // Priority 3: Initial was empty and any port is available
                    if (initialPorts.Count == 0 && currentPorts.Length > 0)
                    {
                        string p = currentPorts[0];
                        Dispatcher.Invoke(() =>
                        {
                            if (isMetaMode && TxtMetaPort != null) TxtMetaPort.Text = p;
                            else if (!isMetaMode && TxtPort != null) TxtPort.Text = p;
                        });
                        AppendLog($"[+] Live Hardware Port Detected : {p}");
                        SetMtkProgress(35, $"Connected on {p}");
                        return (true, p);
                    }
                }

                // Also check PerformQuickHardwareProbe
                var probe = PerformQuickHardwareProbe(false);
                if (probe.HasCom && !string.IsNullOrEmpty(probe.ComPort))
                {
                    string p = probe.ComPort;
                    Dispatcher.Invoke(() =>
                    {
                        if (isMetaMode && TxtMetaPort != null) TxtMetaPort.Text = p;
                        else if (!isMetaMode && TxtPort != null) TxtPort.Text = p;
                    });
                    AppendLog("[+] ════════════ LIVE HARDWARE CONNECTED ════════════");
                    AppendLog($"[+] Live Hardware Port : {p}");
                    AppendLog($"[+] Driver Interface   : {probe.ComDesc}");
                    AppendLog($"[+] Connection Captured: {(tick * 0.25):F1}s");
                    AppendLog("[+] ═════════════════════════════════════════════════");
                    SetMtkProgress(35, $"Connected on {p}");
                    return (true, p);
                }

                await Task.Delay(250);
            }

            // Timed out after timeoutSeconds
            AppendLog($"[-] TIMEOUT: No device detected on USB/COM bus within {timeoutSeconds} seconds!");
            AppendLog("[-] Troubleshooting & Workshop Diagnostic Advice:");
            AppendLog("    • Ensure phone battery has charge and phone is powered completely OFF.");
            AppendLog("    • Hold [Volume Down] or [Vol- and Vol+] firmly BEFORE and WHILE connecting USB cable.");
            AppendLog("    • Verify MediaTek USB VCOM driver is installed in Windows Device Manager.");
            AppendLog("    • Try another USB port (prefer rear motherboard ports or USB 2.0).");
            SetMtkProgress(0, "Listening Timeout");
            return (false, "");
        }

        private bool EnsureValidHardwarePort(string? portName, out string validPort)
        {
            validPort = portName?.Trim() ?? "";
            if (string.IsNullOrWhiteSpace(validPort))
            {
                AppendLog("[-] Error: No COM port specified or detected! Please connect device and click 'Auto Detect'.");
                SetMtkProgress(0, "No Port");
                return false;
            }

            var activePorts = GetSystemSerialPorts();
            if (activePorts == null || !activePorts.Contains(validPort, StringComparer.OrdinalIgnoreCase))
            {
                AppendLog($"[-] Error: Hardware port '{validPort}' is not detected on system serial bus!");
                AppendLog($"[-] Active system ports: {(activePorts != null && activePorts.Length > 0 ? string.Join(", ", activePorts) : "None")}");
                AppendLog("[-] Troubleshooting:");
                AppendLog("    • Ensure phone is completely powered OFF.");
                AppendLog("    • Hold [Volume Down] or [Vol+ and Vol-] while inserting the USB cable.");
                AppendLog("    • Verify MediaTek USB VCOM driver is installed in Windows Device Manager.");
                SetMtkProgress(0, "Port Offline");
                return false;
            }

            return true;
        }

        private bool EnsureValidHardwarePortSilent(string? portName, out string validPort)
        {
            validPort = portName?.Trim() ?? "";
            if (string.IsNullOrWhiteSpace(validPort)) return false;
            var activePorts = GetSystemSerialPorts();
            return activePorts != null && activePorts.Contains(validPort, StringComparer.OrdinalIgnoreCase);
        }

        
        // ====================================================================
        // SECURITY & AUTH BYPASS CONTROLS (LED STYLE)
        // ====================================================================
        private bool _isBromAuthBypassActive = true;
        private bool _isPreloaderExploitActive = true;

        private void OnToggleBromAuthClicked(object sender, RoutedEventArgs e)
        {
            _isBromAuthBypassActive = !_isBromAuthBypassActive;
            UpdateBypassUiState();
            AppendLog($"[*] BROM Auth / SLA Security Bypass: {(_isBromAuthBypassActive ? "ARMED & ACTIVE" : "DISABLED")}");
        }

        private void OnTogglePreloaderExploitClicked(object sender, RoutedEventArgs e)
        {
            _isPreloaderExploitActive = !_isPreloaderExploitActive;
            UpdateBypassUiState();
            AppendLog($"[*] Preloader EMI RAM Exploit: {(_isPreloaderExploitActive ? "ARMED & ACTIVE" : "DISABLED")}");
        }

        private void SetBypassToggles(bool bromAuth, bool preloaderExploit)
        {
            _isBromAuthBypassActive = bromAuth;
            _isPreloaderExploitActive = preloaderExploit;
            UpdateBypassUiState();
        }

        private void UpdateBypassUiState()
        {
            var activeBg = new SolidColorBrush(Color.FromRgb(0x06, 0x4E, 0x3B));
            var activeBorder = new SolidColorBrush(Color.FromRgb(0x10, 0xB9, 0x81));
            var activeLed = new SolidColorBrush(Color.FromRgb(0x10, 0xB9, 0x81));

            var inactiveBg = new SolidColorBrush(Color.FromRgb(0x1E, 0x29, 0x3B));
            var inactiveBorder = new SolidColorBrush(Color.FromRgb(0x33, 0x41, 0x55));
            var inactiveLed = new SolidColorBrush(Color.FromRgb(0x64, 0x74, 0x8B));

            // MTK View Buttons
            if (BtnBromAuthBypass != null)
            {
                BtnBromAuthBypass.Background = _isBromAuthBypassActive ? activeBg : inactiveBg;
                BtnBromAuthBypass.BorderBrush = _isBromAuthBypassActive ? activeBorder : inactiveBorder;
            }
            if (LedBromAuth != null) LedBromAuth.Foreground = _isBromAuthBypassActive ? activeLed : inactiveLed;

            if (BtnPreloaderExploit != null)
            {
                BtnPreloaderExploit.Background = _isPreloaderExploitActive ? activeBg : inactiveBg;
                BtnPreloaderExploit.BorderBrush = _isPreloaderExploitActive ? activeBorder : inactiveBorder;
            }
            if (LedPreloader != null) LedPreloader.Foreground = _isPreloaderExploitActive ? activeLed : inactiveLed;

            // AutoHub Buttons
            if (BtnAutoHubBromAuth != null)
            {
                BtnAutoHubBromAuth.Background = _isBromAuthBypassActive ? activeBg : inactiveBg;
                BtnAutoHubBromAuth.BorderBrush = _isBromAuthBypassActive ? activeBorder : inactiveBorder;
            }
            if (LedAutoHubBrom != null) LedAutoHubBrom.Foreground = _isBromAuthBypassActive ? activeLed : inactiveLed;

            if (BtnAutoHubPreloader != null)
            {
                BtnAutoHubPreloader.Background = _isPreloaderExploitActive ? activeBg : inactiveBg;
                BtnAutoHubPreloader.BorderBrush = _isPreloaderExploitActive ? activeBorder : inactiveBorder;
            }
            if (LedAutoHubPreloader != null) LedAutoHubPreloader.Foreground = _isPreloaderExploitActive ? activeLed : inactiveLed;

            string statusText = (_isBromAuthBypassActive && _isPreloaderExploitActive)
                ? "● BYPASS READY"
                : (_isBromAuthBypassActive ? "● SLA ACTIVE" : (_isPreloaderExploitActive ? "● PRELOADER ACTIVE" : "○ BYPASS OFF"));

            if (TxtBypassStatus != null) TxtBypassStatus.Text = statusText;
            if (TxtAutoHubBypassStatus != null) TxtAutoHubBypassStatus.Text = statusText;
        }

        private void AutoSelectBrandAndModel(string brandName, string modelName)
        {
            if (string.IsNullOrEmpty(brandName)) return;

            // 1. Select Brand in AutoHub and MTK
            int brandIdx = -1;
            if (CmbAutoHubBrand != null)
            {
                for (int i = 0; i < CmbAutoHubBrand.Items.Count; i++)
                {
                    string item = CmbAutoHubBrand.Items[i]?.ToString() ?? "";
                    if (item.Equals(brandName, StringComparison.OrdinalIgnoreCase) ||
                        item.Contains(brandName, StringComparison.OrdinalIgnoreCase))
                    {
                        brandIdx = i;
                        CmbAutoHubBrand.SelectedIndex = i;
                        break;
                    }
                }
            }
            if (CmbBrandSelector != null && brandIdx >= 0 && brandIdx < CmbBrandSelector.Items.Count)
            {
                CmbBrandSelector.SelectedIndex = brandIdx;
            }

            // 2. Select Model in AutoHub and MTK
            if (string.IsNullOrEmpty(modelName)) return;

            string cleanModel = modelName.Trim();

            void MatchAndSelect(ComboBox cmb)
            {
                if (cmb == null || cmb.Items.Count == 0) return;
                int bestMatch = -1;
                for (int i = 0; i < cmb.Items.Count; i++)
                {
                    string item = cmb.Items[i]?.ToString() ?? "";
                    if (item.Equals(cleanModel, StringComparison.OrdinalIgnoreCase))
                    {
                        bestMatch = i;
                        break;
                    }
                    string[] tokens = cleanModel.Split(new[] { ' ', '-', '_' }, StringSplitOptions.RemoveEmptyEntries);
                    foreach (var tok in tokens)
                    {
                        if (tok.Length >= 4 && item.Contains(tok, StringComparison.OrdinalIgnoreCase))
                        {
                            bestMatch = i;
                            break;
                        }
                    }
                    if (bestMatch >= 0) break;
                }

                if (bestMatch >= 0)
                {
                    cmb.SelectedIndex = bestMatch;
                }
            }

            MatchAndSelect(CmbAutoHubModel);
            MatchAndSelect(CmbModelSelector);

            AppendAutoHubLog($"[+] Smart Target Auto-Routed: {CmbAutoHubBrand?.Text} -> {CmbAutoHubModel?.Text}");
        }

        
