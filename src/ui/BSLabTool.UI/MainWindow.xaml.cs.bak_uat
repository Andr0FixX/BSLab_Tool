        private async void OnAutoHubEraseSelectedClicked(object sender, RoutedEventArgs e)
        {
            var selected = GetSelectedPartitionsFromGrid(GridAutoHubPartitions);
            if (selected.Count == 0)
            {
                AppendAutoHubLog("[-] Warning: No partitions selected in table to erase. Select rows first.");
                return;
            }

            var confirm = MessageBox.Show(
                $"WARNING: You are about to erase {selected.Count} partition(s)!\n\nPartitions: {string.Join(", ", selected.Select(p => p.Name))}\n\nAre you absolutely sure?",
                "Auto-Hub Partition Erase Confirmation",
                MessageBoxButton.YesNo,
                MessageBoxImage.Warning);

            if (confirm != MessageBoxResult.Yes)
            {
                AppendAutoHubLog("[*] Partition Erase cancelled safely by technician.");
                return;
            }

            AppendAutoHubLog("══════════════════════════════════════════════════════════════");
            AppendAutoHubLog($"[!] ⚠️ INITIATING PARTITION ERASE ROUTINE: {selected.Count} Partitions");
            AppendAutoHubLog("══════════════════════════════════════════════════════════════");

            string fbCheck = await ExecuteCliAsync("fastboot.exe", "devices");
            bool fbOnline = !string.IsNullOrWhiteSpace(fbCheck) && !fbCheck.Contains("Error");

            int done = 0;
            foreach (var part in selected)
            {
                done++;
                AppendAutoHubLog($"[*] Erasing partition [{done}/{selected.Count}]: '{part.Name}'...");
                if (fbOnline)
                {
                    string res = await ExecuteCliAsync("fastboot.exe", $"erase {part.Name}");
                    AppendAutoHubLog($"[+] Fastboot: {res}");
                }
                else
                {
                    await ExecuteCliAsync("adb.exe", $"shell su -c dd if=/dev/zero of=/dev/block/by-name/{part.Name} bs=4096 count=256");
                    AppendAutoHubLog($"[+] Zeroed block header for partition: '{part.Name}'");
                }
            }

            AppendAutoHubLog("[+] ✅ Selected partition erase completed successfully.");
            AppendAutoHubLog("══════════════════════════════════════════════════════════════");
        }

        private List<TempRootTargetProfile> _tempRootTargets = new();

        private void InitTempRootDatabase()
        {
            try
            {
                string jsonPath = @"c:\BSLab_Tool\engines\temp_root_targets.json";
                if (File.Exists(jsonPath))
                {
                    string json = File.ReadAllText(jsonPath);
                    var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var targets = JsonSerializer.Deserialize<List<TempRootTargetProfile>>(json, opts);
                    if (targets != null && targets.Count > 0)
                    {
                        _tempRootTargets = targets;
                    }
                }
            }
            catch { }

            if (_tempRootTargets.Count == 0)
            {
                _tempRootTargets = new List<TempRootTargetProfile>
                {
                    new() { Brand = "Samsung Galaxy", Model = "Galaxy S25 / S25+ / S25 Ultra", ModelCode = "SM-S931x / S936x / S938x", Kernel = "6.6.98", Build = "S25 Global/China", Exploit = "GhostLock (CVE-2026-43499)", Loader = "Root My Galaxy", Status = "Tested" },
                    new() { Brand = "Samsung Galaxy", Model = "Galaxy S24 Ultra (US/Int/CN)", ModelCode = "SM-S928U1 / S928B / S9280", Kernel = "6.1.145", Build = "DZF2 / DZDR", Exploit = "GhostLock / DirtyFrag", Loader = "RootMyS24", Status = "Tested" },
                    new() { Brand = "Google Pixel", Model = "Pixel 9 / 9 Pro / 9 Pro XL / Fold", ModelCode = "Pixel 9 Series", Kernel = "android14-6.1", Build = "CP2A.260705.006", Exploit = "GhostLock GKI", Loader = "Root My Pixel", Status = "Tested" },
                    new() { Brand = "OnePlus / OPPO / Realme", Model = "OnePlus 15 / Ace 6T", ModelCode = "CPH2745 / PLR110", Kernel = "6.12.23 / 6.12.38", Build = "ColorOS 16", Exploit = "GhostLock", Loader = "ghostlock-oneplus", Status = "Tested" },
                    new() { Brand = "vivo & iQOO", Model = "iQOO Neo 11 / Z10 Turbo Pro", ModelCode = "PD2520 / PD2453", Kernel = "6.6.89", Build = "OriginOS 5", Exploit = "GhostLock", Loader = "RootMyVivo", Status = "Tested" },
                    new() { Brand = "Xiaomi / Redmi / POCO", Model = "Xiaomi 17 / 17T Pro", ModelCode = "pudding / warhol", Kernel = "6.12.23 / 6.12.38", Build = "HyperOS 3", Exploit = "GhostLock", Loader = "Root My Device", Status = "Tested" }
                };
            }

            if (CmbTempRootBrand != null)
            {
                var brands = _tempRootTargets.Select(t => t.Brand).Distinct().ToList();
                CmbTempRootBrand.ItemsSource = brands;
                if (brands.Count > 0)
                {
                    CmbTempRootBrand.SelectedIndex = 0;
                }
            }
        }

        private void OnTempRootBrandChanged(object sender, SelectionChangedEventArgs e)
        {
            if (CmbTempRootBrand?.SelectedItem is string brand)
            {
                var models = _tempRootTargets.Where(t => t.Brand == brand).Select(t => t.Model).Distinct().ToList();
                if (CmbTempRootModel != null)
                {
                    CmbTempRootModel.ItemsSource = models;
                    if (models.Count > 0)
                    {
                        CmbTempRootModel.SelectedIndex = 0;
                    }
                }
            }
        }

        private void OnTempRootModelChanged(object sender, SelectionChangedEventArgs e)
        {
            if (CmbTempRootModel?.SelectedItem is string model)
            {
                var profile = _tempRootTargets.FirstOrDefault(t => t.Model == model);
                if (profile != null)
                {
                    if (TxtTempRootStatusBadge != null)
                    {
                        TxtTempRootStatusBadge.Text = $"🟢 {profile.Status.ToUpperInvariant()} PROFILE ({profile.ModelCode})";
                        TxtTempRootStatusBadge.Foreground = new SolidColorBrush(Color.FromRgb(16, 185, 129));
                    }
                    if (TxtTempRootDetails != null)
                    {
                        TxtTempRootDetails.Text = $"Kernel: {profile.Kernel} | Build: {profile.Build} | Engine: {profile.Exploit} ({profile.Loader})";
                    }
                }
            }
        }

        private async void OnTempRootAutoDetectClicked(object sender, RoutedEventArgs e)
        {
            AppendAutoHubLog("══════════════════════════════════════════════════════════════");
            AppendAutoHubLog("⚡ [TEMP ROOT HARDWARE RADAR] AUTO-DETECTING CONNECTED PHONE");
            AppendAutoHubLog("══════════════════════════════════════════════════════════════");

            string adbCheck = await ExecuteCliAsync("adb.exe", "devices");
            if (!adbCheck.Contains("\tdevice"))
            {
                AppendAutoHubLog("[-] Device not detected via ADB. Connect phone with USB Debugging enabled.");
                if (TxtTempRootStatusBadge != null)
                {
                    TxtTempRootStatusBadge.Text = "🔴 Phone Disconnected (ADB Required)";
                    TxtTempRootStatusBadge.Foreground = new SolidColorBrush(Color.FromRgb(239, 68, 68));
                }
                return;
            }

            string brand = (await ExecuteCliAsync("adb.exe", "shell getprop ro.product.brand")).Trim();
            string model = (await ExecuteCliAsync("adb.exe", "shell getprop ro.product.model")).Trim();
            string kernel = (await ExecuteCliAsync("adb.exe", "shell uname -r")).Trim();
            string build = (await ExecuteCliAsync("adb.exe", "shell getprop ro.build.display.id")).Trim();

            AppendAutoHubLog($"[*] Detected Brand  : {brand.ToUpperInvariant()}");
            AppendAutoHubLog($"[*] Detected Model  : {model}");
            AppendAutoHubLog($"[*] Linux Kernel    : {kernel}");
            AppendAutoHubLog($"[*] OS Build ID     : {build}");

            TempRootTargetProfile? match = null;
            foreach (var target in _tempRootTargets)
            {
                if (target.Model.IndexOf(model, StringComparison.OrdinalIgnoreCase) >= 0 ||
                    target.ModelCode.IndexOf(model, StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    match = target;
                    break;
                }
            }

            if (match != null)
            {
                if (CmbTempRootBrand != null) CmbTempRootBrand.SelectedItem = match.Brand;
                if (CmbTempRootModel != null) CmbTempRootModel.SelectedItem = match.Model;
                if (TxtTempRootStatusBadge != null)
                {
                    TxtTempRootStatusBadge.Text = $"🟢 100% MATCH: {match.Model} ({match.Status})";
                    TxtTempRootStatusBadge.Foreground = new SolidColorBrush(Color.FromRgb(16, 185, 129));
                }
                AppendAutoHubLog($"[+] ✅ Matched Verified Profile: {match.Model} [{match.Exploit}]");
                AppendAutoHubLog($"[+] Ready to audit or apply UID 0 Temporary Root!");
            }
            else
            {
                string? matchedBrand = null;
                foreach (var b in _tempRootTargets.Select(t => t.Brand).Distinct())
                {
                    if (b.IndexOf(brand, StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        matchedBrand = b;
                        break;
                    }
                }

                if (matchedBrand != null && CmbTempRootBrand != null)
                {
                    CmbTempRootBrand.SelectedItem = matchedBrand;
                }

                bool isGki = kernel.Contains("5.10.") || kernel.Contains("5.15.") || kernel.Contains("6.1.") || kernel.Contains("6.6.") || kernel.Contains("6.12.");
                if (isGki)
                {
                    if (TxtTempRootStatusBadge != null)
                    {
                        TxtTempRootStatusBadge.Text = $"🟡 Compatible GKI Kernel ({kernel.Split('-')[0]})";
                        TxtTempRootStatusBadge.Foreground = new SolidColorBrush(Color.FromRgb(245, 158, 11));
                    }
                    AppendAutoHubLog($"[+] Phone uses GKI Kernel {kernel}. Eligible for Generic GhostLock / DFRoot UID 0!");
                }
                else
                {
                    if (TxtTempRootStatusBadge != null)
                    {
                        TxtTempRootStatusBadge.Text = $"🟡 Legacy Kernel {kernel.Split('-')[0]} (Use Fastboot Root)";
                        TxtTempRootStatusBadge.Foreground = new SolidColorBrush(Color.FromRgb(245, 158, 11));
                    }
                    AppendAutoHubLog($"[!] Legacy Kernel {kernel} detected. GhostLock requires GKI 5.10+. Recommend using Fastboot Magisk Root!");
                }
            }

            AppendAutoHubLog("══════════════════════════════════════════════════════════════");
        }

