        private void OnSettingsBrowsePlatformToolsClicked(object sender, RoutedEventArgs e)

        {

            var dlg = new OpenFileDialog

            {

                Title = "Select adb.exe or fastboot.exe in platform-tools",

                Filter = "Executables (*.exe)|*.exe|All Files (*.*)|*.*",

                InitialDirectory = @"C:\BSLab_Tool\tools\platform-tools"

            };

            if (dlg.ShowDialog() == true)

            {

                string dir = System.IO.Path.GetDirectoryName(dlg.FileName) ?? "";

                TxtSettingsPlatformToolsPath.Text = dir;

                AppendSettingsLog($"[+] Platform-Tools Directory Updated: {dir}");

            }

        }



        private async void OnSettingsTestAdbClicked(object sender, RoutedEventArgs e)

        {

            AppendSettingsLog("[*] Testing ADB & Fastboot subsystem binaries...");

            string adbVer = await ExecuteCliAsync("adb.exe", "version");

            string fbVer = await ExecuteCliAsync("fastboot.exe", "--version");



            if (!string.IsNullOrWhiteSpace(adbVer))

            {

                var match = Regex.Match(adbVer, @"Android Debug Bridge version ([^\r\n]+)");

                AppendSettingsLog($"[+] ADB Online: {(match.Success ? match.Groups[1].Value : "Verified")}");

            }

            else

            {

                AppendSettingsLog("[-] ADB binary test failed. Check platform-tools directory.");

            }



            if (!string.IsNullOrWhiteSpace(fbVer))

            {

                var matchFb = Regex.Match(fbVer, @"fastboot version ([^\r\n]+)");

                AppendSettingsLog($"[+] Fastboot Online: {(matchFb.Success ? matchFb.Groups[1].Value : "Verified")}");

            }

            else

            {

                AppendSettingsLog("[-] Fastboot binary test failed.");

            }

        }



