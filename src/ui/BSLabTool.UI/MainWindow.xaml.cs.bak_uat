        public class UnisocModelSpec
        {
            public string ModelName { get; set; }
            public string Chipset { get; set; }
            public string PlatformCode { get; set; }
            public string StorageType { get; set; }
            public string BootKey { get; set; }

            public UnisocModelSpec(string model, string chipset, string platform, string storage, string bootKey)
            {
                ModelName = model;
                Chipset = chipset;
                PlatformCode = platform;
                StorageType = storage;
                BootKey = bootKey;
            }

            public override string ToString() => $"{ModelName} ({Chipset})";
        }

