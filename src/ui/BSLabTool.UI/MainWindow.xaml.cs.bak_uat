        private List<GptPartitionModel> GetSelectedPartitionsFromGrid(DataGrid grid)
        {
            var list = new List<GptPartitionModel>();
            if (grid == null) return list;

            if (grid.SelectedItems != null && grid.SelectedItems.Count > 0)
            {
                foreach (var item in grid.SelectedItems)
                {
                    if (item is GptPartitionModel pm && !list.Contains(pm))
                    {
                        list.Add(pm);
                    }
                }
            }

            if (list.Count == 0 && grid.ItemsSource is IEnumerable<GptPartitionModel> items)
            {
                foreach (var pm in items)
                {
                    if (pm.IsChecked && !list.Contains(pm))
                    {
                        list.Add(pm);
                    }
                }
            }

            return list;
        }

        private async Task ExecuteDumpSelectedPartitionsAsync(DataGrid targetGrid, Action<string> logAction)
        {
            if (targetGrid == null) return;

            var selectedPartitions = GetSelectedPartitionsFromGrid(targetGrid);

            // Fallback: If still empty, select top critical security partitions
            if (selectedPartitions.Count == 0 && targetGrid.ItemsSource is IEnumerable<GptPartitionModel> allItems)
            {
                selectedPartitions.AddRange(allItems.Take(4));
            }

            if (selectedPartitions.Count == 0)
            {
                logAction("[-] Warning: No partitions selected in table to dump. Please select or check partition rows.");
                return;
            }

            string timeStamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            string modelName = (ViewMtk?.Visibility == Visibility.Visible ? CmbModelSelector?.Text : null)
                ?? (ViewUnisoc?.Visibility == Visibility.Visible ? CmbUnisocModel?.Text : null)
                ?? CmbModelSelector?.Text
                ?? CmbAutoHubModel?.Text
                ?? "Infinix_Hot_60i";
            modelName = System.Text.RegularExpressions.Regex.Replace(modelName, @"[^\w\.-]", "_");
            string targetDir = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "backups", "partitions", $"{modelName}_{timeStamp}");
            Directory.CreateDirectory(targetDir);

            logAction("══════════════════════════════════════════════════════════════");
            logAction($"[*] BATCH PARTITION DUMP ENGAGED: {selectedPartitions.Count} Partitions queued.");
            logAction($"[*] Target Storage Directory: {targetDir}");
            logAction("══════════════════════════════════════════════════════════════");

            string adbCheck = await ExecuteCliAsync("adb.exe", "devices");
            bool adbOnline = adbCheck.Contains("\tdevice");
            bool isPortConnected = EnsureValidHardwarePortSilent(TxtPort?.Text, out string port);

            if (!adbOnline && !isPortConnected)
            {
                logAction("[-] Error: No live phone detected! Connect device via ADB or in MediaTek BROM / Preloader mode.");
                return;
            }

            int currentIdx = 0;
            int successCount = 0;
            foreach (var part in selectedPartitions)
            {
                currentIdx++;
                logAction($"[*] [{currentIdx}/{selectedPartitions.Count}] Reading physical block: '{part.Name}' (LBA: 0x{part.StartLba:X8}, Sectors: {part.SectorCount}, Size: {part.SizeStr})...");

                string outFilePath = System.IO.Path.Combine(targetDir, $"{part.Name}.bin");
                bool dumpedLive = false;

                if (isPortConnected && !IsQualcommMode)
                {
                    // MediaTek Native Dump via BSLabCore
                    try
                    {
                        dumpedLive = BSLabBridge.BSLab_MTK_DumpPartition(port, part.Name, part.StartLba, part.SectorCount, outFilePath, _progressCallback);
                    }
                    catch { dumpedLive = false; }
                }

                if (!dumpedLive && adbOnline)
                {
                    // Try ADB physical block dump
                    string ddRes = await ExecuteCliAsync("adb.exe", $"shell su -c 'dd if=/dev/block/by-name/{part.Name} of=/sdcard/{part.Name}.dump'");
                    if (!ddRes.Contains("Permission denied") && !ddRes.Contains("No such") && !ddRes.Contains("failed"))
                    {
                        await ExecuteCliAsync("adb.exe", $"pull /sdcard/{part.Name}.dump \"{outFilePath}\"");
                        await ExecuteCliAsync("adb.exe", $"shell rm /sdcard/{part.Name}.dump");
                        dumpedLive = File.Exists(outFilePath) && new FileInfo(outFilePath).Length > 0;
                    }
                }

                if (!dumpedLive)
                {
                    logAction($"[-] Failed to extract partition '{part.Name}' from physical hardware.");
                    logAction("[-] Notice: Ensure device storage is accessible and root or BROM privileges are active.");
                    continue;
                }

                successCount++;
                using var sha = System.Security.Cryptography.SHA256.Create();
                using var fs = File.OpenRead(outFilePath);
                byte[] hash = await sha.ComputeHashAsync(fs);
                string shaHex = BitConverter.ToString(hash).Replace("-", "").ToLowerInvariant();
                await File.WriteAllTextAsync(outFilePath + ".sha256", $"{shaHex} *{part.Name}.bin\n");

                logAction($"[+] Partition '{part.Name}' committed! Size: {new FileInfo(outFilePath).Length / 1024} KB | SHA-256: {shaHex.Substring(0, 16)}...");
            }

            logAction("══════════════════════════════════════════════════════════════");
            if (successCount > 0)
            {
                logAction($"[+] {successCount}/{selectedPartitions.Count} PARTITIONS SUCCESSFULLY EXTRACTED & VERIFIED!");
                logAction($"[+] Backup Archive Location: {targetDir}");
                try
                {
                    System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = targetDir,
                        UseShellExecute = true
                    });
                }
                catch { }
            }
            else
            {
                logAction("[-] 0 partitions dumped. Ensure device is connected in BROM mode with DA loaded, or ADB Root is active.");
            }
            logAction("══════════════════════════════════════════════════════════════");
        }



        // ====================================================================

        // SMART MODEL SELECTOR & HARDWARE SNIFFER ENGINE

        // ====================================================================



        private void InitSmartModelSelector()

        {

            try

            {

                string jsonPath = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "resources", "database", "brands_models.json");

                if (!File.Exists(jsonPath))

                {

                    jsonPath = @"C:\BSLab_Tool\resources\database\brands_models.json";

                }



                if (File.Exists(jsonPath))

                {

                    string json = File.ReadAllText(jsonPath);

                    using var doc = JsonDocument.Parse(json);

                    foreach (var brandProp in doc.RootElement.EnumerateObject())

                    {

                        string brand = brandProp.Name;

                        var modelsDict = new Dictionary<string, SmartModelInfo>();



                        foreach (var modelProp in brandProp.Value.EnumerateObject())

                        {

                            var m = modelProp.Value;

                            var info = new SmartModelInfo

                            {

                                Chipset = m.TryGetProperty("chipset", out var c) ? c.GetString() ?? "" : "",

                                Platform = m.TryGetProperty("platform", out var p) ? p.GetString() ?? "" : "",

                                CpuFamily = m.TryGetProperty("cpu_family", out var cf) ? cf.GetString() ?? "" : "",

                                LoaderFile = m.TryGetProperty("loader_file", out var lf) ? lf.GetString() ?? "" : "",

                                PreloaderFile = m.TryGetProperty("preloader_file", out var pf) ? pf.GetString() ?? "" : "",

                                Testpoint = m.TryGetProperty("testpoint", out var tp) ? tp.GetString() ?? "" : "",

                                EdlVoltage = m.TryGetProperty("edl_voltage", out var ev) ? ev.GetString() ?? "" : ""

                            };

                            modelsDict[modelProp.Name] = info;

                        }



                        _smartModels[brand] = modelsDict;

                        CmbBrandSelector?.Items.Add(brand);

                        CmbAutoHubBrand?.Items.Add(brand);

                    }

                }

            }

            catch (Exception ex)

            {

                AppendLog($"[!] Note: Smart Database initialized: {ex.Message}");

            }



            if (CmbBrandSelector?.Items.Count > 0)

            {

                int oppoIdx = -1;

                for (int i = 0; i < CmbBrandSelector.Items.Count; i++)

                {

                    if (CmbBrandSelector.Items[i]?.ToString()?.Equals("Oppo", StringComparison.OrdinalIgnoreCase) == true)

                    {

                        oppoIdx = i;

                        break;

                    }

                }

                CmbBrandSelector.SelectedIndex = oppoIdx >= 0 ? oppoIdx : 0;

            }



            if (CmbAutoHubBrand?.Items.Count > 0)

            {

                int oppoIdx = -1;

                for (int i = 0; i < CmbAutoHubBrand.Items.Count; i++)

                {

                    if (CmbAutoHubBrand.Items[i]?.ToString()?.Equals("Oppo", StringComparison.OrdinalIgnoreCase) == true)

                    {

                        oppoIdx = i;

                        break;

                    }

                }

                CmbAutoHubBrand.SelectedIndex = oppoIdx >= 0 ? oppoIdx : 0;

            }

        }



        private void OnAutoHubBrandChanged(object sender, SelectionChangedEventArgs e)

        {

            if (CmbAutoHubBrand?.SelectedItem == null || CmbAutoHubModel == null) return;

            string brand = CmbAutoHubBrand.SelectedItem.ToString() ?? "";



            CmbAutoHubModel.Items.Clear();

            if (_smartModels.TryGetValue(brand, out var models))

            {

                foreach (var modelName in models.Keys)

                {

                    CmbAutoHubModel.Items.Add(modelName);

                }

                if (CmbAutoHubModel.Items.Count > 0)

                {

                    CmbAutoHubModel.SelectedIndex = 0;

                }

            }

        }



        private void OnAutoHubModelChanged(object sender, SelectionChangedEventArgs e)

        {

            if (CmbAutoHubBrand?.SelectedItem == null || CmbAutoHubModel?.SelectedItem == null) return;

            string brand = CmbAutoHubBrand.SelectedItem.ToString() ?? "";

            string modelName = CmbAutoHubModel.SelectedItem.ToString() ?? "";



            if (_smartModels.TryGetValue(brand, out var models) && models.TryGetValue(modelName, out var info))

            {

                bool isMtk = info.Platform.Equals("mtk", StringComparison.OrdinalIgnoreCase);

                bool isQc = info.Platform.Equals("qualcomm", StringComparison.OrdinalIgnoreCase);

                bool isHuawei = info.Platform.Equals("kirin", StringComparison.OrdinalIgnoreCase) || info.Platform.Equals("huawei", StringComparison.OrdinalIgnoreCase);

                bool isUnisoc = info.Platform.Equals("unisoc", StringComparison.OrdinalIgnoreCase);

                bool isPixel = info.Platform.Equals("google", StringComparison.OrdinalIgnoreCase) || info.Platform.Equals("pixel", StringComparison.OrdinalIgnoreCase);

                if (isMtk)
                {
                    SetBypassToggles(true, true);
                }
                else if (isQc)
                {
                    SetBypassToggles(false, false);
                }



                string platTitle = isMtk ? "MediaTek" : 

                                  (isQc ? "Qualcomm Snapdragon" : 

                                  (isHuawei ? "HiSilicon Kirin" : 

                                  (isUnisoc ? "UNISOC / SPD" : 

                                  (isPixel ? "Google Tensor / Android" : info.Platform))));



                TxtAutoHubModelInfo.Text = $"SOC: {info.Chipset} | Platform: {platTitle} ({info.CpuFamily})";

                TxtAutoHubTpInfo.Text = $"Testpoint: {info.Testpoint} ({info.EdlVoltage})";



                AppendAutoHubLog($"[+] ════════════ SMART MODEL SELECTED ════════════");

                AppendAutoHubLog($"[+] Selected Target : {brand} -> {modelName}");

                AppendAutoHubLog($"[+] Hardware SoC    : {info.Chipset}");

                AppendAutoHubLog($"[+] Auto-Loader     : {info.LoaderFile}");

                AppendAutoHubLog($"[+] Testpoint Pin   : {info.Testpoint}");

                AppendAutoHubLog($"[+] ══════════════════════════════════════════════");

            }

        }



