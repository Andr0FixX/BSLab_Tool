        private async void OnBackupNvramClicked(object sender, RoutedEventArgs e)
        {
            var (portOk, port) = await EnsureValidHardwarePortAsync(TxtPort?.Text);
            if (!portOk) return;

            string modeName = IsQualcommMode ? "Qualcomm QCN & EFS (Modemst1/2)" : "MediaTek NVRAM/NVDATA";
            AppendLog($"[*] Initiating High-Security Backup: {modeName} on {port}...");
            SetMtkProgress(25, "Reading live radio & IMEI partition sectors...");

            string backupFolder = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "backups", "security_nv", $"{DateTime.Now:yyyyMMdd_HHmmss}");
            Directory.CreateDirectory(backupFolder);

            bool ok = false;
            try
            {
                await Task.Run(() =>
                {
                    try
                    {
                        if (!IsQualcommMode)
                        {
                            string daPath = ResolveDaPath(TxtDaPath?.Text);
                            if (File.Exists(daPath))
                            {
                                try { BSLabBridge.BSLab_MTK_LoadDA(port, daPath, _progressCallback); } catch { }
                            }
                        }
                        ok = BSLabBridge.BSLab_MTK_BackupNVRAM(port, backupFolder, _progressCallback);
                    }
                    catch
                    {
                        ok = false;
                    }
                });
            }
            catch { }

            if (ok)
            {
                SetMtkProgress(100, "Security Backup Created");
                AppendLog($"[+] Security Backup Archived to: {backupFolder}");
                AppendLog($"[+] Radio calibrations & IMEI successfully safeguarded! Zero-brick checkpoint created.");
            }
            else
            {
                SetMtkProgress(0, "Backup Failed");
                AppendLog($"[-] Security NVRAM Backup failed on {port}. Verify DA loader is running.");
            }
        }

