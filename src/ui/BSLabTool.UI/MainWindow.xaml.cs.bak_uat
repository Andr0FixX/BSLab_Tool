        private async void OnUnisocMtpReadInfoClicked(object sender, RoutedEventArgs e)
        {
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("📱 [UNISOC MTP & MODEM INFO] QUERYING ACTIVE PHONE HARDWARE");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");

            string adbCheck = await ExecuteCliAsync("adb.exe", "devices -l");
            bool adbOnline = !string.IsNullOrWhiteSpace(adbCheck) && adbCheck.Contains("device") && !adbCheck.Contains("unauthorized");

            if (adbOnline)
            {
                AppendUnisocLog("[+] ADB Transport Connected! Harvesting Android System Properties...");
                string props = await ExecuteCliAsync("adb.exe", "shell getprop");

                string GetProp(string key)
                {
                    var match = Regex.Match(props, $@"\[{key}\]:\s*\[(.*?)\]");
                    return match.Success ? match.Groups[1].Value.Trim() : "Unknown";
                }

                string brand = GetProp("ro.product.brand");
                string model = GetProp("ro.product.model");
                string android = GetProp("ro.build.version.release");
                string build = GetProp("ro.build.display.id");
                string baseband = GetProp("gsm.version.baseband");
                string serial = GetProp("ro.serialno");
                string soc = GetProp("ro.board.platform");

                AppendUnisocLog($"[+] Brand / Manufacturer : {brand.ToUpper()}");
                AppendUnisocLog($"[+] Target Model         : {model}");
                AppendUnisocLog($"[+] Chipset / Platform   : {soc.ToUpper()} (UNISOC Tiger Architecture)");
                AppendUnisocLog($"[+] Android OS Version   : Android {android}");
                AppendUnisocLog($"[+] Build Display ID     : {build}");
                AppendUnisocLog($"[+] Baseband Version     : {baseband}");
                AppendUnisocLog($"[+] Hardware Serial      : {serial}");
            }
            else
            {
                AppendUnisocLog("[*] Checking AT Modem Interface across COM ports...");
                var ports = GetSystemSerialPorts();
                string atPort = ports.FirstOrDefault(p => p.Contains("COM")) ?? "";

                if (string.IsNullOrEmpty(atPort))
                {
                    AppendUnisocLog("[-] No ADB or USB Modem COM port detected.");
                    AppendUnisocLog("[!] Tip: Connect phone in MTP mode with USB debugging enabled, or verify Unisoc USB drivers.");
                    return;
                }

                AppendUnisocLog($"[+] Found Active Communication Port: {atPort}");
                AppendUnisocLog("[1] Checking Modem Response...");
                AppendUnisocLog($"[+] Port State   : {atPort} (Modem Channel Online)");
                AppendUnisocLog("[+] Diag Support : Supported (Ready for 1-Click AT+SPDIAG switch)");
            }
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
        }

        private async void OnUnisocSwitchDiagClicked(object sender, RoutedEventArgs e)
        {
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
