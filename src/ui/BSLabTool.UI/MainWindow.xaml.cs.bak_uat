        private async void OnAdbRunShellClicked(object sender, RoutedEventArgs e)
        {
            string cmd = TxtAdbShellInput.Text.Trim();
            if (string.IsNullOrWhiteSpace(cmd)) return;

            string exe = "adb.exe";
            string args = "";

            if (cmd.StartsWith("adb ", StringComparison.OrdinalIgnoreCase))
            {
                exe = "adb.exe";
                args = cmd.Substring(4).Trim();
            }
            else if (cmd.StartsWith("fastboot ", StringComparison.OrdinalIgnoreCase))
            {
                exe = "fastboot.exe";
                args = cmd.Substring(9).Trim();
            }
            else if (cmd.StartsWith("sideload ", StringComparison.OrdinalIgnoreCase))
            {
                exe = "adb.exe";
                args = cmd;
            }
            else
            {
                exe = "adb.exe";
                args = $"shell {cmd}";
            }

            AppendAdbLog($"[>] {exe} {args}");
            string output = await ExecuteCliAsync(exe, args);
            AppendAdbLog(output);
        }

        private async void OnAdbSideloadOtaClicked(object sender, RoutedEventArgs e)
        {
            var dlg = new Microsoft.Win32.OpenFileDialog
            {
                Title = "Select Official Google Pixel OTA Package (.zip)",
                Filter = "Android OTA Update (*.zip)|*.zip|All Files (*.*)|*.*",
                InitialDirectory = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile) + @"\Downloads"
            };

            if (dlg.ShowDialog() != true) return;
            string zipPath = dlg.FileName;

            AppendAdbLog("══════════════════════════════════════════════════════════════");
            AppendAdbLog("🚀 [BS LAB OTA FLASHER] GOOGLE PIXEL & ANDROID RECOVERY SIDELOAD");
            AppendAdbLog("══════════════════════════════════════════════════════════════");
            AppendAdbLog($"[+] Selected OTA Zip : {zipPath}");
            AppendAdbLog($"[+] Package Size     : {new FileInfo(zipPath).Length / (1024 * 1024)} MB");
            AppendAdbLog($"[*] Probing active ADB connection & Recovery Sideload state...");

            string devCheck = await ExecuteCliAsync("adb.exe", "devices");
            AppendAdbLog(devCheck.Trim());

            if (devCheck.Contains("sideload"))
            {
                AppendAdbLog("[+] Device detected in Recovery Sideload Mode. Starting flash!");
            }
            else if (devCheck.Contains("device"))
            {
                AppendAdbLog("[*] Phone is in normal Android mode. Switching to Sideload...");
                AppendAdbLog("[>] adb reboot sideload");
                await ExecuteCliAsync("adb.exe", "reboot sideload");
                AppendAdbLog("[!] Phone is rebooting to Sideload mode. Please wait for recovery to initialize, then click '⚡ ADB Sideload OTA Package' again.");
                return;
            }
            else
            {
                AppendAdbLog("[!] No phone detected in Sideload Mode!");
                AppendAdbLog("    1. Phone power off karein ya Recovery mode mein jayein.");
                AppendAdbLog("    2. 'No Command' screen par: Hold [Power] + press [Vol+] once.");
                AppendAdbLog("    3. Menu se 'Apply update from ADB' select karein.");
                AppendAdbLog("    4. Phir dubara is button par click karein.");
                return;
            }

            AppendAdbLog($"[*] Transferring OTA payload to device... Please DO NOT disconnect USB!");

            await Task.Run(() =>
            {
                try
                {
                    string tool = GetToolPath("adb.exe");
                    var psi = new ProcessStartInfo
                    {
                        FileName = tool,
                        Arguments = $"sideload \"{zipPath}\"",
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        UseShellExecute = false,
                        CreateNoWindow = true
                    };

                    using var proc = Process.Start(psi);
                    if (proc != null)
                    {
                        proc.OutputDataReceived += (s, args) =>
                        {
                            if (!string.IsNullOrEmpty(args.Data))
                            {
                                Dispatcher.Invoke(() => AppendAdbLog(args.Data));
                            }
                        };
                        proc.ErrorDataReceived += (s, args) =>
                        {
                            if (!string.IsNullOrEmpty(args.Data))
                            {
                                Dispatcher.Invoke(() => AppendAdbLog(args.Data));
                            }
                        };
                        proc.BeginOutputReadLine();
                        proc.BeginErrorReadLine();
                        proc.WaitForExit();

                        Dispatcher.Invoke(() =>
                        {
                            if (proc.ExitCode == 0)
                            {
                                AppendAdbLog("══════════════════════════════════════════════════════════════");
                                AppendAdbLog("[✅] OTA FLASH SUCCESSFUL! 100% partitions verified & updated.");
                                AppendAdbLog("[*] Select 'Reboot system now' on phone screen.");
                                AppendAdbLog("══════════════════════════════════════════════════════════════");
                            }
                            else
                            {
                                AppendAdbLog($"[!] Sideload finished with code {proc.ExitCode}.");
                                AppendAdbLog("[!] NOTE: Stock Recovery will reject older versions (Downgrade). Make sure OTA version >= active OS version.");
                            }
                        });
                    }
                }
                catch (Exception ex)
                {
                    Dispatcher.Invoke(() => AppendAdbLog($"[!] Sideload Exception: {ex.Message}"));
                }
            });
        }

        private async void OnFastbootFlashAllClicked(object sender, RoutedEventArgs e)
        {
            var dlg = new Microsoft.Win32.OpenFileDialog
            {
                Title = "Select Google Factory Image flash-all.bat Script",
                Filter = "Batch Script (flash-all.bat)|flash-all.bat|All Files (*.*)|*.*",
                InitialDirectory = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile) + @"\Downloads"
            };

            if (dlg.ShowDialog() != true) return;
            string batPath = dlg.FileName;
            string batDir = Path.GetDirectoryName(batPath) ?? "";

            AppendAdbLog("══════════════════════════════════════════════════════════════");
            AppendAdbLog("⚡ [GOOGLE FACTORY IMAGE FLASHER] EXECUTING FLASH-ALL PIPELINE");
            AppendAdbLog("══════════════════════════════════════════════════════════════");
            AppendAdbLog($"[+] Script Path : {batPath}");
            AppendAdbLog($"[+] Working Dir : {batDir}");

            string fbCheck = await ExecuteCliAsync("fastboot.exe", "devices");
            AppendAdbLog(fbCheck.Trim());

            if (string.IsNullOrWhiteSpace(fbCheck))
            {
                AppendAdbLog("[!] No phone detected in Fastboot Mode! Put device in Bootloader first.");
                return;
            }

            AppendAdbLog("[*] Running flash-all pipeline in background...");

            await Task.Run(() =>
            {
                try
                {
                    var psi = new ProcessStartInfo
                    {
                        FileName = "cmd.exe",
                        Arguments = $"/c \"{batPath}\"",
                        WorkingDirectory = batDir,
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        UseShellExecute = false,
                        CreateNoWindow = true
                    };

                    using var proc = Process.Start(psi);
                    if (proc != null)
                    {
                        proc.OutputDataReceived += (s, args) => { if (!string.IsNullOrEmpty(args.Data)) Dispatcher.Invoke(() => AppendAdbLog(args.Data)); };
                        proc.ErrorDataReceived += (s, args) => { if (!string.IsNullOrEmpty(args.Data)) Dispatcher.Invoke(() => AppendAdbLog(args.Data)); };
                        proc.BeginOutputReadLine();
                        proc.BeginErrorReadLine();
                        proc.WaitForExit();

                        Dispatcher.Invoke(() =>
                        {
                            AppendAdbLog($"[+] Factory Image Flash completed with exit code: {proc.ExitCode}");
                        });
                    }
                }
                catch (Exception ex)
                {
                    Dispatcher.Invoke(() => AppendAdbLog($"[!] Factory Flash Error: {ex.Message}"));
                }
            });
        }



