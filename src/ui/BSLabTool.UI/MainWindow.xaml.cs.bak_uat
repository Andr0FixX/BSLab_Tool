        private async void OnScanHuaweiPortsClicked(object sender, RoutedEventArgs e)

        {

            AppendHuaweiLog("[*] Scanning for connected Huawei hardware interfaces...");

            bool foundAny = false;



            try

            {

                using var key = Microsoft.Win32.Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");

                if (key != null)

                {

                    var names = key.GetValueNames();

                    foreach (var name in names)

                    {

                        var val = key.GetValue(name)?.ToString();

                        if (val != null)

                        {

                            AppendHuaweiLog($"[+] Serial Port Detected: {val} ({name})");

                            if (name.Contains("Huawei", StringComparison.OrdinalIgnoreCase) || 

                                name.Contains("USB0", StringComparison.OrdinalIgnoreCase) ||

                                name.Contains("VCP", StringComparison.OrdinalIgnoreCase))

                            {

                                TxtHuaweiPort.Text = $"{val} (Huawei Interface)";

                                foundAny = true;

                            }

                        }

                    }

                }

            }

            catch (Exception ex)

            {

                AppendHuaweiLog($"[-] Registry serial scan notice: {ex.Message}");

            }



            string fbOut = await ExecuteCliAsync("fastboot.exe", "devices");

            if (!string.IsNullOrWhiteSpace(fbOut) && fbOut.Contains("fastboot"))

            {

                string devId = fbOut.Split('\n')[0].Trim();

                TxtHuaweiPort.Text = devId;

                AppendHuaweiLog($"[+] Huawei Fastboot Hardware Online: {devId}");

                foundAny = true;

            }



            string adbOut = await ExecuteCliAsync("adb.exe", "devices");

            if (!string.IsNullOrWhiteSpace(adbOut) && adbOut.Contains("device\n"))

            {

                AppendHuaweiLog("[+] Huawei ADB Device Online (Phone On / HDB)");

            }



            if (!foundAny)

            {

                AppendHuaweiLog("[!] No active Huawei USB COM 1.0 or Fastboot device detected.");

                AppendHuaweiLog("[*] Tip: For COM 1.0, short testpoint to GND before inserting USB cable.");

                AppendHuaweiLog("[*] Tip: For Fastboot, hold Volume Down and connect USB cable.");

            }

        }



        private void OnHuaweiChipsetChanged(object sender, SelectionChangedEventArgs e)

        {

            if (CmbHuaweiChipset?.SelectedItem is not ComboBoxItem item || TxtHuaweiXloaderPath == null) return;

            string text = item.Content.ToString() ?? "";



            string baseDir = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "resources", "loaders", "kirin");

            if (!Directory.Exists(baseDir))

            {

                baseDir = @"C:\BSLab_Tool\resources\loaders\kirin";

            }



            if (text.Contains("710", StringComparison.OrdinalIgnoreCase))

            {

                TxtHuaweiXloaderPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_710A", "xloader_1.bin");

                TxtHuaweiFastbootBinPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_710A", "fastboot.bin");

                TxtHuaweiTpGuide.Text = "Kirin 710/710A: Short TP pad near CPU shield to GND (1.8V Boot)";

                AppendHuaweiLog("[*] Selected Kirin 710/710A: Loaded xloader_1.bin + bl2.bin + fastboot.bin");

            }

            else if (text.Contains("65", StringComparison.OrdinalIgnoreCase))

            {

                TxtHuaweiXloaderPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_65x", "xloader_1.bin");

                TxtHuaweiFastbootBinPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_65x", "fastboot.bin");

                TxtHuaweiTpGuide.Text = "Kirin 65x (Honor 7X/8X/P Smart): Short TP to Motherboard Ground";

                AppendHuaweiLog("[*] Selected Kirin 65x (650/655/658/659): Loaded xloader_1.bin + fastboot.bin");

            }

            else if (text.Contains("810", StringComparison.OrdinalIgnoreCase))

            {

                TxtHuaweiXloaderPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_810", "xloader_1.bin");

                TxtHuaweiFastbootBinPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_810", "fastboot.bin");

                TxtHuaweiTpGuide.Text = "Kirin 810 (Nova 5/Honor 9X): Testpoint on rear sub-board near battery FPC";

                AppendHuaweiLog("[*] Selected Kirin 810: Loaded xloader_1.bin + fastboot.bin");

            }

            else if (text.Contains("820", StringComparison.OrdinalIgnoreCase))

            {

                TxtHuaweiXloaderPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_820", "xloader_1.bin");

                TxtHuaweiFastbootBinPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_820", "fastboot.bin");

                TxtHuaweiTpGuide.Text = "Kirin 820 5G (Honor 30S): Testpoint adjacent to antenna flex connector";

                AppendHuaweiLog("[*] Selected Kirin 820 5G: Loaded xloader_1.bin + bl2.bin + fastboot.bin");

            }

            else if (text.Contains("970", StringComparison.OrdinalIgnoreCase))

            {

                TxtHuaweiXloaderPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_970", "xloader_1.bin");

                TxtHuaweiFastbootBinPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_970", "fastboot.bin");

                TxtHuaweiTpGuide.Text = "Kirin 970 (P20/Mate 10): Testpoint underneath top camera shield";

                AppendHuaweiLog("[*] Selected Kirin 970: Loaded xloader_1.bin + fastboot.bin");

            }

            else if (text.Contains("980", StringComparison.OrdinalIgnoreCase))

            {

                TxtHuaweiXloaderPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_980", "xloader_1.bin");

                TxtHuaweiFastbootBinPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_980", "fastboot.bin");

                TxtHuaweiTpGuide.Text = "Kirin 980 (P30 Pro/Mate 20): Testpoint gold pad next to volume flex socket";

