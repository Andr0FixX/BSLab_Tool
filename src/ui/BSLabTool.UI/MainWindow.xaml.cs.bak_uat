        // ====================================================================
        // QUALCOMM DIAGNOSTIC (DIAG 900E/901D) ENGINE HANDLERS
        // ====================================================================

        private static string[] GetSystemSerialPorts()
        {
            try
            {
                using var key = Microsoft.Win32.Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");
                if (key != null)
                {
                    var names = key.GetValueNames();
                    var list = new System.Collections.Generic.List<string>();
                    foreach (var n in names)
                    {
                        var val = key.GetValue(n)?.ToString();
                        if (!string.IsNullOrEmpty(val)) list.Add(val);
                    }
                    if (list.Count > 0) return list.ToArray();
                }
            }
            catch { }
            return Array.Empty<string>();
        }

        private string FindActiveQualcommPort()
        {
            try
            {
                var ports = GetSystemSerialPorts();
                if (ports != null && ports.Length > 0)
                {
                    foreach (var p in ports)
                    {
                        if (p.Contains("COM", StringComparison.OrdinalIgnoreCase)) return p;
                    }
                    return ports[0];
                }
            }
            catch { }
            return "";
        }

        private async void OnDiagEnablePortClicked(object sender, RoutedEventArgs e)
        {
