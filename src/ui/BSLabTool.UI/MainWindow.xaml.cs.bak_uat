        private void InitUnisocDatabase()
        {
            if (CmbUnisocBrand == null) return;
            CmbUnisocBrand.Items.Clear();
            foreach (var brand in _unisocDatabase.Keys)
            {
                CmbUnisocBrand.Items.Add(brand);
            }
            CmbUnisocBrand.SelectedIndex = 0;
        }

        private void OnUnisocBrandChanged(object sender, SelectionChangedEventArgs e)
        {
            if (CmbUnisocBrand == null || CmbUnisocModel == null) return;
            string selectedBrand = CmbUnisocBrand.SelectedItem?.ToString() ?? "Infinix";
            CmbUnisocModel.Items.Clear();

            if (_unisocDatabase.TryGetValue(selectedBrand, out var models))
            {
                foreach (var m in models)
                {
                    CmbUnisocModel.Items.Add(m);
                }
                if (CmbUnisocModel.Items.Count > 0)
                {
                    CmbUnisocModel.SelectedIndex = 0;
                }
            }
        }

        private void OnUnisocModelChanged(object sender, SelectionChangedEventArgs e)
        {
            if (CmbUnisocModel?.SelectedItem is UnisocModelSpec spec)
            {
                if (TxtUnisocModelBadge != null) TxtUnisocModelBadge.Text = $"{spec.Chipset}";
                if (TxtUnisocModelInfo != null) TxtUnisocModelInfo.Text = $"Target: {spec.ModelName} | SoC: {spec.Chipset} | Storage: {spec.StorageType}";
                if (TxtUnisocTpInfo != null) TxtUnisocTpInfo.Text = $"Boot Vector: {spec.BootKey}";

                if (spec.Chipset.Contains("T606") || spec.Chipset.Contains("T7250") || spec.Chipset.Contains("T612") || spec.Chipset.Contains("T616"))
                {
                    if (TxtUnisocBromFdl1 != null) TxtUnisocBromFdl1.Text = "resources/loaders/spd/fdl1_tiger.bin (Auto-Configured)";
                    if (TxtUnisocBromFdl2 != null) TxtUnisocBromFdl2.Text = "resources/loaders/spd/fdl2_tiger.bin (Auto-Configured)";
                }
                else
                {
                    if (TxtUnisocBromFdl1 != null) TxtUnisocBromFdl1.Text = "resources/loaders/spd/fdl1_sc9863a.bin (Auto-Configured)";
                    if (TxtUnisocBromFdl2 != null) TxtUnisocBromFdl2.Text = "resources/loaders/spd/fdl2_sc9863a.bin (Auto-Configured)";
                }
            }
        }

        private async Task<string> WaitForUnisocDeviceAsync(int timeoutSeconds = 35)
        {
            _isManualSnifferActive = true;
            SetSnifferIndicatorUi(true);

            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("⏳ [UNISOC PORT SNIFFER ACTIVE] LISTENING FOR DEVICE...");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("[*] INSTRUCTION FOR TECHNICIAN:");
            AppendUnisocLog("    1. Phone ko mukammal POWER OFF karein (5-8 seconds wait).");
            AppendUnisocLog("    2. [Volume Down (-)] button press karke rakhein.");
            AppendUnisocLog("    3. USB Cable insert karein!");
            AppendUnisocLog($"[*] Sniffer polling USB & COM port bus (Timeout: {timeoutSeconds}s)...");

            var startTime = DateTime.Now;
            string detectedPort = "";
            var initialPorts = new HashSet<string>(GetSystemSerialPorts());

            try
            {
                while ((DateTime.Now - startTime).TotalSeconds < timeoutSeconds)
                {
                    // Check 1: Registry SERIALCOMM
                    try
                    {
                        using var key = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");
                        if (key != null)
                        {
                            foreach (var valueName in key.GetValueNames())
                            {
                                string com = key.GetValue(valueName)?.ToString() ?? "";
                                if (!string.IsNullOrEmpty(com))
                                {
                                    if (valueName.Contains("sprd", StringComparison.OrdinalIgnoreCase) ||
                                        valueName.Contains("sci", StringComparison.OrdinalIgnoreCase) ||
                                        valueName.Contains("u2s", StringComparison.OrdinalIgnoreCase))
                                    {
                                        detectedPort = com;
                                        break;
                                    }
                                }
                            }
                        }
                    }
                    catch { }

                    // Check 2: New COM port appeared on bus
                    if (string.IsNullOrEmpty(detectedPort))
                    {
                        var currentPorts = GetSystemSerialPorts();
                        foreach (var p in currentPorts)
                        {
                            if (!initialPorts.Contains(p))
                            {
                                detectedPort = p;
                                break;
                            }
                        }
                    }

                    // Check 3: Check fastboot
                    string fb = await ExecuteCliAsync("fastboot.exe", "devices");
                    if (!string.IsNullOrWhiteSpace(fb) && fb.Contains("fastboot"))
                    {
                        detectedPort = "FASTBOOT_INTERFACE";
                        break;
                    }

                    if (!string.IsNullOrEmpty(detectedPort))
                    {
                        break;
                    }

                }
            }
            finally
            {
                _isManualSnifferActive = false;
            }

            if (!string.IsNullOrEmpty(detectedPort))
            {
                if (detectedPort == "FASTBOOT_INTERFACE")
                {
                    UpdateLiveHardwareNotificationUi(new HardwareRadarResult
                    {
                        HasCom = false,
                        ComPort = "NONE",
                        ComDesc = "Fastboot USB",
                        HasUsb = true,
                        UsbName = "Unisoc Tiger Bootloader (Fastboot)",
                        UsbMode = "FASTBOOT"
                    });
                    AppendUnisocLog("[+] 🚀 UNISOC DEVICE DETECTED IN FASTBOOT MODE!");
                    return "FASTBOOT";
                }

                int elapsedMs = (int)(DateTime.Now - startTime).TotalMilliseconds;
                AppendUnisocLog($"[+] 🚀 UNISOC PORT DETECTED: {detectedPort} (Lock acquired in {elapsedMs}ms)!");
                AppendUnisocLog($"[+] BootROM Handshake Lock Acquired @ 921600 bps.");

                UpdateLiveHardwareNotificationUi(new HardwareRadarResult
                {
                    HasCom = true,
                    ComPort = detectedPort,
                    ComDesc = "Unisoc Tiger BootROM / FDL",
                    HasUsb = true,
                    UsbName = "Unisoc Tiger BootROM (0x1782)",
                    UsbMode = "UNISOC BROM"
                });

                return detectedPort;
            }

            // Timeout
            UpdateLiveHardwareNotificationUi(PerformQuickHardwareProbe(false));
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("[!] ❌ CONNECTION TIMEOUT: No Unisoc device detected within 35s.");
            AppendUnisocLog("[!] TROUBLESHOOTING CHECKLIST:");
            AppendUnisocLog("    • Ensure phone was completely powered OFF before inserting USB.");
            AppendUnisocLog("    • Keep [Volume Down (-)] firmly pressed while plugging in USB.");
            AppendUnisocLog("    • Verify 'SPRD U2S Diag' or 'Unisoc Driver' in Windows Device Manager.");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            return "";
        }

        private async void OnScanUnisocPortsClicked(object sender, RoutedEventArgs e)
        {
            AppendUnisocLog("[*] Scanning for connected Unisoc devices (SPRD U2S Diag / BROM / Modem)...");

            var probeResult = await Task.Run(() => PerformQuickHardwareProbe(true));
            UpdateLiveHardwareNotificationUi(probeResult);

            if (probeResult.HasCom)
            {
                AppendUnisocLog($"[+] Detected Unisoc Communication Port: {probeResult.ComPort} ({probeResult.ComDesc})");
                AppendUnisocLog($"[+] USB Interface State: {probeResult.UsbName} [{probeResult.UsbMode}]");
            }
            else if (probeResult.HasUsb)
            {
                AppendUnisocLog($"[+] Unisoc device online: {probeResult.UsbName} [{probeResult.UsbMode}]");
            }
            else
            {
                AppendUnisocLog("[-] No active Unisoc device found on COM or Fastboot bus.");
            }
        }



