        private async void OnScanSamsungPortsClicked(object sender, RoutedEventArgs e)

        {

            AppendSamsungLog("[*] Scanning for connected Samsung devices (Modem & Download Mode)...");

            string portFound = "";

            string portDesc = "";



            await Task.Run(() =>

            {

                try

                {

                    using var key = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");

                    if (key != null)

                    {

                        foreach (var valueName in key.GetValueNames())

                        {

                            string com = key.GetValue(valueName)?.ToString() ?? "";

                            if (!string.IsNullOrEmpty(com))

                            {

                                if (valueName.Contains("ssud", StringComparison.OrdinalIgnoreCase) || 

                                    valueName.Contains("SAMSUNG", StringComparison.OrdinalIgnoreCase) ||

                                    valueName.Contains("Modem", StringComparison.OrdinalIgnoreCase))

                                {

                                    portFound = com;

                                    portDesc = "SAMSUNG Mobile USB Modem Port Active";

                                    break;

                                }

                                else if (string.IsNullOrEmpty(portFound))

                                {

                                    portFound = com;

                                    portDesc = "Active Serial Communication Port";

                                }

                            }

                        }

                    }

                }

                catch { }

            });



            string adbOut = await ExecuteCliAsync("adb.exe", "devices -l");

            bool hasSamsungAdb = adbOut.Contains("samsung", StringComparison.OrdinalIgnoreCase);



            if (!string.IsNullOrEmpty(portFound))

            {

                TxtSamsungPort.Text = $" {portFound} ({portDesc})";

                TxtSamsungPortStatus.Foreground = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(0x34, 0xD3, 0x99));

                AppendSamsungLog($"[+] Detected Samsung Hardware Port: {portFound} ({portDesc})");

            }

            else if (hasSamsungAdb)

            {

                TxtSamsungPort.Text = " ADB SAMSUNG INTERFACE (USB Debugging Online)";

                TxtSamsungPortStatus.Foreground = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(0x34, 0xD3, 0x99));

                AppendSamsungLog("[+] Detected Samsung Device online via High-Speed ADB Composite Interface.");

            }

            else

            {

                TxtSamsungPort.Text = " No Samsung Port Detected (Connect USB Cable)";

                TxtSamsungPortStatus.Foreground = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(0xEF, 0x44, 0x44));

                AppendSamsungLog("[-] No Samsung COM / Modem port detected. Ensure Samsung USB drivers are installed.");

            }

        }



