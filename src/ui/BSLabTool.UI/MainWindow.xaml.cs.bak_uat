                AppendBackupLog("[-] Could not pull contacts. Ensure USB Debugging is authorized on phone screen.");
            }
        }

        private async Task<bool> BackupSmsCoreAsync(string targetFile)
        {
            string adbExe = GetAdbPath();
            string check = await ExecuteCliAsync(adbExe, "devices");
            if (!check.Contains("\tdevice"))
            {
                Dispatcher.Invoke(() => AppendBackupLog("[-] Error: Android device not detected in authorized ADB mode."));
                return false;
            }

            string res = await ExecuteCliAsync(adbExe, "shell content query --uri content://sms/ --projection address:body:date:type");
            var sb = new StringBuilder();
            sb.AppendLine("<?xml version=\"1.0\" encoding=\"utf-8\"?>");
            sb.AppendLine("<smses count=\"0\">");
            int count = 0;
            if (!string.IsNullOrWhiteSpace(res) && !res.Contains("Error") && !res.Contains("No result"))
            {
                var lines = res.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                foreach (var line in lines)
                {
                    string addr = "";
                    string body = "";
                    string date = "";
                    string type = "1";
                    var mAddr = System.Text.RegularExpressions.Regex.Match(line, @"address=([^,]+)");
                    if (mAddr.Success) addr = System.Security.SecurityElement.Escape(mAddr.Groups[1].Value.Trim());
                    var mBody = System.Text.RegularExpressions.Regex.Match(line, @"body=([^,]+)");
                    if (mBody.Success) body = System.Security.SecurityElement.Escape(mBody.Groups[1].Value.Trim());
                    var mDate = System.Text.RegularExpressions.Regex.Match(line, @"date=([^,]+)");
                    if (mDate.Success) date = mDate.Groups[1].Value.Trim();

                    if (!string.IsNullOrEmpty(addr))
                    {
                        sb.AppendLine($"  <sms address=\"{addr}\" date=\"{date}\" type=\"{type}\" body=\"{body}\" />");
                        count++;
                    }
                }
            }
            sb.AppendLine("</smses>");

            if (count > 0)
            {
                string xml = sb.ToString().Replace("<smses count=\"0\">", $"<smses count=\"{count}\">");
                await File.WriteAllTextAsync(targetFile, xml);
                return true;
            }
            else
            {
                await ExecuteCliAsync(adbExe, $"pull /data/data/com.android.providers.telephony/databases/mmssms.db \"{targetFile}.db\"");
                return File.Exists($"{targetFile}.db") && new FileInfo($"{targetFile}.db").Length > 0;
            }
        }

        private async void OnBackupSmsClicked(object sender, RoutedEventArgs e)
        {
            SetBackupProgress(20, "Extracting live SMS messages database...");
            string target = @"C:\BSLab_Tool\backups\customer_data\sms_messages.xml";
            Directory.CreateDirectory(@"C:\BSLab_Tool\backups\customer_data");

            bool ok = await BackupSmsCoreAsync(target);
            if (ok)
            {
                SetBackupProgress(100, "SMS Messages Exported Successfully!");
                AppendBackupLog($"[+] ✅ Real SMS Messages exported to: {target}");
            }
            else
            {
                SetBackupProgress(0, "Failed to pull SMS.");
                AppendBackupLog("[-] Could not pull SMS messages. Ensure phone is unlocked with USB Debugging.");
            }
        }

        private async Task<bool> BackupGalleryCoreAsync(string targetDir)
        {
            string adbExe = GetAdbPath();
            string check = await ExecuteCliAsync(adbExe, "devices");
            if (!check.Contains("\tdevice"))
            {
                Dispatcher.Invoke(() => AppendBackupLog("[-] Error: Android device not detected in authorized ADB mode."));
                return false;
            }

            Directory.CreateDirectory(targetDir);
            await ExecuteCliAsync(adbExe, $"pull /sdcard/DCIM/Camera \"{targetDir}\"");
            await ExecuteCliAsync(adbExe, $"pull /sdcard/Pictures \"{targetDir}\"");
            var files = Directory.GetFiles(targetDir, "*.*", SearchOption.AllDirectories);
            return files.Length > 0;
        }

        private async void OnBackupGalleryClicked(object sender, RoutedEventArgs e)
        {
            SetBackupProgress(15, "Scanning /sdcard/DCIM/Camera and /sdcard/Pictures for Media...");
            string targetDir = @"C:\BSLab_Tool\backups\customer_data\Camera";

            bool ok = await BackupGalleryCoreAsync(targetDir);
            if (ok)
            {
                int count = Directory.GetFiles(targetDir, "*.*", SearchOption.AllDirectories).Length;
                SetBackupProgress(100, $"Exported {count} Photo/Video file(s)!");
                AppendBackupLog($"[+] ✅ {count} Real Photos and Videos backed up to: {targetDir}");
            }
            else
            {
                SetBackupProgress(0, "No media files found.");
                AppendBackupLog("[-] No camera photos found on device storage or permission denied.");
            }
        }

        private async Task<bool> BackupCallLogsCoreAsync(string targetFile)
        {
            string adbExe = GetAdbPath();
            string check = await ExecuteCliAsync(adbExe, "devices");
            if (!check.Contains("\tdevice"))
            {
                Dispatcher.Invoke(() => AppendBackupLog("[-] Error: Android device not detected in authorized ADB mode."));
                return false;
            }

            string res = await ExecuteCliAsync(adbExe, "shell content query --uri content://call_log/calls/ --projection number:date:duration:type:name");
            var list = new List<object>();
            if (!string.IsNullOrWhiteSpace(res) && !res.Contains("Error") && !res.Contains("No result"))
            {
                var lines = res.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                foreach (var line in lines)
                {
                    string num = "";
                    string dur = "0";
                    string type = "1";
                    string name = "";
                    var mNum = System.Text.RegularExpressions.Regex.Match(line, @"number=([^,]+)");
                    if (mNum.Success) num = mNum.Groups[1].Value.Trim();
                    var mDur = System.Text.RegularExpressions.Regex.Match(line, @"duration=([^,]+)");
                    if (mDur.Success) dur = mDur.Groups[1].Value.Trim();
                    var mType = System.Text.RegularExpressions.Regex.Match(line, @"type=([^,]+)");
                    if (mType.Success) type = mType.Groups[1].Value.Trim();
                    var mName = System.Text.RegularExpressions.Regex.Match(line, @"name=([^,]+)");
                    if (mName.Success) name = mName.Groups[1].Value.Trim();

                    if (!string.IsNullOrEmpty(num))
                    {
                        list.Add(new { number = num, name = name, duration = dur, type = type });
                    }
                }
            }

            if (list.Count > 0)
            {
                await File.WriteAllTextAsync(targetFile, JsonSerializer.Serialize(list, new JsonSerializerOptions { WriteIndented = true }));
                return true;
            }
            return false;
        }

