        private async void OnFastbootFlashPartitionClicked(object sender, RoutedEventArgs e)

        {

            var dlg = new OpenFileDialog

            {

                Filter = "Partition Image (*.img;*.bin)|*.img;*.bin|All Files (*.*)|*.*",

                Title = "Select Image File to Flash via Fastboot"

            };

            if (dlg.ShowDialog() == true)

            {

                string fileName = System.IO.Path.GetFileNameWithoutExtension(dlg.FileName).ToLower();

                string partition = "boot";

                if (fileName.Contains("recovery")) partition = "recovery";

                else if (fileName.Contains("super")) partition = "super";

                else if (fileName.Contains("vbmeta")) partition = "vbmeta";

                else if (fileName.Contains("system")) partition = "system";

                else if (fileName.Contains("boot")) partition = "boot";



                AppendAdbLog($"[*] Flashing partition '{partition}' with {System.IO.Path.GetFileName(dlg.FileName)}...");

                string res = await ExecuteCliAsync("fastboot.exe", $"flash {partition} \"{dlg.FileName}\"");

                AppendAdbLog(res);

            }

        }

        private string? _currentExtractedBootPath = null;

        private string GetBootExtractorPython()
        {
            string[] pythonCandidates = new[]
            {
                @"C:\Users\AndroFixX\miniconda3\python.exe",
                @"C:\Users\AndroFixX\AppData\Local\Programs\Python\Python312\python.exe",
                "python.exe"
            };
            foreach (var cand in pythonCandidates)
            {
                if (File.Exists(cand)) return cand;
            }
            return "python.exe";
        }

        private async void OnAutoDumpBootFromDeviceClicked(object sender, RoutedEventArgs e)
        {
            AppendAdbLog("══════════════════════════════════════════════════════════════");
            AppendAdbLog("📥 [SMART BOOT EXTRACTOR] AUTO-DUMP BOOT FROM LIVE PHONE");
            AppendAdbLog("══════════════════════════════════════════════════════════════");
            AppendAdbLog("[*] Probing active device interfaces (ADB / Fastboot)...");

            string pythonExe = GetBootExtractorPython();
            string scriptPath = @"c:\BSLab_Tool\engines\boot_extractor.py";
            string outDir = @"c:\BSLab_Tool\backups\extracted_boot\phone_dump";

            try
            {
                var proc = new System.Diagnostics.Process
                {
                    StartInfo = new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = pythonExe,
                        Arguments = $"\"{scriptPath}\" dump-device -o \"{outDir}\"",
                        UseShellExecute = false,
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        CreateNoWindow = true
                    }
                };

                proc.Start();
                string output = await proc.StandardOutput.ReadToEndAsync();
                string error = await proc.StandardError.ReadToEndAsync();
                await proc.WaitForExitAsync();

                if (!string.IsNullOrWhiteSpace(output))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(output);
                        var root = doc.RootElement;
                        string status = root.GetProperty("status").GetString() ?? "";

                        if (status == "ok")
                        {
                            string file = root.GetProperty("file").GetString() ?? "";
                            string partition = root.GetProperty("partition").GetString() ?? "boot";
                            long size = root.GetProperty("size").GetInt64();
                            string msg = root.GetProperty("message").GetString() ?? "";

                            _currentExtractedBootPath = file;
                            if (TxtMagiskBootInfo != null)
                            {
                                TxtMagiskBootInfo.Text = $"✅ Target: {System.IO.Path.GetFileName(file)} ({(size / (1024.0 * 1024.0)):F2} MB - {partition})";
                            }

                            AppendAdbLog($"[+] Mode       : {root.GetProperty("mode").GetString()}");
                            AppendAdbLog($"[+] Partition  : {partition}");
                            AppendAdbLog($"[+] Target Img : {file} ({(size / (1024.0 * 1024.0)):F2} MB)");
                            AppendAdbLog($"[+] {msg}");
                            AppendAdbLog("══════════════════════════════════════════════════════════════");
                            AppendAdbLog("✅ [SUCCESS] Boot image dumped from live device and staged!");
                            AppendAdbLog("══════════════════════════════════════════════════════════════");

                            var prompt = MessageBox.Show(
                                $"Boot image dumped successfully from live device!\n\n" +
                                $"Partition: {partition}\n" +
                                $"Saved to: {file}\n\n" +
                                $"Would you like to proceed with 1-Click Magisk Root now?",
                                "Boot Dump Complete",
                                MessageBoxButton.YesNo,
                                MessageBoxImage.Information);

                            if (prompt == MessageBoxResult.Yes)
                            {
                                OnFastbootAutoMagiskRootClicked(sender, e);
                            }
                            return;
                        }
                        else if (status == "need_firmware")
                        {
                            string msg = root.GetProperty("message").GetString() ?? "";
                            AppendAdbLog($"[!] {msg}");
                            AppendAdbLog("══════════════════════════════════════════════════════════════");

                            var prompt = MessageBox.Show(
                                msg + "\n\nWould you like to select your OTA / Firmware ZIP right now to extract boot.img in 3 seconds?",
                                "Firmware Extraction Recommended",
                                MessageBoxButton.YesNo,
                                MessageBoxImage.Question);

                            if (prompt == MessageBoxResult.Yes)
                            {
                                OnAutoExtractBootFromFirmwareClicked(sender, e);
                            }
                            return;
                        }
                        else
                        {
                            string msg = root.TryGetProperty("message", out var m) ? m.GetString() ?? "" : output;
                            AppendAdbLog($"[-] Auto-dump failed: {msg}");
                        }
                    }
                    catch
                    {
                        AppendAdbLog($"[*] Dump Output: {output}");
                    }
                }
                else if (!string.IsNullOrWhiteSpace(error))
                {
                    AppendAdbLog($"[-] Error: {error}");
                }
            }
            catch (Exception ex)
            {
                AppendAdbLog($"[-] Exception: {ex.Message}");
            }

            AppendAdbLog("══════════════════════════════════════════════════════════════");
        }

        private async void OnAutoExtractBootFromFirmwareClicked(object sender, RoutedEventArgs e)
