            if (PanelMetaEngine != null && PanelDiagEngine != null && PanelFlashEngine != null)
            {
                if (PanelMetaEngine.Visibility == Visibility.Visible && IsQualcommMode)
                {
                    PanelMetaEngine.Visibility = Visibility.Collapsed;
                    PanelDiagEngine.Visibility = Visibility.Visible;
                }
                else if (PanelDiagEngine.Visibility == Visibility.Visible && !IsQualcommMode)
