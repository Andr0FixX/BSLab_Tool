        private async Task<bool> BackupContactsCoreAsync(string targetFile)
        {
            string adbExe = GetAdbPath();
            string check = await ExecuteCliAsync(adbExe, "devices");
            if (!check.Contains("\tdevice"))
            {
                Dispatcher.Invoke(() => AppendBackupLog("[-] Error: Android device not detected in authorized ADB mode."));
                return false;
            }

            string res = await ExecuteCliAsync(adbExe, "shell content query --uri content://contacts/phones/ --projection display_name:number");
            var sb = new StringBuilder();
            if (!string.IsNullOrWhiteSpace(res) && !res.Contains("Error") && !res.Contains("No result"))
            {
                var lines = res.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                foreach (var line in lines)
                {
                    string name = "";
                    string num = "";
                    var matchName = System.Text.RegularExpressions.Regex.Match(line, @"display_name=([^,]+)");
                    if (matchName.Success) name = matchName.Groups[1].Value.Trim();
                    var matchNum = System.Text.RegularExpressions.Regex.Match(line, @"number=([^,]+)");
                    if (matchNum.Success) num = matchNum.Groups[1].Value.Trim();

                    if (!string.IsNullOrEmpty(num))
                    {
                        sb.AppendLine("BEGIN:VCARD");
                        sb.AppendLine("VERSION:3.0");
                        sb.AppendLine($"FN:{name}");
                        sb.AppendLine($"TEL;TYPE=CELL:{num}");
                        sb.AppendLine("END:VCARD");
                    }
                }
            }

            if (sb.Length > 0)
            {
                await File.WriteAllTextAsync(targetFile, sb.ToString());
                return true;
            }
            else
            {
                await ExecuteCliAsync(adbExe, $"pull /data/data/com.android.providers.contacts/databases/contacts2.db \"{targetFile}.db\"");
                return File.Exists($"{targetFile}.db") && new FileInfo($"{targetFile}.db").Length > 0;
            }
        }

