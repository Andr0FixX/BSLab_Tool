                TxtHuaweiXloaderPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_990", "xloader_1.bin");

                TxtHuaweiFastbootBinPath.Text = System.IO.Path.Combine(baseDir, "KIRIN_990", "fastboot.bin");

