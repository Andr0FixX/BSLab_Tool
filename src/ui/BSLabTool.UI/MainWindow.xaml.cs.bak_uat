        public ObservableCollection<UnisocPacPartitionItem> PacPartitions { get; } = new();

        private static string FormatBytesHuman(long bytes)
        {
            if (bytes >= 1024L * 1024 * 1024)
                return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
            if (bytes >= 1024L * 1024)
                return $"{bytes / (1024.0 * 1024):F2} MB";
            if (bytes >= 1024L)
                return $"{bytes / 1024.0:F1} KB";
            return $"{bytes} B";
        }

        private void InitUnisocPacStudio()
        {
            if (DgUnisocPacPartitions != null)
            {
                DgUnisocPacPartitions.ItemsSource = PacPartitions;
            }
            if (PacPartitions.Count == 0)
            {
                LoadDefaultPacPartitions();
            }
        }

        private void LoadDefaultPacPartitions()
        {
            PacPartitions.Clear();

            var template = new (string name, string file, long bytes, bool isChecked)[]
            {
                ("fdl1",           "fdl1.bin",           32 * 1024,              true),
                ("fdl2",           "fdl2.bin",           256 * 1024,             true),
                ("splloader",      "splloader.bin",      1024 * 1024,            true),
                ("uboot",          "u-boot.bin",         2 * 1024 * 1024,        true),
                ("trustos",        "tos.bin",            4 * 1024 * 1024,        true),
                ("teecfg",         "teecfg.bin",         1024 * 1024,            true),
                ("sml",            "sml.bin",            1024 * 1024,            true),
                ("vbmeta",         "vbmeta.img",         4 * 1024 * 1024,        true),
                ("vbmeta_system",  "vbmeta_system.img",  4 * 1024 * 1024,        true),
                ("vbmeta_vendor",  "vbmeta_vendor.img",  4 * 1024 * 1024,        true),
                ("dtbo",           "dtbo.img",           8 * 1024 * 1024,        true),
                ("boot",           "boot.img",           64 * 1024 * 1024,       true),
                ("recovery",       "recovery.img",       64 * 1024 * 1024,       true),
                ("super",          "super.img",          4000L * 1024 * 1024,    true),
                ("userdata",       "userdata.img",       128 * 1024 * 1024,      true),
                ("metadata",       "metadata.img",       16 * 1024 * 1024,       true),
                ("socko",          "socko.img",          32 * 1024 * 1024,       true),
                ("odmko",          "odmko.img",          32 * 1024 * 1024,       true),
                ("prodnv",         "prodnv.bin",         4 * 1024 * 1024,        false), // Protected NVRAM
                ("persist",        "persist.img",        32 * 1024 * 1024,       false)  // Protected Calibration
            };

            int idx = 1;
            long totalBytes = 0;
            foreach (var t in template)
            {
                totalBytes += t.bytes;
                PacPartitions.Add(new UnisocPacPartitionItem
                {
                    Index = idx++,
                    Name = t.name,
                    FileName = t.file,
                    FileSizeBytes = t.bytes,
                    FileSizeHuman = FormatBytesHuman(t.bytes),
                    IsChecked = t.isChecked,
                    Status = "Ready"
                });
            }

            if (TxtPacInfoProduct != null) TxtPacInfoProduct.Text = "📦 Standard Unisoc Tiger/SC Template Loaded";
            if (TxtPacInfoSize != null) TxtPacInfoSize.Text = $"{FormatBytesHuman(totalBytes)} • {PacPartitions.Count} Partitions";
            UpdatePacSelectionBadge();
        }

        private void UpdatePacSelectionBadge()
        {
            int total = PacPartitions.Count;
            int selected = PacPartitions.Count(p => p.IsChecked);
            long selectedBytes = PacPartitions.Where(p => p.IsChecked).Sum(p => p.FileSizeBytes);
            if (TxtPacPartitionCountBadge != null)
            {
                TxtPacPartitionCountBadge.Text = $"Selected: {selected} / {total} ({FormatBytesHuman(selectedBytes)})";
            }
        }

