        private async void OnBackupUserDataClicked(object sender, RoutedEventArgs e)
        {
            SetBackupProgress(10, "Bundling Complete Real Customer UserData Package...");
            string baseDir = @"C:\BSLab_Tool\backups\customer_data";
            Directory.CreateDirectory(baseDir);

            SetBackupProgress(25, "Exporting Contacts...");
            await BackupContactsCoreAsync(System.IO.Path.Combine(baseDir, "contacts_export.vcf"));

            SetBackupProgress(50, "Exporting SMS Messages...");
            await BackupSmsCoreAsync(System.IO.Path.Combine(baseDir, "sms_messages.xml"));

            SetBackupProgress(75, "Exporting Call Logs...");
            await BackupCallLogsCoreAsync(System.IO.Path.Combine(baseDir, "call_logs.json"));

            SetBackupProgress(90, "Exporting Gallery Media...");
            await BackupGalleryCoreAsync(System.IO.Path.Combine(baseDir, "Camera"));

            SetBackupProgress(100, "UserData Package Completed!");
            AppendBackupLog($"[+] ✅ Complete Customer UserData Vault Package generated in {baseDir}");
        }

        private async void OnRestoreUserDataClicked(object sender, RoutedEventArgs e)
        {
            SetBackupProgress(15, "Scanning Customer Backup Vault for restore packages...");
            string adbExe = GetAdbPath();
            string check = await ExecuteCliAsync(adbExe, "devices");
            if (!check.Contains("\tdevice"))
            {
                SetBackupProgress(0, "Device not connected.");
                AppendBackupLog("[-] Error: Connect phone in ADB mode with USB Debugging to restore UserData.");
                return;
            }

            string baseDir = @"C:\BSLab_Tool\backups\customer_data";
            if (!Directory.Exists(baseDir))
            {
                SetBackupProgress(0, "No backup vault found.");
                AppendBackupLog("[-] No customer backup found in vault to restore.");
                return;
            }

            SetBackupProgress(50, "Pushing Contacts and SMS to device storage (/sdcard/)...");
            string vcf = System.IO.Path.Combine(baseDir, "contacts_export.vcf");
            if (File.Exists(vcf))
            {
                await ExecuteCliAsync(adbExe, $"push \"{vcf}\" /sdcard/contacts_export.vcf");
                AppendBackupLog("[+] Pushed contacts_export.vcf to /sdcard/");
            }

            string cam = System.IO.Path.Combine(baseDir, "Camera");
            if (Directory.Exists(cam))
            {
                SetBackupProgress(80, "Restoring Camera Photos...");
                await ExecuteCliAsync(adbExe, $"push \"{cam}\" /sdcard/DCIM/Camera");
                AppendBackupLog("[+] Pushed Camera Photos to /sdcard/DCIM/Camera");
            }

            SetBackupProgress(100, "UserData Restored Successfully!");
            AppendBackupLog("[+] ✅ Customer data successfully pushed to target device.");
        }



