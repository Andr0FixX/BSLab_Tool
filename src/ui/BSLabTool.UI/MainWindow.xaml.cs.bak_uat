                if (TxtHuaweiUsbBox != null) { TxtHuaweiUsbBox.Text = res.UsbName; TxtHuaweiUsbBox.Foreground = cyanBrush; }
                if (BadgeHuaweiUsb != null) BadgeHuaweiUsb.Background = cyanBadgeBg;
                if (TxtHuaweiUsbState != null) { TxtHuaweiUsbState.Text = res.UsbMode; TxtHuaweiUsbState.Foreground = cyanBadgeFg; }



                if (LedUnisocModeUsb != null) LedUnisocModeUsb.Fill = cyanBrush;

                if (GlowUnisocModeUsb != null) GlowUnisocModeUsb.Color = cyanGlow;

                if (TxtUnisocModeUsb != null)

                {

                    TxtUnisocModeUsb.Text = res.UsbMode;

                    TxtUnisocModeUsb.Foreground = cyanBrush;

                }



                if (LedGlobalUsb != null) LedGlobalUsb.Fill = cyanBrush;

                if (GlowGlobalUsb != null) GlowGlobalUsb.Color = cyanGlow;

                if (TxtGlobalUsb != null)

                {

                    TxtGlobalUsb.Text = $"USB: {res.UsbMode}";

                    TxtGlobalUsb.Foreground = cyanBrush;

                }



                if (LedStatusUsb != null) LedStatusUsb.Fill = cyanBrush;

                if (TxtStatusUsb != null)

                {

                    TxtStatusUsb.Text = $"USB: {res.UsbMode}";

                    TxtStatusUsb.Foreground = cyanBrush;

                }

            }

            else

            {

                if (LedUnisocUsb != null) LedUnisocUsb.Fill = redBrush;

                if (GlowUnisocUsb != null) GlowUnisocUsb.Color = redGlow;

                if (TxtUnisocUsbBox != null)

                {

                    TxtUnisocUsbBox.Text = "WAITING FOR USB CONNECTION...";

                    TxtUnisocUsbBox.Foreground = grayBrush;

                }

                if (BadgeUnisocUsb != null) BadgeUnisocUsb.Background = darkBadgeBg;

                if (TxtUnisocUsbState != null)

                {

                    TxtUnisocUsbState.Text = "OFFLINE";

                    TxtUnisocUsbState.Foreground = grayBadgeFg;

                }

                // AutoHub Dual Box USB Offline
                if (LedAutoHubUsb != null) LedAutoHubUsb.Fill = redBrush;
                if (GlowAutoHubUsb != null) GlowAutoHubUsb.Color = redGlow;
                if (TxtAutoHubUsbBox != null) { TxtAutoHubUsbBox.Text = "WAITING FOR USB CONNECTION..."; TxtAutoHubUsbBox.Foreground = grayBrush; }
                if (BadgeAutoHubUsb != null) BadgeAutoHubUsb.Background = darkBadgeBg;
                if (TxtAutoHubUsbState != null) { TxtAutoHubUsbState.Text = "OFFLINE"; TxtAutoHubUsbState.Foreground = grayBadgeFg; }

                // MTK Dual Box USB Offline
                if (LedMtkUsb != null) LedMtkUsb.Fill = redBrush;
                if (GlowMtkUsb != null) GlowMtkUsb.Color = redGlow;
                if (TxtMtkUsbBox != null) { TxtMtkUsbBox.Text = "WAITING FOR USB CONNECTION..."; TxtMtkUsbBox.Foreground = grayBrush; }
                if (BadgeMtkUsb != null) BadgeMtkUsb.Background = darkBadgeBg;
                if (TxtMtkUsbState != null) { TxtMtkUsbState.Text = "OFFLINE"; TxtMtkUsbState.Foreground = grayBadgeFg; }

                // Fastboot Dual Box USB Offline
                if (LedFastbootUsb != null) LedFastbootUsb.Fill = redBrush;
                if (GlowFastbootUsb != null) GlowFastbootUsb.Color = redGlow;
                if (TxtFastbootUsbBox != null) { TxtFastbootUsbBox.Text = "WAITING FOR USB CONNECTION..."; TxtFastbootUsbBox.Foreground = grayBrush; }
                if (BadgeFastbootUsb != null) BadgeFastbootUsb.Background = darkBadgeBg;
                if (TxtFastbootUsbState != null) { TxtFastbootUsbState.Text = "OFFLINE"; TxtFastbootUsbState.Foreground = grayBadgeFg; }

                // Samsung Dual Box USB Offline
                if (LedSamsungUsb != null) LedSamsungUsb.Fill = redBrush;
                if (GlowSamsungUsb != null) GlowSamsungUsb.Color = redGlow;
                if (TxtSamsungUsbBox != null) { TxtSamsungUsbBox.Text = "WAITING FOR USB CONNECTION..."; TxtSamsungUsbBox.Foreground = grayBrush; }
                if (BadgeSamsungUsb != null) BadgeSamsungUsb.Background = darkBadgeBg;
                if (TxtSamsungUsbState != null) { TxtSamsungUsbState.Text = "OFFLINE"; TxtSamsungUsbState.Foreground = grayBadgeFg; }

                // Huawei Dual Box USB Offline
                if (LedHuaweiUsb != null) LedHuaweiUsb.Fill = redBrush;
                if (GlowHuaweiUsb != null) GlowHuaweiUsb.Color = redGlow;
                if (TxtHuaweiUsbBox != null) { TxtHuaweiUsbBox.Text = "WAITING FOR USB CONNECTION..."; TxtHuaweiUsbBox.Foreground = grayBrush; }
                if (BadgeHuaweiUsb != null) BadgeHuaweiUsb.Background = darkBadgeBg;
                if (TxtHuaweiUsbState != null) { TxtHuaweiUsbState.Text = "OFFLINE"; TxtHuaweiUsbState.Foreground = grayBadgeFg; }



                if (LedUnisocModeUsb != null) LedUnisocModeUsb.Fill = redBrush;

                if (GlowUnisocModeUsb != null) GlowUnisocModeUsb.Color = redGlow;

                if (TxtUnisocModeUsb != null)

                {

                    TxtUnisocModeUsb.Text = "WAITING...";

                    TxtUnisocModeUsb.Foreground = redText;

                }



                if (LedGlobalUsb != null) LedGlobalUsb.Fill = redBrush;

                if (GlowGlobalUsb != null) GlowGlobalUsb.Color = redGlow;

                if (TxtGlobalUsb != null)

                {

                    TxtGlobalUsb.Text = "USB: DISCONNECTED";

                    TxtGlobalUsb.Foreground = grayBrush;

                }



                if (LedStatusUsb != null) LedStatusUsb.Fill = redBrush;

                if (TxtStatusUsb != null)

                {

                    TxtStatusUsb.Text = "USB: DISCONNECTED";

                    TxtStatusUsb.Foreground = grayBrush;

                }

            }

            // AUTO-HUB LEFT COLUMN RADAR CARD SYNCHRONIZATION
            if (res.HasCom || res.HasUsb)
            {
                if (TxtRadarIcon != null) TxtRadarIcon.Text = "🟢";
                if (BorderRadarIndicator != null) BorderRadarIndicator.BorderBrush = greenBrush;
                if (TxtRadarStatusBadge != null)
                {
                    TxtRadarStatusBadge.Text = $"● {res.UsbMode} ACTIVE & LOCKED";
                    TxtRadarStatusBadge.Foreground = greenBrush;
                }
                if (TxtRadarHardwareTitle != null)
                {
                    TxtRadarHardwareTitle.Text = string.IsNullOrEmpty(res.UsbName) ? "Connected Hardware" : res.UsbName;
                    TxtRadarHardwareTitle.Foreground = greenBrush;
                }
                if (TxtRadarPortInfo != null)
                {
                    TxtRadarPortInfo.Text = res.HasCom 
                        ? $"Active Channel: {res.ComPort} ({res.ComDesc})" 
                        : $"Active Mode: {res.UsbMode}";
                    TxtRadarPortInfo.Foreground = cyanBrush;
                }
                if (TxtAutoHubComPort != null)
                {
                    TxtAutoHubComPort.Text = res.HasCom ? res.ComPort : "USB DIRECT";
                    TxtAutoHubComPort.Foreground = greenBrush;
                }
                if (TxtAutoHubProtocol != null)
                {
                    TxtAutoHubProtocol.Text = res.UsbMode;
                    TxtAutoHubProtocol.Foreground = cyanBrush;
                }
                if (CmbAutoHubComPort != null && res.HasCom)
                {
                    bool found = false;
                    foreach (var item in CmbAutoHubComPort.Items)
                    {
                        if (item?.ToString()?.Contains(res.ComPort) == true)
                        {
                            found = true;
                            CmbAutoHubComPort.SelectedItem = item;
                            break;
                        }
                    }
                    if (!found)
                    {
                        CmbAutoHubComPort.Items.Add($"{res.ComPort} - {res.ComDesc}");
                        CmbAutoHubComPort.SelectedIndex = CmbAutoHubComPort.Items.Count - 1;
                    }
                }
            }
            else
            {
                if (TxtRadarIcon != null) TxtRadarIcon.Text = "⚪";
                if (BorderRadarIndicator != null) BorderRadarIndicator.BorderBrush = new SolidColorBrush(Color.FromRgb(0x33, 0x41, 0x55));
                if (TxtRadarStatusBadge != null)
                {
                    TxtRadarStatusBadge.Text = "● LISTENING ON USB BUS";
                    TxtRadarStatusBadge.Foreground = greenBrush;
                }
                if (TxtRadarHardwareTitle != null)
                {
                    TxtRadarHardwareTitle.Text = "Waiting for Device Connection...";
                    TxtRadarHardwareTitle.Foreground = new SolidColorBrush(Color.FromRgb(0xF8, 0xFA, 0xFC));
                }
                if (TxtRadarPortInfo != null)
                {
                    TxtRadarPortInfo.Text = "Connect device via USB (BROM / EDL 9008 / Diag / Fastboot / ADB)";
                    TxtRadarPortInfo.Foreground = grayBrush;
                }
                if (TxtAutoHubComPort != null)
                {
                    TxtAutoHubComPort.Text = "AUTO";
                    TxtAutoHubComPort.Foreground = new SolidColorBrush(Color.FromRgb(0xE2, 0xE8, 0xF0));
                }
                if (TxtAutoHubProtocol != null)
                {
                    TxtAutoHubProtocol.Text = "Auto-Sniffer";
                    TxtAutoHubProtocol.Foreground = cyanBrush;
                }
            }

        }



        private void SetSnifferIndicatorUi(bool isSniffing)

        {

            var amberBrush = new SolidColorBrush(Color.FromRgb(0xF5, 0x9E, 0x0B));

            var amberGlow = Color.FromRgb(0xF5, 0x9E, 0x0B);

            var amberBadgeBg = new SolidColorBrush(Color.FromRgb(0x78, 0x35, 0x0F));

            var amberBadgeFg = new SolidColorBrush(Color.FromRgb(0xFC, 0xD3, 0x4D));



            if (isSniffing)

            {

                if (LedUnisocCom != null) LedUnisocCom.Fill = amberBrush;

                if (GlowUnisocCom != null) GlowUnisocCom.Color = amberGlow;

                if (TxtUnisocComBox != null)

                {

                    TxtUnisocComBox.Text = "POLLING USB/COM BUS (35s TIMEOUT)...";

                    TxtUnisocComBox.Foreground = amberBrush;

                }

                if (BadgeUnisocCom != null) BadgeUnisocCom.Background = amberBadgeBg;

                if (TxtUnisocComState != null)

                {

                    TxtUnisocComState.Text = "SNIFFING";

                    TxtUnisocComState.Foreground = amberBadgeFg;

                }

                // AutoHub Dual Box Sniffing
                if (LedAutoHubCom != null) LedAutoHubCom.Fill = amberBrush;
                if (GlowAutoHubCom != null) GlowAutoHubCom.Color = amberGlow;
                if (TxtAutoHubComBox != null) { TxtAutoHubComBox.Text = "POLLING USB/COM BUS (35s TIMEOUT)..."; TxtAutoHubComBox.Foreground = amberBrush; }
                if (BadgeAutoHubCom != null) BadgeAutoHubCom.Background = amberBadgeBg;
                if (TxtAutoHubComState != null) { TxtAutoHubComState.Text = "SNIFFING"; TxtAutoHubComState.Foreground = amberBadgeFg; }

                // MTK Dual Box Sniffing
                if (LedMtkCom != null) LedMtkCom.Fill = amberBrush;
                if (GlowMtkCom != null) GlowMtkCom.Color = amberGlow;
                if (TxtMtkComBox != null) { TxtMtkComBox.Text = "POLLING USB/COM BUS (35s TIMEOUT)..."; TxtMtkComBox.Foreground = amberBrush; }
                if (BadgeMtkCom != null) BadgeMtkCom.Background = amberBadgeBg;
                if (TxtMtkComState != null) { TxtMtkComState.Text = "SNIFFING"; TxtMtkComState.Foreground = amberBadgeFg; }

                // Fastboot Dual Box Sniffing
                if (LedFastbootCom != null) LedFastbootCom.Fill = amberBrush;
                if (GlowFastbootCom != null) GlowFastbootCom.Color = amberGlow;
                if (TxtFastbootComBox != null) { TxtFastbootComBox.Text = "POLLING USB/COM BUS (35s TIMEOUT)..."; TxtFastbootComBox.Foreground = amberBrush; }
                if (BadgeFastbootCom != null) BadgeFastbootCom.Background = amberBadgeBg;
                if (TxtFastbootComState != null) { TxtFastbootComState.Text = "SNIFFING"; TxtFastbootComState.Foreground = amberBadgeFg; }

                // Samsung Dual Box Sniffing
                if (LedSamsungCom != null) LedSamsungCom.Fill = amberBrush;
                if (GlowSamsungCom != null) GlowSamsungCom.Color = amberGlow;
                if (TxtSamsungComBox != null) { TxtSamsungComBox.Text = "POLLING USB/COM BUS (35s TIMEOUT)..."; TxtSamsungComBox.Foreground = amberBrush; }
                if (BadgeSamsungCom != null) BadgeSamsungCom.Background = amberBadgeBg;
                if (TxtSamsungComState != null) { TxtSamsungComState.Text = "SNIFFING"; TxtSamsungComState.Foreground = amberBadgeFg; }

                // Huawei Dual Box Sniffing
                if (LedHuaweiCom != null) LedHuaweiCom.Fill = amberBrush;
                if (GlowHuaweiCom != null) GlowHuaweiCom.Color = amberGlow;
                if (TxtHuaweiComBox != null) { TxtHuaweiComBox.Text = "POLLING USB/COM BUS (35s TIMEOUT)..."; TxtHuaweiComBox.Foreground = amberBrush; }
                if (BadgeHuaweiCom != null) BadgeHuaweiCom.Background = amberBadgeBg;
                if (TxtHuaweiComState != null) { TxtHuaweiComState.Text = "SNIFFING"; TxtHuaweiComState.Foreground = amberBadgeFg; }



                if (LedUnisocUsb != null) LedUnisocUsb.Fill = amberBrush;

                if (GlowUnisocUsb != null) GlowUnisocUsb.Color = amberGlow;

                if (TxtUnisocUsbBox != null)

                {

                    TxtUnisocUsbBox.Text = "WAITING: HOLD [VOL-] + INSERT USB CABLE";

                    TxtUnisocUsbBox.Foreground = amberBrush;

                }

                if (BadgeUnisocUsb != null) BadgeUnisocUsb.Background = amberBadgeBg;

                if (TxtUnisocUsbState != null)

                {

                    TxtUnisocUsbState.Text = "HANDSHAKE";

                    TxtUnisocUsbState.Foreground = amberBadgeFg;

                }

                // AutoHub Dual Box USB Handshake
                if (LedAutoHubUsb != null) LedAutoHubUsb.Fill = amberBrush;
                if (GlowAutoHubUsb != null) GlowAutoHubUsb.Color = amberGlow;
                if (TxtAutoHubUsbBox != null) { TxtAutoHubUsbBox.Text = "WAITING: HOLD [VOL-] + INSERT USB CABLE"; TxtAutoHubUsbBox.Foreground = amberBrush; }
                if (BadgeAutoHubUsb != null) BadgeAutoHubUsb.Background = amberBadgeBg;
                if (TxtAutoHubUsbState != null) { TxtAutoHubUsbState.Text = "HANDSHAKE"; TxtAutoHubUsbState.Foreground = amberBadgeFg; }

                // MTK Dual Box USB Handshake
                if (LedMtkUsb != null) LedMtkUsb.Fill = amberBrush;
                if (GlowMtkUsb != null) GlowMtkUsb.Color = amberGlow;
                if (TxtMtkUsbBox != null) { TxtMtkUsbBox.Text = "WAITING: HOLD [VOL-] + INSERT USB CABLE"; TxtMtkUsbBox.Foreground = amberBrush; }
                if (BadgeMtkUsb != null) BadgeMtkUsb.Background = amberBadgeBg;
                if (TxtMtkUsbState != null) { TxtMtkUsbState.Text = "HANDSHAKE"; TxtMtkUsbState.Foreground = amberBadgeFg; }

                // Fastboot Dual Box USB Handshake
                if (LedFastbootUsb != null) LedFastbootUsb.Fill = amberBrush;
                if (GlowFastbootUsb != null) GlowFastbootUsb.Color = amberGlow;
                if (TxtFastbootUsbBox != null) { TxtFastbootUsbBox.Text = "WAITING: HOLD [VOL-] + INSERT USB CABLE"; TxtFastbootUsbBox.Foreground = amberBrush; }
                if (BadgeFastbootUsb != null) BadgeFastbootUsb.Background = amberBadgeBg;
                if (TxtFastbootUsbState != null) { TxtFastbootUsbState.Text = "HANDSHAKE"; TxtFastbootUsbState.Foreground = amberBadgeFg; }

                // Samsung Dual Box USB Handshake
                if (LedSamsungUsb != null) LedSamsungUsb.Fill = amberBrush;
                if (GlowSamsungUsb != null) GlowSamsungUsb.Color = amberGlow;
                if (TxtSamsungUsbBox != null) { TxtSamsungUsbBox.Text = "WAITING: HOLD [VOL-] + INSERT USB CABLE"; TxtSamsungUsbBox.Foreground = amberBrush; }
                if (BadgeSamsungUsb != null) BadgeSamsungUsb.Background = amberBadgeBg;
                if (TxtSamsungUsbState != null) { TxtSamsungUsbState.Text = "HANDSHAKE"; TxtSamsungUsbState.Foreground = amberBadgeFg; }

                // Huawei Dual Box USB Handshake
                if (LedHuaweiUsb != null) LedHuaweiUsb.Fill = amberBrush;
                if (GlowHuaweiUsb != null) GlowHuaweiUsb.Color = amberGlow;
                if (TxtHuaweiUsbBox != null) { TxtHuaweiUsbBox.Text = "WAITING: HOLD [VOL-] + INSERT USB CABLE"; TxtHuaweiUsbBox.Foreground = amberBrush; }
                if (BadgeHuaweiUsb != null) BadgeHuaweiUsb.Background = amberBadgeBg;
                if (TxtHuaweiUsbState != null) { TxtHuaweiUsbState.Text = "HANDSHAKE"; TxtHuaweiUsbState.Foreground = amberBadgeFg; }



                if (LedUnisocModeCom != null) LedUnisocModeCom.Fill = amberBrush;

                if (TxtUnisocModeCom != null) { TxtUnisocModeCom.Text = "POLLING..."; TxtUnisocModeCom.Foreground = amberBrush; }

                if (LedUnisocModeUsb != null) LedUnisocModeUsb.Fill = amberBrush;

                if (TxtUnisocModeUsb != null) { TxtUnisocModeUsb.Text = "WAITING..."; TxtUnisocModeUsb.Foreground = amberBrush; }



                if (LedGlobalCom != null) LedGlobalCom.Fill = amberBrush;

                if (TxtGlobalCom != null) { TxtGlobalCom.Text = "COM: SNIFFING"; TxtGlobalCom.Foreground = amberBrush; }

                if (LedGlobalUsb != null) LedGlobalUsb.Fill = amberBrush;

                if (TxtGlobalUsb != null) { TxtGlobalUsb.Text = "USB: WAITING"; TxtGlobalUsb.Foreground = amberBrush; }

            }

        }



        // ====================================================================

        // WINDOW CHROME CONTROLS (MINIMIZE, MAXIMIZE, CLOSE, DRAG)

        // ====================================================================



        private void OnTitleBarMouseDown(object sender, MouseButtonEventArgs e)

        {

            if (e.ChangedButton == MouseButton.Left)

            {

                if (e.ClickCount == 2)

                {

                    OnMaximizeClicked(sender, e);

                }

                else

                {

                    DragMove();

                }

            }

        }



        private void OnMinimizeClicked(object sender, RoutedEventArgs e)

        {

            WindowState = WindowState.Minimized;

        }



        private void OnMaximizeClicked(object sender, RoutedEventArgs e)

        {

            if (WindowState == WindowState.Maximized)

            {

                WindowState = WindowState.Normal;

                if (BtnMaximize != null) BtnMaximize.Content = "🗖";

            }

            else

            {

                WindowState = WindowState.Maximized;

                if (BtnMaximize != null) BtnMaximize.Content = "🗗";

            }

        }



        private void OnCloseClicked(object sender, RoutedEventArgs e)

        {

            OnExitClicked(sender, e);

        }



        private void TryInitNativeBridge()

        {

            try

            {

                bool initOk = BSLabBridge.BSLab_Initialize(_logCallback);

                if (initOk)

                {

                    AppendLog($"[+] Native Core Link established: {BSLabBridge.BSLab_GetVersion()}");

                }

            }

            catch (DllNotFoundException)

            {

                AppendLog($"[!] Note: BSLabCore.dll will be loaded dynamically from executable directory.");

            }

            catch (Exception ex)

            {

                AppendLog($"[!] Initialization notice: {ex.Message}");

            }

        }



        private void OnNativeLog(int level, string message)

        {

            Dispatcher.Invoke(() => AppendLog(message));

        }



        private void OnNativeProgress(int overallPct, int filePct, string partName, string statusText)

        {

            Dispatcher.Invoke(() =>

            {

                if (ProgressBar != null) ProgressBar.Value = overallPct;

                if (TxtProgressPct != null) TxtProgressPct.Text = $"{overallPct}%";

                if (TxtProgressStatus != null) TxtProgressStatus.Text = $"{partName}: {statusText}";

            });

        }



        private void AppendLog(string message)

        {

            if (TxtLogConsole == null) return;

            string time = DateTime.Now.ToString("HH:mm:ss");

            TxtLogConsole.AppendText($"[{time}] {message}\n");

            TxtLogConsole.ScrollToEnd();

        }



