        private void AppendUnisocLog(string text)

        {

            if (TxtUnisocConsole == null) return;

            string time = DateTime.Now.ToString("HH:mm:ss");

            Dispatcher.Invoke(() =>

            {

                TxtUnisocConsole.AppendText($"[{time}] {text}\n");

                TxtUnisocConsole.ScrollToEnd();

            });

        }



