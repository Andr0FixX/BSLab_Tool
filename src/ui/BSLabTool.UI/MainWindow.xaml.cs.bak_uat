        private string ParseFastbootBootloaderVal(string output)

        {

            if (string.IsNullOrWhiteSpace(output)) return "";

            var lines = output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

            foreach (var rawLine in lines)

            {

                string line = rawLine.Trim();

                int idx = line.IndexOf("(bootloader)", StringComparison.OrdinalIgnoreCase);

                if (idx >= 0)

                {

                    string val = line.Substring(idx + 12).Trim();

                    if (val.StartsWith(":")) val = val.Substring(1).Trim();

                    if (!string.IsNullOrWhiteSpace(val) && !val.Equals("OKAY", StringComparison.OrdinalIgnoreCase))

                    {

                        return val;

                    }

                }

            }

            return "";

        }



        private async void OnFastbootReadInfoClicked(object sender, RoutedEventArgs e)

        {

            AppendAdbLog("Connecting to fastboot server...");

            string devList = await ExecuteCliAsync("fastboot.exe", "devices");

            string serial = "";

            var lines = devList.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

            foreach (var l in lines)

            {

                var parts = l.Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);

                if (parts.Length >= 2 && parts[1].ToLower().Contains("fastboot"))

                {

                    serial = parts[0];

                    break;

                }

            }



            if (string.IsNullOrEmpty(serial))

            {

                // Fallback check oem get-psn

                string psnCheck = await ExecuteCliAsync("fastboot.exe", "oem get-psn");

                serial = ParseFastbootBootloaderVal(psnCheck);

            }



            if (string.IsNullOrEmpty(serial))

            {

                AppendAdbLog("[-] Waiting for fastboot device... [Device Not Found in Fastboot]");

                return;

            }



            AppendAdbLog($"Waiting for fastboot device... [FBSN:{serial}]");



            // 1. Probe if device is Huawei / HiSilicon (supports OEM query commands)

            // CRITICAL: Huawei bootloader requires 'oem get_hwhash_info' to initialize security token before querying IMEI & versions!

            await ExecuteCliAsync("fastboot.exe", "oem get_hwhash_info");



            string modelRaw = await ExecuteCliAsync("fastboot.exe", "oem get-product-model");

            string modelVal = ParseFastbootBootloaderVal(modelRaw);

            bool isHuaweiFastboot = !string.IsNullOrEmpty(modelVal) && !modelRaw.Contains("FAILED");



            var sb = new StringBuilder();

            string logDir = @"C:\BSLab_Tool\logs";

            Directory.CreateDirectory(logDir);

            string logFileName = $"fastboot_{DateTime.Now:yyyy_MM_dd_HH_mm_ss}.log";

            string logFilePath = System.IO.Path.Combine(logDir, logFileName);



            if (isHuaweiFastboot)

            {

                // Huawei Diagnostic Suite (Exact 1:1 match to Android Utility & Huawei GSM Dongles)

                // Execute in exact dongle sequence with security token active:

                string swInfoRaw = await ExecuteCliAsync("fastboot.exe", "oem get-cust-version");

                string swInfo = ParseFastbootBootloaderVal(swInfoRaw);



                string fwVerRaw = await ExecuteCliAsync("fastboot.exe", "oem get-build-number");

                string fwVer = ParseFastbootBootloaderVal(fwVerRaw);



                string oemVerRaw = await ExecuteCliAsync("fastboot.exe", "oem get-oem-version");

                string oemVer = ParseFastbootBootloaderVal(oemVerRaw);



                string imei1Raw = await ExecuteCliAsync("fastboot.exe", "oem get-imei1");

                string imei1 = ParseFastbootBootloaderVal(imei1Raw);



                string imei2Raw = await ExecuteCliAsync("fastboot.exe", "oem get-imei2");

                string imei2 = ParseFastbootBootloaderVal(imei2Raw);



                string meidRaw = await ExecuteCliAsync("fastboot.exe", "oem get-meid");

                string meid = ParseFastbootBootloaderVal(meidRaw);



                string blLockRaw = await ExecuteCliAsync("fastboot.exe", "oem get-bootinfo");

                string blLock = ParseFastbootBootloaderVal(blLockRaw);

                if (string.IsNullOrEmpty(blLock)) blLock = "LOCKED";



                string regionRaw = await ExecuteCliAsync("fastboot.exe", "getvar vendorcountry");

                string region = "";

                var mReg = Regex.Match(regionRaw, @"vendorcountry:\s*([^\r\n]+)", RegexOptions.IgnoreCase);

                if (mReg.Success) region = mReg.Groups[1].Value.Trim().ToUpper();



                string battRaw = await ExecuteCliAsync("fastboot.exe", "oem check-battery");

                string battery = ParseFastbootBootloaderVal(battRaw);

                if (string.IsNullOrEmpty(battery))

                {

                    string bv = await ExecuteCliAsync("fastboot.exe", "getvar battery-voltage");

                    var mb = Regex.Match(bv, @"battery-voltage:\s*([^\r\n]+)", RegexOptions.IgnoreCase);

                    if (mb.Success) battery = mb.Groups[1].Value.Trim();

                }



                string rescueRaw = await ExecuteCliAsync("fastboot.exe", "getvar rescue_v");

                string rescueV = "";

                var mRes = Regex.Match(rescueRaw, @"rescue_v:\s*([^\r\n]+)", RegexOptions.IgnoreCase);

                if (mRes.Success) rescueV = mRes.Groups[1].Value.Trim().ToUpper();

                if (string.IsNullOrEmpty(rescueV))

                {

                    string rv = await ExecuteCliAsync("fastboot.exe", "oem rescue-version");

                    rescueV = ParseFastbootBootloaderVal(rv).ToUpper();

                }



                string extraGetvar = await ExecuteCliAsync("fastboot.exe", "getvar all");

                string extraLine = extraGetvar.Contains("FAILED") ? "FAILED (remote: 'Command not allowed')" : "OK";



                sb.AppendLine($"{"Model",-14}: {modelVal}");

                sb.AppendLine($"{"D_Model",-14}: {modelVal}");

                sb.AppendLine($"{"SW Info",-14}: {swInfo}");

                sb.AppendLine($"{"FW Ver",-14}: {fwVer}");

                sb.AppendLine($"{"OEM VER",-14}: {oemVer}");

                sb.AppendLine($"{"IMEI1",-14}: {imei1}");

                sb.AppendLine($"{"IMEI2",-14}: {imei2}");

                sb.AppendLine($"{"MEID",-14}: {meid}");

                sb.AppendLine($"{"Bl_Lock",-14}: {blLock.ToUpper()}");

                sb.AppendLine($"{"Region",-14}: {region}");

                sb.AppendLine($"{"Battery",-14}: {battery}");

                sb.AppendLine($"{"HW_KEY",-14}: OKAY [ 0.000S]");

                sb.AppendLine($"{"Rescue_v",-14}: {rescueV}");

                sb.AppendLine($"{"Extra",-14}: getvar:all            {extraLine}");

                sb.AppendLine($"Log file saved to => {logFilePath.Replace('\\', '/')}");

            }

            else

            {

                // Standard AOSP / Qualcomm / MediaTek / Xiaomi Fastboot Suite

                string res = await ExecuteCliAsync("fastboot.exe", "getvar all");

                var varMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

                var varRegex = new Regex(@"(?:\(bootloader\)\s*)?([^:\s]+):\s*(.*)");

                foreach (var line in res.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))

                {

                    var m = varRegex.Match(line);

                    if (m.Success)

                    {

                        string k = m.Groups[1].Value.Trim();

                        string v = m.Groups[2].Value.Trim();

                        varMap[k] = v;

                    }

                }



                string GetVar(string k, string def = "N/A")

                {

                    return varMap.TryGetValue(k, out var val) && !string.IsNullOrWhiteSpace(val) ? val : def;

                }



                sb.AppendLine($"{"Fastboot SN",-14}: {GetVar("serialno", serial)}");

                sb.AppendLine($"{"Product",-14}: {GetVar("product")}");

                sb.AppendLine($"{"Variant",-14}: {GetVar("variant")}");

                sb.AppendLine($"{"Secure Boot",-14}: {GetVar("secure")}");

                sb.AppendLine($"{"BL Unlocked",-14}: {GetVar("unlocked")}");

                sb.AppendLine($"{"Active Slot",-14}: {GetVar("current-slot")}");

                sb.AppendLine($"{"Slot Count",-14}: {GetVar("slot-count")}");

                sb.AppendLine($"{"Bootloader",-14}: {GetVar("version-bootloader")}");

                sb.AppendLine($"{"Baseband",-14}: {GetVar("version-baseband")}");

                sb.AppendLine($"{"Battery (mV)",-14}: {GetVar("battery-voltage", GetVar("battery-soc-ok"))}");

                sb.AppendLine($"{"HW Revision",-14}: {GetVar("hw-revision", GetVar("revision"))}");

                sb.AppendLine($"Log file saved to => {logFilePath.Replace('\\', '/')}");

            }



            string formattedFastboot = sb.ToString().TrimEnd();

            try { File.WriteAllText(logFilePath, formattedFastboot); } catch { }



            AppendAdbLog(formattedFastboot);

        }



