                if (GlowSamsungCom != null) GlowSamsungCom.Color = redGlow;
                if (TxtSamsungComBox != null) { TxtSamsungComBox.Text = "NO COM PORT DETECTED"; TxtSamsungComBox.Foreground = redText; }
