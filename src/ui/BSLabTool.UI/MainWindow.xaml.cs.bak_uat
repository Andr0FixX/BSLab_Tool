        private bool IsQualcommMode => CmbPlatform?.SelectedIndex == 1;



        private void OnPlatformSelectionChanged(object sender, SelectionChangedEventArgs? e = null)
        {
            if (TxtPlatformHeader == null || TxtDaPath == null || TxtLogConsole == null) return;

            if (BtnSubTabMetaDiag != null)
