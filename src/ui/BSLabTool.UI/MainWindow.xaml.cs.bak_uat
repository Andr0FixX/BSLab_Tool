                            }
                        }
                        ok = BSLabBridge.BSLab_MTK_RestoreNVRAM(port, "backups/security_nv", _progressCallback);
                    }
                    catch
                    {
                        ok = false;
                    }
                });
            }
            catch { }

            if (ok)
            {
                SetMtkProgress(100, "Security Restored");
                AppendLog($"[+] Radio & Security partitions restored successfully! Baseband & IMEI active.");
            }
            else
            {
                SetMtkProgress(0, "Restore Failed");
                AppendLog($"[-] Security NVRAM Restore failed on {port}.");
            }
        }

        private async void OnUnlockBootloaderClicked(object sender, RoutedEventArgs e)
        {
            var (portOk, port) = await EnsureValidHardwarePortAsync(TxtPort?.Text);
            if (!portOk) return;

            AppendLog($"[*] Initiating Instant Bootloader Unlock on {port} (Mode: {(IsQualcommMode ? "Qualcomm EDL" : "MediaTek BROM")})...");
            SetMtkProgress(30, "Sending Seccfg Unlock Challenge Token...");

            bool ok = false;
            try
            {
                await Task.Run(() =>
                {
                    try
                    {
                        ok = BSLabBridge.BSLab_MTK_UnlockBootloader(port, _progressCallback);
                    }
                    catch
                    {
                        ok = false;
                    }
                });
            }
            catch { }

            if (ok)
            {
                SetMtkProgress(100, "Bootloader Unlocked");
                AppendLog($"[+] Bootloader successfully unlocked! Orange state verified. Custom ROM / Root allowed.");
            }
            else
            {
                SetMtkProgress(0, "Unlock Failed");
                AppendLog($"[-] Bootloader unlock operation failed on {port}.");
            }
        }

        private async void OnRebootClicked(object sender, RoutedEventArgs e)
        {
            var (portOk, port) = await EnsureValidHardwarePortAsync(TxtPort?.Text);
            if (!portOk) return;

            bool isQc = IsQualcommMode;
            AppendLog($"[*] Sending Hardware Reboot command to {port} (Platform: {(isQc ? "Qualcomm Firehose" : "MTK Watchdog")})...");
            SetMtkProgress(50, "Sending Reboot Reset Vector...");

            bool ok = false;
            try
            {
                await Task.Run(() =>
                {
                    try
                    {
                        if (isQc)
                            ok = BSLabBridge.BSLab_QC_Reboot(port);
                        else
                            ok = BSLabBridge.BSLab_MTK_Reboot(port, 0);
                    }
                    catch
                    {
                        ok = false;
                    }
                });
            }
            catch { }

            if (ok)
            {
                SetMtkProgress(100, "Reboot Dispatched");
                AppendLog($"[+] Device received reboot vector! Power-cycling to Normal Android OS.");
            }
            else
            {
                SetMtkProgress(0, "Reboot Failed");
                AppendLog($"[-] Failed to dispatch hardware reboot command to {port}.");
            }
        }

        
