        private void OnBrowsePacClicked(object sender, RoutedEventArgs e)
        {
            var dlg = new OpenFileDialog
            {
                Filter = "Unisoc PAC Firmware (*.pac)|*.pac|All Files (*.*)|*.*",
                Title = "Select Unisoc Stock Firmware (.PAC)"
            };

