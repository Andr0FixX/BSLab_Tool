        private string GetPitFilePath(string fileName)

        {

            string pitDir = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "resources", "loaders", "samsung", "pit");

            if (!Directory.Exists(pitDir)) pitDir = @"C:\BSLab_Tool\resources\loaders\samsung\pit";

            return System.IO.Path.Combine(pitDir, fileName);

        }



        private void LoadAndDisplayPit(string fileName)

        {

            string fullPath = GetPitFilePath(fileName);

            if (!File.Exists(fullPath)) return;



            var entries = ParsePitFile(fullPath);

            _currentPitEntries.Clear();

            _currentPitEntries.AddRange(entries);



            GridSamsungPitPartitions.ItemsSource = null;

            GridSamsungPitPartitions.ItemsSource = _currentPitEntries;



            TxtPitPartCount.Text = $"{entries.Count} Partitions";

            TxtPitSelectedInfo.Text = $"File: {fileName} | Size: {new FileInfo(fullPath).Length} Bytes";

            AppendSamsungLog($"[+] PIT Doctor: Loaded {entries.Count} partition map blocks from {fileName}");

        }



        private List<SamsungPitEntry> ParsePitFile(string filePath)

        {

            var list = new List<SamsungPitEntry>();

            if (!File.Exists(filePath)) return list;



            try

            {

                byte[] data = File.ReadAllBytes(filePath);

                if (data.Length < 28) return list;



                int entryCount = BitConverter.ToInt32(data, 4);

                if (entryCount <= 0 || entryCount > 256) entryCount = 64;



                int offset = 28;

                int entrySize = 132;

                if (data.Length >= 28 + entryCount * 136) entrySize = 136;



                int idx = 1;

                while (offset + entrySize <= data.Length && idx <= entryCount)

                {

                    short attributes = BitConverter.ToInt16(data, offset + 6);

                    uint blockStart = BitConverter.ToUInt32(data, offset + 12);

                    uint blockCount = BitConverter.ToUInt32(data, offset + 16);



                    string partName = Encoding.ASCII.GetString(data, offset + 32, 32).TrimEnd('\0', ' ');

                    string flashFile = Encoding.ASCII.GetString(data, offset + 64, 32).TrimEnd('\0', ' ');



                    if (!string.IsNullOrEmpty(partName))

                    {

                        string fs = (attributes == 0) ? "Raw / Binary" : (attributes == 2 ? "EXT4 / F2FS" : $"Type {attributes}");

                        list.Add(new SamsungPitEntry

                        {

                            Index = idx,

                            Name = partName,

                            FlashFilename = flashFile,

                            BlockStart = blockStart,

                            BlockCount = blockCount,

                            Filesystem = fs

                        });

                        idx++;

                    }



                    offset += entrySize;

                }



                if (list.Count == 0)

                {

                    list = ParsePitStringsFallback(data);

                }

            }

            catch (Exception ex)

            {

                AppendSamsungLog($"[!] PIT Parse Notice: {ex.Message}");

            }



            return list;

        }



        private List<SamsungPitEntry> ParsePitStringsFallback(byte[] data)

        {

            var list = new List<SamsungPitEntry>();

            var knownParts = new[] { "BOOT", "RECOVERY", "SYSTEM", "USERDATA", "CACHE", "EFS", "RADIO", "PARAM", "PERSISTENT", "MISC", "MODEM", "SUPER", "DTBO", "VBMETA" };

            int idx = 1;



            foreach (var part in knownParts)

            {

                byte[] pattern = Encoding.ASCII.GetBytes(part);

                if (IndexOfBytes(data, pattern) >= 0)

                {

                    list.Add(new SamsungPitEntry

                    {

                        Index = idx++,

                        Name = part,

                        FlashFilename = $"{part.ToLowerInvariant()}.img",

                        BlockStart = (ulong)(idx * 0x8000),

                        BlockCount = 0x10000,

                        Filesystem = "EXT4 / Raw"

                    });

                }

            }

            return list;

        }



        private int IndexOfBytes(byte[] source, byte[] pattern)

        {

            for (int i = 0; i < source.Length - pattern.Length; i++)

            {

                bool match = true;

                for (int j = 0; j < pattern.Length; j++)

                {

                    if (source[i + j] != pattern[j]) { match = false; break; }

                }

                if (match) return i;

            }

            return -1;

        }



