                if (TxtHuaweiComBox != null) { TxtHuaweiComBox.Text = "NO COM PORT DETECTED"; TxtHuaweiComBox.Foreground = redText; }
                if (BadgeHuaweiCom != null) BadgeHuaweiCom.Background = darkBadgeBg;
