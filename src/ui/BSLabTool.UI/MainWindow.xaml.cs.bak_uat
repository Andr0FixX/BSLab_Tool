        private async void OnReadGptClicked(object sender, RoutedEventArgs e)
        {
            var (portOk, port) = await EnsureValidHardwarePortAsync(TxtPort?.Text);
            if (!portOk) return;

            AppendLog($"[*] Reading Live GPT Partition Table from eMMC/UFS on {port} (Platform: {(IsQualcommMode ? "Qualcomm Firehose" : "MediaTek DA")})...");
            SetMtkProgress(25, "Reading Primary GPT Header (LBA 1)...");

            bool isQc = IsQualcommMode;
            string daPath = ResolveDaPath(TxtDaPath?.Text);

            if (!isQc && !string.IsNullOrEmpty(daPath) && File.Exists(daPath))
            {
                AppendLog($"[*] Auto-Deploying Download Agent: '{System.IO.Path.GetFileName(daPath)}' to RAM...");
                SetMtkProgress(35, "Streaming DA Stage 1 & 2...");
                await Task.Run(() =>
                {
                    try { BSLabBridge.BSLab_MTK_LoadDA(port, daPath, _progressCallback); } catch { }
                });
            }

            bool loadedOk = false;
            try
            {
                await Task.Run(() =>
                {
                    try
                    {
                        StringBuilder jsonBuf = new StringBuilder(65536);
                        int count = 0;
                        bool ok = isQc
                            ? BSLabBridge.BSLab_QC_ReadGPT(port, jsonBuf, jsonBuf.Capacity, out count)
                            : BSLabBridge.BSLab_MTK_ReadGPT(port, jsonBuf, jsonBuf.Capacity, out count);

                        if (ok && count > 0)
                        {
                            string json = jsonBuf.ToString();
                            using var doc = JsonDocument.Parse(json);
                            var list = new List<GptPartitionModel>();
                            foreach (var element in doc.RootElement.EnumerateArray())
                            {
                                list.Add(new GptPartitionModel
                                {
                                    Index = element.GetProperty("index").GetInt32(),
                                    Name = element.GetProperty("name").GetString() ?? "",
                                    StartLba = element.GetProperty("start_lba").GetUInt64(),
                                    EndLba = element.GetProperty("end_lba").GetUInt64(),
                                    SectorCount = element.GetProperty("sector_count").GetUInt64(),
                                    SizeBytes = element.GetProperty("size_bytes").GetUInt64(),
                                    SizeStr = element.GetProperty("size_str").GetString() ?? "",
                                    IsSlotA = element.GetProperty("is_slot_a").GetBoolean(),
                                    IsSlotB = element.GetProperty("is_slot_b").GetBoolean(),
                                    IsChecked = true
                                });
                            }
                            Dispatcher.Invoke(() =>
                            {
                                _partitions.Clear();
                                _partitions.AddRange(list);
                                GridPartitions.ItemsSource = null;
                                GridPartitions.ItemsSource = _partitions;
                                TxtPartCount.Text = $" ({_partitions.Count} Partitions Loaded)";
                            });
                            loadedOk = true;
                        }
                    }
                    catch
                    {
                    }
                });
            }
            catch { }

            if (loadedOk)
            {
                SetMtkProgress(100, "GPT Table Loaded");
                AppendLog($"[+] Successfully loaded {_partitions.Count} active storage partitions into Live GPT Grid.");
                AppendLog($"[+] Partition Doctor ready for selective dumping and sector servicing.");
            }
            else
            {
                SetMtkProgress(0, "GPT Read Failed");
                AppendLog($"[-] Failed to read GPT Partition Table on {port}!");
                AppendLog("[-] Ensure Download Agent (DA) is running and eMMC/UFS storage is communicating.");
            }
        }

