        private (string desc, string hwId) FindPortDeviceDetails(string portName)

        {

            if (string.IsNullOrEmpty(portName)) return (portName, "");



            try

            {

                using var enumUsb = Registry.LocalMachine.OpenSubKey(@"SYSTEM\CurrentControlSet\Enum\USB");

                if (enumUsb != null)

                {

                    foreach (var vidPid in enumUsb.GetSubKeyNames())

                    {

                        using var devKey = enumUsb.OpenSubKey(vidPid);

                        if (devKey == null) continue;

                        foreach (var instName in devKey.GetSubKeyNames())

                        {

                            using var instKey = devKey.OpenSubKey(instName);

                            if (instKey == null) continue;

                            using var paramKey = instKey.OpenSubKey("Device Parameters");

                            if (paramKey != null)

                            {

                                var p = paramKey.GetValue("PortName")?.ToString();

                                if (string.Equals(p, portName, StringComparison.OrdinalIgnoreCase))

                                {

                                    string desc = instKey.GetValue("FriendlyName")?.ToString() 

                                               ?? instKey.GetValue("DeviceDesc")?.ToString() 

                                               ?? portName;

                                    return (desc, vidPid);

                                }

                            }

                        }

                    }

                }

            }

            catch { }



            return (portName, "");

        }



        private void AutoSelectBrand(string brandName)

        {

            if (CmbAutoHubBrand == null || string.IsNullOrEmpty(brandName)) return;



            for (int i = 0; i < CmbAutoHubBrand.Items.Count; i++)

            {

                string item = CmbAutoHubBrand.Items[i]?.ToString() ?? "";

                if (item.Equals(brandName, StringComparison.OrdinalIgnoreCase) || 

                    item.Contains(brandName, StringComparison.OrdinalIgnoreCase))

                {

                    CmbAutoHubBrand.SelectedIndex = i;

                    break;

                }

            }

        }



        private void OnAutoHubComPortChanged(object sender, SelectionChangedEventArgs e)

        {

            if (CmbAutoHubComPort?.SelectedItem == null) return;

            string selected = CmbAutoHubComPort.SelectedItem.ToString() ?? "";

            

            // Extract "COMxxx" if item is formatted like "COM111 (Android Adapter PCUI)"

            string port = selected;

            var match = Regex.Match(selected, @"(COM\d+)", RegexOptions.IgnoreCase);

            if (match.Success)

            {

                port = match.Groups[1].Value.ToUpperInvariant();

            }



            if (TxtAutoHubComPort != null)

            {

                TxtAutoHubComPort.Text = port;

            }



            if (TxtPort != null && !string.IsNullOrEmpty(port))
            {
                TxtPort.Text = port;
                if (TxtDiagPort != null) TxtDiagPort.Text = port;
            }



            AppendAutoHubLog($"[*] Active Target Port selected: {port} ({selected})");

        }



        private async void OnAutoHubScanUsbClicked(object sender, RoutedEventArgs e)

        {

            await ScanUsbHardwareAsync();

        }



        private async Task ScanUsbHardwareAsync()

        {

            AppendAutoHubLog("[*] Scanning USB Subsystem, Active Hardware Ports & ADB Devices...");



            var portItems = new List<(string port, string desc, string hwId, string display)>();

            var seenPorts = new HashSet<string>(StringComparer.OrdinalIgnoreCase);



            try

            {

                using var key = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");

                if (key != null)

                {

                    foreach (var val in key.GetValueNames())

                    {

                        string p = key.GetValue(val)?.ToString()?.Trim() ?? "";

                        if (!string.IsNullOrEmpty(p) && seenPorts.Add(p))

                        {

                            var (desc, hwId) = FindPortDeviceDetails(p);

                            string display = (string.IsNullOrEmpty(desc) || desc.Equals(p, StringComparison.OrdinalIgnoreCase)) 

                                ? p 

                                : $"{p} ({desc})";

                            portItems.Add((p, desc, hwId, display));

                        }

                    }

                }

            }

            catch { }



            // Check ADB status concurrently

            bool isAdb = false;

            string adbDeviceLine = "";

            string adbBrand = "";

            string adbModel = "";

            try

            {

                string adbOut = await ExecuteCliAsync("adb.exe", "devices -l");

                var lines = adbOut.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

                foreach (var line in lines)

                {

                    if (line.Trim().StartsWith("List of") || string.IsNullOrWhiteSpace(line)) continue;

                    if (line.Contains("device", StringComparison.OrdinalIgnoreCase))

                    {

                        isAdb = true;

                        adbDeviceLine = line.Trim();

                        break;

                    }

                }

                if (isAdb)

                {

                    adbBrand = (await ExecuteCliAsync("adb.exe", "shell getprop ro.product.manufacturer")).Trim();

                    adbModel = (await ExecuteCliAsync("adb.exe", "shell getprop ro.product.model")).Trim();

                }

            }

            catch { }



            // Check Fastboot status

            bool isFastboot = false;

            string fbDeviceLine = "";

            try

            {

                string fbOut = await ExecuteCliAsync("fastboot.exe", "devices");

                var lines = fbOut.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

                foreach (var line in lines)

                {

                    if (line.Contains("fastboot", StringComparison.OrdinalIgnoreCase))

                    {

                        isFastboot = true;

                        fbDeviceLine = line.Trim();

                        break;

                    }

                }

            }

            catch { }



            // Analyze detected ports

            bool isHuaweiManufacture = false;

            bool isHuaweiKirinCom1 = false;

            bool isMtk = false;

            bool isQualcomm = false;

            bool isUnisoc = false;

            bool isSamsung = false;



            string primaryPort = "";

            string primaryDetail = "";

            int selectedIndex = -1;



            for (int i = 0; i < portItems.Count; i++)

            {

                var item = portItems[i];

                string combined = $"{item.desc} {item.hwId} {item.port}".ToUpperInvariant();



                if (combined.Contains("PCUI") || combined.Contains("FAKE ACM") || combined.Contains("DBADAPTER") || (item.hwId.Contains("VID_12D1") && !combined.Contains("1.0")))

                {

                    isHuaweiManufacture = true;

                    if (combined.Contains("PCUI") || string.IsNullOrEmpty(primaryPort))

                    {

                        primaryPort = item.port;

                        primaryDetail = item.desc;

                        selectedIndex = i;

                    }

                }

                else if (combined.Contains("USB COM 1.0") || (item.hwId.Contains("VID_12D1") && combined.Contains("1.0")))

                {

                    isHuaweiKirinCom1 = true;

                    primaryPort = item.port;

                    primaryDetail = item.desc;

                    selectedIndex = i;

                }

                else if (combined.Contains("VID_0E8D") || combined.Contains("MEDIATEK") || combined.Contains("PRELOADER") || combined.Contains("MTK"))

                {

                    isMtk = true;

                    if (string.IsNullOrEmpty(primaryPort))

                    {

                        primaryPort = item.port;

                        primaryDetail = item.desc;

                        selectedIndex = i;

                    }

                }

                else if (combined.Contains("VID_05C6") || combined.Contains("9008") || combined.Contains("QDLOADER") || combined.Contains("QUALCOMM"))

                {

                    isQualcomm = true;

                    if (string.IsNullOrEmpty(primaryPort))

                    {

                        primaryPort = item.port;

                        primaryDetail = item.desc;

                        selectedIndex = i;

                    }

                }

                else if (combined.Contains("VID_1782") || combined.Contains("SPRD") || combined.Contains("UNISOC"))

                {

                    isUnisoc = true;

                    if (string.IsNullOrEmpty(primaryPort))

                    {

                        primaryPort = item.port;

                        primaryDetail = item.desc;

                        selectedIndex = i;

                    }

                }

                else if (combined.Contains("VID_04E8") || combined.Contains("SAMSUNG MOBILE") || combined.Contains("SAMSUNG MODEM"))

                {

                    isSamsung = true;

                    if (string.IsNullOrEmpty(primaryPort))

                    {

                        primaryPort = item.port;

                        primaryDetail = item.desc;

                        selectedIndex = i;

                    }

                }

            }



            // Populate CmbAutoHubComPort

            CmbAutoHubComPort.SelectionChanged -= OnAutoHubComPortChanged;

            CmbAutoHubComPort.Items.Clear();



            if (portItems.Count > 0)

            {

                foreach (var pi in portItems)

                {

                    CmbAutoHubComPort.Items.Add(pi.display);

                }



                if (selectedIndex >= 0 && selectedIndex < CmbAutoHubComPort.Items.Count)

                {

                    CmbAutoHubComPort.SelectedIndex = selectedIndex;

                }

                else

                {

                    CmbAutoHubComPort.SelectedIndex = 0;

                    primaryPort = portItems[0].port;

                    primaryDetail = portItems[0].desc;

                }

            }

            else

            {

                string fallbackText = isAdb ? "ADB (USB Interface)" : (isFastboot ? "FASTBOOT (USB)" : "No Port Detected");

                CmbAutoHubComPort.Items.Add(fallbackText);

                CmbAutoHubComPort.SelectedIndex = 0;

                primaryPort = isAdb ? "ADB" : (isFastboot ? "FASTBOOT" : "NONE");

                primaryDetail = fallbackText;

            }



            TxtAutoHubComPort.Text = primaryPort;

            if (TxtPort != null && !string.IsNullOrEmpty(primaryPort) && primaryPort.StartsWith("COM", StringComparison.OrdinalIgnoreCase))

            {

                TxtPort.Text = primaryPort;

            }

            CmbAutoHubComPort.SelectionChanged += OnAutoHubComPortChanged;



            // Update Radar HUD Banner

            if (isHuaweiManufacture || (isAdb && adbBrand.Contains("HUAWEI", StringComparison.OrdinalIgnoreCase)))

            {

                TxtRadarHardwareTitle.Text = "● HUAWEI / HONOR MANUFACTURE & ADB (ONLINE)";

                TxtRadarHardwareTitle.Foreground = new SolidColorBrush(Color.FromRgb(0xEF, 0x44, 0x44));

                TxtRadarPortInfo.Text = $"Android PCUI & Manufacture Ports ({primaryPort})";

                TxtRadarIcon.Text = "🔴";

                TxtAutoHubProtocol.Text = "Huawei PCUI / AT";

                BorderRadarIndicator.BorderBrush = new SolidColorBrush(Color.FromRgb(0xEF, 0x44, 0x44));



                AppendAutoHubLog($"[+] ══════════════════════════════════════════════════════");

                AppendAutoHubLog($"[+] USB Radar: HUAWEI / HONOR MANUFACTURE MODE VERIFIED!");

                AppendAutoHubLog($"[+] Selected Diagnostic Port: {primaryPort} ({primaryDetail})");

