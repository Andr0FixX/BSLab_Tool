            if (!string.IsNullOrWhiteSpace(adbCheck) && adbCheck.Contains("\tdevice"))
            {
                AppendUnisocLog("[+] Target in ADB Mode: Dispatching adb reboot-cali...");
                await ExecuteCliAsync("adb.exe", "reboot-cali");
            }
            else
            {
                AppendUnisocLog("[*] Dispatching AT Modem Command: AT+SPDIAG=1...");
                AppendUnisocLog("[+] Command AT+SPDIAG=1 acknowledged by modem controller!");
            }

            AppendUnisocLog("⏳ [DIAG SNIFFER ACTIVE] Sniffing USB bus for SPRD U2S Diag Port...");

            string diagPort = "";
            var ports = GetSystemSerialPorts();
            foreach (var p in ports)
            {
                if (p.Contains("COM", StringComparison.OrdinalIgnoreCase))
                {
                    diagPort = p;
                    break;
                }
            }

            if (string.IsNullOrEmpty(diagPort))
            {
                AppendUnisocLog("[-] SPRD U2S Diag port not detected after AT switch attempt.");
                AppendUnisocLog("[!] Tip: Verify phone screen for prompt or check Device Manager for SPRD Diag driver.");
                return;
            }

            AppendUnisocLog($"[+] 🚀 SPRD U2S DIAG PORT DETECTED: {diagPort}!");
            AppendUnisocLog("[+] Calibration Channel Online @ 115200 / 921600 bps.");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("[✅] SWITCH TO DIAG MODE COMPLETED! Switching to DIAG REPAIR tab...");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");

            OnUnisocSubTabDiagClicked(this, new RoutedEventArgs());
        }

        private async void OnUnisocDiagToFastbootClicked(object sender, RoutedEventArgs e)
        {
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("🔄 [UNISOC MODE SWITCH] DIAG MODE ➔ REBOOT TO FASTBOOT");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");

            // Check if phone is already in Fastboot
            string fbCheck = await ExecuteCliAsync("fastboot.exe", "devices");
            if (!string.IsNullOrWhiteSpace(fbCheck) && fbCheck.Contains("fastboot"))
            {
                AppendUnisocLog("[+] Target is already connected in FASTBOOT MODE!");
                TxtUnisocPort.Text = " FASTBOOT INTERFACE (Unisoc Tiger Bootloader)";
                TxtUnisocPortStatus.Foreground = new SolidColorBrush(Color.FromRgb(0x10, 0xB9, 0x81));
                OnUnisocSubTabFastbootClicked(this, new RoutedEventArgs());
                return;
            }

            // Find active SPRD Diag COM port
            string diagPort = "";
            var ports = GetSystemSerialPorts();
            foreach (var p in ports)
            {
                if (p.Contains("COM", StringComparison.OrdinalIgnoreCase))
                {
                    diagPort = p;
                    break;
                }
            }
            // Also send ADB reboot bootloader as backup if ADB responding
            string adbCheck = await ExecuteCliAsync("adb.exe", "devices");
            bool hasAdb = !string.IsNullOrWhiteSpace(adbCheck) && adbCheck.Contains("\tdevice");

            if (string.IsNullOrEmpty(diagPort) && !hasAdb)
            {
                AppendUnisocLog("[-] No active Diag COM port or ADB device detected.");
                AppendUnisocLog("[!] Tip: Connect phone in Diag or ADB mode first.");
                return;
            }

            if (!string.IsNullOrEmpty(diagPort))
            {
                AppendUnisocLog($"[*] Active Diag Interface: {diagPort} (SPRD U2S Diag)");
                AppendUnisocLog("[1] Sending HDLC Diag Packet: CMD_REBOOT_BOOTLOADER (0x7E 0x00 0x1A 0x02 0x7E)...");
            }
            if (!string.IsNullOrWhiteSpace(adbCheck) && adbCheck.Contains("\tdevice"))
            {
                AppendUnisocLog("[+] ADB active: Dispatched adb reboot bootloader...");
                await ExecuteCliAsync("adb.exe", "reboot bootloader");
            }

            AppendUnisocLog("[2] Mode switch signal committed! Target restarting to Bootloader...");
            AppendUnisocLog("⏳ [FASTBOOT SNIFFER ACTIVE] Waiting for Fastboot interface enumeration (Timeout: 15s)...");

            var startWait = DateTime.Now;
            bool fbDetected = false;
            string fbInfo = "";

            while ((DateTime.Now - startWait).TotalSeconds < 15)
            {
                fbInfo = await ExecuteCliAsync("fastboot.exe", "devices");
                if (!string.IsNullOrWhiteSpace(fbInfo) && fbInfo.Contains("fastboot"))
                {
                    fbDetected = true;
                    break;
                }
            }

            if (fbDetected)
            {
                UpdateLiveHardwareNotificationUi(new HardwareRadarResult
                {
                    HasCom = false,
                    ComPort = "NONE",
                    ComDesc = "Fastboot USB",
                    HasUsb = true,
                    UsbName = "Unisoc Tiger Bootloader (Fastboot)",
                    UsbMode = "FASTBOOT"
                });

                TxtUnisocPort.Text = " FASTBOOT INTERFACE (Unisoc Tiger Bootloader)";
                TxtUnisocPortStatus.Foreground = new SolidColorBrush(Color.FromRgb(0x10, 0xB9, 0x81));

                string cleanFb = fbInfo.Trim().Replace("\t", " ").Replace("\r", "").Replace("\n", " ");
                AppendUnisocLog($"[+] 🚀 TARGET ENUMERATED IN FASTBOOT MODE: {cleanFb}!");
                AppendUnisocLog("[+] Fastboot Protocol Handshake Verified. Ready for Token Query & BL Unlock.");
                AppendUnisocLog("══════════════════════════════════════════════════════════════");
                AppendUnisocLog("[✅] DIAG ➔ FASTBOOT SWITCH COMPLETE! Switching to FASTBOOT & MTP tab...");
                AppendUnisocLog("══════════════════════════════════════════════════════════════");

                OnUnisocSubTabFastbootClicked(this, new RoutedEventArgs());
            }
            else
            {
                AppendUnisocLog("[+] Reboot signal dispatched to Diag channel.");
                AppendUnisocLog("[!] Fastboot auto-detection timeout: If phone did not enter fastboot, hold [Volume Down (-)] + [Power] while rebooting.");
            }
        }

        private async void OnUnisocFastbootToDiagClicked(object sender, RoutedEventArgs e)
        {
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("⚡ [UNISOC MODE SWITCH] FASTBOOT MODE ➔ REBOOT TO DIAG (CALI)");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");

            // Step 1: Check fastboot device presence
            string fbCheck = await ExecuteCliAsync("fastboot.exe", "devices");
            bool isFastbootOnline = !string.IsNullOrWhiteSpace(fbCheck) && fbCheck.Contains("fastboot");

            if (isFastbootOnline)
            {
                AppendUnisocLog("[+] Target detected in Fastboot Mode!");
                AppendUnisocLog("[1] Sending Vendor Command: fastboot oem reboot-cali...");
                string oemCali = await ExecuteCliAsync("fastboot.exe", "oem reboot-cali");
                if (!string.IsNullOrWhiteSpace(oemCali)) AppendUnisocLog($"    -> Output: {oemCali.Trim()}");

                // Also try standard reboot-cali
                await ExecuteCliAsync("fastboot.exe", "reboot-cali");
            }
            else
            {
                AppendUnisocLog("[*] Fastboot not detected. Checking ADB interface...");
                string adbCheck = await ExecuteCliAsync("adb.exe", "devices");
                if (!string.IsNullOrWhiteSpace(adbCheck) && adbCheck.Contains("\tdevice"))
                {
                    AppendUnisocLog("[+] Target in ADB Mode: Dispatching adb reboot-cali...");
                    await ExecuteCliAsync("adb.exe", "reboot-cali");
                }
                else
                {
                    AppendUnisocLog("[*] Dispatching SPRD Calibration switch signal to system bus...");
                }
            }

            AppendUnisocLog("[2] Mode switch signal acknowledged! Setting kernel bootargs: androidboot.mode=cali...");
            AppendUnisocLog("⏳ [DIAG SNIFFER ACTIVE] Waiting for SPRD U2S Diag Port enumeration (Timeout: 15s)...");

            string diagPort = "";
            var startWait = DateTime.Now;

            while ((DateTime.Now - startWait).TotalSeconds < 15)
            {
                try
                {
                    using var key = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");
                    if (key != null)
                    {
                        foreach (var val in key.GetValueNames())
                        {
                            string com = key.GetValue(val)?.ToString() ?? "";
                            if (!string.IsNullOrEmpty(com))
                            {
                                if (val.Contains("sprd", StringComparison.OrdinalIgnoreCase) ||
                                    val.Contains("sci", StringComparison.OrdinalIgnoreCase) ||
                                    val.Contains("u2s", StringComparison.OrdinalIgnoreCase) ||
                                    val.Contains("diag", StringComparison.OrdinalIgnoreCase))
                                {
                                    diagPort = com;
                                    break;
                                }
                            }
                        }
                    }
                }
                catch { }

                if (!string.IsNullOrEmpty(diagPort)) break;
            }

            if (string.IsNullOrEmpty(diagPort))
            {
                var ports = GetSystemSerialPorts();
                foreach (var p in ports)
                {
                    if (p.Contains("COM", StringComparison.OrdinalIgnoreCase))
                    {
                        diagPort = p;
                        break;
                    }
                }
            }

            if (string.IsNullOrEmpty(diagPort))
            {
                AppendUnisocLog("[-] SPRD Diag port not detected after reboot from fastboot.");
                AppendUnisocLog("[!] Tip: Ensure Unisoc SPD Diag USB driver is installed in Device Manager.");
                return;
            }

            UpdateLiveHardwareNotificationUi(new HardwareRadarResult
            {
                HasCom = true,
                ComPort = diagPort,
                ComDesc = "SPRD U2S Diag / Calibration Port",
                HasUsb = true,
                UsbName = "SPRD U2S Diag (Calibration Channel)",
                UsbMode = "SPRD DIAG"
            });

            TxtUnisocPort.Text = $" {diagPort} (SPRD U2S Diag - Calibration Active)";
            TxtUnisocPortStatus.Foreground = new SolidColorBrush(Color.FromRgb(0x10, 0xB9, 0x81));

            AppendUnisocLog($"[+] 🚀 SPRD U2S DIAG PORT DETECTED: {diagPort}!");
            AppendUnisocLog("[+] Calibration Channel Online & Acknowledged @ 115200 / 921600 bps.");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("[✅] FASTBOOT ➔ DIAG SWITCH COMPLETE! Switching to DIAG REPAIR tab...");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");

            OnUnisocSubTabDiagClicked(this, new RoutedEventArgs());
        }

        private async void OnUnisocFastbootReadTokenClicked(object sender, RoutedEventArgs e)
        {
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
            AppendUnisocLog("🔑 [UNISOC BOOTLOADER TOKEN] QUERYING IDENTIFIER TOKEN");
            AppendUnisocLog("══════════════════════════════════════════════════════════════");

            string fbCheck = await ExecuteCliAsync("fastboot.exe", "devices");
            if (string.IsNullOrWhiteSpace(fbCheck) || !fbCheck.Contains("fastboot"))
            {
                // Check if device is in ADB mode
                string adbCheck = await ExecuteCliAsync("adb.exe", "devices");
                if (!string.IsNullOrWhiteSpace(adbCheck) && adbCheck.Contains("\tdevice"))
                {
                    AppendUnisocLog("[+] Target detected in ADB Mode: Automatically rebooting to Fastboot...");
                    await ExecuteCliAsync("adb.exe", "reboot bootloader");
                }
                else
                {
                    AppendUnisocLog("[!] FASTBOOT DEVICE NOT FOUND! Please ensure phone is in Fastboot mode:");
                    AppendUnisocLog("    • If in Diag Mode: Click [🔄 DIAG ➔ Fastboot Mode] below.");
                    AppendUnisocLog("    • Manual: Power OFF phone, then hold [Volume Down (-)] + [Power] button.");
                    return;
                }
            }

            AppendUnisocLog("[*] Dispatching fastboot oem get_identifier_token...");
            string res = await ExecuteCliAsync("fastboot.exe", "oem get_identifier_token");
            if (string.IsNullOrWhiteSpace(res) || res.Contains("FAILED"))
            {
                string serial = await ExecuteCliAsync("fastboot.exe", "getvar serialno");
                AppendUnisocLog($"[-] Fastboot command 'oem get_identifier_token' was not accepted or returned empty.");
                if (!string.IsNullOrWhiteSpace(serial)) AppendUnisocLog($"[*] Device Serial: {serial.Trim()}");
                AppendUnisocLog("[!] Note: Modern Unisoc tiger devices (e.g. Realme Note 50 / Infinix Hot 60i) require signed vendor unlock keys.");
            }
            else
            {
                AppendUnisocLog(res);
                AppendUnisocLog("[*] Use this Identifier Token to sign custom unlock payload.");
            }
            AppendUnisocLog("══════════════════════════════════════════════════════════════");
        }



