        private async void OnSettingsTriggerCloudBackupClicked(object sender, RoutedEventArgs e)

        {

            AppendSettingsLog("══════════════════════════════════════════════════════════════");

            AppendSettingsLog("[*] ☁️ INITIATING LIVE GOOGLE DRIVE CLOUD BACKUP ARCHIVE...");

            AppendSettingsLog("[*] Authenticated Account: m.basharat99ali@gmail.com");

            AppendSettingsLog("══════════════════════════════════════════════════════════════");



            await Task.Run(() =>

            {

                try

                {

                    string scriptPath = @"C:\BSLab_Tool\scripts\create_cloud_backup.ps1";

                    if (File.Exists(scriptPath))

                    {

                        var psi = new ProcessStartInfo

                        {

                            FileName = "powershell.exe",

                            Arguments = $"-ExecutionPolicy Bypass -File \"{scriptPath}\"",

                            RedirectStandardOutput = true,

                            UseShellExecute = false,

                            CreateNoWindow = true

                        };

                        using var proc = Process.Start(psi);

                        if (proc != null)

                        {

                            string output = proc.StandardOutput.ReadToEnd();

                            proc.WaitForExit();



                            Dispatcher.Invoke(() =>

                            {

                                AppendSettingsLog("[+] Local archive created successfully.");

                                var lines = output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

                                foreach (var l in lines)

                                {

                                    if (l.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))

                                    {

                                        string zipFile = l.Trim();

                                        // Upload via gdrive

                                        Task.Run(() =>

                                        {

                                            var gpsi = new ProcessStartInfo

                                            {

                                                FileName = "gdrive.cmd",

                                                Arguments = $"mutate upload \"{zipFile}\"",

                                                RedirectStandardOutput = true,

                                                UseShellExecute = false,

                                                CreateNoWindow = true

                                            };

                                            try

                                            {

                                                using var gproc = Process.Start(gpsi);

                                                if (gproc != null)

                                                {

                                                    string gout = gproc.StandardOutput.ReadToEnd();

                                                    gproc.WaitForExit();

                                                    Dispatcher.Invoke(() =>

                                                    {

                                                        AppendSettingsLog($"[+] {gout.Trim()}");

                                                        TxtSettingsLastCloudBackup.Text = $"Latest Archive: {System.IO.Path.GetFileName(zipFile)} (Uploaded to Google Drive)";

                                                    });

                                                }

                                            }

                                            catch (Exception gex)

                                            {

                                                Dispatcher.Invoke(() => AppendSettingsLog($"[-] Cloud upload notice: {gex.Message}"));

                                            }

                                        });

                                        break;

                                    }

                                }

                            });

                        }

                    }

                }

                catch (Exception ex)

                {

                    Dispatcher.Invoke(() => AppendSettingsLog($"[-] Backup error: {ex.Message}"));

                }

            });

        }



