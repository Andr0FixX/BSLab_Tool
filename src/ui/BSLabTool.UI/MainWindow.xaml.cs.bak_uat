        private async void OnAdbInstallApkClicked(object sender, RoutedEventArgs e)

        {

            var dlg = new OpenFileDialog

            {

                Filter = "Android Package (*.apk)|*.apk|All Files (*.*)|*.*",

                Title = "Select APK to Install via ADB"

