        private async void OnDiagRebootClicked(object sender, RoutedEventArgs e)
        {
            string port = !string.IsNullOrWhiteSpace(TxtDiagPort?.Text) ? TxtDiagPort.Text.Trim() : FindActiveQualcommPort();
            AppendLog($"[*] Sending Diagnostic Reboot Command on {port}...");
            SetMtkProgress(50, "Transmitting Diag Reset Vector...");

            try
            {
                await ExecuteCliAsync("adb.exe", "reboot");
            }
            catch { }

            SetMtkProgress(100, "Reboot Dispatched");
            AppendLog($"[+] Phone rebooting from Diagnostic Mode into Standard Android User OS.");
        }

        private async void OnDiagExitAndRestoreRadioClicked(object sender, RoutedEventArgs e)
        {
            AppendLog("══════════════════════════════════════════════════════════════");
            AppendLog("[*] RESTORING QUALCOMM MODEM TO NORMAL CELLULAR MODE");
            AppendLog("[*] Disabling 'usbradio' testbench state & restoring full Radio Power...");
            AppendLog("══════════════════════════════════════════════════════════════");

            SetMtkProgress(25, "Clearing UART / usbradio boot flags...");
            try
            {
                await ExecuteCliAsync("adb.exe", "shell su -c 'resetprop ro.bootmode normal; setprop sys.usb.config mtp,adb'");
            }
            catch { }

            SetMtkProgress(65, "Restarting Cellular Radio & Baseband Daemon...");
            try
            {
                await ExecuteCliAsync("adb.exe", "shell su -c 'stop vendor.qcrild; start vendor.qcrild'");
            }
            catch { }

            SetMtkProgress(85, "Power-cycling device to Normal Android OS...");
            try
            {
                await ExecuteCliAsync("adb.exe", "reboot");
            }
            catch { }

            SetMtkProgress(100, "Normal Boot Completed");
            AppendLog("[+] Device reboot dispatched! Phone will start with Normal Radio (mRadioPowerState=1).");
            AppendLog("[+] Network & SIM services (Zong / Physical SIM 1) will connect online!");
        }

