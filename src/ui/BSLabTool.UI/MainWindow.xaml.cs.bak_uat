        // ====================================================================

        // TOP NAVIGATION TABS CONTROLLER

        // ====================================================================



        private Button? _currentActiveNavTab = null;

        private bool IsNavTabButton(FrameworkElement fe)
        {
            return fe == TabBtnAutoHub || fe == TabBtnAiAnalyse || fe == TabBtnMtk || fe == TabBtnQualcomm ||
                   fe == TabBtnFastboot || fe == TabBtnSamsung || fe == TabBtnUnisoc || fe == TabBtnHuawei ||
                   fe == TabBtnTestPoints || fe == TabBtnPartDoctor || fe == TabBtnBackup || fe == TabBtnSettings;
        }

        private void SetActiveNavTab(Button? activeBtn)
        {
            if (activeBtn != null)
            {
                _currentActiveNavTab = activeBtn;
            }
            else if (_currentActiveNavTab != null)
            {
                activeBtn = _currentActiveNavTab;
            }
            else
            {
                activeBtn = TabBtnAutoHub;
                _currentActiveNavTab = TabBtnAutoHub;
            }

            var regularStyle = (Style)FindResource("CyberNavTab");
            var activeStyle = (Style)FindResource("ActiveNavTab");
            var actBorder = (Brush)FindResource("ActiveNavTabBorder");
            var actFg = (Brush)FindResource("ActiveNavTabForeground");
            var actBg = (Brush)FindResource("ActiveNavTabBackground");
            var regFg = (Brush)FindResource("NavTabForeground");
            var regBg = (Brush)FindResource("NavTabBackground");

            var tabs = new[]
            {
                TabBtnAutoHub, TabBtnAiAnalyse, TabBtnMtk, TabBtnQualcomm,
                TabBtnFastboot, TabBtnSamsung, TabBtnUnisoc, TabBtnHuawei,
                TabBtnTestPoints, TabBtnPartDoctor, TabBtnBackup, TabBtnSettings
            };

            foreach (var tab in tabs)
            {
                if (tab == null) continue;
                tab.ClearValue(Button.BackgroundProperty);
                tab.ClearValue(Button.ForegroundProperty);
                tab.ClearValue(Button.BorderBrushProperty);
                tab.ClearValue(Button.BorderThicknessProperty);
                tab.ClearValue(Button.FontWeightProperty);

                if (tab == activeBtn)
                {
                    tab.Style = activeStyle;
                    tab.BorderBrush = actBorder;
                    tab.Foreground = actFg;
                    tab.Background = actBg;
                    tab.BorderThickness = new Thickness(1);
                    tab.FontWeight = FontWeights.ExtraBold;
                }
                else
                {
                    tab.Style = regularStyle;
                }
            }
        }

        private void ResetTabStyles()
        {
            SetActiveNavTab(null);
        }

        private void HideAllViews()
        {
            ViewAutoHub.Visibility = Visibility.Collapsed;
            ViewAiAnalyse.Visibility = Visibility.Collapsed;
            ViewMtk.Visibility = Visibility.Collapsed;
            ViewFastboot.Visibility = Visibility.Collapsed;
            ViewSamsung.Visibility = Visibility.Collapsed;
            ViewUnisoc.Visibility = Visibility.Collapsed;
            ViewHuawei.Visibility = Visibility.Collapsed;
            ViewBackup.Visibility = Visibility.Collapsed;
            ViewSettings.Visibility = Visibility.Collapsed;
        }

        private void OnNavTabClicked(object sender, RoutedEventArgs e)
        {
            if (sender is not Button btn) return;

            SetActiveNavTab(btn);
            HideAllViews();



            if (btn == TabBtnAutoHub)

            {

                ViewAutoHub.Visibility = Visibility.Visible;

                AppendAutoHubLog("[*] Switched Active Workspace: ⚡ USB AUTO-HUB (Master Hardware Cockpit)");

            }

            else if (btn == TabBtnAiAnalyse)

            {

                ViewAiAnalyse.Visibility = Visibility.Visible;

                AppendAiAnalyseLog("[*] Switched Active Workspace: 🤖 AI ANALYSE (Hardware Co-Pilot & Neural Diagnostics)");

            }

            else if (btn == TabBtnMtk || btn == TabBtnQualcomm || btn == TabBtnPartDoctor)
            {
                ViewMtk.Visibility = Visibility.Visible;
                if (btn == TabBtnQualcomm)
                {
                    if (CmbPlatform != null) CmbPlatform.SelectedIndex = 1;
                    OnPlatformSelectionChanged(CmbPlatform, null);
                }
                else if (btn == TabBtnMtk)
                {
                    if (CmbPlatform != null) CmbPlatform.SelectedIndex = 0;
                    OnPlatformSelectionChanged(CmbPlatform, null);
                }
                if (_partitions.Count == 0)
                {
                    LoadDefaultGptPartitions();
                }
                AppendLog($"[*] Switched Active Workspace: {btn.Content}");
            }

            else if (btn == TabBtnFastboot)

            {

                ViewFastboot.Visibility = Visibility.Visible;

                AppendAdbLog("[*] Switched Active Workspace: FASTBOOT & ADB Universal Service Suite");

            }

            else if (btn == TabBtnSamsung)

            {

                ViewSamsung.Visibility = Visibility.Visible;

                AppendSamsungLog("[*] Switched Active Workspace: SAMSUNG Odin Flasher & MTP Services");

            }

            else if (btn == TabBtnUnisoc)

            {

                ViewUnisoc.Visibility = Visibility.Visible;

                AppendUnisocLog("[*] Switched Active Workspace: UNISOC / SPREADTRUM (SPD) Multi-Engine Suite");

            }

            else if (btn == TabBtnHuawei)

            {

                ViewHuawei.Visibility = Visibility.Visible;

                AppendHuaweiLog("[*] Switched Active Workspace: HUAWEI & HONOR (HiSilicon Kirin Multi-Engine Suite)");

            }

                        else if (btn == TabBtnBackup)

            {

                ViewBackup.Visibility = Visibility.Visible;

                AppendBackupLog("[*] Switched Active Workspace: 🛡️ UNIVERSAL SAFE VAULT & DISASTER RECOVERY DOCTOR");

                RefreshBackupVaultStatus();

            }

            else if (btn == TabBtnSettings)

            {

                ViewSettings.Visibility = Visibility.Visible;

                AppendSettingsLog("[*] Switched Active Workspace: ⚙️ WORKSTATION SETTINGS & SYSTEM CONFIGURATION");

            }

            else

            {

                // Fallback to Auto-Hub

                ViewAutoHub.Visibility = Visibility.Visible;

                AppendAutoHubLog($"[*] Module '{btn.Content}' selected. Layout active.");

            }



            if (_activeEffectiveTheme == "Light")

            {

                if (ViewAutoHub.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewAutoHub);

                else if (ViewAiAnalyse.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewAiAnalyse);

                else if (ViewMtk.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewMtk);

                else if (ViewFastboot.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewFastboot);

                else if (ViewSamsung.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewSamsung);

                else if (ViewUnisoc.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewUnisoc);

                else if (ViewHuawei.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewHuawei);

                else if (ViewBackup.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewBackup);

                else if (ViewSettings.Visibility == Visibility.Visible) ApplyLightThemeRecursive(ViewSettings);

                ApplyDataGridTheme(true);

            }

        }



