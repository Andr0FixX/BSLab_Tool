                if (LedMtkCom != null) LedMtkCom.Fill = redBrush;
                if (GlowMtkCom != null) GlowMtkCom.Color = redGlow;
                if (TxtMtkComBox != null) { TxtMtkComBox.Text = "NO COM PORT DETECTED"; TxtMtkComBox.Foreground = redText; }
                if (BadgeMtkCom != null) BadgeMtkCom.Background = darkBadgeBg;
                if (TxtMtkComState != null) { TxtMtkComState.Text = "OFFLINE"; TxtMtkComState.Foreground = grayBadgeFg; }

                // Fastboot Dual Box COM Offline
                if (LedFastbootCom != null) LedFastbootCom.Fill = redBrush;
                if (GlowFastbootCom != null) GlowFastbootCom.Color = redGlow;
                if (TxtFastbootComBox != null) { TxtFastbootComBox.Text = "NO COM PORT DETECTED"; TxtFastbootComBox.Foreground = redText; }
                if (BadgeFastbootCom != null) BadgeFastbootCom.Background = darkBadgeBg;
                if (TxtFastbootComState != null) { TxtFastbootComState.Text = "OFFLINE"; TxtFastbootComState.Foreground = grayBadgeFg; }

