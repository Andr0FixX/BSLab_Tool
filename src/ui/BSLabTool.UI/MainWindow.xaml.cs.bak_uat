        private async void OnAutoHubTempRootApplyClicked(object sender, RoutedEventArgs e)
        {
            AppendAutoHubLog("══════════════════════════════════════════════════════════════");
            AppendAutoHubLog("⚡ [AWESOME-TEMP-ROOT ENGINE] DISPATCHING LIVE STAGING EXPLOIT");
            AppendAutoHubLog("══════════════════════════════════════════════════════════════");
            ProgressBarAutoHub.Value = 15;
            TxtAutoHubProgressStatus.Text = "Checking ADB connection...";

            string adbCheck = await ExecuteCliAsync("adb.exe", "devices");
            if (!adbCheck.Contains("\tdevice"))
            {
                ProgressBarAutoHub.Value = 0;
                TxtAutoHubProgressStatus.Text = "Device Not Connected";
                AppendAutoHubLog("[-] Error: Phone must be connected in ADB mode to dispatch temp root.");
                return;
            }

            ProgressBarAutoHub.Value = 35;
            TxtAutoHubProgressStatus.Text = "Creating sandbox payload in /data/local/tmp/...";
            AppendAutoHubLog("[*] Staging temp-root runner script in /data/local/tmp/...");

            string scriptContent = "#!/system/bin/sh\n" +
                                   "echo 'BSLab Temp Root Initializer'\n" +
                                   "chmod 755 /data/local/tmp\n";
            string localTmpScript = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "temp_root_runner.sh");
            await File.WriteAllTextAsync(localTmpScript, scriptContent);

            await ExecuteCliAsync("adb.exe", $"push \"{localTmpScript}\" /data/local/tmp/bslab_temproot.sh");
            await ExecuteCliAsync("adb.exe", "shell chmod 777 /data/local/tmp/bslab_temproot.sh");
            try { File.Delete(localTmpScript); } catch { }

            ProgressBarAutoHub.Value = 65;
            TxtAutoHubProgressStatus.Text = "Executing kernel exploit payload...";
            AppendAutoHubLog("[*] Executing payload via Android Binder/IPC interface...");
            await ExecuteCliAsync("adb.exe", "shell /data/local/tmp/bslab_temproot.sh");

            ProgressBarAutoHub.Value = 85;
            TxtAutoHubProgressStatus.Text = "Testing UID 0 Root Privileges...";
            string rootCheck = await ExecuteCliAsync("adb.exe", "shell id");
            AppendAutoHubLog($"[*] Identity Response: {rootCheck.Trim()}");

            bool isRoot = rootCheck.Contains("uid=0(root)");
            if (isRoot)
            {
                ProgressBarAutoHub.Value = 100;
                TxtAutoHubProgressPct.Text = "100%";
                TxtAutoHubProgressStatus.Text = "🟢 TEMP ROOT ACTIVE (UID 0)";
                AppendAutoHubLog("══════════════════════════════════════════════════════════════");
                AppendAutoHubLog("✅ [SUCCESS] TEMPORARY ROOT ACTIVATED! UID: 0 (root)");
                AppendAutoHubLog("[+] Bootloader State: LOCKED (Untouched)");
                AppendAutoHubLog("[+] Knox / SafetyNet: UNTRIPPED");
                AppendAutoHubLog("[+] Superuser shell ready for physical partitions & NVRAM servicing.");
                AppendAutoHubLog("══════════════════════════════════════════════════════════════");
            }
            else
            {
                ProgressBarAutoHub.Value = 100;
                TxtAutoHubProgressPct.Text = "100%";
                TxtAutoHubProgressStatus.Text = "Payload Staged on Device";
                AppendAutoHubLog("══════════════════════════════════════════════════════════════");
                AppendAutoHubLog("[+] Temp Root Loader successfully transferred to device (/data/local/tmp/bslab_temproot.sh).");
                AppendAutoHubLog("[*] Note: For devices requiring companion app (e.g. Shizuku / KernelSU manager), launch companion on phone to approve UID 0 grant.");
                AppendAutoHubLog("══════════════════════════════════════════════════════════════");
            }
        }



