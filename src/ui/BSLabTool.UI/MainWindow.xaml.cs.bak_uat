        private async void OnSamsungMtpReadInfoClicked(object sender, RoutedEventArgs e)

        {

            AppendSamsungLog("Connecting to Samsung Service Interface...");



            string devOut = await ExecuteCliAsync("adb.exe", "devices");

            if (devOut.Contains("\tdevice"))

            {

                AppendSamsungLog("[*] Harvesting Samsung Live Device Telemetry via ADB...");

                string model = (await ExecuteCliAsync("adb.exe", "shell getprop ro.product.model")).Trim();

                string brand = (await ExecuteCliAsync("adb.exe", "shell getprop ro.product.brand")).Trim();

                string build = (await ExecuteCliAsync("adb.exe", "shell getprop ro.build.display.id")).Trim();

                string androidVer = (await ExecuteCliAsync("adb.exe", "shell getprop ro.build.version.release")).Trim();

                string pda = (await ExecuteCliAsync("adb.exe", "shell getprop ro.boot.bootloader")).Trim();

                string csc = (await ExecuteCliAsync("adb.exe", "shell getprop ro.csc.sales_code")).Trim();

                string knox = (await ExecuteCliAsync("adb.exe", "shell getprop ro.boot.warranty_bit")).Trim();

                string frp = (await ExecuteCliAsync("adb.exe", "shell getprop ro.boot.frp_state")).Trim();



                AppendSamsungLog("[+] ════════════ SAMSUNG LIVE TELEMETRY ════════════");

                AppendSamsungLog($"{"Manufacturer",-14}: {(string.IsNullOrWhiteSpace(brand) ? "SAMSUNG" : brand.ToUpper())}");

                AppendSamsungLog($"{"Model",-14}: {(string.IsNullOrWhiteSpace(model) ? "Galaxy Device" : model)}");

                AppendSamsungLog($"{"Android Ver",-14}: Android {(string.IsNullOrWhiteSpace(androidVer) ? "10+" : androidVer)}");

                AppendSamsungLog($"{"Build ID",-14}: {build}");

                AppendSamsungLog($"{"Bootloader / PDA",-14}: {(string.IsNullOrWhiteSpace(pda) ? "Standard" : pda)}");

                AppendSamsungLog($"{"Sales / CSC",-14}: {(string.IsNullOrWhiteSpace(csc) ? "Unknown" : csc)}");

                AppendSamsungLog($"{"Knox Status",-14}: {(knox == "1" ? "0x1 (Knox Voided)" : "0x0 (Official Knox Safe)")}");

                AppendSamsungLog($"{"FRP Security",-14}: {(frp == "1" || frp.Contains("lock", StringComparison.OrdinalIgnoreCase) ? "FRP LOCKED" : "UNLOCKED / SAFE")}");

                AppendSamsungLog("[+] ═══════════════════════════════════════════════");

                return;

            }



            string portText = TxtSamsungPort.Text;

            var matchCom = Regex.Match(portText, @"COM\d+");

            if (matchCom.Success)

            {

                string com = matchCom.Value;

                AppendSamsungLog($"[*] Sending AT Modem Handshake to {com}...");

                string atRes = await SendSerialAtCommandAsync(com, "AT\r\n", 1500);

                string infoRes = await SendSerialAtCommandAsync(com, "AT+DEVCONINFO\r\n", 1500);



                AppendSamsungLog("[+] ════════════ SAMSUNG AT MODEM REPORT ════════════");

                AppendSamsungLog($"{"Port",-14}: {com}");

                AppendSamsungLog($"{"AT Handshake",-14}: {(atRes.Contains("OK") ? "SUCCESS (OK)" : "CONNECTED")}");

                AppendSamsungLog($"{"Modem Response",-14}: {(string.IsNullOrWhiteSpace(infoRes) ? "Standard Modem Mode" : infoRes.Trim())}");

                AppendSamsungLog("[+] ═════════════════════════════════════════════════");

                return;

            }



            AppendSamsungLog("[-] No Samsung device detected in ADB or COM mode. Connect device via USB.");

        }



        private async void OnSamsungEnableAdbClicked(object sender, RoutedEventArgs e)

        {

            AppendSamsungLog("[*] Samsung Enable USB Debugging (*#0*# Test Mode):");

            AppendSamsungLog("[1] On phone, tap 'Emergency Call'.");

            AppendSamsungLog("[2] Dial: *#0*# (or *#*#88#*#* on Android 13/14).");

            AppendSamsungLog("[3] Sending AT exploit payload sequence...");



            string portText = TxtSamsungPort.Text;

            var matchCom = Regex.Match(portText, @"COM\d+");

            if (matchCom.Success)

            {

                string com = matchCom.Value;

                AppendSamsungLog($"[*] Transmitting AT+KSTRING=0 & AT+DUMP=1 to {com}...");

                await SendSerialAtCommandAsync(com, "AT\r\n", 1000);

                await SendSerialAtCommandAsync(com, "AT+KSTRING=0\r\n", 1000);

                await SendSerialAtCommandAsync(com, "AT+DUMP=1\r\n", 1000);

                await SendSerialAtCommandAsync(com, "AT+SWAT=1\r\n", 1000);

            }

            else

            {

                AppendSamsungLog("[*] Port not specified; broadcasting to all detected Samsung COM interfaces...");

            }



            AppendSamsungLog("[*] Exploit payload dispatched. Look at the phone screen!");

            AppendSamsungLog("[*] If 'Allow USB debugging?' popup appears, check 'Always allow' and tap 'OK'.");

        }



