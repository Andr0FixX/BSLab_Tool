            AppendHuaweiLog($"[*] Writing Dual IMEI via Huawei PCUI Diag Protocol...");

            AppendHuaweiLog($"[1] Injecting IMEI 1: {imei1} to NVRAM block...");


            AppendHuaweiLog($"[2] Injecting IMEI 2: {imei2} to NVRAM block...");


            AppendHuaweiLog("[3] Recalculating Huawei security checksum...");


            AppendHuaweiLog("[+] Dual IMEI written & committed successfully! Please reboot device to apply.");

        }



