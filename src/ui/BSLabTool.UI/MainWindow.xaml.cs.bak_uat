        private async Task RunAiDeepDiagnoseAsync()

        {

            AppendAutoHubLog("🤖 [AI Co-Pilot] Initiating 1-Click Hardware & OS Deep Telemetry Sweep...");

            AppendAiAnalyseLog("🤖 [AI Co-Pilot] Initiating 1-Click Hardware & OS Deep Telemetry Sweep...");

            TxtAiEngineStatus.Text = "● AI ANALYZING...";

            TxtAiEngineStatus.Foreground = new SolidColorBrush(Color.FromRgb(0xF5, 0x9E, 0x0B));

            BtnAiDeepDiagnose.IsEnabled = false;



            var report = new AiDiagnosticReport();

            var rawSb = new StringBuilder();

            rawSb.AppendLine($"[+] BS Lab AI Hardware Harvester v1.0 — {DateTime.Now:yyyy-MM-dd HH:mm:ss}");



            try

            {

                // 1. Check ADB connection

                string adbDevices = await ExecuteCliAsync("adb.exe", "devices -l");

                rawSb.AppendLine($"\n--- ADB DEVICES ENUMERATION ---\n{adbDevices.Trim()}");



                bool hasAdb = adbDevices.Contains("device") && !adbDevices.Contains("unauthorized") && !adbDevices.Contains("offline");

                bool hasUnauthorized = adbDevices.Contains("unauthorized");



                if (hasUnauthorized)

                {

                    report.DeviceMode = "ADB (UNAUTHORIZED)";

                    report.RawTelemetry = rawSb.ToString() + "\n[!] Device is UNAUTHORIZED. Please accept RSA fingerprint prompt on phone screen.";

                    AppendAutoHubLog("[!] AI Notice: Device connected via ADB but RSA key is unauthorized. Unlock phone screen and press 'Allow'.");

            AppendAiAnalyseLog("[!] AI Notice: Device connected via ADB but RSA key is unauthorized. Unlock phone screen and press 'Allow'.");

                }

                else if (hasAdb)

                {

                    report.DeviceMode = "ADB (LIVE DEBUGGING)";

                    AppendAutoHubLog("[+] ADB Transport Linked. Harvesting System Properties (getprop)...");

            AppendAiAnalyseLog("[+] ADB Transport Linked. Harvesting System Properties (getprop)...");



                    string props = await ExecuteCliAsync("adb.exe", "shell getprop");

                    rawSb.AppendLine($"\n--- SYSTEM GETPROP TELEMETRY ---\n{props.Trim()}");



                    string GetProp(string key)

                    {

                        var match = Regex.Match(props, $@"\[{key}\]:\s*\[(.*?)\]");

                        return match.Success ? match.Groups[1].Value.Trim() : "";

                    }



                    report.Brand = GetProp("ro.product.brand");

                    if (string.IsNullOrEmpty(report.Brand)) report.Brand = GetProp("ro.product.manufacturer");

                    report.Model = GetProp("ro.product.model");

                    report.AndroidVersion = GetProp("ro.build.version.release");

                    report.BuildId = GetProp("ro.build.display.id");

                    if (string.IsNullOrEmpty(report.BuildId)) report.BuildId = GetProp("ro.build.id");

                    report.CpuAbi = GetProp("ro.product.cpu.abi");



                    string buildType = GetProp("ro.build.type");

                    string secureBoot = GetProp("ro.secure");

                    string debuggable = GetProp("ro.debuggable");

                    string warrantyBit = GetProp("ro.boot.warranty_bit");

                    if (string.IsNullOrEmpty(warrantyBit)) warrantyBit = GetProp("ro.warranty_bit");

                    string flashLocked = GetProp("ro.boot.flash.locked");

                    if (string.IsNullOrEmpty(flashLocked)) flashLocked = GetProp("ro.boot.vbmeta.device_state");

                    string baseband = GetProp("gsm.version.baseband");

                    string simState = GetProp("gsm.sim.state");

                    string kgState = GetProp("ro.boot.kg.state");

                    string frpPst = GetProp("ro.frp.pst");



                    // Check root via su

                    string suCheck = await ExecuteCliAsync("adb.exe", "shell which su");

                    bool isRooted = suCheck.Contains("/su") || suCheck.Contains("magisk");



                    // Evaluate Firmware & ROM Integrity

                    if (buildType == "user" && !isRooted && debuggable != "1")

                    {

                        report.IsOfficialRom = true;

                        report.RomType = "🟢 Official Stock Firmware";

                        report.RomDetails = $"Official (Type: {buildType} | SELinux: Enforcing)";

                    }

                    else

                    {

                        report.IsOfficialRom = false;

                        report.RomType = "🔴 Custom / Tampered ROM";

                        report.RomDetails = $"Modified (Type: {buildType} | Root: {(isRooted ? "Active" : "Eng Binary")})";

                    }



                    // Evaluate Bootloader & Knox

                    if (flashLocked == "1" || flashLocked.ToLowerInvariant() == "locked")

                    {

                        report.IsBootloaderLocked = true;

                        report.BlDetails = "🔒 Locked (Secure Boot Active)";

                    }

                    else

                    {

                        report.IsBootloaderLocked = false;

                        report.BlDetails = "🔓 Unlocked (Custom Binary Allowed)";

                    }



                    if (warrantyBit == "1")

                    {

                        report.IsKnoxTripped = true;

                        report.KnoxDetails = "🔴 Knox 0x1 (Warranty Tripped)";

                    }

                    else

                    {

                        report.IsKnoxTripped = false;

                        report.KnoxDetails = "🟢 Knox 0x0 (Official Knox Safe)";

                    }



                    // Evaluate Modem & Baseband

                    if (string.IsNullOrEmpty(baseband) || baseband.Equals("unknown", StringComparison.OrdinalIgnoreCase) || baseband == "null")

                    {

                        report.IsBasebandHealthy = false;

                        report.BasebandVersion = "🔴 CORRUPTED / UNKNOWN";

                        AppendAutoHubLog("[!] CRITICAL TELEMETRY: gsm.version.baseband is NULL/UNKNOWN! Modem NV corruption detected.");

            AppendAiAnalyseLog("[!] CRITICAL TELEMETRY: gsm.version.baseband is NULL/UNKNOWN! Modem NV corruption detected.");

                    }

                    else

                    {

                        report.IsBasebandHealthy = true;

                        report.BasebandVersion = $"🟢 {baseband}";

                    }



                    // Security & FRP

                    if (!string.IsNullOrEmpty(frpPst) || props.Contains("ro.setupwizard.mode"))

                    {

                        report.FrpStatus = "Active (FRP Locked)";

                    }

                    else

                    {

                        report.FrpStatus = "Clean / Bypassed";

                    }



                    report.KgState = string.IsNullOrEmpty(kgState) ? "Clean / N/A" : kgState;

                    report.IsRooted = isRooted;

                    report.RootDetails = isRooted ? "🔴 Rooted (Su/Magisk Found)" : "🟢 Clean (No Root)";

                    report.RawTelemetry = rawSb.ToString();

                }

                else

                {

                    // 2. Check Fastboot

                    string fbDevices = await ExecuteCliAsync("fastboot.exe", "devices");

                    if (!string.IsNullOrWhiteSpace(fbDevices) && !fbDevices.Contains("Error"))

                    {

                        report.DeviceMode = "FASTBOOT (BOOTLOADER)";

                        string fbVars = await ExecuteCliAsync("fastboot.exe", "getvar all");

                        rawSb.AppendLine($"\n--- FASTBOOT GETVAR TELEMETRY ---\n{fbVars.Trim()}");



                        report.Brand = "Fastboot Device";

                        report.Model = fbDevices.Split('\t', ' ')[0];

                        report.RomType = "🟡 Fastboot Level";

                        report.RomDetails = "Device in Bootloader/Fastboot Mode";



                        bool unlocked = fbVars.Contains("unlocked: yes") || fbVars.Contains("unlocked:true");

                        report.IsBootloaderLocked = !unlocked;

                        report.BlDetails = unlocked ? "🔓 Unlocked" : "🔒 Locked";

                        report.BasebandVersion = "Fastboot Standby";

                        report.FrpStatus = fbVars.Contains("secure: yes") ? "Secure Boot Active" : "Clean";

                        report.RawTelemetry = rawSb.ToString();

                    }

                    else

                    {

                        // 3. Check COM / Low-Level Port (e.g. PCUI, MTK, Qualcomm 9008, SPD)

                        string activePort = CmbAutoHubComPort?.Text ?? "";

                        if (!string.IsNullOrEmpty(activePort) && activePort != "AUTO" && activePort != "No COM Port")

                        {

                            report.DeviceMode = "LOW-LEVEL HARDWARE (COM / BROM / EDL)";

                            report.Brand = CmbAutoHubBrand?.SelectedItem?.ToString() ?? "Detected Hardware";

                            report.Model = CmbAutoHubModel?.SelectedItem?.ToString() ?? "Serial Port Device";

                            report.RomType = "Direct Silicon Handshake";

                            report.RomDetails = $"Connected on {activePort}";

                            report.BlDetails = "BROM / EDL Hardware Level";

                            report.BasebandVersion = "Hardware Modem Handshake";

                            report.FrpStatus = "Persistent Hardware Lock Accessible";

                            rawSb.AppendLine($"\n[+] Hardware COM Port Active: {activePort}");

                            rawSb.AppendLine($"[+] Protocol: Low-Level Direct Bus (BROM / EDL 9008 / Huawei Manufacture)");

                            report.RawTelemetry = rawSb.ToString();

                        }

                        else

                        {

                            // No device connected: sample/diagnostic notice

                            report.DeviceMode = "NO DEVICE DETECTED";

                            report.Brand = "Connect Phone via USB";

                            report.Model = "No Active Interface";

                            report.RomType = "No Telemetry";

                            report.RomDetails = "Connect in ADB, Fastboot or EDL/BROM";

                            report.BlDetails = "No Interface";

                            report.BasebandVersion = "No Interface";

                            report.FrpStatus = "No Interface";

                            rawSb.AppendLine("[!] No USB device detected in ADB, Fastboot or COM port.");

                            rawSb.AppendLine("[*] Connect device via USB with USB Debugging ON or enter Download/Fastboot/BROM mode.");

                            report.RawTelemetry = rawSb.ToString();

                            AppendAutoHubLog("[-] AI Sniffer: No active USB phone detected. Please connect device via USB.");

            AppendAiAnalyseLog("[-] AI Sniffer: No active USB phone detected. Please connect device via USB.");

                        }

                    }

                }

            }

            catch (Exception ex)

            {

                AppendAutoHubLog($"[!] AI Diagnostics Exception: {ex.Message}");

            AppendAiAnalyseLog($"[!] AI Diagnostics Exception: {ex.Message}");

                rawSb.AppendLine($"[!] Exception: {ex}");

                report.RawTelemetry = rawSb.ToString();

            }

            finally

            {

                _currentAiReport = report;

                UpdateAiDiagnosticUi(report);

                TxtAiEngineStatus.Text = "● AI ACTIVE";

                TxtAiEngineStatus.Foreground = new SolidColorBrush(Color.FromRgb(0x34, 0xD3, 0x99));

                BtnAiDeepDiagnose.IsEnabled = true;

                AppendAutoHubLog($"[+] AI Diagnostics Completed. Telemetry synthesized for {report.Brand} {report.Model}.");

            AppendAiAnalyseLog($"[+] AI Diagnostics Completed. Telemetry synthesized for {report.Brand} {report.Model}.");

            }

        }



        private void UpdateAiDiagnosticUi(AiDiagnosticReport report)

        {

            // Health Matrix Pills

            if (report.IsOfficialRom)

            {

                TxtAiRomStatus.Text = "● Official Stock";

                TxtAiRomStatus.Foreground = new SolidColorBrush(Color.FromRgb(0x34, 0xD3, 0x99));

            }

            else

            {

                TxtAiRomStatus.Text = "● Custom / Tampered";

                TxtAiRomStatus.Foreground = new SolidColorBrush(Color.FromRgb(0xEF, 0x44, 0x44));

            }



            if (report.IsBasebandHealthy)

            {

                TxtAiBasebandStatus.Text = "● Healthy";

                TxtAiBasebandStatus.Foreground = new SolidColorBrush(Color.FromRgb(0x34, 0xD3, 0x99));

            }

            else

            {

                TxtAiBasebandStatus.Text = "● Corrupted / Null";

                TxtAiBasebandStatus.Foreground = new SolidColorBrush(Color.FromRgb(0xEF, 0x44, 0x44));

            }



            if (report.IsBootloaderLocked)

            {

                TxtAiBlStatus.Text = report.IsKnoxTripped ? "● BL Locked (Knox 0x1)" : "● Locked (0x0 Safe)";

                TxtAiBlStatus.Foreground = new SolidColorBrush(Color.FromRgb(0x38, 0xBD, 0xF8));

            }

            else

            {

                TxtAiBlStatus.Text = "● Unlocked";

                TxtAiBlStatus.Foreground = new SolidColorBrush(Color.FromRgb(0xF5, 0x9E, 0x0B));

            }



            if (report.FrpStatus.Contains("Active") || report.FrpStatus.Contains("Locked"))

            {

                TxtAiSecurityStatus.Text = "● FRP: Active";

                TxtAiSecurityStatus.Foreground = new SolidColorBrush(Color.FromRgb(0xEF, 0x44, 0x44));

            }

            else

            {

                TxtAiSecurityStatus.Text = "● Clean / Safe";

                TxtAiSecurityStatus.Foreground = new SolidColorBrush(Color.FromRgb(0x34, 0xD3, 0x99));

            }



            // Right Inspector Panel Details

            TxtAiInspectorTitle.Text = $"🤖 AI TELEMETRY: {report.Brand} {report.Model}";

            TxtAiInspectorModeBadge.Text = $"MODE: {report.DeviceMode}";

            TxtAiDetailIdentity.Text = $"Model: {report.Brand} {report.Model} | OS: Android {report.AndroidVersion} | ABI: {report.CpuAbi}";

            TxtAiDetailRom.Text = $"ROM: {report.RomType} | Root: {report.RootDetails} | Build: {report.BuildId}";

            TxtAiDetailBaseband.Text = $"Baseband: {report.BasebandVersion} | Modem: Online";

            TxtAiDetailSecurity.Text = $"BL: {report.BlDetails} | Knox: {report.KnoxDetails} | FRP: {report.FrpStatus}";

            TxtAiRawTelemetry.Text = report.RawTelemetry;



            // Telemetry updated in ViewAiAnalyse

        }




        private void OnAiSubTabResponseClicked(object? sender, RoutedEventArgs? e)
        {
            if (BtnAiSubTabResponse == null || PanelAiResponseView == null) return;
            BtnAiSubTabResponse.Background = new SolidColorBrush(Color.FromRgb(0x25, 0x63, 0xEB));
            BtnAiSubTabResponse.Foreground = new SolidColorBrush(Colors.White);
            if (BtnAiSubTabTerminal != null) { BtnAiSubTabTerminal.Background = new SolidColorBrush(Color.FromRgb(0x1E, 0x29, 0x3B)); BtnAiSubTabTerminal.Foreground = new SolidColorBrush(Color.FromRgb(0x94, 0xA3, 0xB8)); }
            if (BtnAiSubTabProps != null) { BtnAiSubTabProps.Background = new SolidColorBrush(Color.FromRgb(0x1E, 0x29, 0x3B)); BtnAiSubTabProps.Foreground = new SolidColorBrush(Color.FromRgb(0x94, 0xA3, 0xB8)); }

            PanelAiResponseView.Visibility = Visibility.Visible;
            if (PanelAiTerminalView != null) PanelAiTerminalView.Visibility = Visibility.Collapsed;
            if (PanelAiPropsView != null) PanelAiPropsView.Visibility = Visibility.Collapsed;

            PanelAiResponseView.Background = new SolidColorBrush(Color.FromRgb(0x0A, 0x0E, 0x1A));
            if (TxtAiAssistantResponse != null)
            {
                TxtAiAssistantResponse.Background = new SolidColorBrush(Color.FromRgb(0x0A, 0x0E, 0x1A));
                TxtAiAssistantResponse.Foreground = new SolidColorBrush(Color.FromRgb(0x38, 0xBD, 0xF8));
            }
        }

