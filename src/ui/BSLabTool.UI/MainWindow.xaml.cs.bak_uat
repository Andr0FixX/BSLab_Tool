                        RedirectStandardError = true,
                        CreateNoWindow = true
                    }
                };

                proc.Start();
                string output = await proc.StandardOutput.ReadToEndAsync();
                string error = await proc.StandardError.ReadToEndAsync();
                await proc.WaitForExitAsync();

                if (!string.IsNullOrWhiteSpace(output))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(output);
                        var root = doc.RootElement;
                        string status = root.GetProperty("status").GetString() ?? "";

                        if (status == "ok")
                        {
                            string file = root.GetProperty("file").GetString() ?? "";
                            string partition = root.GetProperty("partition").GetString() ?? "boot";
                            string fmt = root.GetProperty("format").GetString() ?? "unknown";
                            long size = root.GetProperty("size").GetInt64();

                            _currentExtractedBootPath = file;
                            if (TxtMagiskBootInfo != null)
                            {
                                TxtMagiskBootInfo.Text = $"✅ Target: {System.IO.Path.GetFileName(file)} ({(size / (1024.0 * 1024.0)):F2} MB - {fmt})";
                            }

                            AppendAdbLog($"[+] Format     : {fmt}");
                            AppendAdbLog($"[+] Partition  : {partition}");
                            AppendAdbLog($"[+] Target Img : {file} ({(size / (1024.0 * 1024.0)):F2} MB)");
                            AppendAdbLog("══════════════════════════════════════════════════════════════");
                            AppendAdbLog("✅ [SUCCESS] Boot image successfully extracted in 3 seconds!");
                            AppendAdbLog("══════════════════════════════════════════════════════════════");

                            var prompt = MessageBox.Show(
                                $"Boot image extracted successfully!\n\n" +
                                $"Format: {fmt}\n" +
                                $"Partition: {partition}\n" +
                                $"Extracted File: {file}\n\n" +
                                $"Would you like to deploy 1-Click Magisk Root with this image now?",
                                "Extraction Complete",
                                MessageBoxButton.YesNo,
                                MessageBoxImage.Information);

                            if (prompt == MessageBoxResult.Yes)
                            {
                                OnFastbootAutoMagiskRootClicked(sender, e);
                            }
                            return;
                        }
                        else
                        {
                            string msg = root.TryGetProperty("message", out var m) ? m.GetString() ?? "" : output;
                            AppendAdbLog($"[-] Extraction failed: {msg}");
                            MessageBox.Show($"Failed to extract boot image:\n\n{msg}", "Extraction Error", MessageBoxButton.OK, MessageBoxImage.Warning);
                        }
                    }
                    catch
                    {
                        AppendAdbLog($"[*] Extractor Output: {output}");
                    }
                }
                else if (!string.IsNullOrWhiteSpace(error))
                {
                    AppendAdbLog($"[-] Error: {error}");
                }
            }
            catch (Exception ex)
            {
                AppendAdbLog($"[-] Exception: {ex.Message}");
            }

            AppendAdbLog("══════════════════════════════════════════════════════════════");
        }

        private async void OnFastbootAutoMagiskRootClicked(object sender, RoutedEventArgs e)
        {
            AppendAdbLog("══════════════════════════════════════════════════════════════");
            AppendAdbLog("🚀 [1-CLICK MAGISK ROOT AUTOMATOR] FASTBOOT DEPLOYMENT ENGAGED");
            AppendAdbLog("══════════════════════════════════════════════════════════════");

            string targetFile = "";
            if (!string.IsNullOrEmpty(_currentExtractedBootPath) && File.Exists(_currentExtractedBootPath))
            {
                var ask = MessageBox.Show(
                    $"An extracted boot image is already staged:\n\n{_currentExtractedBootPath}\n\n" +
                    "Click [Yes] to proceed with this image, or [No] to browse for a different boot file.",
                    "Use Staged Boot Image?",
                    MessageBoxButton.YesNoCancel,
                    MessageBoxImage.Question);

                if (ask == MessageBoxResult.Cancel)
                {
                    AppendAdbLog("[-] Magisk Root cancelled by technician.");
                    return;
                }
                if (ask == MessageBoxResult.Yes)
                {
                    targetFile = _currentExtractedBootPath;
                }
            }

            if (string.IsNullOrEmpty(targetFile))
            {
                var dlg = new OpenFileDialog
                {
                    Filter = "Android Boot Image (*.img;*.bin)|*.img;*.bin|All Files (*.*)|*.*",
                    Title = "Select Stock boot.img or magisk_patched.img",
                    InitialDirectory = Directory.Exists(@"E:\Google Pixel 4XL\Factory Ota Android 11") ? 
                                       @"E:\Google Pixel 4XL\Factory Ota Android 11" : 
                                       @"C:\Users\AndroFixX\Downloads"
                };

                if (dlg.ShowDialog() != true)
                {
                    AppendAdbLog("[-] Magisk Root cancelled: No boot image selected.");
                    return;
                }
                targetFile = dlg.FileName;
            }
            long fileSize = new FileInfo(targetFile).Length;
            AppendAdbLog($"[*] Target Image    : {System.IO.Path.GetFileName(targetFile)} ({(fileSize / (1024.0 * 1024.0)):F2} MB)");
            AppendAdbLog($"[*] Image Location  : {targetFile}");

            bool tempBootOnly = ChkMagiskTempBootOnly?.IsChecked == true;
            AppendAdbLog($"[*] Root Strategy   : {(tempBootOnly ? "🛡️ SAFE TEMPORARY BOOT (Zero Flash Risk - Stock on Reboot)" : "⚡ PERMANENT PARTITION FLASH")}");

            // 1. Device Handshake (ADB or Fastboot)
            string fbDevices = await ExecuteCliAsync("fastboot.exe", "devices");
            bool fbOnline = !string.IsNullOrWhiteSpace(fbDevices) && !fbDevices.Contains("Error");

            if (!fbOnline)
            {
                string adbDevices = await ExecuteCliAsync("adb.exe", "devices");
                if (adbDevices.Contains("\tdevice"))
                {
                    AppendAdbLog("[*] Device detected in ADB mode. Rebooting to bootloader...");
                    await ExecuteCliAsync("adb.exe", "reboot bootloader");
                    AppendAdbLog("[*] Waiting for device to enter Fastboot mode (5 seconds)...");
                    await Task.Delay(5000);
                    fbDevices = await ExecuteCliAsync("fastboot.exe", "devices");
                    fbOnline = !string.IsNullOrWhiteSpace(fbDevices) && !fbDevices.Contains("Error");
                }
            }

            if (!fbOnline)
            {
                AppendAdbLog("[-] Error: Fastboot device not detected. Please connect phone in Fastboot/Bootloader mode.");
                AppendAdbLog("[-] Tip: Turn off phone, hold Volume Down + Power button.");
                AppendAdbLog("══════════════════════════════════════════════════════════════");
                return;
            }

            AppendAdbLog($"[+] Fastboot Device Online: {fbDevices.Trim()}");

            // 2. Query Bootloader Lock Status
            string oemStatus = await ExecuteCliAsync("fastboot.exe", "getvar unlocked");
            if (oemStatus.Contains("unlocked: no") || oemStatus.Contains("unlocked: false"))
            {
                AppendAdbLog("[!] ⚠️ WARNING: Device Bootloader is LOCKED! Custom boot images cannot boot.");
                AppendAdbLog("[!] Unlock bootloader first ('fastboot flashing unlock') or use Temp Root on supported kernels.");
            }

            // 3. Query Active Slot
            string currentSlot = await ExecuteCliAsync("fastboot.exe", "getvar current-slot");
            if (currentSlot.Contains("current-slot:"))
            {
                AppendAdbLog($"[+] Target Active Slot: {currentSlot.Replace("(bootloader)", "").Trim()}");
            }

            // 4. Dispatch Boot or Flash
            if (tempBootOnly)
            {
                AppendAdbLog($"[*] 🛡️ Launching Temporary Boot Session: fastboot boot \"{System.IO.Path.GetFileName(targetFile)}\"...");
                string bootRes = await ExecuteCliAsync("fastboot.exe", $"boot \"{targetFile}\"");
                AppendAdbLog(string.IsNullOrWhiteSpace(bootRes) ? "[+] Device acknowledged temporary boot!" : $"[+] Fastboot: {bootRes}");
                AppendAdbLog("══════════════════════════════════════════════════════════════");
                AppendAdbLog("✅ [SUCCESS] TEMPORARY MAGISK ROOT DISPATCHED!");
                AppendAdbLog("[+] Phone is booting into rooted OS. Partitions remain 100% UNTOUCHED.");
                AppendAdbLog("[+] Next reboot will restore 100% original stock state.");
                AppendAdbLog("══════════════════════════════════════════════════════════════");
            }
            else
            {
                string partTarget = "boot";
                string initBootCheck = await ExecuteCliAsync("fastboot.exe", "getvar partition-type:init_boot");
                if (!initBootCheck.Contains("not found") && initBootCheck.Contains("init_boot"))
                {
                    partTarget = "init_boot";
                    AppendAdbLog("[*] Modern GKI Android 13+ target detected (init_boot partition).");
                }

                AppendAdbLog($"[*] ⚡ Writing Magisk Root to partition '{partTarget}'...");
                string flashRes = await ExecuteCliAsync("fastboot.exe", $"flash {partTarget} \"{targetFile}\"");
                AppendAdbLog($"[+] Flash Result: {flashRes}");

                AppendAdbLog("[*] Rebooting phone into system...");
                await ExecuteCliAsync("fastboot.exe", "reboot");

                AppendAdbLog("══════════════════════════════════════════════════════════════");
                AppendAdbLog("✅ [SUCCESS] MAGISK ROOT PERMANENTLY FLASHED!");
                AppendAdbLog($"[+] Flashed to '{partTarget}' and system rebooted.");
                AppendAdbLog("══════════════════════════════════════════════════════════════");
            }
        }



