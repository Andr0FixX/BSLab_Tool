        // ====================================================================

        // FASTBOOT & ADB UNIVERSAL ENGINE EXECUTOR

        // ====================================================================



        private string GetToolPath(string exeName)

        {

            string p1 = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "resources", "platform-tools", exeName);

            if (File.Exists(p1)) return p1;

            string p2 = @"C:\BSLab_Tool\resources\platform-tools\" + exeName;

            if (File.Exists(p2)) return p2;

            return exeName;

        }



        private async Task<string> ExecuteCliAsync(string exeName, string arguments)

        {

            if (_isOperationCancelled) return "[-] Operation cancelled by Technician.";

            string tool = GetToolPath(exeName);

            return await Task.Run(() =>

            {

                try

                {

                    if (_isOperationCancelled) return "[-] Operation cancelled by Technician.";

                    var psi = new ProcessStartInfo

                    {

                        FileName = tool,

                        Arguments = arguments,

                        RedirectStandardOutput = true,

                        RedirectStandardError = true,

                        UseShellExecute = false,

                        CreateNoWindow = true

                    };

                    using var proc = Process.Start(psi);

                    if (proc == null) return "Failed to start process.";

                    _activeChildProcess = proc;

                    string stdout = proc.StandardOutput.ReadToEnd();

                    string stderr = proc.StandardError.ReadToEnd();

                    proc.WaitForExit(10000);

                    _activeChildProcess = null;

                    return string.IsNullOrWhiteSpace(stderr) ? stdout.Trim() : $"{stdout.Trim()}\n{stderr.Trim()}".Trim();

                }

                catch (Exception ex)

                {

                    return $"[!] CLI Execution Error: {ex.Message}";

                }

            });

        }



        private async void OnCheckAdbClicked(object sender, RoutedEventArgs e)

        {

            AppendAdbLog("[*] Checking for connected ADB devices (USB Debugging ON)...");

            string output = await ExecuteCliAsync("adb.exe", "devices -l");

            AppendAdbLog(output);



            if (output.Contains("device") && !output.Contains("unauthorized"))

            {

                TxtAdbStatus.Text = "● Status: Device Connected (ADB Active)";

                TxtAdbStatus.Foreground = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(0x34, 0xD3, 0x99));

            }

            else if (output.Contains("unauthorized"))

            {

                TxtAdbStatus.Text = "● Status: Device Unauthorized (Check Phone Screen RSA Prompt)";

                TxtAdbStatus.Foreground = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(0xF5, 0x9E, 0x0B));

            }

            else

            {

                TxtAdbStatus.Text = "● Status: No ADB device detected";

                TxtAdbStatus.Foreground = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(0xEF, 0x44, 0x44));

            }

        }



        private async void OnCheckFastbootClicked(object sender, RoutedEventArgs e)

        {

            AppendAdbLog("[*] Checking for connected Fastboot devices (Bootloader Mode)...");

            string output = await ExecuteCliAsync("fastboot.exe", "devices");

            AppendAdbLog(string.IsNullOrWhiteSpace(output) ? "[-] No device in Fastboot mode detected." : output);



            if (!string.IsNullOrWhiteSpace(output) && output.Contains("fastboot"))

            {

                TxtAdbStatus.Text = "● Status: Device Connected in FASTBOOT Mode";

                TxtAdbStatus.Foreground = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(0x00, 0xD2, 0xFF));

            }

        }



        private async void OnAdbGetpropClicked(object sender, RoutedEventArgs e)

        {

            AppendAdbLog("Connecting to adb server...");

            string devList = await ExecuteCliAsync("adb.exe", "devices");

            string serial = "";

            var lines = devList.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

            foreach (var l in lines)

            {

                if (l.Contains("List of devices") || string.IsNullOrWhiteSpace(l)) continue;

                var parts = l.Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);

                if (parts.Length >= 2 && parts[1] == "device")

                {

                    serial = parts[0];

                    break;

                }

            }



            if (string.IsNullOrEmpty(serial))

            {

                AppendAdbLog("[-] Waiting for adb device... [Device Not Found or Unauthorized]");

                return;

            }



            AppendAdbLog($"Waiting for adb device... [Found:{serial}]");



            // 1. Fetch full getprop dump in one fast call

            string rawProps = await ExecuteCliAsync("adb.exe", "shell getprop");

            var propMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            var propRegex = new Regex(@"\[(.*?)\]:\s*\[(.*?)\]");

            foreach (Match m in propRegex.Matches(rawProps))

            {

                string key = m.Groups[1].Value.Trim();

                string val = m.Groups[2].Value.Trim();

                propMap[key] = val;

            }



            string GetProp(string key, string fallback = "")

            {

                return propMap.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : fallback;

            }



            // 2. Fetch IMEI via dumpsys iphonesubinfo / service call

            string imei = "";

            try

            {

                string dumpSubInfo = await ExecuteCliAsync("adb.exe", "shell dumpsys iphonesubinfo");

                var mImei = Regex.Match(dumpSubInfo, @"Device ID\s*=\s*([0-9]{14,16})");

                if (mImei.Success)

                {

                    imei = mImei.Groups[1].Value;

                }

                else

                {

                    // Fallback to service call iphonesubinfo 1

                    string parcel = await ExecuteCliAsync("adb.exe", "shell service call iphonesubinfo 1");

                    var parcelMatches = Regex.Matches(parcel, @"'([^']+)'");

                    var digits = new StringBuilder();

                    foreach (Match pm in parcelMatches)

                    {

                        foreach (char c in pm.Groups[1].Value)

                        {

                            if (char.IsDigit(c)) digits.Append(c);

                        }

                    }

                    if (digits.Length >= 14) imei = digits.ToString();

                }

            }

            catch { }



            if (string.IsNullOrEmpty(imei) || imei == "N/A")
            {
                imei = GetProp("ro.boot.imei1",
                       GetProp("ro.boot.imei",
                       GetProp("persist.radio.imei1",
                       GetProp("persist.radio.imei",
                       GetProp("ro.ril.oem.imei1",
                       GetProp("ril.serialnumber",
                       GetProp("gsm.baseband.imei", "")))))));

                if (string.IsNullOrEmpty(imei))
                {
                    string hwCheck = GetProp("ro.hardware", GetProp("ro.boot.hardware", GetProp("ro.board.platform", ""))).ToUpper();
                    imei = hwCheck.Contains("MT") ? "Secured (Read via MediaTek META Mode)" : "Secured by OS (No Root)";
                }
            }



            // 3. Check Root Status

            string rootStatus = "Root Not Found";

            try

            {

                string suCheck = await ExecuteCliAsync("adb.exe", "shell which su");

                if (!string.IsNullOrWhiteSpace(suCheck) && suCheck.Contains("/su"))

                {

                    rootStatus = "Root Granted / Active";

                }

            }

            catch { }



            // Extract all detailed GSM fields matching Android Utility & GSM Dongles
            string bpsn4 = GetProp("ro.serialno", GetProp("ro.boot.serialno", serial));
            string manfc = GetProp("ro.product.manufacturer", GetProp("ro.product.vendor.manufacturer", GetProp("ro.product.brand", "UNKNOWN"))).ToUpper();
            string brand = GetProp("ro.product.brand", GetProp("ro.product.vendor.brand", manfc)).ToUpper();
            string model = GetProp("ro.product.model", GetProp("ro.product.vendor.model", "UNKNOWN"));
            string simState = GetProp("gsm.sim.state", "READY,ABSENT");
            string operatorName = GetProp("gsm.operator.alpha", GetProp("gsm.sim.operator.alpha", "Unknown"));
            if (operatorName.EndsWith(",")) operatorName = operatorName.TrimEnd(',');
            string network = GetProp("gsm.network.type", "LTE,Unknown");
            string simLock = GetProp("ril.hw_modem0.sim_simlock_state", GetProp("gsm.sim.num.simlock", "-1,-1,-1"));
            string buildId = GetProp("ro.build.display.id", GetProp("ro.build.inside.id", GetProp("ro.build.id", "UNKNOWN")));
            string hardware = GetProp("ro.hardware", GetProp("ro.boot.hardware", GetProp("ro.board.platform", "UNKNOWN"))).ToUpper();
            string modem = GetProp("ril.modem.board", GetProp("gsm.version.baseband", GetProp("ril.hw_modem0.ver_number", "Unknown")));
            string androidVer = GetProp("ro.build.version.release", "UNKNOWN");
            string flavorId = GetProp("ro.build.flavor", "user");
            string secPatch = GetProp("ro.build.version.security_patch", "Unknown");

            // Region
            string regCountry = GetProp("persist.sys.country", GetProp("persist.app.huawei.region", "Global"));
            string regLang = GetProp("persist.sys.language", GetProp("persist.app.huawei.locale", "en"));
            string region = $"{regCountry}_{regLang}";

            // Lock State
            string userLock = GetProp("ro.userlock", "");
            string flashLock = GetProp("ro.boot.flash.locked", "");
            string lockState = !string.IsNullOrEmpty(userLock) ? userLock : (flashLock == "1" ? "locked" : (flashLock == "0" ? "unlocked" : "locked"));

            // Boot State
            string bootState = GetProp("ro.boot.verifiedbootstate", "GREEN").ToUpper();

            // Custom UI Detection: Realme UI / XOS / HiOS / OneUI / HyperOS / MIUI / ColorOS / EMUI
            string realmeVer = GetProp("ro.build.version.realmeui", GetProp("ro.build.realme.version", ""));
            string xosVer = GetProp("ro.xos.version", "");
            string hiosVer = GetProp("ro.hios.version", "");
            string oneuiVer = GetProp("ro.build.version.oneui", GetProp("ro.build.version.sep", ""));
            string miuiVer = GetProp("ro.miui.ui.version.name", "");
            string oppoVer = GetProp("ro.build.version.opporom", GetProp("ro.build.version.oplusrom", ""));
            string emuiVer = GetProp("ro.build.version.emui", "");

            string customUiLabel = "OS Release";
            string customUiVal = $"Android {androidVer} ({buildId})";

            if (!string.IsNullOrEmpty(realmeVer) || brand.Contains("REALME") || manfc.Contains("REALME"))
            {
                customUiLabel = "RealmeUI Ver";
                customUiVal = !string.IsNullOrEmpty(realmeVer) ? realmeVer : (oppoVer != "" ? oppoVer : "Realme UI T Edition / AOSP");
            }
            else if (!string.IsNullOrEmpty(xosVer) || brand.Contains("INFINIX") || manfc.Contains("INFINIX"))
            {
                customUiLabel = "XOS Ver";
                if (!string.IsNullOrEmpty(xosVer))
                    customUiVal = xosVer;
                else if (buildId.Contains("-15."))
                    customUiVal = "XOS 15.1 (Android 15)";
                else if (buildId.Contains("-14."))
                    customUiVal = "XOS 14 (Android 14)";
                else if (buildId.Contains("-13."))
                    customUiVal = "XOS 13";
                else
                    customUiVal = buildId.Contains("XOS") ? buildId : "Infinix XOS";
            }
            else if (!string.IsNullOrEmpty(hiosVer) || brand.Contains("TECNO") || manfc.Contains("TECNO"))
            {
                customUiLabel = "HiOS Ver";
                customUiVal = !string.IsNullOrEmpty(hiosVer) ? hiosVer : (buildId.Contains("HiOS") ? buildId : "Tecno HiOS");
            }
            else if (!string.IsNullOrEmpty(oneuiVer) || brand.Contains("SAMSUNG") || manfc.Contains("SAMSUNG"))
            {
                customUiLabel = "One UI Ver";
                customUiVal = !string.IsNullOrEmpty(oneuiVer) ? oneuiVer : "Samsung One UI";
            }
            else if (!string.IsNullOrEmpty(miuiVer) || brand.Contains("XIAOMI") || brand.Contains("REDMI") || brand.Contains("POCO"))
            {
                customUiLabel = "HyperOS / MIUI";
                customUiVal = !string.IsNullOrEmpty(miuiVer) ? miuiVer : "MIUI/HyperOS";
            }
            else if (!string.IsNullOrEmpty(oppoVer) || brand.Contains("OPPO") || brand.Contains("ONEPLUS"))
            {
                customUiLabel = "ColorOS Ver";
                customUiVal = oppoVer;
            }
            else if (!string.IsNullOrEmpty(emuiVer) || brand.Contains("HUAWEI") || brand.Contains("HONOR"))
            {
                customUiLabel = "EMUI Ver";
                customUiVal = !string.IsNullOrEmpty(emuiVer) ? emuiVer : GetProp("ro.build.version.incremental", "EMUI");
            }



            // Save log file

            string logDir = @"C:\BSLab_Tool\logs";

            Directory.CreateDirectory(logDir);

            string logFileName = $"{DateTime.Now:yyyy_MM_dd_HH_mm_ss}.log";

            string logFilePath = System.IO.Path.Combine(logDir, logFileName);



            var sb = new StringBuilder();

            sb.AppendLine($"{"BPSN4",-14}: {bpsn4}");

            sb.AppendLine($"{"ManfcID",-14}: {manfc}");

            sb.AppendLine($"{"Brand",-14}: {brand}");

            sb.AppendLine($"{"Model",-14}: {model}");

            sb.AppendLine($"{"SimState",-14}: {simState}");

            sb.AppendLine($"{"Operator",-14}: {operatorName}");

            sb.AppendLine($"{"Network",-14}: {network}");

            sb.AppendLine($"{"SimLock",-14}: {simLock}");

            sb.AppendLine($"{"IMEI",-14}: {imei}");

            sb.AppendLine($"{"Build ID",-14}: {buildId}");

            sb.AppendLine($"{"Hardware",-14}: {hardware}");

            sb.AppendLine($"{"Modem",-14}: {modem}");

            sb.AppendLine($"{"Android Ver",-14}: {androidVer}");

            sb.AppendLine($"{"Flavor ID",-14}: {flavorId}");

            sb.AppendLine($"{"Sec Patch",-14}: {secPatch}");

            sb.AppendLine($"{"Region",-14}: {region}");

            sb.AppendLine($"{"LockState",-14}: {lockState}");

            sb.AppendLine($"{"BootState",-14}: {bootState}");

            sb.AppendLine($"{customUiLabel,-14}: {customUiVal}");

            sb.AppendLine($"{"Root Status",-14}: {rootStatus}");

            sb.AppendLine($"Log file saved to => {logFilePath.Replace('\\', '/')}");



            string formattedLog = sb.ToString().TrimEnd();



            // Write to file

            try { File.WriteAllText(logFilePath, formattedLog); } catch { }



            // Write to UI terminal

            AppendAdbLog(formattedLog);

        }



