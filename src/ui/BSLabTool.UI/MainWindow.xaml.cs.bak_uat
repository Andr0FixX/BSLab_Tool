        private async void OnBackupWhatsAppSessionClicked(object sender, RoutedEventArgs e)
        {
            SetBackupProgress(5, "Scanning connected hardware for active WhatsApp databases...");
            string adbExe = GetAdbPath();
            string devId = GetActiveAdbDevice(adbExe);
            string timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            string targetDir = $@"C:\BSLab_Tool\backups\whatsapp\{devId}_{timestamp}";
            Directory.CreateDirectory(targetDir);

            AppendBackupLog($"[+] Target Device: {(string.IsNullOrEmpty(devId) ? "ADB Device (COM)" : devId)}");
            AppendBackupLog($"[+] Vault Destination: {targetDir}");

            SetBackupProgress(25, "Searching storage for WhatsApp databases (msgstore.db.crypt*)...");
            string dbDest = System.IO.Path.Combine(targetDir, "Databases");
            Directory.CreateDirectory(dbDest);

            await Task.Run(async () =>
            {
                try
                {
                    // 1. Pull Media databases from /sdcard Android/media
                    await ExecuteCliAsync(adbExe, $"pull /sdcard/Android/media/com.whatsapp/WhatsApp/Databases \"{dbDest}\"");
                    if (Directory.GetFiles(dbDest).Length == 0)
                    {
                        await ExecuteCliAsync(adbExe, $"pull /sdcard/WhatsApp/Databases \"{dbDest}\"");
                    }

                    // 2. Try pulling key/preferences if root shell exists
                    await ExecuteCliAsync(adbExe, "shell su -c cp /data/data/com.whatsapp/files/key /sdcard/files_key.bin");
                    string pulledKey = System.IO.Path.Combine(targetDir, "files_key.bin");
                    await ExecuteCliAsync(adbExe, $"pull /sdcard/files_key.bin \"{pulledKey}\"");
                    await ExecuteCliAsync(adbExe, "shell rm -f /sdcard/files_key.bin");

                    await ExecuteCliAsync(adbExe, "shell su -c cp /data/data/com.whatsapp/shared_prefs/com.whatsapp_preferences_light.xml /sdcard/wa_prefs.xml");
                    string pulledPrefs = System.IO.Path.Combine(targetDir, "com.whatsapp_preferences.xml");
                    await ExecuteCliAsync(adbExe, $"pull /sdcard/wa_prefs.xml \"{pulledPrefs}\"");
                    await ExecuteCliAsync(adbExe, "shell rm -f /sdcard/wa_prefs.xml");

                    var actualFiles = Directory.GetFiles(targetDir, "*.*", SearchOption.AllDirectories)
                        .Select(f => System.IO.Path.GetRelativePath(targetDir, f))
                        .ToList();

                    if (actualFiles.Count > 0)
                    {
                        var manifest = new
                        {
                            Device = devId,
                            Timestamp = timestamp,
                            WhatsAppPackage = "com.whatsapp",
                            HasKey = File.Exists(pulledKey) && new FileInfo(pulledKey).Length > 0,
                            HasPrefs = File.Exists(pulledPrefs) && new FileInfo(pulledPrefs).Length > 0,
                            Files = actualFiles
                        };

                        string manifestPath = System.IO.Path.Combine(targetDir, "WhatsApp_Session_Manifest.json");
                        await File.WriteAllTextAsync(manifestPath, JsonSerializer.Serialize(manifest, new JsonSerializerOptions { WriteIndented = true }));

                        SetBackupProgress(100, "WhatsApp Session Backup Completed!");
                        Dispatcher.Invoke(() =>
                        {
                            AppendBackupLog($"[+] ✅ SUCCESS: Saved {actualFiles.Count} WhatsApp file(s) into vault: {targetDir}");
                        });
                    }
                    else
                    {
                        SetBackupProgress(0, "No WhatsApp data found on device.");
                        Dispatcher.Invoke(() =>
                        {
                            AppendBackupLog("[-] Warning: No WhatsApp databases could be found on phone storage.");
                            AppendBackupLog("[-] Tip: Ensure WhatsApp is installed, phone is unlocked, and USB Debugging is authorized.");
                        });
                    }
                }
                catch (Exception ex)
                {
                    Dispatcher.Invoke(() => AppendBackupLog($"[-] Error backing up WhatsApp: {ex.Message}"));
                }
            });
        }



