        private void StartLiveClock()

        {

            UpdateClockDisplay();

            _clockTimer = new DispatcherTimer

            {

                Interval = TimeSpan.FromSeconds(1)

            };

            _clockTimer.Tick += (s, e) => UpdateClockDisplay();

            _clockTimer.Start();

        }



        private void UpdateClockDisplay()

        {

            DateTime now = DateTime.Now;

            string timeStr = now.ToString("hh:mm:ss tt"); // e.g. 04:25:30 PM

            string dateStr = now.ToString("dd-MMM-yyyy"); // e.g. 08-Nov-2026



            if (TxtLiveClock != null)

            {

                TxtLiveClock.Text = $"{timeStr} | {dateStr}";

            }

        }



        // ====================================================================

        // REAL-TIME HARDWARE RADAR & DUAL NOTIFICATION SYSTEM (COM & USB)

        // ====================================================================



        private void StartLiveHardwareRadar()

        {

            _liveHardwareRadarTimer = new DispatcherTimer

            {

                Interval = TimeSpan.FromMilliseconds(750)

            };

            _liveHardwareRadarTimer.Tick += OnHardwareRadarTick;

            _liveHardwareRadarTimer.Start();

        }



        private async void OnHardwareRadarTick(object? sender, EventArgs e)

        {

            if (_isRadarBusy || _isManualSnifferActive) return;

            _isRadarBusy = true;

            try

            {

                _fastbootAdbThrottleCounter++;

                bool checkCli = (_fastbootAdbThrottleCounter % 3 == 0);



                var result = await Task.Run(() => PerformQuickHardwareProbe(checkCli));

                if (!_isManualSnifferActive)

                {

                    UpdateLiveHardwareNotificationUi(result);

                }

            }

            catch { }

            finally

            {

                _isRadarBusy = false;

            }

        }



        private class HardwareRadarResult

        {

            public bool HasCom { get; set; }

            public string ComPort { get; set; } = "";

            public string ComDesc { get; set; } = "";

            public bool HasUsb { get; set; }

            public string UsbName { get; set; } = "";

            public string UsbMode { get; set; } = "";

        }



        private HardwareRadarResult PerformQuickHardwareProbe(bool checkCli)

        {

            var res = new HardwareRadarResult();



            try

            {

                using var key = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");

                if (key != null)

                {

                    string bestPort = "";

                    string bestDesc = "";

                    string bestUsb = "";

                    string bestMode = "";

                    int bestScore = 0;



                    foreach (var val in key.GetValueNames())

                    {

                        string p = key.GetValue(val)?.ToString()?.Trim() ?? "";

                        if (string.IsNullOrEmpty(p)) continue;



                        var (desc, hwId) = FindPortDeviceDetails(p);

                        string combined = $"{val} {desc} {hwId} {p}".ToUpperInvariant();



                        int score = 1;

                        string mode = "SERIAL COM";

                        string usbName = string.IsNullOrEmpty(desc) ? p : desc;



                        if (combined.Contains("SPRD") || combined.Contains("U2S") || combined.Contains("SCI") || combined.Contains("1782"))

                        {

                            if (combined.Contains("DIAG") || combined.Contains("CALI"))

                            {

                                score = 10;

                                mode = "SPRD DIAG";

                                usbName = "SPRD U2S Diag (Calibration Port)";

                            }

                            else

                            {

                                score = 9;

                                mode = "UNISOC BROM";

                                usbName = "Unisoc Tiger BootROM (0x1782)";

                            }

                        }

                        else if (combined.Contains("0E8D") || combined.Contains("MEDIATEK") || combined.Contains("PRELOADER") || combined.Contains("MTK"))

                        {

                            score = 8;

                            mode = "MTK BROM";

                            usbName = "MediaTek High-Speed USB (0x0E8D)";

                        }

                        else if (combined.Contains("05C6") || combined.Contains("9008") || combined.Contains("QDLOADER") || combined.Contains("QUALCOMM"))

                        {

                            score = 8;

                            mode = "EDL 9008";

                            usbName = "Qualcomm HS-USB QDLoader 9008 (0x05C6)";

                        }

                        else if (combined.Contains("04E8") || combined.Contains("SAMSUNG"))

                        {

                            score = 7;

                            mode = "SAMSUNG USB";

                            usbName = "Samsung Mobile USB Modem (0x04E8)";

                        }

                        else if (combined.Contains("12D1") || combined.Contains("PCUI") || combined.Contains("HUAWEI"))

                        {

                            score = 7;

                            mode = "HUAWEI PCUI";

                            usbName = "Huawei PCUI / Kirin Interface (0x12D1)";

                        }



                        if (score > bestScore)

                        {

                            bestScore = score;

                            bestPort = p;

                            bestDesc = desc;

                            bestUsb = usbName;

                            bestMode = mode;

                        }

                    }



                    if (!string.IsNullOrEmpty(bestPort))
                    {
                        res.HasCom = true;
                        res.ComPort = bestPort;
                        res.ComDesc = string.IsNullOrEmpty(bestDesc) ? bestMode : bestDesc;
                        res.HasUsb = true;
                        res.UsbName = bestUsb;
                        res.UsbMode = bestMode;
                        _lastHardwareRadarResult = res;
                        return res;
                    }
                }
            }
            catch { }

            // If no serial port detected, check Fastboot or ADB via CLI
            if (!res.HasCom)
            {
                if (checkCli)
                {
                    bool foundUsb = false;
                    try
                    {
                        // Fastboot check
                        var fbPsi = new ProcessStartInfo("fastboot.exe", "devices")
                        {
                            RedirectStandardOutput = true,
                            UseShellExecute = false,
                            CreateNoWindow = true
                        };
                        using var fbProc = Process.Start(fbPsi);
                        if (fbProc != null)
                        {
                            string fbOut = fbProc.StandardOutput.ReadToEnd();
                            fbProc.WaitForExit(300);
                            if (!string.IsNullOrWhiteSpace(fbOut) && fbOut.Contains("fastboot"))
                            {
                                res.HasUsb = true;
                                res.UsbName = "Android Fastboot Bootloader (USB)";
                                res.UsbMode = "FASTBOOT";
                                foundUsb = true;
                            }
                        }

                        if (!foundUsb)
                        {
                            // ADB check
                            var adbPsi = new ProcessStartInfo("adb.exe", "devices")
                            {
                                RedirectStandardOutput = true,
                                UseShellExecute = false,
                                CreateNoWindow = true
                            };
                            using var adbProc = Process.Start(adbPsi);
                            if (adbProc != null)
                            {
                                string adbOut = adbProc.StandardOutput.ReadToEnd();
                                adbProc.WaitForExit(300);
                                if (adbOut.Contains("device\t") || adbOut.Contains("\tdevice"))
                                {
                                    res.HasUsb = true;
                                    res.UsbName = "Android ADB Composite Interface (USB)";
                                    res.UsbMode = "ADB ACTIVE";
                                    foundUsb = true;
                                }
                            }
                        }
                    }
                    catch { }

                    _lastHardwareRadarResult = res;
                }
                else
                {
                    // Retain previous active USB/ADB state during non-CLI ticks to prevent UI flickering / blinking
                    if (_lastHardwareRadarResult.HasUsb && !_lastHardwareRadarResult.HasCom)
                    {
                        res.HasUsb = true;
                        res.UsbName = _lastHardwareRadarResult.UsbName;
                        res.UsbMode = _lastHardwareRadarResult.UsbMode;
                    }
                }
            }

            return res;

        }



        private void UpdateLiveHardwareNotificationUi(HardwareRadarResult res)

        {

            var greenBrush = new SolidColorBrush(Color.FromRgb(0x10, 0xB9, 0x81));

            var greenGlow = Color.FromRgb(0x10, 0xB9, 0x81);

            var greenBadgeBg = new SolidColorBrush(Color.FromRgb(0x06, 0x4E, 0x3B));

            var greenBadgeFg = new SolidColorBrush(Color.FromRgb(0x34, 0xD3, 0x99));



            var cyanBrush = new SolidColorBrush(Color.FromRgb(0x38, 0xBD, 0xF8));

            var cyanGlow = Color.FromRgb(0x38, 0xBD, 0xF8);

            var cyanBadgeBg = new SolidColorBrush(Color.FromRgb(0x1E, 0x3A, 0x8A));

            var cyanBadgeFg = new SolidColorBrush(Color.FromRgb(0x93, 0xC5, 0xFD));



            var redBrush = new SolidColorBrush(Color.FromRgb(0xEF, 0x44, 0x44));

            var redGlow = Color.FromRgb(0xEF, 0x44, 0x44);

            var redText = new SolidColorBrush(Color.FromRgb(0xF8, 0x71, 0x71));

            var grayBrush = new SolidColorBrush(Color.FromRgb(0x94, 0xA3, 0xB8));

            var darkBadgeBg = new SolidColorBrush(Color.FromRgb(0x1F, 0x29, 0x37));

            var grayBadgeFg = new SolidColorBrush(Color.FromRgb(0x9C, 0xA3, 0xAF));



            // COM Port Indicators

            if (res.HasCom)

            {

                if (LedUnisocCom != null) LedUnisocCom.Fill = greenBrush;

                if (GlowUnisocCom != null) GlowUnisocCom.Color = greenGlow;

                if (TxtUnisocComBox != null)

                {

                    TxtUnisocComBox.Text = $"{res.ComPort} ({res.ComDesc})";

                    TxtUnisocComBox.Foreground = greenBrush;

                }

                if (BadgeUnisocCom != null) BadgeUnisocCom.Background = greenBadgeBg;

                if (TxtUnisocComState != null)

                {

                    TxtUnisocComState.Text = "ONLINE";

                    TxtUnisocComState.Foreground = greenBadgeFg;

                }

                // AutoHub Dual Box COM
                if (LedAutoHubCom != null) LedAutoHubCom.Fill = greenBrush;
                if (GlowAutoHubCom != null) GlowAutoHubCom.Color = greenGlow;
                if (TxtAutoHubComBox != null) { TxtAutoHubComBox.Text = $"{res.ComPort} ({res.ComDesc})"; TxtAutoHubComBox.Foreground = greenBrush; }
                if (BadgeAutoHubCom != null) BadgeAutoHubCom.Background = greenBadgeBg;
                if (TxtAutoHubComState != null) { TxtAutoHubComState.Text = "ONLINE"; TxtAutoHubComState.Foreground = greenBadgeFg; }

                // MTK Dual Box COM
                if (LedMtkCom != null) LedMtkCom.Fill = greenBrush;
                if (GlowMtkCom != null) GlowMtkCom.Color = greenGlow;
                if (TxtMtkComBox != null) { TxtMtkComBox.Text = $"{res.ComPort} ({res.ComDesc})"; TxtMtkComBox.Foreground = greenBrush; }
                if (BadgeMtkCom != null) BadgeMtkCom.Background = greenBadgeBg;
                if (TxtMtkComState != null) { TxtMtkComState.Text = "ONLINE"; TxtMtkComState.Foreground = greenBadgeFg; }

                // Fastboot Dual Box COM
                if (LedFastbootCom != null) LedFastbootCom.Fill = greenBrush;
                if (GlowFastbootCom != null) GlowFastbootCom.Color = greenGlow;
                if (TxtFastbootComBox != null) { TxtFastbootComBox.Text = $"{res.ComPort} ({res.ComDesc})"; TxtFastbootComBox.Foreground = greenBrush; }
                if (BadgeFastbootCom != null) BadgeFastbootCom.Background = greenBadgeBg;
                if (TxtFastbootComState != null) { TxtFastbootComState.Text = "ONLINE"; TxtFastbootComState.Foreground = greenBadgeFg; }

                // Samsung Dual Box COM
                if (LedSamsungCom != null) LedSamsungCom.Fill = greenBrush;
                if (GlowSamsungCom != null) GlowSamsungCom.Color = greenGlow;
                if (TxtSamsungComBox != null) { TxtSamsungComBox.Text = $"{res.ComPort} ({res.ComDesc})"; TxtSamsungComBox.Foreground = greenBrush; }
                if (BadgeSamsungCom != null) BadgeSamsungCom.Background = greenBadgeBg;
                if (TxtSamsungComState != null) { TxtSamsungComState.Text = "ONLINE"; TxtSamsungComState.Foreground = greenBadgeFg; }

                // Huawei Dual Box COM
                if (LedHuaweiCom != null) LedHuaweiCom.Fill = greenBrush;
                if (GlowHuaweiCom != null) GlowHuaweiCom.Color = greenGlow;
                if (TxtHuaweiComBox != null) { TxtHuaweiComBox.Text = $"{res.ComPort} ({res.ComDesc})"; TxtHuaweiComBox.Foreground = greenBrush; }
                if (BadgeHuaweiCom != null) BadgeHuaweiCom.Background = greenBadgeBg;
                if (TxtHuaweiComState != null) { TxtHuaweiComState.Text = "ONLINE"; TxtHuaweiComState.Foreground = greenBadgeFg; }



                if (LedUnisocModeCom != null) LedUnisocModeCom.Fill = greenBrush;

                if (GlowUnisocModeCom != null) GlowUnisocModeCom.Color = greenGlow;

                if (TxtUnisocModeCom != null)

                {

                    TxtUnisocModeCom.Text = res.ComPort;

