        private void OnModelSelectionChanged(object sender, SelectionChangedEventArgs e)

        {

            if (CmbBrandSelector?.SelectedItem == null || CmbModelSelector?.SelectedItem == null) return;

            string brand = CmbBrandSelector.SelectedItem.ToString() ?? "";

            string modelName = CmbModelSelector.SelectedItem.ToString() ?? "";



            if (_smartModels.TryGetValue(brand, out var models) && models.TryGetValue(modelName, out var info))

            {

                bool isMtk = info.Platform.Equals("mtk", StringComparison.OrdinalIgnoreCase);

                bool isQc = info.Platform.Equals("qualcomm", StringComparison.OrdinalIgnoreCase);

                bool isHuawei = info.Platform.Equals("kirin", StringComparison.OrdinalIgnoreCase) || info.Platform.Equals("huawei", StringComparison.OrdinalIgnoreCase);

                bool isUnisoc = info.Platform.Equals("unisoc", StringComparison.OrdinalIgnoreCase);

                bool isPixel = info.Platform.Equals("google", StringComparison.OrdinalIgnoreCase) || info.Platform.Equals("pixel", StringComparison.OrdinalIgnoreCase);

                if (isMtk)
                {
                    SetBypassToggles(true, true);
                }
                else if (isQc)
                {
                    SetBypassToggles(false, false);
                }



                // Auto-switch platform mode to match hardware architecture

                if (isMtk && CmbPlatform != null && CmbPlatform.SelectedIndex != 0)
                {
                    CmbPlatform.SelectedIndex = 0;
                }

                if (isMtk)
                {
                    SetBypassToggles(true, true);
                    AppendLog($"[+] Auto-Configured Exploit Engine: MediaTek SLA/DAA Auth Bypass & Preloader Exploit ARMED for {brand} -> {modelName}.");
                }
                else if (isQc && CmbPlatform != null && CmbPlatform.SelectedIndex != 1)
                {
                    CmbPlatform.SelectedIndex = 1;
                    SetBypassToggles(false, false);
                }

                else if (isHuawei)

                {

                    // Switch to Huawei Kirin Workspace

                    SetActiveNavTab(TabBtnHuawei);

                    HideAllViews();

                    ViewHuawei.Visibility = Visibility.Visible;

                    AppendHuaweiLog($"[*] Switched to HUAWEI (KIRIN) Workspace for {brand} -> {modelName}");



                    // Auto-select corresponding Kirin Chipset in CmbHuaweiChipset

                    if (CmbHuaweiChipset != null)

                    {

                        for (int i = 0; i < CmbHuaweiChipset.Items.Count; i++)

                        {

                            if (CmbHuaweiChipset.Items[i] is ComboBoxItem cItem)

                            {

                                string cText = cItem.Content?.ToString() ?? "";

                                if (info.Chipset.Contains("710", StringComparison.OrdinalIgnoreCase) && cText.Contains("710"))

                                {

                                    CmbHuaweiChipset.SelectedIndex = i;

                                    break;

                                }

                                else if (info.Chipset.Contains("65", StringComparison.OrdinalIgnoreCase) && cText.Contains("65"))

                                {

                                    CmbHuaweiChipset.SelectedIndex = i;

                                    break;

                                }

                                else if (info.Chipset.Contains("810", StringComparison.OrdinalIgnoreCase) && cText.Contains("810"))

                                {

                                    CmbHuaweiChipset.SelectedIndex = i;

                                    break;

                                }

                                else if (info.Chipset.Contains("820", StringComparison.OrdinalIgnoreCase) && cText.Contains("820"))

                                {

                                    CmbHuaweiChipset.SelectedIndex = i;

                                    break;

                                }

                                else if (info.Chipset.Contains("970", StringComparison.OrdinalIgnoreCase) && cText.Contains("970"))

                                {

                                    CmbHuaweiChipset.SelectedIndex = i;

                                    break;

                                }

                                else if (info.Chipset.Contains("980", StringComparison.OrdinalIgnoreCase) && cText.Contains("980"))

                                {

                                    CmbHuaweiChipset.SelectedIndex = i;

                                    break;

                                }

                                else if (info.Chipset.Contains("990", StringComparison.OrdinalIgnoreCase) && cText.Contains("990"))

                                {

                                    CmbHuaweiChipset.SelectedIndex = i;

                                    break;

                                }

                            }

                        }

                    }



                    if (!string.IsNullOrEmpty(info.LoaderFile) && TxtHuaweiXloaderPath != null)

                    {

                        TxtHuaweiXloaderPath.Text = info.LoaderFile;

                    }

                }

                else if (isPixel)

                {

                    // Switch to Fastboot & ADB Workspace for Google Pixel

                    SetActiveNavTab(TabBtnFastboot);

                    HideAllViews();

                    ViewFastboot.Visibility = Visibility.Visible;

                    AppendAdbLog($"[*] Switched to FASTBOOT & ADB Workspace for {brand} -> {modelName}");

                    AppendAdbLog($"[+] Architecture: {info.Chipset} | Mode: Fastboot / FastbootD / Rescue");

                }

                else if (isUnisoc)

                {

                    // Switch to Unisoc (SPD) Workspace

                    SetActiveNavTab(TabBtnUnisoc);

                    HideAllViews();

                    ViewUnisoc.Visibility = Visibility.Visible;

                    AppendUnisocLog($"[*] Switched to UNISOC (SPD) Workspace for {brand} -> {modelName}");

                }



                // Auto-populate verified loader

                if (!string.IsNullOrEmpty(info.LoaderFile) && TxtDaPath != null && !isHuawei && !isPixel)

                {

                    TxtDaPath.Text = info.LoaderFile;

                }



                string platTitle = isMtk ? "MediaTek" : 

                                  (isQc ? "Qualcomm Snapdragon" : 

                                  (isHuawei ? "HiSilicon Kirin" : 

                                  (isUnisoc ? "UNISOC / SPD" : 

                                  (isPixel ? "Google Tensor / Android" : info.Platform))));

                TxtSelectedModelInfo.Text = $"SOC: {info.Chipset} | Platform: {platTitle} ({info.CpuFamily})";

                TxtSelectedTestpoint.Text = $"Testpoint: {info.Testpoint} ({info.EdlVoltage})";



                AppendLog($"[+] ════════════ SMART MODEL SELECTED ════════════");

                AppendLog($"[+] Brand / Model : {brand} -> {modelName}");

                AppendLog($"[+] Hardware SoC  : {info.Chipset}");

                AppendLog($"[+] Auto-Loader   : {info.LoaderFile}");

                AppendLog($"[+] Testpoint Pin : {info.Testpoint}");

                AppendLog($"[+] ══════════════════════════════════════════════");

            }

        }



        private async void OnAutoDetectClicked(object sender, RoutedEventArgs e)
        {
            AppendLog("[*] Hardware Sniffer: Scanning active physical USB buses and serial communication ports...");

            var probe = await Task.Run(() => PerformQuickHardwareProbe(true));

            if (probe.HasCom)
            {
                TxtPort.Text = probe.ComPort;
                if (TxtDiagPort != null) TxtDiagPort.Text = probe.ComPort;

                string descUpper = probe.ComDesc.ToUpperInvariant();
                if (descUpper.Contains("MEDIATEK") || descUpper.Contains("MTK") || descUpper.Contains("PRELOADER") || descUpper.Contains("DA USB"))
                {
                    AppendLog($"[+] Live Hardware Verified: MediaTek Preloader/BROM Port ({probe.ComPort})");
                    AppendLog($"[+] Platform Device: {probe.ComDesc}");
                    if (IsQualcommMode && CmbPlatform != null) CmbPlatform.SelectedIndex = 0;
                }
                else if (descUpper.Contains("9008") || descUpper.Contains("QDLOADER") || descUpper.Contains("QUALCOMM"))
                {
                    AppendLog($"[+] Live Hardware Verified: Qualcomm HS-USB QDLoader 9008 ({probe.ComPort})");
                    AppendLog($"[+] Platform Device: {probe.ComDesc}");
                    if (!IsQualcommMode && CmbPlatform != null) CmbPlatform.SelectedIndex = 1;
                }
                else if (descUpper.Contains("SPRD") || descUpper.Contains("UNISOC") || descUpper.Contains("U2S") || descUpper.Contains("DIAG"))
                {
                    AppendLog($"[+] Live Hardware Verified: UNISOC / Spreadtrum Active Port ({probe.ComPort})");
                    AppendLog($"[+] Platform Device: {probe.ComDesc}");
                }
                else if (descUpper.Contains("HUAWEI") || descUpper.Contains("KIRIN") || descUpper.Contains("1.0"))
                {
                    AppendLog($"[+] Live Hardware Verified: Huawei USB COM 1.0 Port ({probe.ComPort})");
                    AppendLog($"[+] Platform Device: {probe.ComDesc}");
                }
                else
                {
                    AppendLog($"[+] Active Serial Port Detected: {probe.ComPort} ({probe.ComDesc})");
                }
            }
            else if (probe.HasUsb)
            {
                AppendLog($"[+] Live USB Interface Detected: {probe.UsbName} [{probe.UsbMode}]");
                if (probe.UsbMode == "ADB ACTIVE")
                {
                    AppendLog("[*] Querying Live ADB Device Descriptors...");
                    try
                    {
                        string model = (await ExecuteCliAsync("adb.exe", "shell getprop ro.product.model")).Trim();
                        string brand = (await ExecuteCliAsync("adb.exe", "shell getprop ro.product.brand")).Trim();
                        string soc = (await ExecuteCliAsync("adb.exe", "shell getprop ro.board.platform")).Trim();
                        string android = (await ExecuteCliAsync("adb.exe", "shell getprop ro.build.version.release")).Trim();
                        AppendLog($"[+] Device Brand : {brand.ToUpper()}");
                        AppendLog($"[+] Device Model : {model}");
                        AppendLog($"[+] Platform SoC : {soc}");
                        AppendLog($"[+] Android Ver  : {android}");
                    }
                    catch { }
                }
                else if (probe.UsbMode == "FASTBOOT")
                {
                    AppendLog("[*] Querying Live Fastboot Device Descriptors...");
                    try
                    {
                        string prod = await ExecuteCliAsync("fastboot.exe", "getvar product");
                        string unlock = await ExecuteCliAsync("fastboot.exe", "getvar unlocked");
                        AppendLog($"[+] Fastboot Product : {prod.Trim()}");
                        AppendLog($"[+] Bootloader State : {unlock.Trim()}");
                    }
                    catch { }
                }
            }
            else
            {
                TxtPort.Text = "NO DEVICE";
                AppendLog("[-] Hardware Sniffer: No active device detected on USB/COM bus.");
                AppendLog("[!] Tip: Connect device with USB cable (Hold Vol- for BROM/Diag, or power off for MTK/EDL).");
            }
        }



