<Window x:Class="BSLabTool.UI.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ — Technician Authentication &amp; HWID Device Activation"
        Width="520" Height="720" MinWidth="460" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Glassmorphism & High-Tech Neon Brushes -->
        <LinearGradientBrush x:Key="BorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#818CF8" Offset="0.5"/>
            <GradientStop Color="#06B6D4" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BtnPrimaryGlow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0.0"/>
            <GradientStop Color="#0369A1" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Window Border with Glow -->
    <Border CornerRadius="16" BorderThickness="1.5" BorderBrush="{StaticResource BorderGlow}" Background="#0B132B" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#0284C7" Opacity="0.4" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="46"/>
                <!-- Main Responsive Scrollable Body -->
                <RowDefinition Height="*"/>
                <!-- Footer / Status Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Custom High-Tech Title Bar -->
            <Border Grid.Row="0" Background="#111C35" CornerRadius="15,15,0,0" BorderThickness="0,0,0,1" BorderBrush="#1E293B" MouseDown="OnTitleBarMouseDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="#0284C7" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BS LAB TOOL™" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="v2.5 PRO ENTERPRISE • AUTH SUITE" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Title Controls (Settings, Minimize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Supabase Config Toggle -->
                        <Button x:Name="BtnToggleConfig" Click="OnToggleConfigClicked" Width="30" Height="28" Background="#1E293B" BorderBrush="#334155" Foreground="#94A3B8" Margin="0,0,6,0" Cursor="Hand" ToolTip="Supabase Cloud Configuration">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Minimize Button -->
                        <Button Click="OnMinimizeClicked" Width="30" Height="28" Background="#1E293B" BorderBrush="#334155" Foreground="#94A3B8" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="─" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button Click="OnCloseClicked" Width="30" Height="28" Background="#3F1B22" BorderBrush="#E11D48" Foreground="#FDA4AF" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Scrollable Responsive Form Card -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,16">
                <StackPanel MaxWidth="440" HorizontalAlignment="Stretch">

                    <!-- Supabase Config Expandable Panel -->
                    <Border x:Name="PanelSupabaseConfig" Visibility="Collapsed" Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚡" FontSize="14" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                <TextBlock Text="Supabase Cloud Connection Settings" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>

                            <TextBlock Text="Supabase Project URL:" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtConfigUrl" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Supabase Anon Public API Key:" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtConfigAnonKey" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Offline Lease Grace Window (Days):" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtConfigDays" Style="{StaticResource ModernTextBox}" Height="34" Text="7" Margin="0,0,0,10"/>

                            <Button Click="OnSaveConfigClicked" Content="💾 Save Supabase Settings" Height="34" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" VerticalAlignment="Stretch">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Hardware ID (HWID) Binding Card (Prominent & Always Visible) -->
                    <Border Background="#131F37" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔒" FontSize="12" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                <TextBlock Text="BOUND HARDWARE IDENTIFIER (HWID)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtHwidDisplay" Grid.Row="1" Grid.Column="0" Text="BSLAB-XXXX-XXXX-XXXX" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F8FAFC" VerticalAlignment="Center"/>

                            <Button Grid.Row="1" Grid.Column="1" Click="OnCopyHwidClicked" Padding="10,4" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="TxtBtnCopy" Text="📋 Copy HWID" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Account security binds to this machine's CPU &amp; Motherboard. Tamper-safe." FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Offline Mode Status Banner (Shows if local 7-day lease exists) -->
                    <Border x:Name="BorderOfflineBanner" Visibility="Collapsed" Background="#142B28" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#10B981" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtOfflineHeader" Text="7-Day Offline License Active" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOfflineRemaining" Text="6 Days, 21 Hours Remaining before required check-in." FontSize="9.5" Foreground="#A7F3D0" Margin="14,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Click="OnContinueOfflineClicked" Content="⚡ Run Offline" Padding="10,6" Background="#065F46" BorderBrush="#10B981" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tab Switcher: [ Sign In ] | [ Register Account ] -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnTabSignIn" Grid.Column="0" Click="OnTabSignInClicked" Height="36" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBorder" Background="#0284C7" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🔑" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Sign In" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnTabRegister" Grid.Column="1" Click="OnTabRegisterClicked" Height="36" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBorder" Background="Transparent" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📝" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Register Account" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Input Fields Container -->
                    <StackPanel>

                        <!-- Username Field (Visible on Register) -->
                        <StackPanel x:Name="PanelUsername" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Technician Username:" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtUsername" Style="{StaticResource ModernTextBox}" Height="38"/>
                        </StackPanel>

                        <!-- Email Field -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email Address:" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBox}" Height="38"/>
                        </StackPanel>

                        <!-- Password Field -->
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Password:" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="BtnForgotPassword" Text="Forgot Password?" HorizontalAlignment="Right" FontSize="10.5" Foreground="#38BDF8" Cursor="Hand" MouseDown="OnForgotPasswordClicked"/>
                            </Grid>
                            <Grid>
                                <PasswordBox x:Name="PbPassword" Style="{StaticResource ModernPasswordBox}" Height="38" PasswordChanged="OnPasswordChanged"/>
                                <TextBox x:Name="TxtPasswordPlain" Style="{StaticResource ModernTextBox}" Height="38" Visibility="Collapsed" TextChanged="OnPlainPasswordChanged"/>
                                <Button Click="OnTogglePasswordVisibility" HorizontalAlignment="Right" Width="36" Height="36" Background="Transparent" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand">
                                    <TextBlock x:Name="TxtEyeIcon" Text="👁" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Confirm Password Field (Visible on Register) -->
                        <StackPanel x:Name="PanelConfirmPassword" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Confirm Password:" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PbConfirmPassword" Style="{StaticResource ModernPasswordBox}" Height="38"/>
                        </StackPanel>

                        <!-- Options: Remember Me (DPAPI Encrypted) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                            <CheckBox x:Name="ChkRememberMe" IsChecked="True" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Save credentials securely on this workstation (DPAPI Encrypted)"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <!-- Submit Button -->
                        <Button x:Name="BtnSubmit" Click="OnSubmitClicked" Height="44" Cursor="Hand" Background="{StaticResource BtnPrimaryGlow}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1" BorderBrush="#38BDF8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#0284C7" Opacity="0.5" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSubmitIcon" Text="🚀" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtSubmitLabel" Text="Sign In to BS Lab Tool" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>

                    <!-- Status Notification Banner -->
                    <Border x:Name="BorderStatusBanner" Visibility="Collapsed" CornerRadius="8" Padding="12,8" Margin="0,16,0,0" Background="#1E293B" BorderThickness="1" BorderBrush="#334155">
                        <TextBlock x:Name="TxtStatusMessage" Text="Status Message" FontSize="11" TextWrapping="Wrap" Foreground="#38BDF8"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. Bottom Information Bar -->
            <Border Grid.Row="2" Background="#070D1E" CornerRadius="0,0,15,15" BorderThickness="0,1,0,0" BorderBrush="#1E293B" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔒 256-bit DPAPI Vault &amp; Supabase Auth" FontSize="9.5" Foreground="#64748B"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅 7-Day Offline Lease Engine" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
