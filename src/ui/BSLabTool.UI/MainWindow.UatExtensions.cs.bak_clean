        #region 27-Brand Color Ribbon Routing

        private void OnUatBrandRibbonClick(object sender, RoutedEventArgs e)
        {
            if (sender is Button btn && btn.Tag is string brandName)
            {
                // Auto-route brand selection to main dropdown
                if (FindName("CmbUatBrand") is ComboBox cmbBrand)
                {
                    foreach (var item in cmbBrand.Items)
                    {
                        if (item.ToString()?.IndexOf(brandName, StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            cmbBrand.SelectedItem = item;
                            break;
                        }
                    }
                }

                // Update active device badge
                if (FindName("TxtUatBrandBadge") is TextBlock txtBadge)
                {
                    txtBadge.Text = brandName.ToLower();
                }
            }
        }

