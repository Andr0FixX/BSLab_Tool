                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtUnisocModelBadge" DockPanel.Dock="Right" Text="T7250 / T606 / SC9863A" FontSize="7.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="4,0,0,0"/>
