                                        <DockPanel>
                                            <TextBlock Text="🔬 QUALCOMM DIAGNOSTIC (DIAG 900E/901D) ENGINE" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            <Border Background="#064E3B" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                <TextBlock Text="● DIAG: ACTIVE" FontSize="7.5" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <!-- Diag Port & Activation -->
                                    <Border Background="#1A1A24" CornerRadius="5" Padding="6,4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="TARGET QUALCOMM DIAG PORT:" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,2"/>
