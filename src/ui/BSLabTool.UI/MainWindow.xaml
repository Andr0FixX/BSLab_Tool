                            <Button Content="⚡ Dump Selected Region" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" Height="28" Padding="10,2" BorderThickness="0" Margin="0,0,6,0" Click="OnUatDumpSelectedClicked"/>
                            <Button Content="🗄️ WRITE DUMP" Background="#F57F17" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="10" Height="28" Padding="12,2" BorderThickness="0" Margin="0,0,6,0" Click="OnUatWriteDumpClicked"/>
