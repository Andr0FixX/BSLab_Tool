                        <Button Content="Infinix" Tag="infinix" Height="19" Margin="0,1" Background="#52B52A" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="1+ ONEPLUS" Tag="oneplus" Height="19" Margin="0,1" Background="#EB0028" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="SAMSUNG" Tag="samsung" Height="19" Margin="0,1" Background="#1428A0" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="HUAWEI" Tag="huawei" Height="19" Margin="0,1" Background="#CF0A2C" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
