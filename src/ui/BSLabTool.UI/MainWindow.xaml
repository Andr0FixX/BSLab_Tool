                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📑 PARTITION MANAGER" FontSize="9.5" FontWeight="Bold" Foreground="#2DD4BF" VerticalAlignment="Center"/>
