                                        <Ellipse x:Name="LedMtkUsb" Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowMtkUsb" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Border x:Name="BadgeMtkUsb" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtMtkUsbState" Text="OFFLINE" FontSize="7.5" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="⚡ USB DEVICE" FontSize="7.5" FontWeight="Bold" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtMtkUsbBox" Text="WAITING FOR USB..." FontSize="9" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- ACTION BUTTONS: SCAN, ABORT & CLEAR -->
