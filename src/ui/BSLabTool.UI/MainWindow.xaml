                        <!-- Loader File Picker -->
                        <Border Background="#1A232A" BorderBrush="#37474F" BorderThickness="1" CornerRadius="2" Height="24" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="📁" Width="24" Background="#37474F" Foreground="#FFFFFF" BorderThickness="0" Click="OnBrowseUatLoaderClicked" ToolTip="Browse Qualcomm Firehose Loader (.mbn, .elf)"/>
