                                                    <TextBlock Text="📑 PARTITIONS:" FontSize="9.5" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                                                    <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
