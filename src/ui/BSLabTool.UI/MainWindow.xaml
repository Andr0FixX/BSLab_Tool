                                                <TextBox x:Name="TxtDiagPort" Text="" Background="#0F0F14" Foreground="#FFFFFF" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,1" Width="170" DockPanel.Dock="Left"/>
                                                <Button Content="Auto Detect" Background="#D97706" Foreground="#FFFFFF" BorderThickness="0" Height="22" FontSize="9" Margin="5,0,0,0" Click="OnAutoDetectClicked"/>
                                            </DockPanel>
