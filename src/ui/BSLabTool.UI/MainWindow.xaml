                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="IMEI 1 (Physical SIM):" FontSize="8" Foreground="#CBD5E1" Margin="2,0,0,1"/>
                                                    <TextBox x:Name="TxtDiagImei1" Text="" Height="22" Background="#0F0F14" Foreground="#34D399" BorderBrush="#2E2E40" FontSize="10" FontWeight="Bold" Padding="4,1"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="IMEI 2 (Dual / eSIM):" FontSize="8" Foreground="#CBD5E1" Margin="2,0,0,1"/>
