                <Border Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="3" Padding="8,1" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtUatJobCount" Text="COUNT : 464" FontSize="9.5" FontWeight="ExtraBold" Foreground="#4DD0E1" FontFamily="Consolas"/>
                </Border>
                <TextBlock Text="BS LAB TOOL™ © 2026" FontSize="9" Foreground="#90A4AE" VerticalAlignment="Center" Margin="0,0,10,0"/>

