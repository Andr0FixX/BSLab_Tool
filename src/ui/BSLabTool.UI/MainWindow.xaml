                        <Button Content="android" Tag="android" Height="19" Margin="0,1" Background="#3DDC84" Foreground="#000000" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid> <!-- Closes Row 2 (3-Column Workspace) -->

    <!-- ==================================================================== -->
    <!-- ROW 3: UAT PRO TELEMETRY BOTTOM STATUS BAR                          -->
    <!-- ==================================================================== -->
    <Border Grid.Row="3" Background="{DynamicResource StatusBarBackground}" BorderBrush="{DynamicResource StatusBarBorder}" BorderThickness="0,1,0,0">
        <DockPanel Margin="10,0">
            <!-- Customer Job Count & Hardware Status -->
