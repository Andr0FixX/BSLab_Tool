                                <TextBlock x:Name="TxtUnisocModeUsb"/>
                            </Grid>
                        </Border>

                        <!-- Sub-Tabs: [ BROM ] [ PAC FLASH ] [ DIAG REPAIR ] [ FASTBOOT ] -->
                        <Border Grid.Row="2" Background="#1A1A24" CornerRadius="3" Padding="2" Margin="0,0,0,5">
                            <UniformGrid Columns="4">
                                <Button x:Name="BtnUnisocSubTabBrom" Content="BROM" Style="{StaticResource SubTabButtonActive}" Click="OnUnisocSubTabBromClicked" Margin="1,0"/>
