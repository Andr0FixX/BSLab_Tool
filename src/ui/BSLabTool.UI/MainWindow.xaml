                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="MEID / PESN (Optional):" FontSize="8" Foreground="#CBD5E1" Margin="2,0,0,1"/>
                                            <TextBox x:Name="TxtDiagMeid" Text="" Height="20" Background="#0F0F14" Foreground="#38BDF8" BorderBrush="#2E2E40" FontSize="9.5" Padding="4,1" Margin="0,0,0,3"/>
                                            <UniformGrid Columns="2" Margin="0,0,0,2">
                                                <Button Content="Write Diag IMEI (NV)" Style="{StaticResource CyberBulletButton}" Margin="0,1,2,1" Click="OnDiagWriteImeiClicked"/>
                                                <Button Content="Read Diag IMEI" Style="{StaticResource CyberBulletButton}" Margin="2,1,0,1" Click="OnDiagReadImeiClicked"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- QCN Patch IMEI, Network Calibration & EFS Reset -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,4" Margin="0,0,0,4" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="💾 QCN PATCH IMEI &amp; EFS NETWORK REPAIR:" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8" Margin="2,0,0,3"/>
                                            <DockPanel Margin="0,0,0,4">
                                                <Button Content="📂 Load QCN" Width="74" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="8.5" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnDiagLoadQcnClicked" ToolTip="Load Qualcomm .qcn or .xqcn calibration file"/>
                                                <TextBox x:Name="TxtDiagQcnPath" Text="" Background="#0F0F14" Foreground="#38BDF8" BorderBrush="#2E2E40" Height="22" FontSize="8.5" Padding="4,1" VerticalContentAlignment="Center" ToolTip="Loaded .qcn / .xqcn file path for IMEI patching"/>
                                            </DockPanel>
                                            <Button Content="⚡ Patch IMEI in QCN &amp; Write (Diag Method)" Style="{StaticResource CyberBulletButton}" Foreground="#00FFA3" FontWeight="Bold" Margin="0,1" Click="OnDiagWriteImeiQcnMethodClicked"/>
                                            <UniformGrid Columns="2" Margin="0,1">
                                                <Button Content="Read QCN Backup" Style="{StaticResource CyberBulletButton}" Margin="0,1,2,1" Click="OnDiagBackupQcnClicked"/>
                                                <Button Content="Write QCN Only" Style="{StaticResource CyberBulletButton}" Margin="2,1,0,1" Click="OnDiagRestoreQcnClicked"/>
                                            </UniformGrid>
                                            <Button Content="Wipe &amp; Reset Corrupted EFS (Modemst1/2)" Style="{StaticResource CyberBulletButton}" Margin="0,1" Click="OnDiagResetEfsClicked"/>
                                            <UniformGrid Columns="2" Margin="0,1,0,0">
                                                <Button Content="Diag Reboot OS" Style="{StaticResource CyberBulletButton}" Margin="0,1,2,1" Click="OnDiagRebootClicked"/>
                                                <Button Content="Exit Diag &amp; Radio" Style="{StaticResource CyberBulletButton}" Margin="2,1,0,1" Click="OnDiagExitAndRestoreRadioClicked"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Universal Progress HUD (Shared Across All Sub-Engines) -->
                                <Border Background="#1A1A24" CornerRadius="5" Padding="8" Margin="0,2,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock x:Name="TxtProgressStatus" Text="Ready for operation" FontSize="10" Foreground="#CBD5E1" DockPanel.Dock="Left"/>
                                            <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="10" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="ProgressBar" Height="6" Background="#27272A" Foreground="#00D2FF" Value="0" Maximum="100"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- RIGHT COLUMN: 100% PURE & UPGRADED PARTITION MANAGER + LIVE LOGS -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Dual Live Hardware Notification Radar Dock -->
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="240"/>  <!-- Row 2: Partition Manager -->
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>    <!-- Row 4: Live Log Console -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: DUAL LIVE HARDWARE NOTIFICATION RADAR DOCK (COM PORT & USB DEVICE) -->
                        <Border Grid.Row="0" Background="#0C101C" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>   <!-- Box 1: COM Port Box -->
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="1.2*"/> <!-- Box 2: USB Interface Box -->
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- BOX 1: CONNECTED COM PORT WITH LIVE LED LIGHT -->
                                <Border Grid.Column="0" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                    <DockPanel>
                                        <Ellipse x:Name="LedMtkCom" Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowMtkCom" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Border x:Name="BadgeMtkCom" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtMtkComState" Text="OFFLINE" FontSize="7.5" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🔌 COM PORT" FontSize="7.5" FontWeight="Bold" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtMtkComBox" Text="NO COM PORT" FontSize="9" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- BOX 2: CONNECTED USB INTERFACE WITH LIVE LED LIGHT -->
                                <Border Grid.Column="2" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="6,4">
