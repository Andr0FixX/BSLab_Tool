                                            <CheckBox x:Name="ChkPacEraseUserdata" Content="Erase Userdata" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10" IsChecked="True" Margin="0,2"/>
                                            <CheckBox x:Name="ChkPacBackupNv" Content="Backup NVRAM" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10" IsChecked="True" Margin="0,2"/>
                                            <CheckBox x:Name="ChkPacKeepCalib" Content="Keep Calibration" Foreground="#34D399" FontWeight="SemiBold" FontSize="10" IsChecked="True" Margin="0,2"/>
                                            <CheckBox x:Name="ChkPacRepart" Content="Re-Partition" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Margin="0,2"/>
