                                                <Button Content="USERDATA" Height="19" Padding="6,0" FontSize="8" FontWeight="Bold" Background="#1E293B" Foreground="#F87171" BorderThickness="0" Margin="0,0,4,2" Click="OnMetaPresetUserdataClicked"/>
                                                <Button Content="MISC" Height="19" Padding="6,0" FontSize="8" FontWeight="Bold" Background="#1E293B" Foreground="#FBBF24" BorderThickness="0" Margin="0,0,4,2" Click="OnMetaPresetMiscClicked"/>
                                                <Button Content="PARA" Height="19" Padding="6,0" FontSize="8" FontWeight="Bold" Background="#1E293B" Foreground="#A78BFA" BorderThickness="0" Margin="0,0,4,2" Click="OnMetaPresetParaClicked"/>
                                                <Button Content="CACHE" Height="19" Padding="6,0" FontSize="8" FontWeight="Bold" Background="#1E293B" Foreground="#34D399" BorderThickness="0" Margin="0,0,4,2" Click="OnMetaPresetCacheClicked"/>
                                                <Button Content="MD_UDC" Height="19" Padding="6,0" FontSize="8" FontWeight="Bold" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Margin="0,0,4,2" Click="OnMetaPresetMdUdcClicked"/>
                                            </WrapPanel>
                                            <Button x:Name="BtnMetaFormatExecute" Content="⚡ EXECUTE FORMAT PARTITION" Height="26" Background="#DC2626" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="9.5" BorderThickness="0" Click="OnMetaFormatPartExecuteClicked"/>
