                                <Border Background="#0F172A" CornerRadius="3" Padding="6,3">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtUnisocModelInfo" Text="Select Brand &amp; Model (Auto-routes FDL1, FDL2)" FontSize="8" Foreground="#F59E0B" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtUnisocTpInfo" Text="Boot Key: Hold [Vol-] &amp; Connect USB Cable" FontSize="7.5" Foreground="#94A3B8" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 1.5: Hidden Mode Live Indicators (Radar Dock is on Right) -->
                        <Border Grid.Row="1" Visibility="Collapsed">
                            <Grid>
                                <Ellipse x:Name="LedUnisocModeCom"><Ellipse.Effect><DropShadowEffect x:Name="GlowUnisocModeCom"/></Ellipse.Effect></Ellipse>
                                <TextBlock x:Name="TxtUnisocModeCom"/>
