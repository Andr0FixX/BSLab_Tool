                                <Button x:Name="BtnUnisocSubTabDiag" Content="DIAG REPAIR" Style="{StaticResource SubTabButtonInactive}" Click="OnUnisocSubTabDiagClicked" Margin="1,0"/>
                                <Button x:Name="BtnUnisocSubTabFastboot" Content="FASTBOOT" Style="{StaticResource SubTabButtonInactive}" Click="OnUnisocSubTabFastbootClicked" Margin="1,0"/>
                            </UniformGrid>
                        </Border>

                        <!-- Panel Container (No Scrollbar Needed) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- PANEL 1: BROM SERVICE (FDL1 / FDL2 ENGINE) -->
                                <StackPanel x:Name="PanelUnisocBrom" Visibility="Visible">
                                    <TextBlock Text="⚡ UNISOC BROM / FDL BOOTROM SERVICE:" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8" Margin="2,0,0,4"/>

                                    <!-- FDL 1 & FDL 2 LOADER BOXES -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="5,4" Margin="0,0,0,5">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock Text="FDL 1:" Width="38" Foreground="#38BDF8" FontWeight="Bold" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="Browse" Width="46" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="20" FontSize="8.5" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowseUnisocBromFdl1Clicked"/>
                                                <TextBox x:Name="TxtUnisocBromFdl1" Text="resources/loaders/spd/fdl1.bin (Auto)" Background="#0F0F14" Foreground="#94A3B8" BorderBrush="#2E2E40" Height="20" FontSize="8.5" Padding="4,1"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="FDL 2:" Width="38" Foreground="#34D399" FontWeight="Bold" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="Browse" Width="46" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="20" FontSize="8.5" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowseUnisocBromFdl2Clicked"/>
                                                <TextBox x:Name="TxtUnisocBromFdl2" Text="resources/loaders/spd/fdl2.bin (Auto)" Background="#0F0F14" Foreground="#94A3B8" BorderBrush="#2E2E40" Height="20" FontSize="8.5" Padding="4,1"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,0,0,2">
                                        <Button Content="Sync &amp; Load FDL1/2" Style="{StaticResource CyberBulletButton}" Margin="0,1,2,1" Click="OnUnisocBromHandshakeClicked"/>
                                        <Button Content="📖 Read Device Info" Style="{StaticResource CyberBulletButton}" Foreground="#38BDF8" Margin="2,1,0,1" Click="OnUnisocBromReadInfoClicked"/>
                                        <Button Content="Enter DIAG Mode" Style="{StaticResource CyberBulletButton}" Margin="0,1,2,1" Click="OnUnisocBromEnterDiagClicked"/>
                                        <Button Content="Reset FRP Lock" Style="{StaticResource CyberBulletButton}" Margin="2,1,0,1" Click="OnUnisocBromFrpClicked"/>
                                        <Button Content="Safe Factory Reset" Style="{StaticResource CyberBulletButton}" Margin="0,1,2,1" Click="OnUnisocBromFactoryResetClicked"/>
                                        <Button Content="Read Live GPT Table" Style="{StaticResource CyberBulletButton}" Margin="2,1,0,1" Click="OnUnisocBromReadGptClicked"/>
                                        <Button Content="Backup Security (NV)" Style="{StaticResource CyberBulletButton}" Margin="0,1,2,1" Click="OnUnisocBromBackupClicked"/>
                                        <Button Content="Erase Partition" Style="{StaticResource CyberBulletButton}" Margin="2,1,0,1" Click="OnUnisocBromErasePartitionClicked"/>
                                    </UniformGrid>
                                    <Button Content="🩺 eMMC / UFS Storage Health Doctor" Style="{StaticResource CyberBulletButton}" Foreground="#34D399" Margin="0,1,0,4" Click="OnUnisocEmmcHealthCheckClicked"/>

                                    <Border Height="1" Background="#232332" Margin="2,4,2,5"/>
                                    <TextBlock Text="SUPPORTED CHIPSET ARCHITECTURES:" FontSize="8" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,3"/>
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="5,3">
                                        <TextBlock Text="• Tiger: T606, T610, T612, T616, T700 | SC: SC9863A, SC7731E&#x0a;• Brands: Realme, Infinix, Tecno, itel, Nokia, Samsung A03" FontSize="8" Foreground="#64748B" LineHeight="12" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- PANEL 2: PAC STOCK FIRMWARE FLASHER & PARTITION STUDIO -->
                                <StackPanel x:Name="PanelUnisocPac" Visibility="Collapsed">
                                    <TextBlock Text="📦 UNISOC OFFICIAL PAC FLASHER &amp; PARTITION STUDIO:" FontSize="9" FontWeight="Bold" Foreground="#00D2FF" Margin="0,2,0,6"/>

                                    <!-- PAC File Browser -->
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="PAC FILE:" Width="55" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        <Button Content="Browse" Width="50" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowsePacClicked"/>
                                        <TextBox x:Name="TxtPacPath" Text="Select Firmware (*.pac)" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,2"/>
                                    </DockPanel>

                                    <!-- PAC Archive Info Pill -->
                                    <Border Background="#0C1427" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtPacInfoProduct" Text="📦 Standard Unisoc Tiger/SC Template Loaded" FontSize="8.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtPacInfoSize" Text="4.18 GB • 20 Partitions" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Custom FDL Loaders in Flash Tab -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="FDL 1:" Width="45" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Content="Browse" Width="50" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowsePacFdl1Clicked"/>
                                                <TextBox x:Name="TxtPacFdl1" Text="Auto-extract from PAC (or browse custom)" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,2"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="FDL 2:" Width="45" Foreground="#34D399" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Content="Browse" Width="50" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowsePacFdl2Clicked"/>
                                                <TextBox x:Name="TxtPacFdl2" Text="Auto-extract from PAC (or browse custom)" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,2"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 📑 PARTITION STUDIO & SELECTIVE FLASH GRID -->
