                        <Button Content="Lenovo" Tag="lenovo" Height="19" Margin="0,1" Background="#E2231A" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="NOKIA" Tag="nokia" Height="19" Margin="0,1" Background="#124191" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="TCL" Tag="tcl" Height="19" Margin="0,1" Background="#E50914" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
