                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                    <Button Content="✓ All" Width="34" Height="19" Background="#1E293B" Foreground="#38BDF8" FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="1,0" Click="OnPacSelectAllClicked" ToolTip="Select All Partitions for Full Flash"/>
                                                    <Button Content="✗ None" Width="38" Height="19" Background="#1E293B" Foreground="#94A3B8" FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="1,0" Click="OnPacDeselectAllClicked" ToolTip="Deselect All"/>
                                                    <Button Content="⚡ Core" Width="40" Height="19" Background="#1E293B" Foreground="#F59E0B" FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="1,0" Click="OnPacSelectCoreClicked" ToolTip="Boot + Recovery + VBMeta + Super"/>
                                                    <Button Content="🛡️ Unbrick" Width="52" Height="19" Background="#1E293B" Foreground="#10B981" FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="1,0" Click="OnPacSelectUnbrickClicked" ToolTip="FDL1 + FDL2 + SPL + Boot"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- DataGrid of Partitions -->
                                            <DataGrid x:Name="DgUnisocPacPartitions" Height="195" Background="#070709" RowBackground="#0B0F19" AlternatingRowBackground="#101726" BorderThickness="1" BorderBrush="#1E293B" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B" RowHeight="22" FontSize="9" Foreground="#F8FAFC" ColumnHeaderStyle="{StaticResource CyberColumnHeader}" CellStyle="{StaticResource CyberCell}">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="FLASH" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                                    <DataGridTextColumn Header="PARTITION" Binding="{Binding Name}" Width="95">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="IMAGE FILE" Binding="{Binding FileName}" Width="110">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="SIZE" Binding="{Binding FileSizeHuman}" Width="65">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Flashing Options -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
