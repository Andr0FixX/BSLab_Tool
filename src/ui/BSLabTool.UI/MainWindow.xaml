                        <Button Content="SONY" Tag="sony" Height="19" Margin="0,1" Background="#212121" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="PIXEL" Tag="pixel" Height="19" Margin="0,1" Background="#4285F4" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="IT ADMIN" Tag="itadmin" Height="19" Margin="0,1" Background="#00695C" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="Apple" Tag="apple" Height="19" Margin="0,1" Background="#546E7A" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="MEDIATEK" Tag="mediatek" Height="19" Margin="0,1" Background="#F57C00" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
