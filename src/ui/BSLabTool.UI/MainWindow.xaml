                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="IMEI 2:" Width="50" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtUnisocImei2" Text="867462056766433" Background="#0F0F14" Foreground="#FFFFFF" BorderBrush="#2E2E40" Height="24" FontSize="11" Padding="5,2"/>
