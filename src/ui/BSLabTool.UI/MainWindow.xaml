                                    </Border>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <RadioButton x:Name="RbUatProtocolNew" GroupName="UatProtocols" Content="Protocol - New (V6)" IsChecked="True" Foreground="#34D399" FontWeight="Bold" FontSize="8.8" Margin="0,0,10,0" Checked="OnUatProtocolNewChecked"/>
                                    <RadioButton x:Name="RbUatProtocolOld" GroupName="UatProtocols" Content="Protocol - Old (V5)" Foreground="#FBBF24" FontWeight="Bold" FontSize="8.8" Checked="OnUatProtocolOldChecked"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtUatProtocolDesc" Text="⚡ Helio G-Series / Dimensity / ARM64 (MTK_DA_V6.bin)" FontSize="7.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 27-BRAND VERTICAL COLOR RIBBON BAR -->
