                        <!-- Select Dump File Path -->
                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Dump File:" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="📁 Browse..." DockPanel.Dock="Right" Height="26" Width="70" Background="#24333E" Foreground="#FFA726" BorderBrush="#37474F" FontSize="9" FontWeight="Bold" Margin="4,0,0,0" Click="OnUatBrowseDumpFileClicked"/>
