                        <Button Content="MOTOROLA" Tag="motorola" Height="19" Margin="0,1" Background="#001489" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="LAVA" Tag="lava" Height="19" Margin="0,1" Background="#E52D27" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
