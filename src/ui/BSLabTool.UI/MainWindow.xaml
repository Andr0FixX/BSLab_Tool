                                                <TextBox x:Name="TxtMetaFormatPartName" Text="frp" Background="#0F0F14" Foreground="#FCA5A5" BorderBrush="#374151" Height="24" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" Padding="6,2" KeyDown="OnMetaFormatPartKeyDown"/>
