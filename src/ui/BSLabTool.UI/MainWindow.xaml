                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="🗑️ META DIRECT PARTITION FORMAT" FontSize="9.5" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center"/>
                                                <Border Background="#450A0A" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                                    <TextBlock Text="FAST LBA WIPE" FontSize="7.5" FontWeight="Bold" Foreground="#FCA5A5"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="Enter Partition Name (e.g. frp, userdata, misc, para, cache, nvram):" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,3"/>
