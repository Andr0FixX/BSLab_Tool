                                            <Button Content="Read Live Diag Info (Baseband &amp; Hardware)" Style="{StaticResource CyberBulletButton}" Margin="0,1" Click="OnDiagReadInfoClicked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Qualcomm IMEI & MEID Calibration -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,4" Margin="0,0,0,4" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📶 QUALCOMM NV ITEMS &amp; IMEI CALIBRATION:" FontSize="8.5" FontWeight="Bold" Foreground="#34D399" Margin="2,0,0,3"/>
