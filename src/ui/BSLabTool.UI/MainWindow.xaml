                                    <!-- Progress Bar -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6" Margin="0,2,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock x:Name="TxtPacStatus" Text="Ready for PAC Firmware Flash" FontSize="10" Foreground="#CBD5E1" DockPanel.Dock="Left"/>
