<Window x:Class="BSLabTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS Lab Tool v2.6.0 PRO Enterprise — Professional GSM Service Platform"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        MinWidth="1024" MinHeight="600"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        Background="{DynamicResource BackgroundDark}"
        Foreground="#FFFFFF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window Control Button Styles -->
        <Style x:Key="WindowCtrlButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#00D2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E11D48"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sub-Tab Toggle Buttons -->
        <Style x:Key="SubTabButtonActive" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                    <Setter Property="BorderBrush" Value="#7DD3FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubTabButtonInactive" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3B49"/>
                    <Setter Property="Foreground" Value="#38BDF8"/>
                    <Setter Property="BorderBrush" Value="#0284C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Brand Card Container Style -->
        <Style x:Key="ModernBrandCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1F2B35"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3B49"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mini Quick Action Button on Brand Card -->
        <Style x:Key="BrandCardQuickBtn" TargetType="Button">
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Bullet Action Button (Checklist-style from screenshot) -->
        <Style x:Key="CyberBulletButton" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BulletButtonForeground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="BulletDot" Width="10" Height="10" Fill="{DynamicResource BulletDotFill}" Stroke="{DynamicResource BulletDotStroke}" StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BulletHoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BulletHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0284C7"/>
                                <Setter TargetName="BulletDot" Property="Fill" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Dark Cyber Theme -->
        <Style x:Key="CyberColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CyberCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark Theme ComboBox Item -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#13131A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0369A1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fallback Global ComboBoxItem Dark Theme -->
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>

        <!-- Toggle Button for Dark ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="3" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" />
                <Border Grid.Column="0" Margin="1" Background="#0F172A" CornerRadius="2,0,0,2" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00D2FF" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#00D2FF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00D2FF" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#00D2FF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark Theme ComboBox -->
        <Style x:Key="DarkCyberComboBox" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="340"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource DarkComboBoxToggleButton}" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="#FFFFFF"
                                              Margin="8,3,24,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#13131A"
                                        BorderThickness="1"
                                        BorderBrush="#334155"
                                        CornerRadius="4"
                                        Padding="2"
                                        Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.7" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" Background="#13131A">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#13131A"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Cyber ReadOnly Console / TextBox Style (Prevents Windows Aero ReadOnly White Background) -->
        <Style x:Key="DarkCyberConsoleTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0E1A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="SelectionBrush" Value="#0284C7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Button Styles -->
        <Style x:Key="CyberNavTab" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource NavTabBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource NavTabForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavTabHoverBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavTabHoverForeground}"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveNavTab" TargetType="Button" BasedOn="{StaticResource CyberNavTab}">
            <Setter Property="Background" Value="{DynamicResource ActiveNavTabBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTabForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActiveNavTabBorder}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Row 0: Top Header & Branding -->
            <RowDefinition Height="34"/> <!-- Row 1: Top Navigation Tabs -->
            <RowDefinition Height="*"/>  <!-- Row 2: Dynamic Main Workspace -->
            <RowDefinition Height="28"/> <!-- Row 3: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================================================================== -->
        <!-- ROW 0: UAT PRO MASTER SYSTEM & TELEMETRY HEADER                     -->
        <!-- ==================================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}" BorderBrush="{DynamicResource TitleBarBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0: Left Title & Version Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BS LAB TOOL™ v2.6.2" FontSize="11.5" FontWeight="ExtraBold" Foreground="#4DD0E1" VerticalAlignment="Center"/>
                    <Border Background="#1A3A54" BorderBrush="#0288D1" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO ENTERPRISE" FontSize="8" FontWeight="Bold" Foreground="#4FC3F7"/>
                    </Border>
                </StackPanel>

                <!-- Col 1: Centered Profile & Hardware Telemetry (Compact, Zero Overlap) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- User Profile Avatar & Account Launcher -->
                    <Border Cursor="Hand" MouseDown="OnUserProfileHeaderClicked" ToolTip="Click to view Account, HWID Binding &amp; License Status" Background="Transparent" CornerRadius="6" Padding="3,2" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#FBC02D" Margin="0,0,5,0" VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#37474F"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeaderUserName" Text="Syed Bisharat Ali" FontSize="8.5" FontWeight="Bold" Foreground="#ECEFF1" MaxWidth="135" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtHeaderUserSubtitle" Text="Shop #5, Arif Center" FontSize="7.5" Foreground="#90A4AE" MaxWidth="135" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hidden LED indicators to preserve C# bindings -->
                    <StackPanel Visibility="Collapsed">
                        <Border x:Name="PillGlobalCom">
                            <StackPanel>
                                <Ellipse x:Name="LedGlobalCom">
                                    <Ellipse.Effect><DropShadowEffect x:Name="GlowGlobalCom" BlurRadius="6" ShadowDepth="0" Color="#EF4444"/></Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="TxtGlobalCom"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PillGlobalUsb">
                            <StackPanel>
                                <Ellipse x:Name="LedGlobalUsb">
                                    <Ellipse.Effect><DropShadowEffect x:Name="GlowGlobalUsb" BlurRadius="6" ShadowDepth="0" Color="#EF4444"/></Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="TxtGlobalUsb"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- System PC & CPU Telemetry Card -->
                    <Border Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,5,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻" FontSize="12" Foreground="#4DD0E1" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="System: " FontSize="7.5" Foreground="#90A4AE"/>
                                    <TextBlock x:Name="TxtUatPcName" Text="DESKTOP-IE9S34C" FontSize="8" FontWeight="Bold" Foreground="#4DD0E1" MaxWidth="105" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtUatCpuModel" Text="Intel(R) Core(TM) i3-5005U" FontSize="7.5" Foreground="#CFD8DC" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Target Device Preview Card -->
                    <Border x:Name="BorderDevicePreview" Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,5,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📱" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <Border x:Name="BadgeBrandContainer" Background="#008450" CornerRadius="3" Padding="4,1" Margin="0,0,0,1" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtUatBrandBadge" Text="oppo" FontSize="7" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock x:Name="TxtUatDeviceRenderName" Text="F21 PRO (CPH2363)" FontSize="7.5" FontWeight="Bold" Foreground="#ECEFF1" MaxWidth="125" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- COM Port Selection Dropdown (Dark Cyber Styled) -->
                    <Border Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔌" FontSize="11" Foreground="#FFA726" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbPortUat" Style="{StaticResource DarkCyberComboBox}" Width="105" Height="22" FontSize="8.5" Foreground="#ECEFF1" VerticalContentAlignment="Center" Margin="0,0,5,0">
                                <ComboBoxItem Content="Port Selection..." IsSelected="True"/>
                                <ComboBoxItem Content="COM3: Qualcomm 9008"/>
                                <ComboBoxItem Content="COM4: MediaTek Port"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkAutoDetectPort" Content="Auto" ToolTip="Auto detect COM Port" IsChecked="True" Foreground="#FFA726" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Col 2: Right Controls & Snapshot -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📷" ToolTip="Take Instant UI Snapshot" Style="{StaticResource WindowCtrlButton}" Width="24" Height="24" Click="OnUatSnapshotClicked" Margin="0,0,2,0"/>
                    <Button Content="🔄" ToolTip="Refresh Ports" Style="{StaticResource WindowCtrlButton}" Width="24" Height="24" Click="OnScanPortsClicked" Margin="0,0,3,0"/>
                    <Border Background="#1B5E20" CornerRadius="3" Padding="5,2" Margin="0,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" FontSize="8.5" FontWeight="ExtraBold" Foreground="#69F0AE"/>
                    </Border>
                    <!-- Multi-Language Switcher (Urdu / Arabic / English) -->
                    <Button x:Name="BtnLanguageSwitcher" Content="🌐 EN" ToolTip="Switch Language: English / اردو / العربية" Style="{StaticResource WindowCtrlButton}" Width="Auto" Padding="6,2" Height="24" Click="OnLanguageSwitchClicked" Margin="0,0,4,0" Foreground="#00FFA3" FontWeight="Bold" FontSize="9.5"/>
                    <!-- In-App Auto-Update Button (1-Click Silent Cloud Sync) -->
                    <Button x:Name="BtnTitleAutoUpdate" Content="⚡ AUTO UPDATE" ToolTip="1-Click Silent Auto-Update: Checks online, downloads and upgrades software in-place without manual installation wizard" Style="{StaticResource WindowCtrlButton}" Width="Auto" Padding="7,2" Height="24" Click="OnOpenAutoUpdaterClicked" Margin="0,0,4,0" Foreground="#FFB800" Background="#261C04" BorderBrush="#FFB800" BorderThickness="1" FontWeight="ExtraBold" FontSize="9.5"/>
                    <Button x:Name="BtnMinimize" Content="—" ToolTip="Minimize" Style="{StaticResource WindowCtrlButton}" Click="OnMinimizeClicked"/>
                    <Button x:Name="BtnMaximize" Content="🗗" ToolTip="Maximize / Restore" Style="{StaticResource WindowCtrlButton}" Click="OnMaximizeClicked"/>
                    <Button x:Name="BtnClose" Content="✕" ToolTip="Close Application" Style="{StaticResource WindowCloseButton}" Click="OnCloseClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: UAT PRO DOTTED SUB-NAVIGATION TABS                           -->
        <!-- ==================================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource NavBackground}" BorderBrush="{DynamicResource NavBorder}" BorderThickness="0,0,0,1" Height="34">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Focusable="False">
                <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                    <Button x:Name="TabUatServices" Content="⋮ SERVICES" Style="{StaticResource ActiveNavTab}" Click="OnNavTabClicked" Margin="0,0,3,0"/>
                    <Button x:Name="TabUatFlasher" Content="⋮ FLASHER" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,3,0"/>
