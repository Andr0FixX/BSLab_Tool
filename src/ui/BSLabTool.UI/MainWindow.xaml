                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="PROTOCOLS (MTK DA ENGINE)" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
