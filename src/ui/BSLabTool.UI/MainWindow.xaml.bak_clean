<Window x:Class="BSLabTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS Lab Tool v2.5 PRO Enterprise — Professional GSM Service Platform"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="1024" MinHeight="600"
        Background="{DynamicResource BackgroundDark}"
        Foreground="#FFFFFF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window Control Button Styles -->
        <Style x:Key="WindowCtrlButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#00D2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E11D48"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sub-Tab Toggle Buttons -->
        <Style x:Key="SubTabButtonActive" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource SubTabActiveBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTabActiveForeground}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubTabActiveBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubTabButtonInactive" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource SubTabInactiveBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTabInactiveForeground}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubTabInactiveBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cyber Bullet Action Button (Checklist-style from screenshot) -->
        <Style x:Key="CyberBulletButton" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BulletButtonForeground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="BulletDot" Width="10" Height="10" Fill="{DynamicResource BulletDotFill}" Stroke="{DynamicResource BulletDotStroke}" StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BulletHoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BulletHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0284C7"/>
                                <Setter TargetName="BulletDot" Property="Fill" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Dark Cyber Theme -->
        <Style x:Key="CyberColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CyberCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark Theme ComboBox Item -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#13131A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0369A1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fallback Global ComboBoxItem Dark Theme -->
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>

        <!-- Toggle Button for Dark ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="3" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" />
                <Border Grid.Column="0" Margin="1" Background="#0F172A" CornerRadius="2,0,0,2" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00D2FF" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#00D2FF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00D2FF" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#00D2FF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark Theme ComboBox -->
        <Style x:Key="DarkCyberComboBox" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="340"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource DarkComboBoxToggleButton}" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,24,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#13131A"
                                        BorderThickness="1"
                                        BorderBrush="#334155"
                                        CornerRadius="4"
                                        Padding="2"
                                        Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.7" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" Background="#13131A">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#13131A"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Cyber ReadOnly Console / TextBox Style (Prevents Windows Aero ReadOnly White Background) -->
        <Style x:Key="DarkCyberConsoleTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0E1A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="SelectionBrush" Value="#0284C7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Button Styles -->
        <Style x:Key="CyberNavTab" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource NavTabBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource NavTabForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavTabHoverBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavTabHoverForeground}"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveNavTab" TargetType="Button" BasedOn="{StaticResource CyberNavTab}">
            <Setter Property="Background" Value="{DynamicResource ActiveNavTabBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTabForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActiveNavTabBorder}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Row 0: Top Header & Branding -->
            <RowDefinition Height="34"/> <!-- Row 1: Top Navigation Tabs -->
            <RowDefinition Height="*"/>  <!-- Row 2: Dynamic Main Workspace -->
            <RowDefinition Height="28"/> <!-- Row 3: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================================================================== -->
        <!-- ROW 0: UAT PRO MASTER SYSTEM & TELEMETRY HEADER                     -->
        <!-- ==================================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}" BorderBrush="{DynamicResource TitleBarBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
            <DockPanel Margin="10,0,8,0">
                <!-- Left Title & Quick Action Icons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Button Content="🏛️" ToolTip="Master Dashboard" Style="{StaticResource WindowCtrlButton}" Width="28" Height="26" Click="OnUatHomeClicked" Margin="0,0,2,0"/>
                    <Button Content="🖥️" ToolTip="Windows Device Manager" Style="{StaticResource WindowCtrlButton}" Width="28" Height="26" Click="OnUatDeviceManagerClicked" Margin="0,0,2,0"/>
                    <Button Content="⚙️" ToolTip="Global Settings" Style="{StaticResource WindowCtrlButton}" Width="28" Height="26" Click="OnUatSettingsClicked" Margin="0,0,2,0"/>
                    <Button Content="🔗" ToolTip="Share / Copy Logs" Style="{StaticResource WindowCtrlButton}" Width="28" Height="26" Click="OnUatShareClicked" Margin="0,0,8,0"/>
                    
                    <TextBlock Text="UAT PRO™ - Version 205.01 - (Windows 10 : 64-bit)" FontSize="11" FontWeight="Bold" Foreground="#ECEFF1" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Window Controls & Snapshots -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Content="📷" ToolTip="Take Instant UI Snapshot" Style="{StaticResource WindowCtrlButton}" Width="28" Height="26" Click="OnUatSnapshotClicked" Margin="0,0,4,0"/>
                    <Button Content="🔄" ToolTip="Refresh Ports" Style="{StaticResource WindowCtrlButton}" Width="28" Height="26" Click="OnScanPortsClicked" Margin="0,0,4,0"/>
                    
                    <Border Background="#1B5E20" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" FontSize="10" FontWeight="ExtraBold" Foreground="#69F0AE"/>
                    </Border>
                    
                    <Button x:Name="BtnMinimize" Content="—" ToolTip="Minimize" Style="{StaticResource WindowCtrlButton}" Click="OnMinimizeClicked"/>
                    <Button x:Name="BtnMaximize" Content="🗗" ToolTip="Maximize / Restore" Style="{StaticResource WindowCtrlButton}" Click="OnMaximizeClicked"/>
                    <Button x:Name="BtnClose" Content="✕" ToolTip="Close Application" Style="{StaticResource WindowCloseButton}" Click="OnCloseClicked"/>
                </StackPanel>

                <!-- Center Telemetry: User Profile + System PC Card + Target Device Preview + Port Selector -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- User Avatar Profile -->
                    <Border Width="32" Height="32" CornerRadius="16" Background="#FBC02D" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#37474F"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Syed Bisharat Ali" FontSize="10" FontWeight="Bold" Foreground="#ECEFF1"/>
                        <TextBlock Text="Shop #5, Arif Center" FontSize="8.5" Foreground="#90A4AE"/>
                    </StackPanel>

                    <!-- LIVE HARDWARE NOTIFICATION RADAR (COM & USB INDICATORS) -->
                    <Border x:Name="PillGlobalCom" Background="#1F2B35" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedGlobalCom" Width="7" Height="7" Fill="#EF4444" Margin="0,0,4,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="GlowGlobalCom" BlurRadius="6" ShadowDepth="0" Color="#EF4444"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtGlobalCom" Text="COM: NO DEVICE" FontSize="8.5" FontWeight="Bold" Foreground="#90A4AE" FontFamily="Consolas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PillGlobalUsb" Background="#1F2B35" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedGlobalUsb" Width="7" Height="7" Fill="#EF4444" Margin="0,0,4,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="GlowGlobalUsb" BlurRadius="6" ShadowDepth="0" Color="#EF4444"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtGlobalUsb" Text="USB: DISCONNECTED" FontSize="8.5" FontWeight="Bold" Foreground="#90A4AE" FontFamily="Consolas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- System Telemetry Card (Desktop & CPU) -->
                    <Border Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻" FontSize="16" Foreground="#4DD0E1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="System: " FontSize="8.5" Foreground="#90A4AE"/>
                                    <TextBlock x:Name="TxtUatPcName" Text="DESKTOP-IE9S34C" FontSize="9.5" FontWeight="Bold" Foreground="#4DD0E1"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtUatCpuModel" Text="Intel(R) Core(TM) i3-5005U CPU @ 2.00GHz" FontSize="8.5" Foreground="#CFD8DC" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Target Device Preview (Phone Render & Brand Logo Badge) -->
                    <Border x:Name="BorderDevicePreview" Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📱" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <Border Background="#008450" CornerRadius="3" Padding="5,1" Margin="0,0,0,2" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtUatBrandBadge" Text="oppo" FontSize="8.5" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock x:Name="TxtUatDeviceRenderName" Text="F21 PRO (CPH2363)" FontSize="8.5" FontWeight="Bold" Foreground="#ECEFF1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Port Selection Dropdown & Auto Detect Checkbox -->
                    <Border Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔌" FontSize="13" Foreground="#FFA726" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbPortUat" Width="130" Height="22" FontSize="9.5" Background="#1A232A" Foreground="#ECEFF1" BorderBrush="#37474F" VerticalContentAlignment="Center" Margin="0,0,6,0">
                                <ComboBoxItem Content="Port Selection..." IsSelected="True"/>
                                <ComboBoxItem Content="COM3: Qualcomm HS-USB 9008"/>
                                <ComboBoxItem Content="COM4: MediaTek USB Port"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkAutoDetectPort" Content="Auto detect port" IsChecked="True" Foreground="#FFA726" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================================================================== -->
        <!-- ROW 1: UAT PRO DOTTED SUB-NAVIGATION TABS                           -->
        <!-- ==================================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource NavBackground}" BorderBrush="{DynamicResource NavBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                <Button x:Name="TabUatServices" Content="⋮ SERVICES" Style="{StaticResource ActiveNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabUatFlasher" Content="⋮ FLASHER" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabUatPartition" Content="⋮ PARTITION MANAGER" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabUatBackup" Content="⋮ BACKUP FIRMWARE" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabUatDiag" Content="⋮ DIAG" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabUatDump" Content="⋮ DUMP" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,8,0"/>

                <Border Width="1" Height="16" Background="#37474F" Margin="2,0,8,0" VerticalAlignment="Center"/>

                <Button x:Name="TabBtnAutoHub" Content="⚡ USB AUTO-HUB" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnAiAnalyse" Content="🤖 AI ANALYSE" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnMtk" Content="📱 MEDIATEK" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnQualcomm" Content="🐉 QUALCOMM" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnFastboot" Content="🚀 FASTBOOT" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnSamsung" Content="🏢 SAMSUNG" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnUnisoc" Content="⚡ UNISOC" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnHuawei" Content="🔴 HUAWEI" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnTestPoints" Content="📍 TEST POINTS" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnPartDoctor" Content="🛠️ PARTITION DOCTOR" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnBackup" Content="🛡️ BACKUP" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked" Margin="0,0,4,0"/>
                <Button x:Name="TabBtnSettings" Content="⚙️ SETTINGS" Style="{StaticResource CyberNavTab}" Click="OnNavTabClicked"/>
            </StackPanel>
        </Border>

        <!-- ==================================================================== -->
        <!-- ROW 2: UAT PRO 3-COLUMN MASTER WORKSPACE                            -->
        <!-- ==================================================================== -->
        <Grid Grid.Row="2" Margin="4,4,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>  <!-- Col 0: Leftmost Vertical Action Dock -->
                <ColumnDefinition Width="*"/>   <!-- Col 1: Center Stage & Workspaces -->
                <ColumnDefinition Width="360"/> <!-- Col 2: Main Selection & 27-Brand Ribbon -->
            </Grid.ColumnDefinitions>

            <!-- ================================================================ -->
            <!-- COL 0: LEFTMOST VERTICAL ACTION DOCK (15 ACTION ICONS)           -->
            <!-- ================================================================ -->
            <Border Grid.Column="0" Background="#171F26" BorderBrush="#24333E" BorderThickness="0,0,1,0" CornerRadius="4,0,0,4">
                <DockPanel LastChildFill="False">
                    <!-- Top Action Icons Stack -->
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Content="🏛️" ToolTip="Master Dashboard" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatHomeClicked"/>
                        <Button Content="🖥️" ToolTip="Windows Device Manager" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatDeviceManagerClicked"/>
                        <Button Content="⚙️" ToolTip="Tool &amp; Driver Settings" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatSettingsClicked"/>
                        <Button Content="🔗" ToolTip="Share / Export Logs" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatShareClicked"/>
                        <Button Content="👥" ToolTip="User Account &amp; Credits" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatAccountsClicked"/>
                        <Button Content="🔌" ToolTip="USB Driver &amp; Filter Wizard" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatUsbWizardClicked"/>
                        <Button Content="💻" ToolTip="Serial AT Command Terminal" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatTerminalClicked"/>
                        <Button Content="📱" ToolTip="ADB &amp; Fastboot Toolkit" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatFastbootSuiteClicked"/>
                        <Button Content="🦊" ToolTip="Hardware Pinout &amp; EDL Testpoint Database" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatTestPointsClicked"/>
                        <Button Content="f" FontWeight="ExtraBold" FontSize="13" Foreground="#4267B2" ToolTip="Facebook Community Support" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatFacebookClicked"/>
                        <Button Content="✈️" ToolTip="Official Telegram Updates" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatTelegramClicked"/>
                        <Button Content="▶️" ToolTip="Official Video Guides" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatYouTubeClicked"/>
                        <Button Content="🛒" ToolTip="Buy Credits &amp; Renew License" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatCartClicked"/>
                        <Button Content="🛡️" ToolTip="Anti-Brick Protection Guard" Width="38" Height="28" Margin="0,1" Style="{StaticResource WindowCtrlButton}" Click="OnUatShieldClicked"/>
                    </StackPanel>

                    <!-- Bottom Power Button -->
                    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button Content="⏻" ToolTip="Emergency Exit / Safe Shutdown" Width="38" Height="30" FontSize="15" Foreground="#FF5252" Background="#261C1F" BorderBrush="#5C1D24" BorderThickness="1" Click="OnUatPowerExitClicked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================================================================ -->
            <!-- COL 1: CENTER STAGE (ACTIVE VIEWPORTS & LIVE EXECUTION SCREEN)   -->
            <!-- ================================================================ -->
            <Grid Grid.Column="1" Margin="6,0,6,0">

            <!-- ================================================================ -->
                        <!-- ================================================================ -->
            <!-- VIEW 0: USB AUTO-HUB (UNIVERSAL HARDWARE RADAR & 1-CLICK COCKPIT) -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewAutoHub" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Master Cockpit Controls (Scrollable) -->
                <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Cockpit Header Banner -->
                            <Border Background="#0C1427" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ USB AUTO-HUB" FontSize="11" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                                        <Border Background="#1E3A8A" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                            <TextBlock Text="UNIVERSAL COCKPIT" FontSize="8.5" FontWeight="Bold" Foreground="#93C5FD"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAutoHubEngineState" Text="● AUTOPILOT ONLINE" FontSize="9" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- CARD 1: LIVE USB PORT RADAR & HARDWARE SNIFFER CARD -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="📡 LIVE USB HARDWARE RADAR:" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRadarStatusBadge" Text="● LISTENING ON USB BUS" FontSize="9" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Visual Hardware Detection Radar Banner -->
                                    <Border x:Name="BorderRadarIndicator" Background="#0B0F19" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Animated Icon / Pulse -->
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1E293B" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtRadarIcon" Text="⚪" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock x:Name="TxtRadarHardwareTitle" Text="Waiting for Device Connection..." FontSize="10.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock x:Name="TxtRadarPortInfo" Text="Connect device via USB (BROM / EDL 9008 / Diag / Fastboot / ADB)" FontSize="8.5" Foreground="#94A3B8"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="🔍 Scan" Height="26" Padding="10,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" BorderThickness="0" VerticalAlignment="Center" Click="OnAutoHubScanUsbClicked"/>
                                        </Grid>
                                    </Border>

                                    <!-- Dedicated Port Selector Dropdown -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎯 TARGET COM PORT:" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbAutoHubComPort" Style="{StaticResource DarkCyberComboBox}" Grid.Column="1" Height="24" SelectionChanged="OnAutoHubComPortChanged"/>
                                        <Button Grid.Column="2" Content="🔄" Width="24" Height="24" Margin="4,0,0,0" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Click="OnAutoHubScanUsbClicked"/>
                                    </Grid>

                                    <!-- Quick Port & Chipset Specs Ribbon -->
                                    <Border Background="#0F172A" CornerRadius="3" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="SELECTED PORT" FontSize="7.5" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtAutoHubComPort" Text="AUTO" FontSize="9.5" FontWeight="Bold" Foreground="#E2E8F0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="PROTOCOL" FontSize="7.5" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtAutoHubProtocol" Text="Auto-Sniffer" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SECURITY GUARD" FontSize="7.5" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtAutoHubGuard" Text="Anti-Brick Active" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: SMART BRAND & MODEL SELECTOR -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="🎯 TARGET BRAND &amp; MODEL (SMART DB):" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAutoHubModelBadge" Text="242 Brands / 11,920+ Models" FontSize="8.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbAutoHubBrand" Style="{StaticResource DarkCyberComboBox}" IsTextSearchEnabled="True" Grid.Column="0" Height="24" SelectionChanged="OnAutoHubBrandChanged"/>
                                        <ComboBox x:Name="CmbAutoHubModel" Style="{StaticResource DarkCyberComboBox}" IsTextSearchEnabled="True" Grid.Column="2" Height="24" SelectionChanged="OnAutoHubModelChanged"/>
                                    </Grid>

                                    <!-- Detected Chipset & Testpoint Info Banner -->
                                    <Border Background="#0F172A" CornerRadius="3" Padding="8,4">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtAutoHubModelInfo" Text="Select Brand &amp; Model (Auto-routes MTK, Qualcomm, Samsung, Unisoc, Kirin)" FontSize="8.5" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtAutoHubTpInfo" Text="Testpoint: Connect USB or Short TP to GND (1.8V)" FontSize="8" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                                                        <!-- Auto-Hub Security & Auth Bypass Suite (LED Style) -->
                            <Border Background="#121722" CornerRadius="5" Padding="8,6" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="🛡️ HARDWARE SECURITY &amp; AUTH BYPASS:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <Border x:Name="BadgeAutoHubBypassStatus" Background="#064E3B" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtAutoHubBypassStatus" Text="● BYPASS READY" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnAutoHubBromAuth" Grid.Column="0" Height="28" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Click="OnToggleBromAuthClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="LedAutoHubBrom" Text="●" FontSize="11" Foreground="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAutoHubBromLabel" Text="BROM Auth / SLA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnAutoHubPreloader" Grid.Column="2" Height="28" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Click="OnTogglePreloaderExploitClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="LedAutoHubPreloader" Text="●" FontSize="11" Foreground="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAutoHubPreloaderLabel" Text="Preloader Exploit" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: 1-CLICK UNIVERSAL AUTOPILOT HERO BUTTON -->
                            <Border Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="6" Padding="4" Margin="0,0,0,8">
                                <Button Content="⚡ 1-CLICK AUTO-IDENTIFY &amp; SERVICE (AUTOPILOT)" Height="38" Background="#0284C7" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="OnAutoHubUniversalAutopilotClicked"/>
                            </Border>

                            <!-- CARD 4: DIRECT 1-CLICK SERVICE OPERATIONS GRID -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ONE-CLICK SERVICE OPERATIONS (ALL CHIPSETS):" FontSize="8.5" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Content="🛡️ Reset FRP Lock" Height="28" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubResetFrpClicked"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="☁️ Bypass Mi Account" Height="28" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubBypassMiClicked"/>

                                        <Button Grid.Row="1" Grid.Column="0" Content="✔️ Safe Factory Reset" Height="28" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubFactoryResetClicked"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="🔓 Unlock Bootloader" Height="28" Background="#EA580C" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubUnlockBlClicked"/>

                                        <Button Grid.Row="2" Grid.Column="0" Content="📊 Read Live GPT Table" Height="28" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubReadGptClicked"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="🔄 Watchdog Reboot" Height="28" Background="#475569" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubRebootClicked"/>

                                        <Button Grid.Row="3" Grid.Column="0" Content="💾 Backup Security/NV" Height="28" Background="#0891B2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubBackupSecurityClicked"/>
                                        <Button Grid.Row="3" Grid.Column="2" Content="📥 Restore Security/NV" Height="28" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubRestoreSecurityClicked"/>

                                        <Button Grid.Row="4" Grid.Column="0" Content="🩺 eMMC/UFS Health Check" Height="28" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnAutoHubEmmcHealthCheckClicked"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="⛔ Emergency Abort" Height="28" Background="#991B1B" Foreground="#FECACA" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,4" Click="OnEmergencyAbortClicked"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 5: ⚡ ZERO-BL TEMP ROOT & PRIVILEGE STUDIO (UID 0) -->
                            <Border Background="#161A26" CornerRadius="6" BorderBrush="#7C3AED" BorderThickness="1.5" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <!-- Header with Glowing Badge and Auto-Detect Button -->
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ ZERO-BL TEMP ROOT STUDIO" FontSize="10" FontWeight="ExtraBold" Foreground="#A78BFA"/>
                                            <Border Background="#2E1065" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                                <TextBlock Text="UID 0 • KERNEL 4.9-6.12" FontSize="7.5" FontWeight="Bold" Foreground="#C084FC"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="⚡ Auto-Detect Phone" HorizontalAlignment="Right" Height="22" Padding="6,1" Background="#1E1B4B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" FontSize="8" FontWeight="Bold" Click="OnTempRootAutoDetectClicked" ToolTip="Reads device brand, model &amp; uname -r via ADB and auto-selects profile"/>
                                    </DockPanel>

                                    <!-- Brand & Model Selection Grid -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Brand Dropdown -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="BRAND" FontSize="7.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CmbTempRootBrand" Height="26" Background="#0D1117" Foreground="#F8FAFC" FontSize="8.5" BorderBrush="#30363D" SelectionChanged="OnTempRootBrandChanged"/>
                                        </StackPanel>

                                        <!-- Model Dropdown -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TARGET MODEL" FontSize="7.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CmbTempRootModel" Height="26" Background="#0D1117" Foreground="#F8FAFC" FontSize="8.5" BorderBrush="#30363D" SelectionChanged="OnTempRootModelChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Selected Profile Metadata & Hardware Verification Badge -->
                                    <Border Background="#0D1117" CornerRadius="4" Padding="6,5" Margin="0,0,0,6" BorderBrush="#232332" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="STATUS:" FontSize="7.5" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtTempRootStatusBadge" Text="⚪ Ready - Select Brand &amp; Model" FontSize="7.5" FontWeight="Bold" Foreground="#38BDF8" Margin="4,0,0,0"/>
                                            </DockPanel>
                                            <TextBlock x:Name="TxtTempRootDetails" Text="KMI / Kernel: GKI 5.10-6.12 | Exploit: DirtyFrag / GhostLock" FontSize="7.5" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔍 Audit Hardware Matrix" Height="28" Background="#4338CA" Foreground="#FFFFFF" FontWeight="Bold" FontSize="8.5" BorderThickness="0" Click="OnAutoHubTempRootCheckClicked" ToolTip="Audits phone kernel and tests exploit compatibility"/>
                                        <Button Grid.Column="2" Content="⚡ 1-Click Temp Root (UID 0)" Height="28" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="8.5" BorderThickness="0" Click="OnAutoHubTempRootApplyClicked" ToolTip="Deploys exploit payload and verifies root UID 0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Cockpit Real-Time Progress HUD -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtAutoHubProgressStatus" Text="Ready for operation" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAutoHubProgressPct" Text="0%" FontSize="10" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="ProgressBarAutoHub" Height="6" Background="#27272A" Foreground="#00D2FF" Value="0" Maximum="100"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Column: Partition Doctor GPT Table & Autopilot Log Console -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Environment Stats Banner -->
                        <RowDefinition Height="280"/>  <!-- Dedicated Live Storage GPT Table -->
                        <RowDefinition Height="*"/>    <!-- Master Terminal Log Console -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: DUAL LIVE HARDWARE NOTIFICATION RADAR DOCK (COM PORT & USB DEVICE) -->
                    <Border Grid.Row="0" Background="#0C101C" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/> <!-- Box 1: COM Port Box -->
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.5*"/> <!-- Box 2: USB Interface Box -->
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                            </Grid.ColumnDefinitions>

                            <!-- BOX 1: CONNECTED COM PORT WITH LIVE LED LIGHT -->
                            <Border Grid.Column="0" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                <DockPanel>
                                    <Ellipse x:Name="LedAutoHubCom" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowAutoHubCom" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Border x:Name="BadgeAutoHubCom" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtAutoHubComState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔌 COM PORT BUS" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtAutoHubComBox" Text="NO COM PORT DETECTED" FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- BOX 2: CONNECTED USB INTERFACE WITH LIVE LED LIGHT -->
                            <Border Grid.Column="2" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                <DockPanel>
                                    <Ellipse x:Name="LedAutoHubUsb" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowAutoHubUsb" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Border x:Name="BadgeAutoHubUsb" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtAutoHubUsbState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="⚡ USB DEVICE / MODE" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtAutoHubUsbBox" Text="WAITING FOR USB CONNECTION..." FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- ACTION BUTTONS: SCAN, ABORT & CLEAR -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔍 Scan" Height="28" Padding="10,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnAutoHubScanUsbClicked"/>
                                <Button Content="⛔ ABORT" Height="28" Padding="10,0" Background="#991B1B" Foreground="#FECACA" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnEmergencyAbortClicked"/>
                                <Button Content="Clear Log" Height="28" Padding="10,0" Background="#1E1E2A" Foreground="#94A3B8" FontSize="10" BorderThickness="0" Click="OnAutoHubClearLogClicked"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Dedicated Full-Height Live Storage GPT Partition Table -->
                    <Border Grid.Row="1" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💽 LIVE STORAGE GPT PARTITION DOCTOR" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="eMMC / UFS SECTORS" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🔄 Reload GPT" Width="80" Height="22" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Margin="0,0,4,0" Click="OnAutoHubReadGptClicked"/>
                                    <Button x:Name="BtnAutoHubDumpSelected" Content="💾 Dump Selected" Width="95" Height="22" Background="#0284C7" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Click="OnAutoHubDumpSelectedClicked"/>
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="GridAutoHubPartitions" Grid.Row="1" Background="#070709" RowBackground="#0B0F19" AlternatingRowBackground="#101726" BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B" RowHeight="24" FontSize="10" Foreground="#F8FAFC" ColumnHeaderStyle="{StaticResource CyberColumnHeader}" CellStyle="{StaticResource CyberCell}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="35">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', monospace"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="PARTITION NAME" Binding="{Binding Name}" Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="START LBA" Binding="{Binding StartLba, StringFormat=0x{0:X8}}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', monospace"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="SECTORS" Binding="{Binding SectorCount}" Width="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', monospace"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="SIZE" Binding="{Binding SizeStr}" Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', monospace"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="FILESYSTEM" Binding="{Binding Filesystem}" Width="105">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', monospace"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="FLAGS / STATUS" Binding="{Binding Status}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Row 2: Master Autopilot Diagnostics & Engine Log Terminal -->
                    <Border Grid.Row="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ USB AUTO-HUB ENGINE PROTOCOL CONSOLE" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="HARDWARE BUS" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Copy Log" Width="70" Height="22" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Click="OnAutoHubCopyLogClicked" Margin="0,0,6,0"/>
                                    <Button Content="Clear Console" Width="85" Height="22" Background="#1E293B" Foreground="#94A3B8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Click="OnAutoHubClearLogClicked"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox x:Name="TxtAutoHubConsole" Grid.Row="1" Background="#070709" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ -->
            <!-- VIEW 0.5: AI ANALYSE (DEDICATED CO-PILOT & TELEMETRY LAB)          -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewAiAnalyse" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: AI Hardware Co-Pilot & Workflow Compiler -->
                <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- AI Laboratory Banner Header -->
                            <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🤖 AI HARDWARE CO-PILOT" FontSize="11" FontWeight="ExtraBold" Foreground="#A5B4FC"/>
                                        <Border Background="#312E81" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                            <TextBlock Text="PRO ACTIVE" FontSize="8.5" FontWeight="Bold" Foreground="#C7D2FE"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAiEngineStatus" Text="● AI READY" FontSize="9" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- 1-Click Deep Diagnose Hero Button -->
                            <Border Background="#0F172A" BorderBrush="#6366F1" BorderThickness="1.5" CornerRadius="6" Padding="3" Margin="0,0,0,8">
                                <Button x:Name="BtnAiDeepDiagnose" Content="⚡ 1-CLICK AI DEEP DIAGNOSE &amp; TELEMETRY SWEEP" Height="36" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" BorderThickness="0" Cursor="Hand" Click="OnAiDiagnoseClicked"/>
                            </Border>

                            <!-- 4 Visual Health Pills (Live Diagnostic Matrix) -->
                            <Border Background="#161A26" CornerRadius="5" Padding="8" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pill 1: ROM Integrity -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#0F172A" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="FIRMWARE INTEGRITY" FontSize="7.5" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtAiRomStatus" Text="Waiting Scan..." FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pill 2: Modem & Baseband -->
                                    <Border Grid.Row="0" Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="MODEM / BASEBAND" FontSize="7.5" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtAiBasebandStatus" Text="Waiting Scan..." FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pill 3: Bootloader & Knox -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#0F172A" CornerRadius="4" Padding="6,4">
                                        <StackPanel>
                                            <TextBlock Text="BOOTLOADER &amp; KNOX" FontSize="7.5" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtAiBlStatus" Text="Waiting Scan..." FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pill 4: Security Locks (FRP / KG) -->
                                    <Border Grid.Row="1" Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="6,4">
                                        <StackPanel>
                                            <TextBlock Text="SECURITY / FRP LOCK" FontSize="7.5" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtAiSecurityStatus" Text="Waiting Scan..." FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Technician Natural Language Prompt Section -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="[=] TECHNICIAN PROBLEM PROMPT (ROMAN URDU / ENGLISH):" FontSize="8.5" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,6"/>

                                    <!-- Quick Symptom Tags / Chips -->
                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Content="⚡ ADB &amp; Fastboot Master" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="🔄 Reboot Modes &amp; EDL/BROM" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="🧬 All SoCs Architecture" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="🛠️ Partition Doctor (Dump/Flash)" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="📶 Baseband / Null IMEI" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="🔓 FRP / Google Lock" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="🔄 Fix Bootloop" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="🔑 Screen Lock (Keep Data)" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="☁️ Mi Cloud / Account" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="📦 Restore Official ROM" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="🛡️ Knox / KG Bypass" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="📱 Vivo / Oppo Demo Remove" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                        <Button Content="🔴 Manufacture Mode Off" Style="{StaticResource CyberBulletButton}" Margin="0,0,4,4" Click="OnAiQuickChipClicked"/>
                                    </WrapPanel>

                                    <!-- Modern Glowing Prompt Input & Send Section -->
                                    <Border Background="#0C1427" CornerRadius="6" BorderBrush="#2563EB" BorderThickness="1.5" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock Text="💬 TYPE PHONE ISSUE (ROMAN URDU / ENGLISH):" FontSize="8.5" FontWeight="ExtraBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="✕ Clear" Height="20" Padding="8,1" Background="#1E293B" Foreground="#94A3B8" FontSize="8" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="OnAiClearPromptClicked" Margin="0,0,6,0"/>
                                                    <Border Background="#064E3B" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                        <TextBlock Text="● AI CO-PILOT ONLINE" FontSize="7.5" FontWeight="Bold" Foreground="#34D399"/>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Prompt Textarea -->
                                            <Border Background="#070A13" CornerRadius="4" BorderBrush="#1E293B" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                                <TextBox x:Name="TxtAiTechnicianPrompt" Height="46" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="10" FontWeight="Medium" TextWrapping="Wrap" AcceptsReturn="False" KeyDown="OnAiPromptKeyDown" Text="adb se read info lo"/>
                                            </Border>

                                            <!-- Prominent Full Width Send Button -->
                                            <Button x:Name="BtnAiAskAndPlan" Content="🚀 SEND PROMPT &amp; COMPILE SURGICAL WORKFLOW (ENTER)" Height="34" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" BorderThickness="0" Cursor="Hand" Click="OnAiAskAndPlanClicked"/>
                                            <TextBlock Text="💡 Tip: Type problem and press [Enter] to instantly generate verified surgical repair steps" FontSize="7.5" Foreground="#64748B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Autonomous Surgical Workflow & Permission Card (Collapsible) -->
                            <Border x:Name="BorderAiWorkflowCard" Visibility="Collapsed" Background="#0C1427" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtAiWorkflowTitle" Text="⚡ RECOMMENDED WORKFLOW: BASEBAND REPAIR" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <Border Background="#064E3B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtAiWorkflowRisk" Text="🛡️ RISK: MINIMAL (ZERO DATA LOSS)" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Diagnosed Fault Callout Box -->
                                    <Border Background="#161A26" CornerRadius="3" Padding="6,4" Margin="0,0,0,6" BorderBrush="#253248" BorderThickness="1">
                                        <TextBlock x:Name="TxtAiWorkflowIssue" Text="Diagnosed Fault: Null baseband / modem partition corruption detected." FontSize="8" Foreground="#F59E0B" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Step Checklist -->
                                    <TextBlock x:Name="TxtAiWorkflowSteps" Text="1. Dump EFS/NVRAM partition backup&#x0a;2. Flush modem corrupt sectors&#x0a;3. Write verified factory modem calibration&#x0a;4. Soft-reboot device into verified state" FontSize="8.5" Foreground="#CBD5E1" Margin="0,0,0,6" LineHeight="14"/>

                                    <Border Background="#1E293B" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtAiWorkflowSafety" Text="🛡️ Pre-Flight Guard: Automatic EFS / NVRAM backup will be committed to disk before write operations." FontSize="8" Foreground="#94A3B8"/>
                                    </Border>

                                    <!-- Permission Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnAiExecuteWorkflow" Grid.Column="0" Content="⚡ AUTHORIZE &amp; EXECUTE WORKFLOW" Height="28" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" BorderThickness="0" Cursor="Hand" Click="OnAiExecuteWorkflowClicked"/>
                                        <Button x:Name="BtnAiDismissWorkflow" Grid.Column="2" Content="✕ Dismiss" Height="28" Width="60" Background="#334155" Foreground="#CBD5E1" FontWeight="Bold" FontSize="9" BorderThickness="0" Click="OnAiDismissWorkflowClicked"/>
                                    </Grid>

                                    <!-- Execution Progress HUD -->
                                    <StackPanel x:Name="PanelAiWorkflowProgress" Visibility="Collapsed" Margin="0,4,0,0">
                                        <DockPanel Margin="0,2">
                                            <TextBlock x:Name="TxtAiWorkflowStepStatus" Text="Executing Step 1/4: Dumping EFS..." FontSize="8.5" Foreground="#38BDF8"/>
                                            <TextBlock x:Name="TxtAiWorkflowPct" Text="25%" FontSize="8.5" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="ProgressBarAiWorkflow" Height="4" Background="#1E293B" Foreground="#34D399" Value="25" Maximum="100"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Column: Dedicated AI Response Viewport & Hardware Hub -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Banner -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: 4 Detail Cards -->
                        <RowDefinition Height="*"/>    <!-- Row 2: AI Response Viewport & Hub -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header Banner with Copy Props button -->
                    <Border Grid.Row="0" Background="#161A26" CornerRadius="5" Padding="10,6" Margin="0,0,0,6" BorderBrush="#253248" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAiInspectorTitle" Text="🔬 AI HARDWARE TELEMETRY &amp; OS INTEGRITY REPORT" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                    <TextBlock x:Name="TxtAiInspectorModeBadge" Text="MODE: STANDBY" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                </Border>
                            </StackPanel>
                            <Button Content="📋 Copy Raw Props" Width="100" Height="22" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Click="OnAiCopyRawTelemetryClicked"/>
                        </DockPanel>
                    </Border>

                    <!-- Row 1: 4 Rich Detail Cards in 2x2 Grid -->
                    <Border Grid.Row="1" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Detail Card 1: Identity -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#0F172A" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="📱 DEVICE IDENTITY &amp; OS" FontSize="7.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TxtAiDetailIdentity" Text="Model: Waiting Scan... | OS: ? | CPU: ?" FontSize="8.5" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Border>

                            <!-- Detail Card 2: Firmware & Root -->
                            <Border Grid.Row="0" Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="🛡️ FIRMWARE INTEGRITY &amp; ROOT" FontSize="7.5" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock x:Name="TxtAiDetailRom" Text="Build: Waiting Scan... | Type: ? | Root: ?" FontSize="8.5" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Border>

                            <!-- Detail Card 3: Modem & Baseband -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#0F172A" CornerRadius="4" Padding="6,4">
                                <StackPanel>
                                    <TextBlock Text="📡 RADIO, MODEM &amp; BASEBAND" FontSize="7.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                    <TextBlock x:Name="TxtAiDetailBaseband" Text="Baseband: Waiting Scan... | SIM: ? | RIL: ?" FontSize="8.5" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Border>

                            <!-- Detail Card 4: Security & Knox -->
                            <Border Grid.Row="1" Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="6,4">
                                <StackPanel>
                                    <TextBlock Text="🔐 BOOTLOADER, KNOX &amp; FRP" FontSize="7.5" FontWeight="Bold" Foreground="#F43F5E"/>
                                    <TextBlock x:Name="TxtAiDetailSecurity" Text="Bootloader: ? | Knox: ? | FRP: ?" FontSize="8.5" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 2: Master AI Hub (Response Viewport & Protocol Terminal) -->
                    <Border Grid.Row="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Tab Strip -->
                                <RowDefinition Height="*"/>    <!-- Active Content Body -->
                            </Grid.RowDefinitions>

                            <!-- Navigation Sub-Tabs -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnAiSubTabResponse" Content="🤖 AI EXPERT RESPONSE" Height="26" Padding="12,0" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Cursor="Hand" Click="OnAiSubTabResponseClicked" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnAiSubTabTerminal" Content="⚡ EXECUTION LOGS" Height="26" Padding="12,0" Background="#1E293B" Foreground="#94A3B8" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Cursor="Hand" Click="OnAiSubTabTerminalClicked" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnAiSubTabProps" Content="🔬 RAW TELEMETRY" Height="26" Padding="12,0" Background="#1E293B" Foreground="#94A3B8" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Cursor="Hand" Click="OnAiSubTabPropsClicked"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnAiCopyContent" Content="📋 Copy Content" Width="95" Height="22" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Click="OnAiCopyContentClicked" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnAiClearContent" Content="✕ Clear View" Width="80" Height="22" Background="#1E293B" Foreground="#94A3B8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Click="OnAiClearContentClicked"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- View 1: Dedicated AI Assistant Response Panel (Active by Default) -->
                            <Border x:Name="PanelAiResponseView" Grid.Row="1" Background="#0A0E1A" CornerRadius="4" BorderBrush="#1E293B" BorderThickness="1" Padding="8" Visibility="Visible">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtAiResponseHeader" Text="🤖 BS LAB AI EXPERT ASSISTANT — INTELLIGENT HARDWARE &amp; GSM ADVICE" FontSize="9.5" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                                        <Border Background="#064E3B" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock Text="● NEURAL ENGINE ACTIVE" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBox x:Name="TxtAiAssistantResponse" Grid.Row="1" Style="{StaticResource DarkCyberConsoleTextBox}" Background="#0A0E1A" Foreground="#38BDF8" FontFamily="Consolas, Segoe UI" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="4" TextWrapping="Wrap" Text="[*] AI Co-Pilot Online &amp; Ready.&#x0a;Type any phone issue, terminal question, or hardware pinout query on the left and press [ENTER] or click [SEND PROMPT &amp; COMPILE SURGICAL WORKFLOW].&#x0a;&#x0a;The AI will immediately deliver complete step-by-step guidance, verified terminal commands, SoC protocols, and anti-brick safety precautions right here."/>
                                </Grid>
                            </Border>

                            <!-- View 2: Execution Logs Terminal Console -->
                            <Border x:Name="PanelAiTerminalView" Grid.Row="1" Background="#070709" CornerRadius="4" Padding="6" Visibility="Collapsed">
                                <TextBox x:Name="TxtAiAnalyseConsole" Style="{StaticResource DarkCyberConsoleTextBox}" Background="#070709" Foreground="#A5B4FC" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" TextWrapping="Wrap"/>
                            </Border>

                            <!-- View 3: Raw Telemetry Getprop Viewer -->
                            <Border x:Name="PanelAiPropsView" Grid.Row="1" Background="#070709" CornerRadius="4" Padding="6" Visibility="Collapsed">
                                <TextBox x:Name="TxtAiRawTelemetry" Style="{StaticResource DarkCyberConsoleTextBox}" Background="#070709" Foreground="#94A3B8" BorderThickness="0" FontFamily="Consolas" FontSize="9.5" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Text="[*] AI Telemetry Harvester Ready. Connect phone in ADB, Fastboot or EDL/BROM and click [1-CLICK AI DEEP DIAGNOSE]."/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ -->
            <!-- VIEW 1: MEDIATEK (MTK) PANE                                      -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewMtk" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Sub-Tabs Strip -->
                    <RowDefinition Height="*"/>    <!-- Main Body -->
                </Grid.RowDefinitions>

                <!-- ROW 0: SUB-TABS STRIP (FLASH VS META/DIAG ENGINE) -->
                <Border Grid.Row="0" Background="#0C1427" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSubTabFlash" Content="⚡ FLASH &amp; SERVICE" Height="26" Padding="12,0" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Cursor="Hand" Click="OnSubTabFlashClicked" Margin="0,0,4,0"/>
                            <Button x:Name="BtnSubTabPartitions" Content="📑 PARTITIONS MANAGER" Height="26" Padding="12,0" Background="#1E293B" Foreground="#94A3B8" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Cursor="Hand" Click="OnSubTabPartitionsClicked" Margin="0,0,4,0"/>
                            <Button x:Name="BtnSubTabMetaDiag" Content="🔬 META MODE REPAIR ENGINE" Height="26" Padding="12,0" Background="#1E293B" Foreground="#94A3B8" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Cursor="Hand" Click="OnSubTabMetaDiagClicked"/>
                        </StackPanel>
                        <Border Background="#064E3B" CornerRadius="3" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSubEngineStatus" Text="● ACTIVE: BROM / DA ENGINE" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ROW 1: SPLIT PANELS (LEFT CONTROLS + RIGHT DATA/LOGS) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: DYNAMIC ENGINES (FLASH / META / DIAG) -->
                    <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- ======================================================== -->
                                <!-- 1. ENGINE A: BROM / EDL FLASH & SERVICE (DEFAULT)        -->
                                <!-- ======================================================== -->
                                <StackPanel x:Name="PanelFlashEngine" Visibility="Visible">
                                    <!-- Platform Switcher Header -->
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtPlatformHeader" Text="❖ MEDIATEK (MTK) ENGINE" FontSize="11" FontWeight="Bold" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbPlatform" Style="{StaticResource DarkCyberComboBox}" Width="135" Height="24" HorizontalAlignment="Right" SelectionChanged="OnPlatformSelectionChanged">
                                            <ComboBoxItem Content="MediaTek (MTK)" IsSelected="True"/>
                                            <ComboBoxItem Content="Qualcomm (EDL)"/>
                                        </ComboBox>
                                    </DockPanel>

                                    <!-- Smart Model & Variant Selector Card -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="8" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="🎯 SMART MODEL &amp; VARIANT SELECTOR:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAutoLoaderBadge" Text="✓ Auto-Loader Configured" FontSize="9" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <!-- Brand and Model Dropdowns -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CmbBrandSelector" Style="{StaticResource DarkCyberComboBox}" IsTextSearchEnabled="True" Grid.Column="0" Height="26" SelectionChanged="OnBrandSelectionChanged"/>
                                                <ComboBox x:Name="CmbModelSelector" Style="{StaticResource DarkCyberComboBox}" IsTextSearchEnabled="True" Grid.Column="2" Height="26" SelectionChanged="OnModelSelectionChanged"/>
                                            </Grid>

                                            <!-- Detected Chipset & Testpoint Info Banner -->
                                            <Border Background="#0B0F19" CornerRadius="3" Padding="6,4">
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtSelectedModelInfo" Text="Select Brand &amp; Model (e.g. Oppo A37m MTK vs A37f QC)" FontSize="9" Foreground="#94A3B8"/>
                                                    <TextBlock x:Name="TxtSelectedTestpoint" Text="Testpoint: Hold Volume Down + Insert USB Cable" FontSize="9" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                                                        <!-- Security & Auth Bypass Suite (LED Style) -->
                                    <Border Background="#121722" CornerRadius="5" Padding="8,6" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock Text="🛡️ SECURITY &amp; AUTH BYPASS SUITE:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeBypassStatus" Background="#064E3B" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="TxtBypassStatus" Text="● BYPASS READY" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                                </Border>
                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Button 1: BROM Auth / SLA Bypass -->
                                                <Button x:Name="BtnBromAuthBypass" Grid.Column="0" Height="28" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Click="OnToggleBromAuthClicked" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="LedBromAuth" Text="●" FontSize="11" Foreground="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtBromAuthLabel" Text="BROM Auth / SLA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- Button 2: Preloader EMI Exploit -->
                                                <Button x:Name="BtnPreloaderExploit" Grid.Column="2" Height="28" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Click="OnTogglePreloaderExploitClicked" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="LedPreloader" Text="●" FontSize="11" Foreground="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtPreloaderLabel" Text="Preloader Exploit" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Hardware Port & Loader Selection -->
                                    <Border Background="#1A1A24" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtPortLabel" Text="TARGET HARDWARE PORT:" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBox x:Name="TxtPort" Text="" Background="#0F0F14" Foreground="#FFFFFF" BorderBrush="#2E2E40" Height="26" FontSize="11" Padding="5,3" Width="170" DockPanel.Dock="Left"/>
                                                <Button Content="Auto Detect" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Height="26" Margin="6,0,0,0" Click="OnAutoDetectClicked"/>
                                            </DockPanel>

                                            <!-- Loader / Firehose -->
                                            <TextBlock x:Name="TxtDaLabel" Text="CUSTOM DOWNLOAD AGENT (DA):" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBox x:Name="TxtDaPath" Text="resources/loaders/mtk/Redmi_14c.13.13c.15c_android15.da" Background="#0F0F14" Foreground="#CBD5E1" BorderBrush="#2E2E40" Height="26" FontSize="10" Padding="5,3"/>
                                                <Button x:Name="BtnBrowseDa" Content="Browse" Width="55" Background="#334155" Foreground="#FFFFFF" BorderThickness="0" Height="26" Margin="6,0,0,0" DockPanel.Dock="Right" Click="OnBrowseDaClicked"/>
                                            </DockPanel>

                                            <!-- Scatter / OFP / OZIP / Raw Firmware -->
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock x:Name="TxtScatterLabel" Text="FIRMWARE FILE (SCATTER / OFP / OZIP):" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <TextBlock Text=".txt | .ofp | .ozip | .bin" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBox x:Name="TxtScatterPath" Text="Select Android_scatter.txt, OFP, OZIP or Raw Firmware Image" Background="#0F0F14" Foreground="#94A3B8" BorderBrush="#2E2E40" Height="26" FontSize="10" Padding="5,3"/>
                                                <Button x:Name="BtnBrowseScatter" Content="Browse" Width="55" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Height="26" Margin="6,0,0,0" DockPanel.Dock="Right" Click="OnBrowseScatterClicked"/>
                                            </DockPanel>
                                            <Button x:Name="BtnFlashFirmware" Content="⚡ FLASH FIRMWARE (WRITE PARTITIONS)" Height="28" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,2,0,0" Click="OnFlashFirmwareClicked" Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Section 1: Hardware Protocol & Handshake -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtActionsHeader" Text="HARDWARE PROTOCOL &amp; DA ACTIONS:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="4,2,0,4"/>
                                            <Button x:Name="BtnMtkReadInfo" Content="🔍 Read Info (Hardware Telemetry)" Style="{StaticResource CyberBulletButton}" Click="OnMtkReadInfoClicked" Margin="0,0,0,2"/>
                                            <Button x:Name="BtnHandshake" Content="Phase 1: Sync Handshake (BROM / Sahara)" Style="{StaticResource CyberBulletButton}" Click="OnHandshakeClicked"/>
                                            <Button x:Name="BtnLoadDa" Content="Phase 2: Load Download Agent / Firehose" Style="{StaticResource CyberBulletButton}" Click="OnLoadDaClicked"/>
                                            <Button x:Name="BtnReadGpt" Content="Read Partition Table (Live GPT Sectors)" Style="{StaticResource CyberBulletButton}" Click="OnReadGptClicked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Section 2: Recommended 1-Click Operations -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtOneClickHeader" Text="RECOMMENDED 1-CLICK SERVICING (MTK):" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="4,2,0,4"/>
                                            <Button x:Name="BtnResetFrp" Content="Reset FRP Lock (Google Account)" Style="{StaticResource CyberBulletButton}" Click="OnResetFrpClicked"/>
                                            <Button x:Name="BtnMiAccount" Content="Bypass Mi Account (Cloud Lock Safe)" Style="{StaticResource CyberBulletButton}" Click="OnResetMiAccountClicked"/>
                                            <Button x:Name="BtnFactoryReset" Content="Factory Reset (Safe Userdata Format)" Style="{StaticResource CyberBulletButton}" Click="OnFactoryResetClicked"/>
                                            <Button x:Name="BtnUnlockBl" Content="Unlock Bootloader (Instant BROM / EDL)" Style="{StaticResource CyberBulletButton}" Click="OnUnlockBootloaderClicked"/>
                                            <Button x:Name="BtnRelockBl" Content="Relock Bootloader" Style="{StaticResource CyberBulletButton}" Click="OnRelockBlClicked"/>
                                            <Button x:Name="BtnDemoMode" Content="Remove Retail Demo Mode (Vivo/Oppo)" Style="{StaticResource CyberBulletButton}" Click="OnDemoModeClicked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Section 3: NVRAM & Baseband / IMEI Calibration -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtSecurityHeader" Text="NVRAM, BASEBAND &amp; IMEI PROTECTION:" FontSize="9" FontWeight="Bold" Foreground="#34D399" Margin="4,2,0,4"/>
                                            <Button x:Name="BtnBackupNvram" Content="Backup Security / NVRAM / QCN / EFS" Style="{StaticResource CyberBulletButton}" Click="OnBackupNvramClicked"/>
                                            <Button x:Name="BtnRestoreNvram" Content="Restore Security / NVRAM / QCN / EFS" Style="{StaticResource CyberBulletButton}" Click="OnRestoreNvramClicked"/>
                                            <Button x:Name="BtnRepairBaseband" Content="Repair Baseband Unknown / Fix Null IMEI" Style="{StaticResource CyberBulletButton}" Click="OnRepairBasebandClicked"/>
                                            <Button x:Name="BtnReboot" Content="Hardware Watchdog Reboot Device" Style="{StaticResource CyberBulletButton}" Click="OnRebootClicked"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ======================================================== -->
                                <!-- 2. ENGINE B: MEDIATEK META MODE SUITE                    -->
                                <!-- ======================================================== -->
                                <StackPanel x:Name="PanelMetaEngine" Visibility="Collapsed">
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#00D2FF" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock Text="🔬 MEDIATEK META MODE REPAIR ENGINE" FontSize="10" FontWeight="Bold" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                            <Border Background="#064E3B" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                <TextBlock Text="● META: READY" FontSize="7.5" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <!-- META Connection & Port -->
                                    <Border Background="#1A1A24" CornerRadius="5" Padding="6,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="TARGET META HARDWARE PORT:" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,0,3"/>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBox x:Name="TxtMetaPort" Text="" Background="#0F0F14" Foreground="#FFFFFF" BorderBrush="#2E2E40" Height="24" FontSize="11" Padding="5,2" Width="170" DockPanel.Dock="Left"/>
                                                <Button Content="Auto Detect" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Height="24" Margin="6,0,0,0" Click="OnAutoDetectClicked"/>
                                            </DockPanel>
                                            <Button Content="Reboot Phone to META Mode (BROM / Preloader)" Style="{StaticResource CyberBulletButton}" Click="OnMetaRebootClicked"/>
                                            <Button Content="Read META Hardware Info &amp; Baseband" Style="{StaticResource CyberBulletButton}" Click="OnMetaReadInfoClicked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- META Dual IMEI Calibration -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📶 META DUAL IMEI REPAIR (NVRAM / NVDATA):" FontSize="9" FontWeight="Bold" Foreground="#34D399" Margin="4,0,0,4"/>
                                            <TextBlock Text="IMEI 1 (Primary SIM):" FontSize="8.5" Foreground="#CBD5E1" Margin="4,0,0,1"/>
                                            <TextBox x:Name="TxtMetaImei1" Text="867462056766425" Height="24" Background="#0F0F14" Foreground="#34D399" BorderBrush="#2E2E40" FontSize="10.5" FontWeight="Bold" Padding="5,2" Margin="0,0,0,4"/>
                                            <TextBlock Text="IMEI 2 (Secondary SIM):" FontSize="8.5" Foreground="#CBD5E1" Margin="4,0,0,1"/>
                                            <TextBox x:Name="TxtMetaImei2" Text="867462056766600" Height="24" Background="#0F0F14" Foreground="#34D399" BorderBrush="#2E2E40" FontSize="10.5" FontWeight="Bold" Padding="5,2" Margin="0,0,0,4"/>
                                            <Button Content="Write Dual IMEI (Permanent Hardware NV)" Style="{StaticResource CyberBulletButton}" Click="OnMetaWriteImeiClicked"/>
                                            <Button Content="Read Dual IMEI from Connected Phone" Style="{StaticResource CyberBulletButton}" Click="OnMetaReadImeiClicked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- META Factory Operations & NVRAM DB -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🛠️ META FACTORY OPERATIONS:" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="4,0,0,4"/>
                                            <Button Content="META Safe Factory Reset (Anti-Relock)" Style="{StaticResource CyberBulletButton}" Click="OnMetaFactoryResetClicked"/>
                                            <Button Content="Backup NVRAM Database (MD1_DB / AP_DB)" Style="{StaticResource CyberBulletButton}" Click="OnMetaBackupNvramClicked"/>
                                            <Button Content="Restore NVRAM Database to Phone" Style="{StaticResource CyberBulletButton}" Click="OnMetaRestoreNvramClicked"/>
                                            <Button Content="Exit META Mode (Reboot to Normal OS)" Style="{StaticResource CyberBulletButton}" Click="OnMetaExitClicked"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ======================================================== -->
                                <!-- 3. ENGINE C: QUALCOMM DIAGNOSTIC (DIAG) SUITE             -->
                                <!-- ======================================================== -->
                                <StackPanel x:Name="PanelDiagEngine" Visibility="Collapsed">
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#F59E0B" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock Text="🔬 QUALCOMM DIAGNOSTIC (DIAG 900E/901D) ENGINE" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            <Border Background="#064E3B" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                <TextBlock Text="● DIAG: ACTIVE" FontSize="7.5" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <!-- Diag Port & Activation -->
                                    <Border Background="#1A1A24" CornerRadius="5" Padding="6,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="TARGET QUALCOMM DIAG PORT:" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,0,3"/>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBox x:Name="TxtDiagPort" Text="" Background="#0F0F14" Foreground="#FFFFFF" BorderBrush="#2E2E40" Height="24" FontSize="11" Padding="5,2" Width="170" DockPanel.Dock="Left"/>
                                                <Button Content="Auto Detect" Background="#D97706" Foreground="#FFFFFF" BorderThickness="0" Height="24" Margin="6,0,0,0" Click="OnAutoDetectClicked"/>
                                            </DockPanel>
                                            <Button Content="Enable Diag Port (*#*#717717#*#* / AT Modem)" Style="{StaticResource CyberBulletButton}" Click="OnDiagEnablePortClicked"/>
                                            <Button Content="Read Live Diag Info (Baseband &amp; Hardware)" Style="{StaticResource CyberBulletButton}" Click="OnDiagReadInfoClicked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Qualcomm IMEI & MEID Calibration -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📶 QUALCOMM NV ITEMS &amp; IMEI CALIBRATION:" FontSize="9" FontWeight="Bold" Foreground="#34D399" Margin="4,0,0,4"/>
                                            <TextBlock Text="MEID / PESN (Optional):" FontSize="8.5" Foreground="#CBD5E1" Margin="4,0,0,1"/>
                                            <TextBox x:Name="TxtDiagMeid" Text="" Height="24" Background="#0F0F14" Foreground="#38BDF8" BorderBrush="#2E2E40" FontSize="10" Padding="5,2" Margin="0,0,0,4"/>
                                            <TextBlock Text="IMEI 1 (Physical SIM / Primary):" FontSize="8.5" Foreground="#CBD5E1" Margin="4,0,0,1"/>
                                            <TextBox x:Name="TxtDiagImei1" Text="" Height="24" Background="#0F0F14" Foreground="#34D399" BorderBrush="#2E2E40" FontSize="10.5" FontWeight="Bold" Padding="5,2" Margin="0,0,0,4"/>
                                            <TextBlock Text="IMEI 2 (Optional / eSIM / Dual SIM):" FontSize="8.5" Foreground="#CBD5E1" Margin="4,0,0,1"/>
                                            <TextBox x:Name="TxtDiagImei2" Text="" Height="24" Background="#0F0F14" Foreground="#34D399" BorderBrush="#2E2E40" FontSize="10.5" FontWeight="Bold" Padding="5,2" Margin="0,0,0,4"/>
                                            <Button Content="Write Diag IMEI (NVRAM Items)" Style="{StaticResource CyberBulletButton}" Click="OnDiagWriteImeiClicked"/>
                                            <Button Content="Read Diag IMEI from Phone" Style="{StaticResource CyberBulletButton}" Click="OnDiagReadImeiClicked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- QCN Network Calibration & EFS Reset -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="6,6" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="💾 QCN &amp; EFS NETWORK REPAIR:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="4,0,0,4"/>
                                            <Button Content="Read QCN Backup from Phone" Style="{StaticResource CyberBulletButton}" Click="OnDiagBackupQcnClicked"/>
                                            <Button Content="Write QCN Calibration File" Style="{StaticResource CyberBulletButton}" Click="OnDiagRestoreQcnClicked"/>
                                            <Button Content="Wipe &amp; Reset Corrupted EFS (Modemst1/2)" Style="{StaticResource CyberBulletButton}" Click="OnDiagResetEfsClicked"/>
                                            <Button Content="Diag Reboot Device (Soft-Reset to Normal OS)" Style="{StaticResource CyberBulletButton}" Click="OnDiagRebootClicked"/>
                                            <Button Content="Exit Diag &amp; Restore Radio Power (Normal Boot)" Style="{StaticResource CyberBulletButton}" Click="OnDiagExitAndRestoreRadioClicked"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Universal Progress HUD (Shared Across All Sub-Engines) -->
                                <Border Background="#1A1A24" CornerRadius="5" Padding="8" Margin="0,2,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock x:Name="TxtProgressStatus" Text="Ready for operation" FontSize="10" Foreground="#CBD5E1" DockPanel.Dock="Left"/>
                                            <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="10" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="ProgressBar" Height="6" Background="#27272A" Foreground="#00D2FF" Value="0" Maximum="100"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- RIGHT COLUMN: 100% PURE & UPGRADED PARTITION MANAGER + LIVE LOGS -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Dual Live Hardware Notification Radar Dock -->
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="240"/>  <!-- Row 2: Partition Manager -->
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>    <!-- Row 4: Live Log Console -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: DUAL LIVE HARDWARE NOTIFICATION RADAR DOCK (COM PORT & USB DEVICE) -->
                        <Border Grid.Row="0" Background="#0C101C" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/> <!-- Box 1: COM Port Box -->
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="1.5*"/> <!-- Box 2: USB Interface Box -->
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- BOX 1: CONNECTED COM PORT WITH LIVE LED LIGHT -->
                                <Border Grid.Column="0" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                    <DockPanel>
                                        <Ellipse x:Name="LedMtkCom" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowMtkCom" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Border x:Name="BadgeMtkCom" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtMtkComState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🔌 COM PORT BUS" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtMtkComBox" Text="NO COM PORT DETECTED" FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- BOX 2: CONNECTED USB INTERFACE WITH LIVE LED LIGHT -->
                                <Border Grid.Column="2" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                    <DockPanel>
                                        <Ellipse x:Name="LedMtkUsb" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowMtkUsb" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Border x:Name="BadgeMtkUsb" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtMtkUsbState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="⚡ USB DEVICE / MODE" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtMtkUsbBox" Text="WAITING FOR USB CONNECTION..." FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- ACTION BUTTONS: SCAN, ABORT & CLEAR -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🔍 Scan" Height="28" Padding="10,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnAutoDetectClicked"/>
                                    <Button Content="⛔ ABORT" Height="28" Padding="10,0" Background="#991B1B" Foreground="#FECACA" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnEmergencyAbortClicked"/>
                                    <Button Content="Clear Console" Height="28" Padding="10,0" Background="#1E1E2A" Foreground="#94A3B8" FontSize="10" BorderThickness="0" Click="OnClearLogClicked"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- TOP: UPGRADED PARTITION MANAGER -->
                        <Border Grid.Row="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Partition Manager Header Controls -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📑 PARTITION MANAGER (LIVE GPT / FIREHOSE)" FontSize="10" FontWeight="Bold" Foreground="#2DD4BF" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPartCount" Text=" (0 Partitions Loaded)" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Search Filter Box -->
                                        <TextBox x:Name="TxtPartitionSearch" Width="120" Height="22" Background="#0B0F19" Foreground="#CBD5E1" BorderBrush="#1E293B" Padding="4,2" FontSize="9" VerticalContentAlignment="Center" Margin="0,0,4,0" TextChanged="OnPartitionSearchTextChanged"/>
                                        <Button Content="☑️ All" Width="36" Height="22" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Margin="0,0,3,0" Click="OnSelectAllPartitionsClicked"/>
                                        <Button Content="◻️ None" Width="42" Height="22" Background="#1E293B" Foreground="#94A3B8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Margin="0,0,3,0" Click="OnDeselectAllPartitionsClicked"/>
                                        <Button Content="🔄 Reload" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Height="22" Padding="6,0" Margin="0,0,3,0" Click="OnReloadGptClicked"/>
                                        <Button Content="💾 Dump Selected" Background="#0284C7" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Height="22" Padding="6,0" Margin="0,0,3,0" Click="OnDumpSelectedClicked"/>
                                        <Button Content="✍️ Flash Single" Background="#7C3AED" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Height="22" Padding="6,0" Margin="0,0,3,0" Click="OnFlashSinglePartitionClicked"/>
                                        <Button Content="🗑️ Erase Selected" Background="#7F1D1D" Foreground="#FCA5A5" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Height="22" Padding="6,0" Click="OnEraseSelectedClicked"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Pure Upgraded Partition DataGrid -->
                                <DataGrid x:Name="GridPartitions" Grid.Row="1" AutoGenerateColumns="False" 
                                          Background="#0A0A0E" RowBackground="#111118" AlternatingRowBackground="#161622" 
                                          Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" 
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#222232" 
                                          ColumnHeaderStyle="{StaticResource CyberColumnHeader}"
                                          CellStyle="{StaticResource CyberCell}"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsChecked}" Width="35"/>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="35"/>
                                        <DataGridTextColumn Header="Partition Name" Binding="{Binding Name}" Width="130" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Start LBA" Binding="{Binding StartLba}" Width="95"/>
                                        <DataGridTextColumn Header="End LBA" Binding="{Binding EndLba}" Width="95"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeStr}" Width="80" Foreground="#34D399"/>
                                        <DataGridTextColumn Header="Filesystem" Binding="{Binding Filesystem}" Width="90" Foreground="#38BDF8"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" Foreground="#F59E0B"/>
                                        <DataGridTextColumn Header="Sectors" Binding="{Binding SectorCount}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- BOTTOM: LIVE HARDWARE DIAGNOSTICS & PROTOCOL CONSOLE -->
                        <Border Grid.Row="4" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="LIVE HARDWARE DIAGNOSTICS &amp; ENGINE LOG" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <Button Content="Clear" Width="55" Height="20" Background="#1E1E2A" Foreground="#94A3B8" BorderThickness="0" HorizontalAlignment="Right" Click="OnClearLogClicked"/>
                                </DockPanel>

                                <TextBox x:Name="TxtLogConsole" Grid.Row="1" Background="#0A0A0E" Foreground="#CBD5E1" 
                                         BorderBrush="#1E1E28" BorderThickness="1" FontFamily="Consolas, Courier New" 
                                         FontSize="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                         IsReadOnly="True" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- VIEW 2: FASTBOOT & ADB UNIVERSAL SUITE PANE                       -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewFastboot" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/> <!-- Left Checklist Actions Card -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>   <!-- Right Console & Command Runner -->
                </Grid.ColumnDefinitions>

                <!-- Left: Sub-Tabs & Action Checklist -->
                <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Sub-Tabs: ADB vs FASTBOOT -->
                            <RowDefinition Height="*"/>    <!-- Scrollable Action Button List -->
                        </Grid.RowDefinitions>

                        <!-- Sub-Tabs: [ADB] and [FASTBOOT] (Matches exact screenshot styling) -->
                        <Border Grid.Row="0" Background="#1A1A24" CornerRadius="3" Padding="2" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnSubTabAdb" Grid.Column="0" Content="ADB" Style="{StaticResource SubTabButtonActive}" Click="OnSubTabAdbClicked"/>
                                <Button x:Name="BtnSubTabFastboot" Grid.Column="1" Content="FASTBOOT" Style="{StaticResource SubTabButtonInactive}" Margin="3,0,0,0" Click="OnSubTabFastbootClicked"/>
                            </Grid>
                        </Border>

                        <!-- Action Lists Container -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- ADB Action Checklist (Exact 15 items from screenshot) -->
                                <StackPanel x:Name="PanelAdbActions" Visibility="Visible">
                                    <Button Content="ADB Read Info" Style="{StaticResource CyberBulletButton}" Click="OnAdbGetpropClicked"/>
                                    <Button Content="ADB Reboot to Fastboot" Style="{StaticResource CyberBulletButton}" Click="OnAdbRebootFastbootClicked"/>
                                    <Button Content="ADB Reboot to Recovery" Style="{StaticResource CyberBulletButton}" Click="OnAdbRebootRecoveryClicked"/>
                                    <Button Content="ADB Reboot to EDL" Style="{StaticResource CyberBulletButton}" Click="OnAdbRebootEdlClicked"/>
                                    <Button Content="ADB Reboot to META (MTK)" Style="{StaticResource CyberBulletButton}" Click="OnAdbRebootMetaClicked"/>
                                    <Button Content="ADB Restart Device" Style="{StaticResource CyberBulletButton}" Click="OnAdbRebootSystemClicked"/>
                                    <Button Content="ADB ShutDown Device" Style="{StaticResource CyberBulletButton}" Click="OnAdbPowerOffClicked"/>
                                    <Button Content="ADB Factory Reset (old Android)" Style="{StaticResource CyberBulletButton}" Click="OnAdbFactoryResetOldClicked"/>
                                    <Button Content="ADB Remove FRP Lock (ADB)" Style="{StaticResource CyberBulletButton}" Click="OnAdbResetFrpClicked"/>
                                    <Button Content="Xiaomi Enable Diag (ADB)" Style="{StaticResource CyberBulletButton}" Click="OnAdbEnableDiagClicked"/>
                                    <Button Content="Install APK (Adb)" Style="{StaticResource CyberBulletButton}" Click="OnAdbInstallApkClicked"/>
                                    <Button Content="⚡ ADB Sideload OTA Package (.ZIP)" Style="{StaticResource CyberBulletButton}" Foreground="#38BDF8" Click="OnAdbSideloadOtaClicked"/>
                                    <Button Content="Disable PayJoy APP (ADB)" Style="{StaticResource CyberBulletButton}" Click="OnAdbDisablePayjoyClicked"/>
                                    <Button Content="Vivo Demo Remove (MT6877T)" Style="{StaticResource CyberBulletButton}" Click="OnAdbVivoDemoClicked"/>
                                    <Button Content="Vivo Demo Remove (AT)" Style="{StaticResource CyberBulletButton}" Click="OnAdbVivoDemoAtClicked"/>
                                    <Button Content="RealME (Wireless Test Assistant mode) Disable" Style="{StaticResource CyberBulletButton}" Click="OnAdbRealmeDisableClicked"/>
                                    <Button Content="⚡ 1-Click Auto-Patch &amp; Root (Magisk Fastboot)" Style="{StaticResource CyberBulletButton}" Foreground="#A78BFA" Click="OnFastbootAutoMagiskRootClicked"/>
                                </StackPanel>

                                <!-- FASTBOOT Action Checklist (Exact 12 items from screenshot) -->
                                <StackPanel x:Name="PanelFastbootActions" Visibility="Collapsed">
                                    <!-- 1-Click Magisk Auto-Patcher & Root Engine (Unlocked Bootloader) -->
                                    <Border Background="#161A26" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderBrush="#7C3AED" BorderThickness="1.5">
                                        <StackPanel>
                                            <TextBlock Text="⚡ 1-CLICK MAGISK AUTO-PATCHER &amp; ROOT ENGINE" FontSize="9.5" FontWeight="ExtraBold" Foreground="#A78BFA" Margin="0,0,0,3"/>
                                            <TextBlock Text="Zero Database Required: Auto-dumps from live phone or extracts from OTA/Firmware." FontSize="8" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                            <!-- Extracted Boot Badge -->
                                            <Border Background="#0D1117" CornerRadius="4" Padding="6,4" Margin="0,0,0,6" BorderBrush="#30363D" BorderThickness="1">
                                                <TextBlock x:Name="TxtMagiskBootInfo" Text="📦 Boot Image: (Not loaded - click Dump or Extract below)" FontSize="8" Foreground="#F59E0B" TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- Two Smart Auto-Extractor Buttons -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="📥 Auto-Dump Phone" Height="26" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="8" BorderBrush="#38BDF8" BorderThickness="1" Click="OnAutoDumpBootFromDeviceClicked" ToolTip="Dumps active boot partition live from connected phone via ADB / Fastboot"/>
                                                <Button Grid.Column="2" Content="📦 Extract OTA/ZIP" Height="26" Background="#1E293B" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="8" BorderBrush="#F43F5E" BorderThickness="1" Click="OnAutoExtractBootFromFirmwareClicked" ToolTip="Auto-extracts boot.img from OTA zip (payload.bin), Factory zip, or Samsung tar in 3 seconds"/>
                                            </Grid>

                                            <CheckBox x:Name="ChkMagiskTempBootOnly" Content="Temporary Boot Only (Safe - Zero Flash Risk)" IsChecked="True" Foreground="#CBD5E1" FontSize="8.5" Margin="0,0,0,6"/>
                                            <Button Content="🚀 Auto-Patch &amp; Root via Magisk" Height="28" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Click="OnFastbootAutoMagiskRootClicked"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="Fastboot Read Info" Style="{StaticResource CyberBulletButton}" Click="OnFastbootReadInfoClicked"/>
                                    <Button Content="Exit Fastboot Mode" Style="{StaticResource CyberBulletButton}" Click="OnFastbootExitClicked"/>
                                    <Button Content="Fastboot Flash Partition" Style="{StaticResource CyberBulletButton}" Click="OnFastbootFlashPartitionClicked"/>
                                    <Button Content="Fastboot Set Active Slot [A]" Style="{StaticResource CyberBulletButton}" Click="OnSetSlotAClicked"/>
                                    <Button Content="Fastboot Set Active Slot [B]" Style="{StaticResource CyberBulletButton}" Click="OnSetSlotBClicked"/>
                                    <Button Content="Fastboot Reboot Recovery (Nokia)" Style="{StaticResource CyberBulletButton}" Click="OnFastbootRebootRecoveryNokiaClicked"/>
                                    <Button Content="Fastboot Reboot FastbootD (Nokia)" Style="{StaticResource CyberBulletButton}" Click="OnFastbootRebootFastbootdNokiaClicked"/>
                                    <Button Content="Fastboot OEM EDL (BL-Unlocked)" Style="{StaticResource CyberBulletButton}" Click="OnFastbootOemEdlClicked"/>
                                    <Button Content="Fastboot WIPE EFS (BL-Unlocked)" Style="{StaticResource CyberBulletButton}" Click="OnFastbootWipeEfsClicked"/>
                                    <Button Content="⚡ Flash Google Factory Image (flash-all.bat)" Style="{StaticResource CyberBulletButton}" Foreground="#F59E0B" Click="OnFastbootFlashAllClicked"/>

                                    <!-- Spacing before lower group (matches screenshot) -->
                                    <Border Height="1" Background="#232332" Margin="4,24,4,16"/>

                                    <Button Content="Fastboot Fix DM-Verity Error" Style="{StaticResource CyberBulletButton}" Click="OnFastbootFixDmVerityClicked"/>
                                    <Button Content="Generic Fastboot G-Lock Wipe" Style="{StaticResource CyberBulletButton}" Click="OnFastbootGLockWipeClicked"/>
                                    <Button Content="Generic Fastboot Factory Reset" Style="{StaticResource CyberBulletButton}" Click="OnFastbootFactoryResetClicked"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: Console & Command Runner -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Device Status & Command Runner Bar: DUAL LIVE HARDWARE NOTIFICATION RADAR -->
                    <Border Grid.Row="0" Background="#0C101C" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Dual Live Hardware Notification Radar Dock -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/> <!-- Box 1: COM Port Box -->
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="1.5*"/> <!-- Box 2: USB Interface Box -->
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- BOX 1: CONNECTED COM PORT WITH LIVE LED LIGHT -->
                                <Border Grid.Column="0" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                    <DockPanel>
                                        <Ellipse x:Name="LedFastbootCom" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowFastbootCom" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Border x:Name="BadgeFastbootCom" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtFastbootComState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🔌 COM PORT BUS" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtFastbootComBox" Text="NO COM PORT DETECTED" FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- BOX 2: CONNECTED USB INTERFACE WITH LIVE LED LIGHT -->
                                <Border Grid.Column="2" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                    <DockPanel>
                                        <Ellipse x:Name="LedFastbootUsb" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowFastbootUsb" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Border x:Name="BadgeFastbootUsb" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtFastbootUsbState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="⚡ USB DEVICE / MODE" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtFastbootUsbBox" Text="WAITING FOR USB CONNECTION..." FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- ACTION BUTTONS: CHECK, ABORT & CLEAR -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAdbStatus" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TxtAdbDeviceSerial" Visibility="Collapsed"/>
                                    <Button Content="🔍 Check" Height="28" Padding="10,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnCheckAdbClicked"/>
                                    <Button Content="⛔ ABORT" Height="28" Padding="10,0" Background="#991B1B" Foreground="#FECACA" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnEmergencyAbortClicked"/>
                                    <Button Content="Clear Console" Height="28" Padding="10,0" Background="#1E1E2A" Foreground="#94A3B8" FontSize="10" BorderThickness="0" Click="OnClearLogClicked"/>
                                </StackPanel>
                            </Grid>

                            <!-- Direct Shell Command Runner -->
                            <DockPanel Grid.Row="1">
                                <TextBlock Text="COMMAND:" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtAdbShellInput" Text="getprop ro.build.version.release" Background="#0A0A0E" Foreground="#FFFFFF" BorderBrush="#2E2E40" Height="28" FontSize="11" Padding="6,4"/>
                                <Button Content="▶ Run" Width="70" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Height="28" Margin="6,0,0,0" DockPanel.Dock="Right" Click="OnAdbRunShellClicked"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Console for Fastboot & ADB -->
                    <Border Grid.Row="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="FASTBOOT &amp; ADB TERMINAL OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="TxtAdbConsole" Grid.Row="1" Background="#070709" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ -->
            <!-- VIEW 3: SAMSUNG DUAL-ENGINE SUITE (MTP & ODIN)                   -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewSamsung" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/> <!-- Left Sub-Tabs & Actions -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>   <!-- Right Console & Diagnostics -->
                </Grid.ColumnDefinitions>

                <!-- Left: Sub-Tabs & Action Panel -->
                <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Sub-Tabs: MTP vs ODIN -->
                            <RowDefinition Height="*"/>    <!-- Scrollable Panel Container -->
                        </Grid.RowDefinitions>

                        <!-- Sub-Tabs: [ MTP SERVICE ], [ ODIN FLASHER ], and [ 📑 PIT DOCTOR & DB ] -->
                        <Border Grid.Row="0" Background="#1A1A24" CornerRadius="3" Padding="2" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnSamsungSubTabMtp" Grid.Column="0" Content="MTP SERVICE" Style="{StaticResource SubTabButtonActive}" Click="OnSamsungSubTabMtpClicked"/>
                                <Button x:Name="BtnSamsungSubTabOdin" Grid.Column="1" Content="ODIN FLASHER" Style="{StaticResource SubTabButtonInactive}" Margin="2,0,0,0" Click="OnSamsungSubTabOdinClicked"/>
                                <Button x:Name="BtnSamsungSubTabPit" Grid.Column="2" Content="📑 PIT DOCTOR &amp; DB" Style="{StaticResource SubTabButtonInactive}" Margin="2,0,0,0" Click="OnSamsungSubTabPitClicked"/>
                            </Grid>
                        </Border>

                        <!-- Panel Container -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- PANEL 1: MTP MODE SERVICE SUITE -->
                                <StackPanel x:Name="PanelSamsungMtp" Visibility="Visible">
                                    <TextBlock Text="SAMSUNG MTP / AT DIAGNOSTIC SUITE:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="4,2,0,6"/>

                                    <Button Content="Samsung Read Device Info (MTP)" Style="{StaticResource CyberBulletButton}" Click="OnSamsungMtpReadInfoClicked"/>
                                    <Button Content="Samsung Enable ADB (*#0*# Test Mode)" Style="{StaticResource CyberBulletButton}" Click="OnSamsungEnableAdbClicked"/>
                                    <Button Content="Samsung Reset FRP (MTP 2023/2024)" Style="{StaticResource CyberBulletButton}" Click="OnSamsungMtpFrpClicked"/>
                                    <Button Content="Samsung Reset FRP (New Security 2025/2026)" Style="{StaticResource CyberBulletButton}" Click="OnSamsungMtpFrpNewClicked"/>
                                    <Button Content="Samsung Factory Reset (Safe MTP Wipe)" Style="{StaticResource CyberBulletButton}" Click="OnSamsungMtpFactoryResetClicked"/>
                                    
                                    <Border Height="1" Background="#232332" Margin="4,10,4,10"/>
                                    <TextBlock Text="REBOOT MODES &amp; UTILITIES:" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="4,0,0,6"/>

                                    <Button Content="Samsung Reboot to Download Mode (Odin Mode)" Style="{StaticResource CyberBulletButton}" Click="OnSamsungRebootDownloadClicked"/>
                                    <Button Content="Samsung Reboot to Recovery Mode" Style="{StaticResource CyberBulletButton}" Click="OnSamsungRebootRecoveryClicked"/>
                                    <Button Content="Samsung Reboot Device (Normal)" Style="{StaticResource CyberBulletButton}" Click="OnSamsungRebootSystemClicked"/>
                                    <Button Content="Samsung Disable Factory Mode / Retail Demo" Style="{StaticResource CyberBulletButton}" Click="OnSamsungDisableDemoClicked"/>
                                    <Button Content="Samsung Read PIT Table (MTP Mode)" Style="{StaticResource CyberBulletButton}" Click="OnSamsungReadPitMtpClicked"/>
                                </StackPanel>

                                <!-- PANEL 2: ODIN MULTI-DOWNLOADER FLASHER -->
                                <StackPanel x:Name="PanelSamsungOdin" Visibility="Collapsed">
                                    <TextBlock Text="🏢 SAMSUNG ODIN 4/5-FILE FLASHER (V3.14 ENGINE):" FontSize="9" FontWeight="Bold" Foreground="#00D2FF" Margin="0,2,0,6"/>

                                    <!-- Quick Model / PIT Selector inside Odin Flasher (Hybrid Pillar 2) -->
                                    <Border Background="#161A26" CornerRadius="4" Padding="6,4" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🎯 MODEL PIT:" FontSize="8.5" FontWeight="Bold" Foreground="#2DD4BF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="CmbOdinModelPit" Style="{StaticResource DarkCyberComboBox}" Grid.Column="1" Height="24" SelectionChanged="OnOdinModelPitSelected"/>
                                            <Button Grid.Column="2" Content="📑 Inspect" ToolTip="Inspect in PIT Doctor Studio" Width="55" Height="24" Margin="4,0,0,0" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Click="OnOdinInspectPitClicked"/>
                                        </Grid>
                                    </Border>

                                    <!-- BL (Bootloader) -->
                                    <DockPanel Margin="0,0,0,5">
                                        <CheckBox x:Name="ChkOdinBl" Content="BL:" Width="50" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                        <Button Content="Browse" Width="55" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="24" Margin="5,0,0,0" DockPanel.Dock="Right" Click="OnBrowseOdinBlClicked"/>
                                        <TextBox x:Name="TxtOdinBl" Text="Select BL_*.tar.md5" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="24" FontSize="10" Padding="5,2"/>
                                    </DockPanel>

                                    <!-- AP (System & Data) -->
                                    <DockPanel Margin="0,0,0,5">
                                        <CheckBox x:Name="ChkOdinAp" Content="AP:" Width="50" Foreground="#34D399" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                        <Button Content="Browse" Width="55" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="24" Margin="5,0,0,0" DockPanel.Dock="Right" Click="OnBrowseOdinApClicked"/>
                                        <TextBox x:Name="TxtOdinAp" Text="Select AP_*.tar.md5" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="24" FontSize="10" Padding="5,2"/>
                                    </DockPanel>

                                    <!-- CP (Modem / Baseband) -->
                                    <DockPanel Margin="0,0,0,5">
                                        <CheckBox x:Name="ChkOdinCp" Content="CP:" Width="50" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                        <Button Content="Browse" Width="55" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="24" Margin="5,0,0,0" DockPanel.Dock="Right" Click="OnBrowseOdinCpClicked"/>
                                        <TextBox x:Name="TxtOdinCp" Text="Select CP_*.tar.md5" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="24" FontSize="10" Padding="5,2"/>
                                    </DockPanel>

                                    <!-- CSC (Carrier / Country) -->
                                    <DockPanel Margin="0,0,0,5">
                                        <CheckBox x:Name="ChkOdinCsc" Content="CSC:" Width="50" Foreground="#A78BFA" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                        <Button Content="Browse" Width="55" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="24" Margin="5,0,0,0" DockPanel.Dock="Right" Click="OnBrowseOdinCscClicked"/>
                                        <TextBox x:Name="TxtOdinCsc" Text="Select CSC_*.tar.md5" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="24" FontSize="10" Padding="5,2"/>
                                    </DockPanel>

                                    <!-- USERDATA (Optional) -->
                                    <DockPanel Margin="0,0,0,5">
                                        <CheckBox x:Name="ChkOdinUserdata" Content="USER:" Width="50" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        <Button Content="Browse" Width="55" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="24" Margin="5,0,0,0" DockPanel.Dock="Right" Click="OnBrowseOdinUserdataClicked"/>
                                        <TextBox x:Name="TxtOdinUserdata" Text="Select USERDATA_*.tar.md5 (Optional)" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="24" FontSize="10" Padding="5,2"/>
                                    </DockPanel>

                                    <!-- PIT Partition Table (Optional) -->
                                    <DockPanel Margin="0,0,0,8">
                                        <CheckBox x:Name="ChkOdinPit" Content="PIT:" Width="50" Foreground="#2DD4BF" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        <Button Content="Browse" Width="55" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="24" Margin="5,0,0,0" DockPanel.Dock="Right" Click="OnBrowseOdinPitClicked"/>
                                        <TextBox x:Name="TxtOdinPit" Text="Select *.pit (Optional)" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="24" FontSize="10" Padding="5,2"/>
                                    </DockPanel>

                                    <!-- Flashing Options -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
                                        <UniformGrid Columns="2">
                                            <CheckBox x:Name="ChkOdinAutoReboot" Content="Auto Reboot" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10" IsChecked="True" Margin="0,2"/>
                                            <CheckBox x:Name="ChkOdinFReset" Content="F. Reset Time" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10" IsChecked="True" Margin="0,2"/>
                                            <CheckBox x:Name="ChkOdinNandErase" Content="Nand Erase" Foreground="#EF4444" FontWeight="SemiBold" FontSize="10" Margin="0,2"/>
                                            <CheckBox x:Name="ChkOdinRePartition" Content="Re-Partition" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Margin="0,2"/>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Flash Action Buttons -->
                                    <Button Content="⚡ Flash Samsung Firmware (Odin)" Height="34" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,5" Click="OnSamsungFlashOdinClicked"/>
                                    <Button Content="📑 Read PIT from Download Mode" Height="28" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,8" Click="OnSamsungReadPitDownloadClicked"/>

                                    <!-- Odin Progress Bar -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6" Margin="0,2,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock x:Name="TxtOdinStatus" Text="Ready for Odin Flash" FontSize="10" Foreground="#CBD5E1" DockPanel.Dock="Left"/>
                                                <TextBlock x:Name="TxtOdinPct" Text="0%" FontSize="10" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <ProgressBar x:Name="ProgressBarOdin" Height="6" Background="#27272A" Foreground="#00D2FF" Value="0" Maximum="100"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- PANEL 3: SAMSUNG PIT DOCTOR & PARTITION STUDIO -->
                                <StackPanel x:Name="PanelSamsungPit" Visibility="Collapsed">
                                    <Border Background="#0C1427" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📑 SAMSUNG PIT DOCTOR &amp; PARTITION STUDIO" FontSize="10.5" FontWeight="ExtraBold" Foreground="#2DD4BF"/>
                                                <Border Background="#134E4A" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                                    <TextBlock Text="484+ VERIFIED DATABASE" FontSize="8.5" FontWeight="Bold" Foreground="#5EEAD4"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="● ENGINE ONLINE" FontSize="9" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Model Selector & Search Filter Card -->
                                    <Border Background="#161A26" CornerRadius="5" Padding="8" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="🎯 TARGET SAMSUNG MODEL &amp; PIT:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtPitModelCount" Text="484 Files Ready" FontSize="8.5" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtPitSearchFilter" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" Height="26" FontSize="10" Padding="5,3" ToolTip="Search Model (e.g. A03, A12, S21)" TextChanged="OnPitSearchFilterChanged"/>
                                                <ComboBox x:Name="CmbSamsungPitModel" Style="{StaticResource DarkCyberComboBox}" Grid.Column="2" Height="26" SelectionChanged="OnSamsungPitModelSelected"/>
                                            </Grid>

                                            <!-- PIT File Info Ribbon -->
                                            <Border Background="#0B0F19" CornerRadius="3" Padding="6,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtPitSelectedInfo" Text="Select model to load partition table layout" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtPitPartCount" Grid.Column="1" Text="0 Partitions" FontSize="9" FontWeight="Bold" Foreground="#2DD4BF" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Operations Toolbar -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⚡ Auto-Load into Odin" Height="28" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0" ToolTip="Bind selected PIT to Odin Flasher and enable Re-Partition" Click="OnPitAutoBindOdinClicked"/>
                                        <Button Grid.Column="2" Content="📥 Read PIT from Phone" Height="28" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0" ToolTip="Dump live PIT from connected Samsung in Download Mode" Click="OnSamsungReadPitDownloadClicked"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📤 Surgical Write PIT Only" Height="26" Background="#B45309" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" ToolTip="Directly flash PIT to phone to fix 'There is no PIT partition' error" Click="OnPitSurgicalWriteClicked"/>
                                        <Button Grid.Column="2" Content="💾 Export / Save PIT" Height="26" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" FontSize="9.5" BorderThickness="0" ToolTip="Save parsed PIT file" Click="OnPitExportClicked"/>
                                    </Grid>

                                    <!-- Visual PIT Partition DataGrid -->
                                    <Border Background="#070709" CornerRadius="4" BorderBrush="#1E293B" BorderThickness="1" Height="240" Margin="0,0,0,0">
                                        <DataGrid x:Name="GridSamsungPitPartitions" Background="#070709" BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B" RowHeight="22" FontSize="10" Foreground="#E2E8F0" RowBackground="#070709" AlternatingRowBackground="#0E0E14" ColumnHeaderStyle="{StaticResource CyberColumnHeader}" CellStyle="{StaticResource CyberCell}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Width="28" Binding="{Binding Index}" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Partition Name" Width="105" Binding="{Binding Name}" FontWeight="Bold" Foreground="#2DD4BF" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Flash File" Width="115" Binding="{Binding FlashFilename}" Foreground="#E2E8F0" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Block Start" Width="80" Binding="{Binding BlockStart}" FontFamily="Consolas" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Block Count" Width="80" Binding="{Binding BlockCount}" FontFamily="Consolas" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Filesystem" Width="*" Binding="{Binding Filesystem}" Foreground="#34D399" IsReadOnly="True"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: Shared Samsung Port Bar & Diagnostics Console -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Device Status & Command Toolbar: DUAL LIVE HARDWARE NOTIFICATION RADAR -->
                    <Border Grid.Row="0" Background="#0C101C" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/> <!-- Box 1: COM Port Box -->
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.5*"/> <!-- Box 2: USB Interface Box -->
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                            </Grid.ColumnDefinitions>

                            <!-- BOX 1: CONNECTED COM PORT WITH LIVE LED LIGHT -->
                            <Border Grid.Column="0" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                <DockPanel>
                                    <Ellipse x:Name="LedSamsungCom" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowSamsungCom" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Border x:Name="BadgeSamsungCom" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtSamsungComState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔌 COM PORT BUS" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtSamsungComBox" Text="NO COM PORT DETECTED" FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- BOX 2: CONNECTED USB INTERFACE WITH LIVE LED LIGHT -->
                            <Border Grid.Column="2" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                <DockPanel>
                                    <Ellipse x:Name="LedSamsungUsb" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowSamsungUsb" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Border x:Name="BadgeSamsungUsb" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtSamsungUsbState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="⚡ USB DEVICE / MODE" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtSamsungUsbBox" Text="WAITING FOR USB CONNECTION..." FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- ACTION BUTTONS: SCAN, ABORT & CLEAR -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSamsungPortStatus" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtSamsungPort" Visibility="Collapsed"/>
                                <Button Content="🔍 Scan Ports" Height="28" Padding="10,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnScanSamsungPortsClicked"/>
                                <Button Content="⛔ ABORT" Height="28" Padding="10,0" Background="#991B1B" Foreground="#FECACA" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnEmergencyAbortClicked"/>
                                <Button Content="Clear Console" Height="28" Padding="10,0" Background="#1E1E2A" Foreground="#94A3B8" FontSize="10" BorderThickness="0" Click="OnClearSamsungLogClicked"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Console for Samsung Service & Flashing -->
                    <Border Grid.Row="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="SAMSUNG SERVICE &amp; ODIN PROTOCOL LOG" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="TxtSamsungConsole" Grid.Row="1" Background="#070709" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ -->
            <!-- VIEW 4: UNISOC / SPREADTRUM (SPD) MULTI-ENGINE SUITE             -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewUnisoc" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/> <!-- Left Sub-Tabs & Actions -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>   <!-- Right Console & Port -->
                </Grid.ColumnDefinitions>

                <!-- Left: 4 Sub-Tabs & Dedicated Panels -->
                <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Smart Brand & Model Selector -->
                            <RowDefinition Height="Auto"/> <!-- Mode Header Dual Live Hardware Radar -->
                            <RowDefinition Height="Auto"/> <!-- 4 Sub-Tabs strip -->
                            <RowDefinition Height="*"/>    <!-- Scrollable container -->
                        </Grid.RowDefinitions>

                        <!-- CARD 1: SMART BRAND & MODEL SELECTOR FOR UNISOC -->
                        <Border Grid.Row="0" Background="#161A26" CornerRadius="5" Padding="8" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="🎯 TARGET BRAND &amp; MODEL (UNISOC DB):" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtUnisocModelBadge" Text="Tiger T7250 / T606 / SC9863A" FontSize="8" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbUnisocBrand" Style="{StaticResource DarkCyberComboBox}" IsTextSearchEnabled="True" Grid.Column="0" Height="24" SelectionChanged="OnUnisocBrandChanged"/>
                                    <ComboBox x:Name="CmbUnisocModel" Style="{StaticResource DarkCyberComboBox}" IsTextSearchEnabled="True" Grid.Column="2" Height="24" SelectionChanged="OnUnisocModelChanged"/>
                                </Grid>

                                <!-- Detected Chipset & Boot Key Info Banner -->
                                <Border Background="#0F172A" CornerRadius="3" Padding="8,4">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtUnisocModelInfo" Text="Select Brand &amp; Model (Auto-routes FDL1, FDL2 &amp; Handshake)" FontSize="8.5" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtUnisocTpInfo" Text="Boot Key: Hold [Vol-] &amp; Connect USB Cable" FontSize="8" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 1.5: MODE LIVE NOTIFICATION PANEL (COM BOX & USB BOX WITH LIVE LEDS) -->
                        <Border Grid.Row="1" Background="#0C101C" CornerRadius="4" Padding="6,4" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COM Port Box (Mode Header) -->
                                <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="3" Padding="6,4">
                                    <DockPanel>
                                        <Ellipse x:Name="LedUnisocModeCom" Width="9" Height="9" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowUnisocModeCom" BlurRadius="8" ShadowDepth="0" Color="#EF4444"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🔌 COM BUS" FontSize="7.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                                            <TextBlock x:Name="TxtUnisocModeCom" Text="NO PORT" FontSize="9" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- USB Interface Box (Mode Header) -->
                                <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="3" Padding="6,4">
                                    <DockPanel>
                                        <Ellipse x:Name="LedUnisocModeUsb" Width="9" Height="9" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowUnisocModeUsb" BlurRadius="8" ShadowDepth="0" Color="#EF4444"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="⚡ USB MODE" FontSize="7.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                                            <TextBlock x:Name="TxtUnisocModeUsb" Text="WAITING..." FontSize="9" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Sub-Tabs: [ BROM ] [ PAC FLASH ] [ DIAG REPAIR ] [ FASTBOOT ] -->
                        <Border Grid.Row="2" Background="#1A1A24" CornerRadius="3" Padding="2" Margin="0,0,0,6">
                            <UniformGrid Columns="4">
                                <Button x:Name="BtnUnisocSubTabBrom" Content="BROM" Style="{StaticResource SubTabButtonActive}" Click="OnUnisocSubTabBromClicked" Margin="1,0"/>
                                <Button x:Name="BtnUnisocSubTabPac" Content="PAC FLASH" Style="{StaticResource SubTabButtonInactive}" Click="OnUnisocSubTabPacClicked" Margin="1,0"/>
                                <Button x:Name="BtnUnisocSubTabDiag" Content="DIAG REPAIR" Style="{StaticResource SubTabButtonInactive}" Click="OnUnisocSubTabDiagClicked" Margin="1,0"/>
                                <Button x:Name="BtnUnisocSubTabFastboot" Content="FASTBOOT" Style="{StaticResource SubTabButtonInactive}" Click="OnUnisocSubTabFastbootClicked" Margin="1,0"/>
                            </UniformGrid>
                        </Border>

                        <!-- Panel Container -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- PANEL 1: BROM SERVICE (FDL1 / FDL2 ENGINE) -->
                                <StackPanel x:Name="PanelUnisocBrom" Visibility="Visible">
                                    <TextBlock Text="⚡ UNISOC BROM / FDL BOOTROM SERVICE:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="4,2,0,6"/>

                                    <!-- FDL 1 & FDL 2 LOADER BOXES -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="FDL 1:" Width="45" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Content="Browse" Width="50" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowseUnisocBromFdl1Clicked"/>
                                                <TextBox x:Name="TxtUnisocBromFdl1" Text="resources/loaders/spd/fdl1.bin (Auto / Custom)" Background="#0F0F14" Foreground="#94A3B8" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,2"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="FDL 2:" Width="45" Foreground="#34D399" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Content="Browse" Width="50" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowseUnisocBromFdl2Clicked"/>
                                                <TextBox x:Name="TxtUnisocBromFdl2" Text="resources/loaders/spd/fdl2.bin (Auto / Custom)" Background="#0F0F14" Foreground="#94A3B8" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,2"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="Sync Handshake &amp; Load FDL1 / FDL2" Style="{StaticResource CyberBulletButton}" Click="OnUnisocBromHandshakeClicked"/>
                                    <Button Content="📖 Read Device Info (Hardware Descriptors &amp; SoC)" Style="{StaticResource CyberBulletButton}" Foreground="#38BDF8" Click="OnUnisocBromReadInfoClicked"/>
                                    <Button Content="Enter DIAG Mode (BROM to Diag Switch)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocBromEnterDiagClicked"/>
                                    <Button Content="Reset FRP Lock (Direct Persist/FRP Wipe)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocBromFrpClicked"/>
                                    <Button Content="Safe Factory Reset (Format Userdata)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocBromFactoryResetClicked"/>
                                    <Button Content="Read Live GPT Partition Table" Style="{StaticResource CyberBulletButton}" Click="OnUnisocBromReadGptClicked"/>
                                    <Button Content="Backup Important Security Partitions (NV/Misc)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocBromBackupClicked"/>
                                    <Button Content="Erase Active Selected Partition" Style="{StaticResource CyberBulletButton}" Click="OnUnisocBromErasePartitionClicked"/>
                                    <Button Content="🩺 eMMC / UFS Storage Health Doctor" Style="{StaticResource CyberBulletButton}" Foreground="#34D399" Click="OnUnisocEmmcHealthCheckClicked"/>

                                    <Border Height="1" Background="#232332" Margin="4,12,4,10"/>
                                    <TextBlock Text="SUPPORTED CHIPSET ARCHITECTURES:" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,0,4"/>
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6,4">
                                        <TextBlock Text="• Tiger Series: T606, T610, T612, T616, T700&#x0a;• SC Series: SC9863A, SC7731E, SC9832E&#x0a;• Brands: Realme, Infinix, Tecno, itel, Nokia, Samsung A03/A03 Core" FontSize="9" Foreground="#64748B" LineHeight="14"/>
                                    </Border>
                                </StackPanel>

                                <!-- PANEL 2: PAC STOCK FIRMWARE FLASHER & PARTITION STUDIO -->
                                <StackPanel x:Name="PanelUnisocPac" Visibility="Collapsed">
                                    <TextBlock Text="📦 UNISOC OFFICIAL PAC FLASHER &amp; PARTITION STUDIO:" FontSize="9" FontWeight="Bold" Foreground="#00D2FF" Margin="0,2,0,6"/>

                                    <!-- PAC File Browser -->
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="PAC FILE:" Width="55" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        <Button Content="Browse" Width="50" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowsePacClicked"/>
                                        <TextBox x:Name="TxtPacPath" Text="Select Firmware (*.pac)" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,2"/>
                                    </DockPanel>

                                    <!-- PAC Archive Info Pill -->
                                    <Border Background="#0C1427" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtPacInfoProduct" Text="📦 Standard Unisoc Tiger/SC Template Loaded" FontSize="8.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtPacInfoSize" Text="4.18 GB • 20 Partitions" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Custom FDL Loaders in Flash Tab -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="FDL 1:" Width="45" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Content="Browse" Width="50" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowsePacFdl1Clicked"/>
                                                <TextBox x:Name="TxtPacFdl1" Text="Auto-extract from PAC (or browse custom)" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,2"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="FDL 2:" Width="45" Foreground="#34D399" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Content="Browse" Width="50" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Height="22" Margin="4,0,0,0" DockPanel.Dock="Right" Click="OnBrowsePacFdl2Clicked"/>
                                                <TextBox x:Name="TxtPacFdl2" Text="Auto-extract from PAC (or browse custom)" Background="#0F0F14" Foreground="#64748B" BorderBrush="#2E2E40" Height="22" FontSize="10" Padding="4,2"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 📑 PARTITION STUDIO & SELECTIVE FLASH GRID -->
                                    <Border Background="#111827" CornerRadius="4" BorderBrush="#253248" BorderThickness="1" Padding="6,5" Margin="0,0,0,6">
                                        <StackPanel>
                                            <!-- Quick Selective Controls Strip -->
                                            <DockPanel Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📑 PARTITIONS:" FontSize="9.5" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                                                    <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                                        <TextBlock x:Name="TxtPacPartitionCountBadge" Text="Selected: 18 / 20" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                    <Button Content="✓ All" Width="34" Height="19" Background="#1E293B" Foreground="#38BDF8" FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="1,0" Click="OnPacSelectAllClicked" ToolTip="Select All Partitions for Full Flash"/>
                                                    <Button Content="✗ None" Width="38" Height="19" Background="#1E293B" Foreground="#94A3B8" FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="1,0" Click="OnPacDeselectAllClicked" ToolTip="Deselect All"/>
                                                    <Button Content="⚡ Core" Width="40" Height="19" Background="#1E293B" Foreground="#F59E0B" FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="1,0" Click="OnPacSelectCoreClicked" ToolTip="Boot + Recovery + VBMeta + Super"/>
                                                    <Button Content="🛡️ Unbrick" Width="52" Height="19" Background="#1E293B" Foreground="#10B981" FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="1,0" Click="OnPacSelectUnbrickClicked" ToolTip="FDL1 + FDL2 + SPL + Boot"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- DataGrid of Partitions -->
                                            <DataGrid x:Name="DgUnisocPacPartitions" Height="195" Background="#070709" RowBackground="#0B0F19" AlternatingRowBackground="#101726" BorderThickness="1" BorderBrush="#1E293B" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B" RowHeight="22" FontSize="9" Foreground="#F8FAFC" ColumnHeaderStyle="{StaticResource CyberColumnHeader}" CellStyle="{StaticResource CyberCell}">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="FLASH" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                                    <DataGridTextColumn Header="PARTITION" Binding="{Binding Name}" Width="95">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="IMAGE FILE" Binding="{Binding FileName}" Width="110">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="SIZE" Binding="{Binding FileSizeHuman}" Width="65">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Flashing Options -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                        <UniformGrid Columns="2">
                                            <CheckBox x:Name="ChkPacEraseUserdata" Content="Erase Userdata" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10" IsChecked="True" Margin="0,2"/>
                                            <CheckBox x:Name="ChkPacBackupNv" Content="Backup NVRAM" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10" IsChecked="True" Margin="0,2"/>
                                            <CheckBox x:Name="ChkPacKeepCalib" Content="Keep Calibration" Foreground="#34D399" FontWeight="SemiBold" FontSize="10" IsChecked="True" Margin="0,2"/>
                                            <CheckBox x:Name="ChkPacRepart" Content="Re-Partition" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Margin="0,2"/>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Flash & Unpack Action Buttons -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⚡ Flash Selected (ResearchDownload)" Height="32" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnUnisocFlashPacClicked"/>
                                        <Button Grid.Column="2" Content="📦 Unpack PAC" Height="32" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Click="OnUnisocUnpackPacClicked"/>
                                    </Grid>

                                    <!-- Progress Bar -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6" Margin="0,2,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock x:Name="TxtPacStatus" Text="Ready for PAC Firmware Flash" FontSize="10" Foreground="#CBD5E1" DockPanel.Dock="Left"/>
                                                <TextBlock x:Name="TxtPacPct" Text="0%" FontSize="10" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <ProgressBar x:Name="ProgressBarPac" Height="6" Background="#27272A" Foreground="#00D2FF" Value="0" Maximum="100"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- PANEL 3: DIAG REPAIR (IMEI & NVRAM) -->
                                <StackPanel x:Name="PanelUnisocDiag" Visibility="Collapsed">
                                    <TextBlock Text="🔬 UNISOC DIAGNOSTIC &amp; CALIBRATION (SPRD DIAG):" FontSize="9" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,6"/>

                                    <Button Content="Read Device Security &amp; Calibration Info" Style="{StaticResource CyberBulletButton}" Click="OnUnisocDiagReadInfoClicked"/>
                                    <Button Content="Read Dual IMEI (Diag Mode)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocDiagReadImeiClicked"/>
                                    <Button Content="Wipe Data / Factory Reset (Diag Mode)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocDiagWipeDataClicked"/>

                                    <Border Height="1" Background="#232332" Margin="4,8,4,8"/>
                                    <TextBlock Text="DUAL IMEI REPAIR (DIAG MODE):" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="2,0,0,4"/>

                                    <!-- IMEI 1 -->
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="IMEI 1:" Width="50" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtUnisocImei1" Text="867462056766425" Background="#0F0F14" Foreground="#FFFFFF" BorderBrush="#2E2E40" Height="24" FontSize="11" Padding="5,2"/>
                                    </DockPanel>

                                    <!-- IMEI 2 -->
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="IMEI 2:" Width="50" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtUnisocImei2" Text="867462056766433" Background="#0F0F14" Foreground="#FFFFFF" BorderBrush="#2E2E40" Height="24" FontSize="11" Padding="5,2"/>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📖 Read IMEI (Diag)" Height="28" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnUnisocDiagReadImeiClicked"/>
                                        <Button Grid.Column="2" Content="✍️ Write Dual IMEI" Height="28" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnUnisocDiagWriteImeiClicked"/>
                                    </Grid>

                                    <Border Height="1" Background="#232332" Margin="4,4,4,8"/>
                                    <TextBlock Text="NVRAM / BASEBAND SECURITY:" FontSize="9" FontWeight="Bold" Foreground="#A78BFA" Margin="2,0,0,4"/>

                                    <Button Content="Backup NVRAM / Baseband (fixnv + prodnv)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocDiagBackupNvramClicked"/>
                                    <Button Content="Restore NVRAM / Baseband" Style="{StaticResource CyberBulletButton}" Click="OnUnisocDiagRestoreNvramClicked"/>
                                    <Button Content="Wipe / Format Corrupted NVRAM" Style="{StaticResource CyberBulletButton}" Click="OnUnisocDiagWipeNvramClicked"/>
                                    <Button Content="🩺 eMMC / UFS Storage Health Doctor (Diag)" Style="{StaticResource CyberBulletButton}" Foreground="#34D399" Click="OnUnisocEmmcHealthCheckClicked"/>
                                    <Button Content="🔄 Reboot DIAG ➔ FASTBOOT (Bootloader)" Style="{StaticResource CyberBulletButton}" Foreground="#38BDF8" Click="OnUnisocDiagToFastbootClicked"/>
                                </StackPanel>

                                <!-- PANEL 4: FASTBOOT & MTP SUITE -->
                                <StackPanel x:Name="PanelUnisocFastboot" Visibility="Collapsed">
                                    <TextBlock Text="🚀 UNISOC FASTBOOT &amp; MTP SERVICE SUITE:" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,6"/>

                                    <TextBlock Text="MTP &amp; AT MODEM (PHONE ON):" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="2,2,0,4"/>
                                    <Button Content="MTP Read Device Info (AT+DEVCONINFO)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocMtpReadInfoClicked"/>
                                    <Button Content="1-Click Switch MTP to DIAG Mode (AT+SPDIAG)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocSwitchDiagClicked"/>

                                    <Border Height="1" Background="#232332" Margin="4,8,4,8"/>
                                    <TextBlock Text="🔄 DUAL-MODE REBOOT CONTROLLER (DIAG ⇄ FASTBOOT):" FontSize="9" FontWeight="Bold" Foreground="#34D399" Margin="2,0,0,4"/>

                                    <Button Content="🔄 DIAG Mode ➔ Reboot to FASTBOOT (Bootloader)" Style="{StaticResource CyberBulletButton}" Foreground="#38BDF8" Click="OnUnisocDiagToFastbootClicked"/>
                                    <Button Content="⚡ FASTBOOT Mode ➔ Reboot to DIAG (Cali Mode)" Style="{StaticResource CyberBulletButton}" Foreground="#FBBF24" Click="OnUnisocFastbootToDiagClicked"/>

                                    <Border Height="1" Background="#232332" Margin="4,8,4,8"/>
                                    <TextBlock Text="FASTBOOT SECURITY &amp; BOOTLOADER:" FontSize="9" FontWeight="Bold" Foreground="#E2E8F0" Margin="2,0,0,4"/>

                                    <Button Content="Fastboot Read Identifier Token (RSA Keygen)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocFastbootReadTokenClicked"/>
                                    <Button Content="Fastboot Unlock Bootloader (Custom Token Sign)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocFastbootUnlockBlClicked"/>
                                    <Button Content="Fastboot Wipe FRP (persist / frp)" Style="{StaticResource CyberBulletButton}" Click="OnUnisocFastbootWipeFrpClicked"/>
                                    <Button Content="🩺 Fastboot eMMC / UFS Health Doctor" Style="{StaticResource CyberBulletButton}" Foreground="#34D399" Click="OnUnisocEmmcHealthCheckClicked"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: Shared UNISOC Port Bar & Diagnostics Console -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Device Status & Command Toolbar: DUAL LIVE HARDWARE NOTIFICATION RADAR -->
                    <Border Grid.Row="0" Background="#0C101C" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/> <!-- Box 1: COM Port Box -->
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.5*"/> <!-- Box 2: USB Interface Box -->
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                            </Grid.ColumnDefinitions>

                            <!-- BOX 1: CONNECTED COM PORT WITH LIVE LED LIGHT -->
                            <Border Grid.Column="0" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                <DockPanel>
                                    <!-- Glowing LED Light -->
                                    <Ellipse x:Name="LedUnisocCom" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowUnisocCom" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Badge on Right -->
                                    <Border x:Name="BadgeUnisocCom" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtUnisocComState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                    </Border>

                                    <!-- Text Content -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔌 COM PORT BUS" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtUnisocComBox" Text="NO COM PORT DETECTED" FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- BOX 2: CONNECTED USB INTERFACE WITH LIVE LED LIGHT -->
                            <Border Grid.Column="2" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                <DockPanel>
                                    <!-- Glowing LED Light -->
                                    <Ellipse x:Name="LedUnisocUsb" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowUnisocUsb" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Badge on Right -->
                                    <Border x:Name="BadgeUnisocUsb" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtUnisocUsbState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                    </Border>

                                    <!-- Text Content -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="⚡ USB DEVICE / MODE" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtUnisocUsbBox" Text="WAITING FOR USB CONNECTION..." FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- ACTION BUTTONS: SCAN, ABORT & CLEAR -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUnisocPortStatus" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtUnisocPort" Visibility="Collapsed"/>

                                <Button Content="🔍 Scan Ports" Height="28" Padding="12,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnScanUnisocPortsClicked"/>
                                <Button Content="⛔ ABORT" Height="28" Padding="10,0" Background="#991B1B" Foreground="#FECACA" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnEmergencyAbortClicked"/>
                                <Button Content="Clear Console" Height="28" Padding="10,0" Background="#1E1E2A" Foreground="#94A3B8" FontSize="10" BorderThickness="0" Click="OnClearUnisocLogClicked"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Central Display: Toggle between Protocol Log & Live GPT Partition Table -->
                    <Border Grid.Row="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TOP HEADER & VIEW TOGGLE SWITCH BAR -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <!-- View Switcher Tabs -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnUnisocViewConsole" Content="📜 PROTOCOL LOG" Height="24" Padding="10,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" BorderThickness="0" Margin="0,0,4,0" Click="OnUnisocToggleViewClicked" Tag="Console"/>
                                    <Button x:Name="BtnUnisocViewGpt" Content="🗂️ LIVE GPT PARTITIONS (0)" Height="24" Padding="10,0" Background="#1E1E2A" Foreground="#94A3B8" FontWeight="Bold" FontSize="9" BorderThickness="0" Click="OnUnisocToggleViewClicked" Tag="GPT"/>
                                </StackPanel>

                                <!-- GPT Actions Toolbar (Visible when GPT Tab is active) -->
                                <StackPanel x:Name="ToolbarUnisocGpt" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <TextBox x:Name="TxtUnisocPartitionSearch" Width="110" Height="22" Background="#0B0F19" Foreground="#CBD5E1" BorderBrush="#1E293B" Padding="4,2" FontSize="9" VerticalContentAlignment="Center" Margin="0,0,4,0" TextChanged="OnUnisocPartitionSearchTextChanged"/>
                                    <Button Content="☑️ All" Width="36" Height="22" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Margin="0,0,3,0" Click="OnUnisocSelectAllGptClicked"/>
                                    <Button Content="◻️ None" Width="42" Height="22" Background="#1E293B" Foreground="#94A3B8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Margin="0,0,3,0" Click="OnUnisocDeselectAllGptClicked"/>
                                    <Button Content="🔄 Read GPT" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Height="22" Padding="6,0" Margin="0,0,3,0" Click="OnUnisocBromReadGptClicked"/>
                                    <Button Content="💾 Dump Selected" Background="#0284C7" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Height="22" Padding="8,0" Margin="0,0,3,0" Click="OnUnisocDumpSelectedPartitionsClicked"/>
                                    <Button Content="🗑️ Erase Selected" Background="#7F1D1D" Foreground="#FCA5A5" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Height="22" Padding="6,0" Click="OnUnisocBromErasePartitionClicked"/>
                                </StackPanel>

                                <!-- Console Actions Toolbar (Visible when Console Tab is active) -->
                                <StackPanel x:Name="ToolbarUnisocConsole" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="SPREADTRUM / UNISOC ENGINE LOG" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- VIEW 1: UNISOC PROTOCOL LOG CONSOLE -->
                            <TextBox x:Name="TxtUnisocConsole" Grid.Row="1" Background="#070709" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" TextWrapping="Wrap" Visibility="Visible"/>

                            <!-- VIEW 2: INTERACTIVE LIVE GPT PARTITION TABLE DATAGRID -->
                            <Grid x:Name="PanelUnisocGptView" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="GridUnisocPartitions" Grid.Row="0" AutoGenerateColumns="False" 
                                          Background="#0A0A0E" RowBackground="#111118" AlternatingRowBackground="#161622" 
                                          Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" 
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#222232" 
                                          ColumnHeaderStyle="{StaticResource CyberColumnHeader}"
                                          CellStyle="{StaticResource CyberCell}"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="35"/>
                                        <DataGridTextColumn Header="Partition Name" Binding="{Binding Name}" Width="130" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Start LBA" Binding="{Binding StartLba}" Width="95"/>
                                        <DataGridTextColumn Header="End LBA" Binding="{Binding EndLba}" Width="95"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeStr}" Width="85" Foreground="#34D399"/>
                                        <DataGridTextColumn Header="Filesystem" Binding="{Binding Filesystem}" Width="90" Foreground="#38BDF8"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" Foreground="#F59E0B"/>
                                        <DataGridTextColumn Header="Sectors" Binding="{Binding SectorCount}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Bottom Status Bar for GPT View -->
                                <Border Grid.Row="1" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="6,4" Margin="0,4,0,0">
                                    <DockPanel>
                                        <TextBlock x:Name="TxtUnisocGptSummary" Text="No partition table loaded. Click [Read Live GPT Partition Table] to scan target eMMC/UFS storage." FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtUnisocGptSelectionInfo" Text="0 Partitions Selected" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ -->
            <!-- VIEW 5: HUAWEI / HONOR (HISILICON KIRIN) SUITE                   -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewHuawei" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Controls: 4 Sub-Tabs & Operation Panels -->
                <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Sub-Tabs Strip -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>    <!-- Scrollable Panel Content -->
                        </Grid.RowDefinitions>

                        <!-- Sub-Tabs Selector Strip -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnHuaweiSubTabCom1" Grid.Column="0" Content="USB COM 1.0" Style="{StaticResource SubTabButtonActive}" Click="OnHuaweiSubTabCom1Clicked"/>
                            <Button x:Name="BtnHuaweiSubTabFastboot" Grid.Column="2" Content="FASTBOOT" Style="{StaticResource SubTabButtonInactive}" Click="OnHuaweiSubTabFastbootClicked"/>
                            <Button x:Name="BtnHuaweiSubTabManufacture" Grid.Column="4" Content="MANUFACTURE" Style="{StaticResource SubTabButtonInactive}" Click="OnHuaweiSubTabManufactureClicked"/>
                            <Button x:Name="BtnHuaweiSubTabDload" Grid.Column="6" Content="UPGRADE (DLOAD)" Style="{StaticResource SubTabButtonInactive}" Click="OnHuaweiSubTabDloadClicked"/>
                        </Grid>

                        <!-- Scrollable Sub-Tab Panels -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- ==================================================== -->
                                <!-- PANEL 1: USB COM 1.0 (TESTPOINT BOOT ENGINE)        -->
                                <!-- ==================================================== -->
                                <StackPanel x:Name="PanelHuaweiCom1" Visibility="Visible">
                                    <TextBlock Text="⚡ HUAWEI USB COM 1.0 (TESTPOINT BOOT ENGINE):" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,6"/>

                                    <!-- Chipset Selector Card -->
                                    <Border Background="#1A1A24" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="🎯 SELECT HISILICON KIRIN CHIPSET:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtHuaweiLoaderBadge" Text="✓ Auto-Loader Configured" FontSize="9" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <ComboBox x:Name="CmbHuaweiChipset" Style="{StaticResource DarkCyberComboBox}" Height="26" Margin="0,0,0,6" SelectionChanged="OnHuaweiChipsetChanged">
                                                <ComboBoxItem Content="Kirin 710 / 710A / 710F (xLoader + BL2 + Fastboot)" IsSelected="True"/>
                                                <ComboBoxItem Content="Kirin 650 / 655 / 658 / 659 (xLoader + Fastboot)"/>
                                                <ComboBoxItem Content="Kirin 810 (DaVinci NPU Architecture)"/>
                                                <ComboBoxItem Content="Kirin 820 5G (xLoader + BL2 + Fastboot)"/>
                                                <ComboBoxItem Content="Kirin 970 (xLoader + Fastboot - P20 / Mate 10)"/>
                                                <ComboBoxItem Content="Kirin 980 (xLoader + Fastboot - P30 / Mate 20)"/>
                                                <ComboBoxItem Content="Kirin 990 / 990 5G (xLoader + BL2 + Fastboot - P40 / Mate 30)"/>
                                            </ComboBox>

                                            <!-- Testpoint Guidance Banner -->
                                            <Border Background="#0B0F19" CornerRadius="3" Padding="6,4">
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtHuaweiTpGuide" Text="Testpoint: Short TP testpoint pad to GND (Motherboard Shield) + Connect USB" FontSize="9" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Port: HUAWEI USB COM 1.0 (VID_12D1 &amp; PID_3609)" FontSize="8.5" Foreground="#64748B" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Kirin Loader Files (BL1 / xLoader & BL2 / Fastboot) -->
                                    <Border Background="#1A1A24" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="KIRIN STAGE 1 (XLOADER / BL1):" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBox x:Name="TxtHuaweiXloaderPath" Text="resources/loaders/kirin/KIRIN_710A/xloader_1.bin" Background="#0F0F14" Foreground="#CBD5E1" BorderBrush="#2E2E40" Height="26" FontSize="10" Padding="5,3"/>
                                                <Button Content="Browse" Width="55" Background="#334155" Foreground="#FFFFFF" BorderThickness="0" Height="26" Margin="6,0,0,0" DockPanel.Dock="Right" Click="OnBrowseHuaweiXloaderClicked"/>
                                            </DockPanel>

                                            <TextBlock Text="KIRIN STAGE 2 (BL2 / FASTBOOT):" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                            <DockPanel>
                                                <TextBox x:Name="TxtHuaweiFastbootBinPath" Text="resources/loaders/kirin/KIRIN_710A/fastboot.bin" Background="#0F0F14" Foreground="#CBD5E1" BorderBrush="#2E2E40" Height="26" FontSize="10" Padding="5,3"/>
                                                <Button Content="Browse" Width="55" Background="#334155" Foreground="#FFFFFF" BorderThickness="0" Height="26" Margin="6,0,0,0" DockPanel.Dock="Right" Click="OnBrowseHuaweiFastbootBinClicked"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- USB COM 1.0 Boot Protocol -->
                                    <TextBlock Text="KIRIN BOOT PROTOCOL ACTIONS:" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⚡ Phase 1: COM 1.0 Handshake" Height="32" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnHuaweiCom1HandshakeClicked"/>
                                        <Button Grid.Column="2" Content="📦 Phase 2: Boot Fastboot" Height="32" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnHuaweiCom1BootFastbootClicked"/>
                                    </Grid>

                                    <!-- One-Click Testpoint Service Operations -->
                                    <TextBlock Text="TESTPOINT HARDWARE OPERATIONS (COM 1.0):" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,4"/>

                                    <Button Content="🔓 1-Click Reset FRP &amp; Huawei ID (Testpoint)" Height="34" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,5" Click="OnHuaweiCom1ResetFrpIdClicked"/>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📑 Read OEMINFO" Height="30" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Click="OnHuaweiCom1ReadOemInfoClicked"/>
                                        <Button Grid.Column="2" Content="✍️ Write OEMINFO" Height="30" Background="#1E293B" Foreground="#FBBF24" FontWeight="Bold" BorderThickness="0" Click="OnHuaweiCom1WriteOemInfoClicked"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🌍 Change Vendor / Country" Height="30" Background="#1E293B" Foreground="#A78BFA" FontWeight="Bold" BorderThickness="0" Click="OnHuaweiCom1ChangeVendorCountryClicked"/>
                                        <Button Grid.Column="2" Content="🛠️ Dead Boot Unbrick (Kirin)" Height="30" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnHuaweiCom1DeadBootUnbrickClicked"/>
                                    </Grid>

                                    <Button Content="🧹 Low-Level Factory Wipe (Format Userdata)" Height="30" Background="#475569" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,6" Click="OnHuaweiCom1FactoryWipeClicked"/>

                                    <!-- Progress HUD -->
                                    <Border Background="#1A1A24" CornerRadius="5" Padding="8" Margin="0,2,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock x:Name="TxtHuaweiProgressStatus" Text="Ready for Huawei Kirin operation" FontSize="10" Foreground="#CBD5E1" DockPanel.Dock="Left"/>
                                                <TextBlock x:Name="TxtHuaweiProgressPct" Text="0%" FontSize="10" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <ProgressBar x:Name="ProgressBarHuawei" Height="6" Background="#27272A" Foreground="#00D2FF" Value="0" Maximum="100"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ==================================================== -->
                                <!-- PANEL 2: FASTBOOT & RESCUE MODE SERVICES            -->
                                <!-- ==================================================== -->
                                <StackPanel x:Name="PanelHuaweiFastboot" Visibility="Collapsed">
                                    <TextBlock Text="🚀 HUAWEI FASTBOOT &amp; RESCUE MODE SERVICES:" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,6"/>

                                    <TextBlock Text="DIAGNOSTICS &amp; HARDWARE INFO:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="2,2,0,4"/>
                                    <Button Content="Huawei Deep Read Info (OEM Hash / Country / Bootinfo)" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootDeepInfoClicked"/>
                                    <Button Content="Check Battery Voltage &amp; Hardware Health" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootCheckBatteryClicked"/>
                                    <Button Content="Check Bootloader &amp; FRP Lock Status" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootCheckLockStatusClicked"/>

                                    <Border Height="1" Background="#232332" Margin="4,8,4,8"/>
                                    <TextBlock Text="BOOTLOADER &amp; FRP REMOVAL:" FontSize="9" FontWeight="Bold" Foreground="#E2E8F0" Margin="2,0,0,4"/>

                                    <!-- 16-Digit Bootloader Unlock Key Input -->
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="OEM BOOTLOADER UNLOCK KEY (16 DIGITS):" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                            <DockPanel>
                                                <TextBox x:Name="TxtHuaweiUnlockKey" Text="" Background="#0F0F14" Foreground="#34D399" FontFamily="Consolas" FontWeight="Bold" BorderBrush="#2E2E40" Height="26" FontSize="11" Padding="5,3"/>
                                                <Button Content="🔓 Unlock BL" Width="90" Background="#B45309" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Height="26" Margin="6,0,0,0" DockPanel.Dock="Right" Click="OnHuaweiFastbootUnlockBlClicked"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="🔒 Re-Lock Bootloader (fastboot oem relock)" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootRelockBlClicked"/>
                                    <Button Content="⚡ Fastboot Erase FRP (Unlocked / Temp Exploit)" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootEraseFrpClicked"/>

                                    <Border Height="1" Background="#232332" Margin="4,8,4,8"/>
                                    <TextBlock Text="REBOOTS &amp; RESCUE SWITCHING:" FontSize="9" FontWeight="Bold" Foreground="#34D399" Margin="2,0,0,4"/>

                                    <Button Content="🔄 Reboot to Normal System" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootRebootNormalClicked"/>
                                    <Button Content="🚑 Reboot to eRecovery Mode" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootRebootErecoveryClicked"/>
                                    <Button Content="💾 Reboot to Upgrade / DLOAD Mode (fastboot oem reboot-update)" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootRebootDloadClicked"/>
                                    <Button Content="⚡ Soft Reset Fastboot" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiFastbootRebootFastbootClicked"/>
                                </StackPanel>

                                <!-- ==================================================== -->
                                <!-- PANEL 3: MANUFACTURE MODE (PCUI & DIAG REPAIR)      -->
                                <!-- ==================================================== -->
                                <StackPanel x:Name="PanelHuaweiManufacture" Visibility="Collapsed">
                                    <TextBlock Text="🛠️ HUAWEI MANUFACTURE MODE (PCUI / DIAG SUITE):" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,6"/>

                                    <!-- Secret Code Activation Helper Banner -->
                                    <Border Background="#1E1A0F" BorderBrush="#854D0E" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="📱 HOW TO ACTIVATE MANUFACTURE MODE:" FontSize="9.5" FontWeight="Bold" Foreground="#FBBF24"/>
                                            <TextBlock Text="1. Open Dialer and type: *#*#2846579#*#*" FontSize="8.5" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                            <TextBlock Text="2. Select: ProjectMenu -&gt; Background Settings -&gt; USB Ports Settings" FontSize="8.5" Foreground="#E2E8F0"/>
                                            <TextBlock Text="3. Select: 'Manufacture Mode' (Enables Huawei Mobile Connect - PCUI Port)" FontSize="8.5" Foreground="#34D399" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Security & Diagnostics -->
                                    <TextBlock Text="SECURITY READ &amp; BACKUP:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="2,0,0,4"/>
                                    <Button Content="Read Security Information &amp; RF Calibration" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiManufactureReadSecurityClicked"/>
                                    <Button Content="Backup Security &amp; Calibration (CERT / NV / OEM)" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiManufactureBackupSecurityClicked"/>
                                    <Button Content="Restore Security &amp; Calibration (CERT / NV)" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiManufactureRestoreSecurityClicked"/>

                                    <Border Height="1" Background="#232332" Margin="4,8,4,8"/>
                                    <TextBlock Text="DUAL IMEI REPAIR (15 DIGITS):" FontSize="9" FontWeight="Bold" Foreground="#E2E8F0" Margin="2,0,0,4"/>

                                    <Border Background="#1A1A24" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="IMEI 1:" Width="50" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtHuaweiImei1" Text="860123456789012" Background="#0F0F14" Foreground="#38BDF8" FontFamily="Consolas" BorderBrush="#2E2E40" Height="24" FontSize="11" Padding="4,2"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="IMEI 2:" Width="50" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtHuaweiImei2" Text="860123456789020" Background="#0F0F14" Foreground="#38BDF8" FontFamily="Consolas" BorderBrush="#2E2E40" Height="24" FontSize="11" Padding="4,2"/>
                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="📖 Read IMEI" Height="26" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Click="OnHuaweiManufactureReadImeiClicked"/>
                                                <Button Grid.Column="2" Content="✍️ Write Dual IMEI" Height="26" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnHuaweiManufactureWriteImeiClicked"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Hardware Identifiers (MAC / SN / MEID) -->
                                    <TextBlock Text="HARDWARE IDENTIFIERS (MAC / MEID / SN):" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="2,0,0,4"/>
                                    <Button Content="Repair WiFi MAC Address &amp; Bluetooth UID" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiManufactureRepairMacClicked"/>
                                    <Button Content="Repair MEID &amp; Electronic Serial Number (SN)" Style="{StaticResource CyberBulletButton}" Click="OnHuaweiManufactureRepairSnMeidClicked"/>
                                </StackPanel>

                                <!-- ==================================================== -->
                                <!-- PANEL 4: UPGRADE / DLOAD FLASHER                    -->
                                <!-- ==================================================== -->
                                <StackPanel x:Name="PanelHuaweiDload" Visibility="Collapsed">
                                    <TextBlock Text="💾 HUAWEI DLOAD &amp; SD-UPDATE FLASHER:" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,6"/>

                                    <Border Background="#1A1A24" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="HUAWEI FIRMWARE (UPDATE.APP):" FontSize="9.5" FontWeight="ExtraBold" Foreground="#CBD5E1" Margin="0,0,0,3"/>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBox x:Name="TxtHuaweiUpdateAppPath" Text="Select stock UPDATE.APP (or cust/preload)..." Background="#0F0F14" Foreground="#CBD5E1" BorderBrush="#2E2E40" Height="26" FontSize="10" Padding="5,3"/>
                                                <Button Content="Browse" Width="55" Background="#334155" Foreground="#FFFFFF" BorderThickness="0" Height="26" Margin="6,0,0,0" DockPanel.Dock="Right" Click="OnBrowseHuaweiUpdateAppClicked"/>
                                            </DockPanel>

                                            <!-- Flashing Options -->
                                            <CheckBox x:Name="ChkHuaweiVerifyCrc" Content="Verify Firmware Checksum (CRC32/SHA256)" IsChecked="True" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="9.5" Margin="0,2,0,4"/>
                                            <CheckBox x:Name="ChkHuaweiWipeData" Content="Wipe Data / Factory Reset After Flash" IsChecked="False" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="9.5" Margin="0,0,0,4"/>
                                            <CheckBox x:Name="ChkHuaweiSkipCust" Content="Skip Cust / Region Verification (Cross-Flash)" IsChecked="False" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="9.5"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Flash Execution Button -->
                                    <Button Content="⚡ 1-Click Flash UPDATE.APP" Height="36" Background="#EA580C" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="12" BorderThickness="0" Margin="0,4,0,8" Click="OnHuaweiFlashUpdateAppClicked"/>

                                    <!-- DLOAD Mode Instructions Banner -->
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="7">
                                        <StackPanel>
                                            <TextBlock Text="📖 DLOAD MODE COMBINATION:" FontSize="9.5" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                                            <TextBlock Text="1. Power off device completely." FontSize="9" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                            <TextBlock Text="2. Hold Volume Up + Volume Down + Power button together." FontSize="9" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                            <TextBlock Text="3. Phone enters 'Software Installing / EMUI Update' screen." FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: Shared Huawei Port Status Bar & Cyan Terminal Console -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Device Status & Command Toolbar: DUAL LIVE HARDWARE NOTIFICATION RADAR -->
                    <Border Grid.Row="0" Background="#0C101C" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/> <!-- Box 1: COM Port Box -->
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.5*"/> <!-- Box 2: USB Interface Box -->
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                            </Grid.ColumnDefinitions>

                            <!-- BOX 1: CONNECTED COM PORT WITH LIVE LED LIGHT -->
                            <Border Grid.Column="0" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                <DockPanel>
                                    <Ellipse x:Name="LedHuaweiCom" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowHuaweiCom" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Border x:Name="BadgeHuaweiCom" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtHuaweiComState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔌 HUAWEI COM PORT" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtHuaweiComBox" Text="NO COM PORT DETECTED" FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- BOX 2: CONNECTED USB INTERFACE WITH LIVE LED LIGHT -->
                            <Border Grid.Column="2" Background="#111827" BorderBrush="#253248" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                <DockPanel>
                                    <Ellipse x:Name="LedHuaweiUsb" Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowHuaweiUsb" BlurRadius="10" ShadowDepth="0" Color="#EF4444"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Border x:Name="BadgeHuaweiUsb" DockPanel.Dock="Right" Background="#1F2937" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtHuaweiUsbState" Text="OFFLINE" FontSize="8" FontWeight="ExtraBold" Foreground="#9CA3AF"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="⚡ HUAWEI USB INTERFACE" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtHuaweiUsbBox" Text="WAITING FOR HUAWEI DEVICE..." FontSize="10.5" FontWeight="ExtraBold" Foreground="#F87171" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- ACTION BUTTONS: SCAN & ABORT & CLEAR -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHuaweiPortStatus" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtHuaweiPort" Visibility="Collapsed"/>

                                <Button Content="🔍 Scan Ports" Height="28" Padding="12,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnScanHuaweiPortsClicked"/>
                                <Button Content="⛔ ABORT" Height="28" Padding="10,0" Background="#991B1B" Foreground="#FECACA" FontWeight="Bold" FontSize="10" BorderThickness="0" Margin="0,0,6,0" Click="OnEmergencyAbortClicked"/>
                                <Button Content="Clear Console" Height="28" Padding="10,0" Background="#1E1E2A" Foreground="#94A3B8" FontSize="10" BorderThickness="0" Click="OnClearHuaweiLogClicked"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Console for Huawei / Honor HiSilicon Kirin Protocol Log -->
                    <Border Grid.Row="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="HUAWEI &amp; HONOR HISILICON (KIRIN) PROTOCOL LOG" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="TxtHuaweiConsole" Grid.Row="1" Background="#070709" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

                        <!-- ================================================================ -->
            <!-- VIEW 7: UNIVERSAL MULTI-MODE SAFE VAULT & BACKUP DOCTOR          -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewBackup" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Hardware Radar & Status Strip -->
                    <RowDefinition Height="*"/>    <!-- Main 3-Column Vault Workspace -->
                    <RowDefinition Height="180"/>  <!-- Bottom Live Protocol Console -->
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP STATUS & ACTIVE MODE RADAR -->
                <Border Grid.Row="0" Background="#121622" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ UNIVERSAL SAFE VAULT &amp; DISASTER RECOVERY DOCTOR" FontSize="11.5" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                            <Border Background="#065F46" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="ZERO-OTP SESSIONS ONLINE" FontSize="8.5" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                            <Border Background="#1E3A8A" CornerRadius="3" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="MULTI-MODE HARDWARE DUMP" FontSize="8.5" FontWeight="Bold" Foreground="#93C5FD"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="📁 Open All Backups Folder" Height="24" Padding="8,0" Background="#1E293B" Foreground="#38BDF8" FontSize="9" FontWeight="Bold" BorderThickness="1" BorderBrush="#334155" Click="OnOpenBackupFolderClicked" Margin="0,0,8,0"/>
                            <Button Content="⛔ ABORT" Height="24" Padding="8,0" Background="#991B1B" Foreground="#FECACA" FontSize="9" FontWeight="Bold" BorderThickness="0" Click="OnEmergencyAbortClicked" Margin="0,0,8,0"/>
                            <Border Background="#0B0F19" CornerRadius="3" Padding="8,2" BorderBrush="#1E293B" BorderThickness="1">
                                <TextBlock x:Name="TxtBackupVaultStatus" Text="● HARDWARE RADAR: STANDBY &amp; LISTENING" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ROW 1: MAIN 3-COLUMN VAULT WORKSPACE -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/> <!-- Col 0: WhatsApp Zero-OTP Vault -->
                        <ColumnDefinition Width="380"/> <!-- Col 1: Hardware & NV Security Dump -->
                        <ColumnDefinition Width="*"/>   <!-- Col 2: Customer UserData & Explorer Extractor -->
                    </Grid.ColumnDefinitions>

                    <!-- ======================================================== -->
                    <!-- COLUMN 0: WHATSAPP ZERO-OTP SESSION VAULT                -->
                    <!-- ======================================================== -->
                    <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="💬 WHATSAPP ZERO-OTP VAULT" FontSize="10" FontWeight="ExtraBold" Foreground="#34D399" VerticalAlignment="Center"/>
                                        <TextBlock Text="● NO OTP NEEDED" FontSize="8" FontWeight="Bold" Foreground="#A7F3D0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="Active login session, master encryption keys (files/key), and raw databases cloning without receiving SMS/Call OTP code." FontSize="9" FontWeight="Medium" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- WhatsApp Primary Action Buttons -->
                                <Button Content="📥 1-Click Backup WhatsApp Session (No OTP)" Height="30" Background="#065F46" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,5" Click="OnBackupWhatsAppSessionClicked"/>
                                <Button Content="📤 1-Click Restore WhatsApp Session to Phone" Height="30" Background="#047857" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,5" Click="OnRestoreWhatsAppSessionClicked"/>
                                <Button Content="🔑 Extract Master Decryption Key &amp; Crypt DB" Height="26" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,5" Click="OnExtractWhatsAppKeyClicked"/>
                                <Button Content="📱 Clone Session to Secondary Device" Height="26" Background="#1E293B" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,5" Click="OnCloneWhatsAppSessionClicked"/>
                                <Button Content="💬 Generate HTML / PDF Chat Report" Height="26" Background="#1E293B" Foreground="#FCD34D" FontWeight="SemiBold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,8" Click="OnGenerateChatReportClicked"/>
                                <Button Content="📂 Browse WhatsApp Vault in Explorer" Height="28" Background="#0C4A6E" Foreground="#38BDF8" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,8" Click="OnOpenWhatsAppExplorerClicked"/>

                                <!-- Options Checklist -->
                                <Border Background="#161A26" CornerRadius="4" Padding="8,6" BorderBrush="#253248" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="EXTRACTION CONFIGURATION:" FontSize="8.5" FontWeight="ExtraBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ChkWaMedia" Content="Include Public Media (Voice, Photos, Docs)" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="9" IsChecked="True" Margin="0,2"/>
                                        <CheckBox x:Name="ChkWaBusiness" Content="Scan WhatsApp Business (com.whatsapp.w4b)" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="9" IsChecked="True" Margin="0,2"/>
                                        <CheckBox x:Name="ChkWaScoped" Content="Bypass Android 11/12/13 Scoped Storage" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="9" IsChecked="True" Margin="0,2"/>
                                        <CheckBox x:Name="ChkWaDecrypted" Content="Extract Decrypted Plaintext SQLite Databases" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="9" IsChecked="True" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ======================================================== -->
                    <!-- COLUMN 1: MULTI-MODE HARDWARE DUMP & CALIBRATION VAULT   -->
                    <!-- ======================================================== -->
                    <Border Grid.Column="1" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="#78350F" BorderBrush="#B45309" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="⚡ MULTI-MODE HARDWARE &amp; NV DUMP" FontSize="10" FontWeight="ExtraBold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                        <TextBlock Text="● ALL CHIPSETS" FontSize="8" FontWeight="Bold" Foreground="#FDE68A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="Full physical sector readout (MTK BROM, Qualcomm EDL 9008, Huawei PCUI, SPRD). Guarantees 0-brick &amp; fixes Null IMEI." FontSize="9" FontWeight="Medium" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Hardware Primary Action Buttons -->
                                <Button Content="⚡ 1-Click Backup Security / NVRAM (IMEI Protection)" Height="30" Background="#B45309" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,5" Click="OnBackupSecurityNvClicked"/>
                                <Button Content="🔄 1-Click Restore Security / NVRAM (Fix Null IMEI)" Height="30" Background="#92400E" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,5" Click="OnRestoreSecurityNvClicked"/>
                                <Button Content="💾 Dump Critical Partitions (Boot, Recovery, OEMInfo)" Height="26" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,5" Click="OnDumpSelectedPartitionsClicked"/>
                                <Button Content="💽 Full eMMC / UFS Raw Sector Dump (Complete Unbrick)" Height="26" Background="#1E293B" Foreground="#F472B6" FontWeight="SemiBold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,5" Click="OnDumpFullEmmcClicked"/>
                                <Button Content="🛡️ Create Anti-Accident Checkpoint (Unplug Safe Guard)" Height="26" Background="#1E293B" Foreground="#34D399" FontWeight="SemiBold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,8" Click="OnCreateCheckpointClicked"/>
                                <Button Content="📂 Browse Security &amp; NV Vault in Explorer" Height="28" Background="#713F12" Foreground="#FDE047" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,8" Click="OnOpenSecurityExplorerClicked"/>

                                <!-- Hardware Options Checklist -->
                                <Border Background="#161A26" CornerRadius="4" Padding="8,6" BorderBrush="#253248" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="HARDWARE DUMP PARAMETERS:" FontSize="8.5" FontWeight="ExtraBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ChkNvVerify" Content="Verify SHA-256 / MD5 Checksums Post-Read" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="9" IsChecked="True" Margin="0,2"/>
                                        <CheckBox x:Name="ChkNvCompress" Content="Auto-Compress Raw Dumps to .zip Archive" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="9" IsChecked="True" Margin="0,2"/>
                                        <CheckBox x:Name="ChkNvSkipEmpty" Content="Skip Sparse / Empty Null Sectors (High Speed)" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="9" IsChecked="True" Margin="0,2"/>
                                        <CheckBox x:Name="ChkNvOeminfo" Content="Include HiSilicon / Huawei Live oeminfo.bin" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="9" IsChecked="True" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ======================================================== -->
                    <!-- COLUMN 2: CUSTOMER USERDATA & CONTACTS VAULT             -->
                    <!-- ======================================================== -->
                    <Border Grid.Column="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="👤 CUSTOMER USERDATA &amp; CONTACTS VAULT" FontSize="10" FontWeight="ExtraBold" Foreground="#A5B4FC" VerticalAlignment="Center"/>
                                        <TextBlock Text="● ZERO CLOUD DEPENDENCY" FontSize="8" FontWeight="Bold" Foreground="#C7D2FE" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="Extract contacts, call logs, SMS, and gallery without Google cloud account or screen lock hindrances." FontSize="9" FontWeight="Medium" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- UserData Action Buttons -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📇 Export Contacts (.vcf)" Height="28" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Click="OnBackupContactsClicked"/>
                                    <Button Grid.Column="2" Content="💬 Export SMS Messages" Height="28" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Click="OnBackupSmsClicked"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📷 Export Camera &amp; Photos" Height="28" Background="#1E293B" Foreground="#34D399" FontWeight="Bold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Click="OnBackupGalleryClicked"/>
                                    <Button Grid.Column="2" Content="📞 Export Call History" Height="28" Background="#1E293B" Foreground="#FCD34D" FontWeight="Bold" FontSize="9" BorderThickness="1" BorderBrush="#334155" Click="OnBackupCallLogsClicked"/>
                                </Grid>

                                <Button Content="📥 1-Click Full UserData Package Backup" Height="30" Background="#312E81" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,5" Click="OnBackupUserDataClicked"/>
                                <Button Content="📤 1-Click Restore Full UserData to Fresh ROM" Height="30" Background="#1E1B4B" Foreground="#A5B4FC" FontWeight="Bold" FontSize="9.5" BorderThickness="1" BorderBrush="#4338CA" Margin="0,0,0,8" Click="OnRestoreUserDataClicked"/>
                                <Button Content="📂 Browse Extracted Customer Files in Explorer" Height="28" Background="#1E3A8A" Foreground="#93C5FD" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Margin="0,0,0,8" Click="OnOpenCustomerExplorerClicked"/>

                                <!-- Extraction Summary Card -->
                                <Border Background="#161A26" CornerRadius="4" Padding="8,6" BorderBrush="#253248" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="STORAGE &amp; MEDIA GEOMETRY:" FontSize="8.5" FontWeight="ExtraBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <TextBlock Text="Active Directory: C:\BSLab_Tool\backups\" FontSize="8.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="#CBD5E1"/>
                                        <TextBlock x:Name="TxtBackupDiskSpace" Text="Disk Space Available: 142.6 GB Free on Drive C:\" FontSize="8" FontFamily="Consolas" Foreground="#34D399" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ROW 2: LIVE PROTOCOL CONSOLE & PROGRESS BAR -->
                <Border Grid.Row="2" Background="#101017" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Console Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡ SAFE VAULT &amp; DISASTER RECOVERY PROTOCOL CONSOLE" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                    <TextBlock Text="REAL-TIME I/O MONITOR" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📋 Copy Log" Width="70" Height="20" Background="#1E293B" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Click="OnCopyBackupLogClicked" Margin="0,0,6,0"/>
                                <Button Content="🧹 Clear" Width="50" Height="20" Background="#1E293B" Foreground="#94A3B8" FontSize="8.5" FontWeight="Bold" BorderThickness="0" Click="OnClearBackupConsoleClicked"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Progress Bar & Status -->
                        <Grid Grid.Row="1" Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="BackupProgressBar" Grid.Column="0" Height="6" Background="#1E293B" Foreground="#10B981" BorderThickness="0" Value="0" Maximum="100"/>
                            <TextBlock x:Name="TxtBackupProgressPct" Grid.Column="1" Text="0%" FontSize="8.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Log Console -->
                        <TextBox x:Name="TxtBackupConsole" Grid.Row="2" Background="#070709" Foreground="#34D399" FontFamily="Consolas" FontSize="10" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>


            <!-- ================================================================ -->
            <!-- VIEW 6: ENTERPRISE SETTINGS & WORKSTATION CONFIGURATION         -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Tool Paths, Baud Rates & Safety Guard -->
                <Border Grid.Column="0" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Settings Header Banner -->
                            <Border Background="#0C1427" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️ WORKSTATION SETTINGS" FontSize="11" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                                        <Border Background="#1E3A8A" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                            <TextBlock Text="ENTERPRISE CORE" FontSize="8.5" FontWeight="Bold" Foreground="#93C5FD"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="● SYNCED" FontSize="9" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- CARD 0: APPLICATION THEME & APPEARANCE -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎨 APPLICATION THEME &amp; APPEARANCE" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                                <TextBlock Text="REAL-TIME UI" FontSize="7.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtCurrentThemeBadge" Text="● ACTIVE: DARK" FontSize="9" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock Text="Select workstation visual interface theme:" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,6"/>

                                    <!-- 3 Theme Cards Grid -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Option 1: Dark Theme -->
                                        <Border x:Name="BorderThemeDark" Grid.Column="0" Background="#0C1427" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="5" Padding="8,8" Cursor="Hand" MouseLeftButtonDown="OnThemeDarkClicked">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🌙" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock Text="Dark Theme" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Midnight Cyber" FontSize="7.5" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Option 2: Light Theme -->
                                        <Border x:Name="BorderThemeLight" Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="8,8" Cursor="Hand" MouseLeftButtonDown="OnThemeLightClicked">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="☀️" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock Text="Light Theme" FontSize="9.5" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Clean Lab White" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Option 3: Default by System -->
                                        <Border x:Name="BorderThemeSystem" Grid.Column="4" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="8,8" Cursor="Hand" MouseLeftButtonDown="OnThemeSystemClicked">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="💻" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock Text="Default by System" FontSize="9.5" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Follows Windows" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Theme Status & Info Ribbon -->
                                    <Border Background="#0B0F19" CornerRadius="4" Padding="8,5" BorderBrush="#1E293B" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtThemeStatusInfo" Text="Active: 🌙 Dark Cyber Core (OLED contrast &amp; reduced eye fatigue for firmware flashing)." FontSize="8" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                            <Button Content="⚡ Apply Now" Width="80" Height="22" Background="#0284C7" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Click="OnApplyThemeClicked"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CARD 1: PLATFORM-TOOLS & BINARY ENVIRONMENT -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📁 PLATFORM-TOOLS &amp; BINARY PATHS" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>

                                    <!-- ADB / Fastboot Path -->
                                    <TextBlock Text="ADB &amp; Fastboot Executable Directory:" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSettingsPlatformToolsPath" Grid.Column="0" Height="24" Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155" FontSize="9" Padding="4,2" Text="C:\BSLab_Tool\tools\platform-tools" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Browse Folder" Width="28" Height="24" Margin="4,0,0,0" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Click="OnSettingsBrowsePlatformToolsClicked"/>
                                        <Button Grid.Column="2" Content="⚡ Test" ToolTip="Test ADB &amp; Fastboot" Width="48" Height="24" Margin="4,0,0,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnSettingsTestAdbClicked"/>
                                    </Grid>

                                    <!-- Loaders & DA Path -->
                                    <TextBlock Text="Hardware Loaders Directory (MTK DA / Firehose / Kirin xLoader):" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSettingsLoadersPath" Grid.Column="0" Height="24" Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155" FontSize="9" Padding="4,2" Text="C:\BSLab_Tool\resources\loaders" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Browse Folder" Width="28" Height="24" Margin="4,0,0,0" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Click="OnSettingsBrowseLoadersClicked"/>
                                    </Grid>

                                    <!-- PIT Database Path -->
                                    <TextBlock Text="Samsung 484 PIT Database Directory:" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSettingsPitPath" Grid.Column="0" Height="24" Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155" FontSize="9" Padding="4,2" Text="C:\BSLab_Tool\resources\pit_database" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Browse Folder" Width="28" Height="24" Margin="4,0,0,0" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Click="OnSettingsBrowsePitClicked"/>
                                    </Grid>

                                    <!-- Local Backups Path -->
                                    <TextBlock Text="Local Backups &amp; Surgical Snapshots Directory:" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSettingsBackupsPath" Grid.Column="0" Height="24" Background="#0B0F19" Foreground="#38BDF8" BorderBrush="#334155" FontSize="9" Padding="4,2" Text="C:\BSLab_Tool\backups" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Browse Folder" Width="28" Height="24" Margin="4,0,0,0" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Click="OnSettingsBrowseBackupsClicked"/>
                                        <Button Grid.Column="2" Content="📂 Open" ToolTip="Open Backups Folder in Explorer" Width="55" Height="24" Margin="4,0,0,0" Background="#1E293B" Foreground="#34D399" FontWeight="Bold" BorderThickness="0" Click="OnSettingsOpenBackupsFolderClicked"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: HARDWARE COMMUNICATION & PORT SETTINGS -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🔌 HARDWARE COMMUNICATION &amp; COM RADAR" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Default Serial Baud Rate:" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CmbSettingsBaudRate" Style="{StaticResource DarkCyberComboBox}" Height="24" SelectedIndex="0">
                                                <ComboBoxItem Content="115200 (Standard Diagnostic)"/>
                                                <ComboBoxItem Content="921600 (High-Speed BROM / EDL)"/>
                                                <ComboBoxItem Content="460800 (Fast UART)"/>
                                                <ComboBoxItem Content="230400 (Stable Diag)"/>
                                                <ComboBoxItem Content="57600 (Legacy Modem)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Serial Read Timeout:" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CmbSettingsTimeout" Style="{StaticResource DarkCyberComboBox}" Height="24" SelectedIndex="1">
                                                <ComboBoxItem Content="1000 ms (Fast Response)"/>
                                                <ComboBoxItem Content="1500 ms (Optimal)"/>
                                                <ComboBoxItem Content="3000 ms (Extended USB)"/>
                                                <ComboBoxItem Content="5000 ms (Long Operations)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="USB Radar Polling Interval:" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CmbSettingsPollInterval" Style="{StaticResource DarkCyberComboBox}" Height="24" SelectedIndex="0">
                                                <ComboBoxItem Content="1.5 Seconds (Real-Time)"/>
                                                <ComboBoxItem Content="3.0 Seconds (Standard)"/>
                                                <ComboBoxItem Content="5.0 Seconds (Low CPU)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="4,16,0,0" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkSettingsAutoSniffer" Content="Auto-Engage on Device Plug" IsChecked="True" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="9"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: ANTI-BRICK SAFETY GUARD SYSTEM -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="🛡️ ANTI-BRICK SAFETY GUARD ENGINE" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                        <Border Background="#064E3B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="100% ACTIVE" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </DockPanel>

                                    <CheckBox x:Name="ChkSettingsAntiBrick" Content="Enable Universal Anti-Brick Guard (Zero-Brick Protection)" IsChecked="True" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="9.5" Margin="0,0,0,5"/>
                                    <CheckBox x:Name="ChkSettingsPreflightBackup" Content="Mandatory Automated Pre-Flight EFS / NVRAM Backup" IsChecked="True" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="9" Margin="0,0,0,5"/>
                                    <CheckBox x:Name="ChkSettingsBatteryThreshold" Content="Enforce Safe Battery Level (&gt; 30% / 3750mV) Before Write" IsChecked="True" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="9" Margin="0,0,0,5"/>
                                    <CheckBox x:Name="ChkSettingsGptCrc" Content="Verify Storage Geometry &amp; Header CRC Checksums" IsChecked="True" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="9"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Column: Cloud Backups, Driver Tools & Shop Profile -->
                <Border Grid.Column="2" Background="#13131A" CornerRadius="6" BorderBrush="#232332" BorderThickness="1" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- CARD 4: CLOUD BACKUP & GOOGLE DRIVE INTEGRATION -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="☁️ GOOGLE DRIVE CLOUD BACKUP &amp; ARCHIVING" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <Border Background="#0C4A6E" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                            <TextBlock Text="GDRIVE ONLINE" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Cloud Status Info Card -->
                                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Authenticated Google Account: m.basharat99ali@gmail.com" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                            <TextBlock x:Name="TxtSettingsLastCloudBackup" Text="Latest Archive: BSLab_Tool_Full_Backup_20261109_031743.zip (ID: 14rtsnSTHuZW1Rw2m4V_G34hpT07yTYi4)" FontSize="9" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                                            <TextBlock Text="Storage Policy: Full Workstation Archive (Code, Loaders, PIT Database, Roadmaps)" FontSize="8.5" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cloud Actions -->
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="☁️ Create &amp; Upload Full Cloud Backup" Height="28" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,4,0" Click="OnSettingsTriggerCloudBackupClicked"/>
                                        <Button Grid.Column="1" Content="📋 View Google Drive File List" Height="28" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Margin="4,0,0,0" Click="OnSettingsViewCloudBackupsClicked"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 5: WINDOWS DRIVERS & SYSTEM DIAGNOSTICS -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🧰 WINDOWS SYSTEM &amp; DRIVER DIAGNOSTICS" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#0C1427" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="5" Padding="3" Margin="0,0,0,6">
                                        <Button Content="⚡ 1-CLICK AUTO-INSTALL ALL DRIVERS (PNP DRIVERSTORE)" Height="30" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Cursor="Hand" Click="OnSettingsAutoInstallAllDriversClicked"/>
                                    </Border>
                                    <Button Grid.Column="0" Content="🔌 Device Manager (devmgmt.msc)" Height="28" Background="#1E293B" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,4,0" Click="OnSettingsOpenDeviceManagerClicked"/>
                                        <Button Grid.Column="1" Content="🌐 Network Connections (ncpa.cpl)" Height="28" Background="#1E293B" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Margin="4,0,0,0" Click="OnSettingsOpenNetworkConnectionsClicked"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔄 Force Rescan USB Bus (pnputil)" Height="28" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,4,0" Click="OnSettingsRescanUsbClicked"/>
                                        <Button Grid.Column="1" Content="🛡️ Verify LibUsb-win32 Filter" Height="28" Background="#1E293B" Foreground="#34D399" FontWeight="SemiBold" BorderThickness="0" Margin="4,0,0,0" Click="OnSettingsVerifyLibusbClicked"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 6: WORKSTATION PROFILE & ENTERPRISE LICENSE -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="🏢 WORKSTATION PROFILE &amp; LIFETIME LICENSE" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <Border Background="#78350F" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="LIFETIME PRO" FontSize="8" FontWeight="Bold" Foreground="#FDE68A"/>
                                        </Border>
                                    </DockPanel>

                                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Proprietor:" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Syed Bisharat Ali (Shah Ji)" FontSize="9.5" FontWeight="ExtraBold" Foreground="#FFFFFF"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Trading Facility:" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="BS Lab &amp; Mobile Traders — Shop #5, Arif Center, Hall Road, Lahore" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Enterprise Email:" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="m.basharat99ali@gmail.com / admin@bslab.com" FontSize="9" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="License Key:" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="BSLAB-ENT-2026-PRO-9941-LHR (Verified &amp; Activated)" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#FCD34D" Margin="0,3,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Button Content="💾 Save Settings Configuration" Height="28" Background="#065F46" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnSettingsSaveConfigClicked"/>
                                </StackPanel>
                            </Border>

                            <!-- Settings Protocol Log Console -->
                            <Border Background="#161A26" CornerRadius="5" Padding="10" BorderBrush="#253248" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SETTINGS &amp; SYSTEM AUDIT LOG" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSettingsConsole" Height="100" Background="#070709" Foreground="#34D399" FontFamily="Consolas" FontSize="10.5" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ================================================================ -->
            <!-- VIEW UAT DUMP: PHYSICAL EMMC / UFS SECTOR DUMPER                 -->
            <!-- ================================================================ -->
            <Grid x:Name="ViewUatDump" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Partition Sector Map DataGrid -->
                <Border Grid.Row="0" Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="4">
                    <DataGrid Background="#1A232A" Foreground="#ECEFF1" BorderThickness="0" HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A3945">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="140" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Start LBA" Width="120" Binding="{Binding StartLba}"/>
                            <DataGridTextColumn Header="End LBA" Width="120" Binding="{Binding EndLba}"/>
                            <DataGridTextColumn Header="Size" Width="100" Binding="{Binding Size}"/>
                            <DataGridTextColumn Header="File Offset" Width="*" Binding="{Binding Offset}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Bottom Ladder Menu Bar -->
                <Border Grid.Row="1" Background="#1F2B35" BorderBrush="#324452" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ladder Trigger Button -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="📁 Select Dump Size" Background="#24333E" Foreground="#ECEFF1" BorderBrush="#37474F" Height="26" Padding="8,2" FontSize="10" FontWeight="Bold" Click="OnUatToggleDumpLadder"/>
                            <TextBlock x:Name="TxtDumpSelectedSize" Text="Full Dump" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#4DD0E1" FontWeight="Bold" FontSize="10"/>
                        </StackPanel>

                        <!-- Select Dump File Path -->
                        <TextBox Grid.Column="1" Text="... Select Dump File" Background="#1A232A" Foreground="#90A4AE" BorderBrush="#37474F" Height="24" VerticalContentAlignment="Center" Margin="10,0"/>

                        <!-- Action Button: WRITE DUMP -->
                        <Button Grid.Column="2" Content="🗄️ WRITE DUMP" Background="#F57F17" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="10" Height="26" Padding="12,2" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Flyout Ladder Popup (512MB - Full Dump) -->
                <Border x:Name="FlyoutDumpLadder" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="130" Background="#1F2B35" BorderBrush="#4DD0E1" BorderThickness="1" CornerRadius="3" Padding="4" Margin="6,0,0,38" Visibility="Collapsed">
                    <StackPanel>
                        <Button Content="📁 512 MB" Tag="512 MB" Background="Transparent" Foreground="#ECEFF1" BorderThickness="0" Height="22" HorizontalContentAlignment="Left" Click="OnUatDumpLadderSelect"/>
                        <Button Content="📁 1 GB" Tag="1 GB" Background="Transparent" Foreground="#ECEFF1" BorderThickness="0" Height="22" HorizontalContentAlignment="Left" Click="OnUatDumpLadderSelect"/>
                        <Button Content="📁 2 GB" Tag="2 GB" Background="Transparent" Foreground="#ECEFF1" BorderThickness="0" Height="22" HorizontalContentAlignment="Left" Click="OnUatDumpLadderSelect"/>
                        <Button Content="📁 4 GB" Tag="4 GB" Background="Transparent" Foreground="#ECEFF1" BorderThickness="0" Height="22" HorizontalContentAlignment="Left" Click="OnUatDumpLadderSelect"/>
                        <Button Content="📁 8 GB" Tag="8 GB" Background="Transparent" Foreground="#ECEFF1" BorderThickness="0" Height="22" HorizontalContentAlignment="Left" Click="OnUatDumpLadderSelect"/>
                        <Button Content="📁 Full Dump" Tag="Full Dump" Background="#37474F" Foreground="#4DD0E1" BorderThickness="0" Height="22" FontWeight="Bold" HorizontalContentAlignment="Left" Click="OnUatDumpLadderSelect"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================================================================ -->
            <!-- LIVE EXECUTION OVERLAY (ACTIVE FLASHING & FORMATTING SCREEN)     -->
            <!-- ================================================================ -->
            <Grid x:Name="UatExecutionOverlay" Visibility="Collapsed" Background="#1F2B35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top glowing task banner -->
                    <RowDefinition Height="*"/>    <!-- Syntax highlighted execution log -->
                    <RowDefinition Height="Auto"/> <!-- Timer and WorkID -->
                    <RowDefinition Height="36"/>   <!-- Navigation & Quick tools -->
                </Grid.RowDefinitions>

                <!-- Top Green Glowing Header Banner -->
                <Border Grid.Row="0" Background="#102A24" BorderBrush="#00E676" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtUatExecutionTitle" Text="[EDL] FORMAT - FACTORY RESET - SAFE | CPH2363 (F21 PRO)" Foreground="#00E676" FontSize="11.5" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                </Border>

                <!-- Syntax Highlighted Log Terminal -->
                <Border Grid.Row="1" Background="#141D24" BorderBrush="#24333E" BorderThickness="1" CornerRadius="3" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Handshaking... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Init Handshake Sequence... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Initializing Protocol... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Serial: 7454CCF8 SoC : [Snapdragon 680 4G] Target : [SM6225]" Foreground="#FFA726" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="HWID : [0X001B80E1]" Foreground="#4DD0E1" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="PKhash [0] : D53F19D28ED8CA4A5D9C5BD7DDB365DB" Foreground="#BA68C8" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="PKhash [1] : C9268CBDE3DFC8A151E70C8B0A0DFFC2" Foreground="#BA68C8" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Configuring boot... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Version [6] Code Size [816] Signature Size [256] Header Type [NEW]" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Connecting to flash programmer... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Chipset Type... 64 Bit" Foreground="#4DD0E1" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Initializing connection... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Configuring device... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Firehose config : UFS [Sector:4096] [Target:0] [Host:1048576]" Foreground="#FFA726" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Reading partition map... OK - LUN Count : 6" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Requesting server... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Reading device info... FAILED" Foreground="#FF5252" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Reading data... OK" Foreground="#00E676" FontSize="10" FontFamily="Consolas"/>
                            <TextBlock Text="Erasing USERDATA ... OK" Foreground="#00E676" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Timer & WorkID Status -->
                <StackPanel Grid.Row="2" Margin="0,6,0,6">
                    <TextBlock x:Name="TxtUatElapsedTime" Text="Elapsed Time : 6 minutes 21 seconds" Foreground="#F06292" FontWeight="Bold" FontSize="10.5" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtUatWorkId" Text="Operation/WorkID : 4198185828" Foreground="#BA68C8" FontWeight="Bold" FontSize="10.5"/>
                </StackPanel>

                <!-- Navigation Back & Floating Tool Palette -->
                <DockPanel Grid.Row="3">
                    <Button DockPanel.Dock="Left" Content="&lt; Back" Width="70" Height="26" Background="#24333E" Foreground="#ECEFF1" BorderBrush="#37474F" FontSize="10" FontWeight="Bold" Click="OnUatBackFromExecutionClicked"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Quick Tool Trigger Button -->
                        <Button Content="🧰 Quick Tools" Background="#24333E" Foreground="#4DD0E1" BorderBrush="#37474F" Height="26" Padding="8,2" FontSize="10" FontWeight="Bold" Click="OnUatToggleUtilityTray"/>
                        <!-- Emergency Stop Button -->
                        <Button Content="⏹ Stop" Width="60" Height="26" Margin="6,0,0,0" Background="#C62828" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" BorderThickness="0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Floating 12-Icon Utility Launcher Tray -->
                <Border x:Name="PopupUatQuickTools" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#1F2B35" BorderBrush="#4DD0E1" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,6,6" Visibility="Collapsed">
                    <UniformGrid Columns="4" Rows="3" Width="140" Height="105">
                        <Button Content="🖥️" Tag="devmgmt" ToolTip="Device Manager" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="⚙️" Tag="driver" ToolTip="Driver Wizard" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="🛡️" Tag="defender" ToolTip="Antivirus Exclusion" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="🔢" Tag="calc" ToolTip="Calculator" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="🔄" Tag="usbcycle" ToolTip="Restart USB Hub" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="✈️" Tag="telegram" ToolTip="Telegram Group" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="📂" Tag="explorer" ToolTip="Open Logs Folder" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="⌨️" Tag="cmd" ToolTip="CMD Terminal" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="🤖" Tag="adb" ToolTip="ADB &amp; Fastboot" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="🔊" Tag="sound" ToolTip="Audio Notifications" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="⚡" Tag="fastboot" ToolTip="Fastboot Mode" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                        <Button Content="📝" Tag="notepad" ToolTip="Open Notepad Log" Margin="2" Style="{StaticResource WindowCtrlButton}" Click="OnUatQuickToolAction"/>
                    </UniformGrid>
                </Border>
            </Grid>

        </Grid> <!-- Closes Col 1 (Center Stage) -->

        <!-- ================================================================ -->
        <!-- COL 2: UAT PRO MAIN SELECTION & 27-BRAND COLOR RIBBON BAR        -->
        <!-- ================================================================ -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- Main Selection Controls -->
                <ColumnDefinition Width="70"/>  <!-- 27-Brand Color Ribbon -->
            </Grid.ColumnDefinitions>

            <!-- MAIN SELECTION CONTROLS PANEL -->
            <Border Grid.Column="0" Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="4,0,0,4" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Section Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="★ " Foreground="#FBC02D" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="MAIN SELECTION" Foreground="#ECEFF1" FontSize="10.5" FontWeight="ExtraBold"/>
                        </StackPanel>

                        <!-- Options Group -->
                        <Border Background="#1F2B35" BorderBrush="#2F414F" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="OPTIONS" FontSize="9" FontWeight="Bold" Foreground="#90A4AE" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="Backup Security" Foreground="#ECEFF1" FontSize="9" Margin="0,2"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Skip Info." Foreground="#ECEFF1" FontSize="9" Margin="0,2"/>
                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Auto Reboot" IsChecked="True" Foreground="#ECEFF1" FontSize="9" Margin="0,2"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Skip Drivers Info." Foreground="#ECEFF1" FontSize="9" Margin="0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mode Radios -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="Auto Detect Device" Foreground="#ECEFF1" FontSize="9.5" Margin="0,0,10,0"/>
                            <RadioButton Content="By Model" IsChecked="True" Foreground="#ECEFF1" FontSize="9.5"/>
                        </StackPanel>

                        <!-- Brands Dropdown -->
                        <TextBlock Text="Brands :" FontSize="9.5" FontWeight="Bold" Foreground="#CFD8DC" Margin="0,2,0,2"/>
                        <ComboBox x:Name="CmbUatBrand" Height="24" FontSize="9.5" Background="#1A232A" Foreground="#ECEFF1" BorderBrush="#37474F" Margin="0,0,0,6">
                            <ComboBoxItem Content="OPPO" IsSelected="True"/>
                            <ComboBoxItem Content="VIVO"/>
                            <ComboBoxItem Content="XIAOMI"/>
                            <ComboBoxItem Content="TECNO"/>
                            <ComboBoxItem Content="INFINIX"/>
                            <ComboBoxItem Content="ONEPLUS"/>
                            <ComboBoxItem Content="SAMSUNG"/>
                            <ComboBoxItem Content="HUAWEI"/>
                            <ComboBoxItem Content="REALME"/>
                            <ComboBoxItem Content="ITEL"/>
                        </ComboBox>

                        <!-- Search Model Box -->
                        <Border Background="#1A232A" BorderBrush="#37474F" BorderThickness="1" CornerRadius="2" Height="24" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="✕" Width="20" Background="Transparent" Foreground="#90A4AE" BorderThickness="0" FontSize="9"/>
                                <TextBlock DockPanel.Dock="Right" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#90A4AE" FontSize="10"/>
                                <TextBox x:Name="TxtUatSearchModel" Background="Transparent" Foreground="#ECEFF1" BorderThickness="0" VerticalContentAlignment="Center" FontSize="9.5" Text="Search Model"/>
                            </DockPanel>
                        </Border>

                        <!-- Models Dropdown -->
                        <TextBlock Text="Models :" FontSize="9.5" FontWeight="Bold" Foreground="#CFD8DC" Margin="0,2,0,2"/>
                        <ComboBox x:Name="CmbUatModel" Height="24" FontSize="9.5" Background="#1A232A" Foreground="#ECEFF1" BorderBrush="#37474F" Margin="0,0,0,6">
                            <ComboBoxItem Content="CPH2363 (F21 PRO)" IsSelected="True"/>
                            <ComboBoxItem Content="CPH2219 (A74)"/>
                            <ComboBoxItem Content="CPH2239 (A54)"/>
                            <ComboBoxItem Content="CPH2127 (A53)"/>
                            <ComboBoxItem Content="CPH1909 (A5s)"/>
                        </ComboBox>

                        <!-- Storage Dropdown -->
                        <TextBlock Text="Storage :" FontSize="9.5" FontWeight="Bold" Foreground="#CFD8DC" Margin="0,2,0,2"/>
                        <ComboBox Height="24" FontSize="9.5" Background="#1A232A" Foreground="#ECEFF1" BorderBrush="#37474F" Margin="0,0,0,8">
                            <ComboBoxItem Content="⚙ Auto" IsSelected="True"/>
                            <ComboBoxItem Content="eMMC"/>
                            <ComboBoxItem Content="UFS"/>
                        </ComboBox>

                        <!-- Loader File Picker -->
                        <Border Background="#1A232A" BorderBrush="#37474F" BorderThickness="1" CornerRadius="2" Height="24" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="📁" Width="24" Background="#37474F" Foreground="#FFFFFF" BorderThickness="0"/>
                                <TextBox Text="C:\prog_emmc_firehose_Sdm660_ddr.mbn" Background="Transparent" Foreground="#ECEFF1" BorderThickness="0" VerticalContentAlignment="Center" FontSize="8.5"/>
                            </DockPanel>
                        </Border>

                        <!-- Protocols Group -->
                        <Border Background="#1F2B35" BorderBrush="#2F414F" BorderThickness="1" CornerRadius="3" Padding="6">
                            <StackPanel>
                                <TextBlock Text="PROTOCOLS" FontSize="9" FontWeight="Bold" Foreground="#90A4AE" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Protocol - New" IsChecked="True" Foreground="#ECEFF1" FontSize="9" Margin="0,0,12,0"/>
                                    <RadioButton Content="Protocol - Old" Foreground="#ECEFF1" FontSize="9"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 27-BRAND VERTICAL COLOR RIBBON BAR -->
            <Border Grid.Column="1" Background="#1A232A" BorderBrush="#324452" BorderThickness="0,1,1,1" CornerRadius="0,4,4,0" Padding="1">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="1,0">
                        <!-- 27 Brands Stack -->
                        <Button Content="oppo" Tag="oppo" Height="19" Margin="0,1" Background="#008450" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="vivo" Tag="vivo" Height="19" Margin="0,1" Background="#0084FF" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="xiaomi" Tag="xiaomi" Height="19" Margin="0,1" Background="#FF6700" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="TECNO" Tag="tecno" Height="19" Margin="0,1" Background="#0099FF" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="Infinix" Tag="infinix" Height="19" Margin="0,1" Background="#52B52A" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="1+ ONEPLUS" Tag="oneplus" Height="19" Margin="0,1" Background="#EB0028" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="SAMSUNG" Tag="samsung" Height="19" Margin="0,1" Background="#1428A0" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="HUAWEI" Tag="huawei" Height="19" Margin="0,1" Background="#CF0A2C" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="HISILICON" Tag="hisilicon" Height="19" Margin="0,1" Background="#7B1FA2" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="ASUS" Tag="asus" Height="19" Margin="0,1" Background="#00539B" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="Lenovo" Tag="lenovo" Height="19" Margin="0,1" Background="#E2231A" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="NOKIA" Tag="nokia" Height="19" Margin="0,1" Background="#124191" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="TCL" Tag="tcl" Height="19" Margin="0,1" Background="#E50914" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="LG" Tag="lg" Height="19" Margin="0,1" Background="#A50034" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="MOTOROLA" Tag="motorola" Height="19" Margin="0,1" Background="#001489" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="LAVA" Tag="lava" Height="19" Margin="0,1" Background="#E52D27" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="ZTE" Tag="zte" Height="19" Margin="0,1" Background="#0072CE" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="itel" Tag="itel" Height="19" Margin="0,1" Background="#E60012" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="SONY" Tag="sony" Height="19" Margin="0,1" Background="#212121" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="PIXEL" Tag="pixel" Height="19" Margin="0,1" Background="#4285F4" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="IT ADMIN" Tag="itadmin" Height="19" Margin="0,1" Background="#00695C" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="Apple" Tag="apple" Height="19" Margin="0,1" Background="#546E7A" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="MEDIATEK" Tag="mediatek" Height="19" Margin="0,1" Background="#F57C00" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="QUALCOMM" Tag="qualcomm" Height="19" Margin="0,1" Background="#0277BD" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="SPREADTRUM" Tag="spreadtrum" Height="19" Margin="0,1" Background="#2E7D32" Foreground="#FFFFFF" FontSize="7.5" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="JTAG" Tag="jtag" Height="19" Margin="0,1" Background="#6A1B9A" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                        <Button Content="android" Tag="android" Height="19" Margin="0,1" Background="#3DDC84" Foreground="#000000" FontSize="8" FontWeight="ExtraBold" BorderThickness="0" Click="OnUatBrandRibbonClick"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid> <!-- Closes Row 2 (3-Column Workspace) -->

    <!-- ==================================================================== -->
    <!-- ROW 3: UAT PRO TELEMETRY BOTTOM STATUS BAR                          -->
    <!-- ==================================================================== -->
    <Border Grid.Row="3" Background="{DynamicResource StatusBarBackground}" BorderBrush="{DynamicResource StatusBarBorder}" BorderThickness="0,1,0,0">
        <DockPanel Margin="10,0">
            <!-- Customer Job Count & Hardware Status -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <Border Background="#24333E" BorderBrush="#324452" BorderThickness="1" CornerRadius="3" Padding="8,1" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtUatJobCount" Text="COUNT : 464" FontSize="9.5" FontWeight="ExtraBold" Foreground="#4DD0E1" FontFamily="Consolas"/>
                </Border>
                <TextBlock Text="UAT PRO™ © 2015-2026" FontSize="9" Foreground="#90A4AE" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Live COM & USB Indicators in Status Bar -->
                <Border Background="#1F2B35" BorderBrush="#324452" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LedStatusCom" Width="5" Height="5" Fill="#EF4444" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusCom" Text="PORT: OFFLINE" FontSize="8" FontWeight="Bold" Foreground="#90A4AE" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
                <Border Background="#1F2B35" BorderBrush="#324452" BorderThickness="1" CornerRadius="3" Padding="4,1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LedStatusUsb" Width="5" Height="5" Fill="#EF4444" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusUsb" Text="USB: DISCONNECTED" FontSize="8" FontWeight="Bold" Foreground="#90A4AE" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Active Engine & Live Clock -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Updated on : 29-10-2026" FontSize="8.5" Foreground="#78909C" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtUatClock" Text="15 - November - 2026 - 07:15:00 PM" FontSize="9" Foreground="#ECEFF1" Margin="0,0,16,0" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtLiveClock" Visibility="Collapsed"/>
                <Border Background="#1A3A54" BorderBrush="#0288D1" BorderThickness="1" CornerRadius="3" Padding="6,1">
                    <TextBlock Text="Selected Module : QUALCOMM" FontSize="9" FontWeight="Bold" Foreground="#4FC3F7"/>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
    </Grid>
</Window>