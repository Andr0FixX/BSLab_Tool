<Application x:Class="BSLabTool.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- UAT PRO Official Dark Slate & Charcoal Theme Engine -->
            <SolidColorBrush x:Key="BackgroundDark" Color="#1F2B35"/>
            <SolidColorBrush x:Key="CardDark" Color="#24333E"/>
            <SolidColorBrush x:Key="CardHeader" Color="#2B3B48"/>
            <SolidColorBrush x:Key="CardBorder" Color="#324452"/>
            <SolidColorBrush x:Key="AccentCyan" Color="#4DD0E1"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF1"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#90A4AE"/>

            <!-- Dynamic Theme Tokens -->
            <SolidColorBrush x:Key="BulletButtonForeground" Color="#CFD8DC"/>
            <SolidColorBrush x:Key="BulletDotFill" Color="#37474F"/>
            <SolidColorBrush x:Key="BulletDotStroke" Color="#546E7A"/>
            <SolidColorBrush x:Key="BulletHoverBackground" Color="#2B3B48"/>
            <SolidColorBrush x:Key="BulletHoverForeground" Color="#4DD0E1"/>

            <SolidColorBrush x:Key="NavBackground" Color="#1A232A"/>
            <SolidColorBrush x:Key="NavBorder" Color="#2A3945"/>
            <SolidColorBrush x:Key="NavTabBackground" Color="#24333E"/>
            <SolidColorBrush x:Key="NavTabForeground" Color="#90A4AE"/>
            <SolidColorBrush x:Key="NavTabHoverBackground" Color="#2F414F"/>
            <SolidColorBrush x:Key="NavTabHoverForeground" Color="#80DEEA"/>
            <SolidColorBrush x:Key="ActiveNavTabBackground" Color="#37474F"/>
            <SolidColorBrush x:Key="ActiveNavTabForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ActiveNavTabBorder" Color="#4DD0E1"/>

            <SolidColorBrush x:Key="TitleBarBackground" Color="#1A232A"/>
            <SolidColorBrush x:Key="TitleBarBorder" Color="#2A3945"/>
            <SolidColorBrush x:Key="StatusBarBackground" Color="#192229"/>
            <SolidColorBrush x:Key="StatusBarBorder" Color="#2A3945"/>

            <SolidColorBrush x:Key="SubTabInactiveBackground" Color="#24333E"/>
            <SolidColorBrush x:Key="SubTabInactiveForeground" Color="#90A4AE"/>
            <SolidColorBrush x:Key="SubTabInactiveBorder" Color="#324452"/>
            <SolidColorBrush x:Key="SubTabActiveBackground" Color="#37474F"/>
            <SolidColorBrush x:Key="SubTabActiveForeground" Color="#4DD0E1"/>
            <SolidColorBrush x:Key="SubTabActiveBorder" Color="#4DD0E1"/>

            <!-- Syntax Highlighting Tokens -->
            <SolidColorBrush x:Key="SyntaxGreen" Color="#00E676"/>
            <SolidColorBrush x:Key="SyntaxRed" Color="#FF5252"/>
            <SolidColorBrush x:Key="SyntaxPurple" Color="#BA68C8"/>
            <SolidColorBrush x:Key="SyntaxOrange" Color="#FFA726"/>
            <SolidColorBrush x:Key="SyntaxCyan" Color="#4DD0E1"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>