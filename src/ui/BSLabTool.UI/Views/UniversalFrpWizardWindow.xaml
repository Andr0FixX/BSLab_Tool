                        <TextBlock x:Name="TxtBottomStatus" Text="ARMED &amp; MONITORING" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
