<Window x:Class="BSLabTool.UI.Views.UniversalFrpWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — Universal 1-Click FRP &amp; Cloud Lock Bypass Wizard"
        Width="1050" Height="700" MinWidth="850" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Neon Gradient Brushes -->
        <LinearGradientBrush x:Key="BorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0.0"/>
            <GradientStop Color="#10B981" Offset="0.5"/>
            <GradientStop Color="#00E5FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGreenGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F59E0B" Offset="0.0"/>
            <GradientStop Color="#10B981" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SamsungBlueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0.0"/>
            <GradientStop Color="#38BDF8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="XiaomiOrangeGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EA580C" Offset="0.0"/>
            <GradientStop Color="#F97316" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleShieldGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C3AED" Offset="0.0"/>
            <GradientStop Color="#A855F7" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Modern Action Button Style -->
        <Style x:Key="WizardActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Giant Action Button Style -->
        <Style x:Key="WizardGiantButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldGreenGradient}"/>
            <Setter Property="Foreground" Value="#0B132B"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#10B981" Opacity="0.4" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub-Nav Tab Style -->
        <Style x:Key="WizardNavTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Neon Border -->
    <Border CornerRadius="12" BorderThickness="1.5" BorderBrush="{StaticResource BorderGlow}" Background="#0B132B" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#F59E0B" Opacity="0.3" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="46"/>
                <!-- Device Status & Mode Banner -->
                <RowDefinition Height="64"/>
                <!-- Mode Navigation Tabs -->
                <RowDefinition Height="42"/>
                <!-- Main Workspace Panels -->
                <RowDefinition Height="*"/>
                <!-- Bottom Info Bar -->
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- ================================================================ -->
            <!-- ROW 0: CUSTOM TITLE BAR                                           -->
            <!-- ================================================================ -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="12,12,0,0" MouseDown="OnTitleBarMouseDown" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="18" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BS LAB TOOL PRO" FontSize="14" FontWeight="ExtraBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="1-CLICK FRP &amp; CLOUD WIZARD" FontSize="9.5" FontWeight="Bold" Foreground="#0B132B"/>
                        </Border>
                    </StackPanel>

                    <!-- Center Badge -->
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Samsung • Xiaomi • MediaTek • Qualcomm • Unisoc • FinTech MDM" FontSize="10" Foreground="#64748B"/>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Width="30" Height="26" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" Click="OnMinimizeClicked" Cursor="Hand"/>
                        <Button Content="✕" Width="30" Height="26" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="OnCloseClicked" Cursor="Hand" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- ROW 1: LIVE DEVICE TELEMETRY & CONNECTION BANNER                  -->
            <!-- ================================================================ -->
            <Border Grid.Row="1" Background="#131F37" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Icon & Mode Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BdModeIcon" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtModeIcon" Text="🔌" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtDetectedModeBadge" Text="SCANNING PORTS..." FontWeight="ExtraBold" FontSize="11" Foreground="#F59E0B" Margin="0,0,8,0"/>
                                <Border x:Name="BdBypassReadiness" Background="#166534" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBypassReadiness" Text="AUTO-DETECT ACTIVE" FontSize="8.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtDetectedDevice" Text="Plug device in MTP, ADB, Fastboot, BROM, or EDL mode" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Scan / Refresh Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔄 Rescan Device" Style="{StaticResource WizardActionButton}" Click="OnRescanPortsClicked" Margin="0,0,8,0"/>
                        <Button Content="⚙️ Device Manager" Style="{StaticResource WizardActionButton}" Click="OnOpenDevMgrClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- ROW 2: METHOD & BRAND NAVIGATION TABS                             -->
            <!-- ================================================================ -->
            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Button x:Name="TabBtnSmartAuto" Content="⚡ SMART AUTO-PILOT" Style="{StaticResource WizardNavTab}" Foreground="#F59E0B" BorderBrush="#F59E0B" Click="OnWizardTabClicked" Tag="Auto"/>
                    <Button x:Name="TabBtnSamsung" Content="🏢 SAMSUNG MTP &amp; QR" Style="{StaticResource WizardNavTab}" Click="OnWizardTabClicked" Tag="Samsung"/>
                    <Button x:Name="TabBtnXiaomi" Content="⚡ XIAOMI MI ACCOUNT" Style="{StaticResource WizardNavTab}" Click="OnWizardTabClicked" Tag="Xiaomi"/>
                    <Button x:Name="TabBtnDirectWipe" Content="🛠️ MTK / EDL PARTITIONS" Style="{StaticResource WizardNavTab}" Click="OnWizardTabClicked" Tag="DirectWipe"/>
                    <Button x:Name="TabBtnFinTech" Content="🛡️ PAYJOY &amp; MDM LEASE" Style="{StaticResource WizardNavTab}" Click="OnWizardTabClicked" Tag="FinTech"/>
                </StackPanel>
            </Border>

            <!-- ================================================================ -->
            <!-- ROW 3: MAIN WORKSPACE (LEFT CONTROLS + RIGHT LIVE CONSOLE)        -->
            <!-- ================================================================ -->
            <Grid Grid.Row="3" Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460"/> <!-- Action Controls & Guides -->
                    <ColumnDefinition Width="*"/>   <!-- Live Execution Console & Progress -->
                </Grid.ColumnDefinitions>

                <!-- LEFT PANELS -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <!-- PANEL 1: SMART AUTO-PILOT -->
                    <ScrollViewer x:Name="PanelSmartAuto" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                        <StackPanel Margin="0,0,4,0">
                            <!-- Hero Card -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⚡ 1-CLICK UNIVERSAL BYPASS ENGINE" FontSize="13" FontWeight="ExtraBold" Foreground="#F59E0B"/>
                                    <TextBlock Text="Automatically probes connected interfaces, matches hardware security level, and bypasses Factory Reset Protection (FRP) with zero guesswork." FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                    <Button Content="🚀 START 1-CLICK AUTO BYPASS" Style="{StaticResource WizardGiantButton}" Click="OnStartAutoBypassClicked" Margin="0,0,0,6"/>
                                    <TextBlock Text="Supports Android 5.0 up to 14/15 on all major chipsets" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Mode Quick Selectors -->
                            <TextBlock Text="MANUAL TRIGGER / OVERRIDE MODES:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,4,0,6"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="MTP Test Mode (*#0*#)" Style="{StaticResource WizardActionButton}" Click="OnTriggerMtpBypassClicked" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="Fastboot FRP Erase" Style="{StaticResource WizardActionButton}" Click="OnTriggerFastbootBypassClicked" Margin="4,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="ADB SetupWizard Kill" Style="{StaticResource WizardActionButton}" Click="OnTriggerAdbBypassClicked" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="EDL/BROM Direct Wipe" Style="{StaticResource WizardActionButton}" Click="OnTriggerBromEdlBypassClicked" Margin="4,0,0,0"/>
                            </Grid>

                            <!-- Workshop Pro-Tips Card -->
                            <Border Background="#162032" CornerRadius="8" Padding="12" BorderBrush="#1E293B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="💡 WORKSHOP CONNECTION TIPS:" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Samsung: Tap Emergency Call ➔ Dial *#0*# or *#9900#." FontSize="10" Foreground="#94A3B8" Margin="0,2"/>
                                    <TextBlock Text="• Xiaomi / Redmi: Hold Vol Down + Power for Fastboot Mode." FontSize="10" Foreground="#94A3B8" Margin="0,2"/>
                                    <TextBlock Text="• MediaTek: Power off phone, hold Vol+ &amp; Vol- then insert USB." FontSize="10" Foreground="#94A3B8" Margin="0,2"/>
                                    <TextBlock Text="• Qualcomm: Use TestPoint or EDL cable for 9008 mode." FontSize="10" Foreground="#94A3B8" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PANEL 2: SAMSUNG MTP & QR SUITE -->
                    <ScrollViewer x:Name="PanelSamsungMtpSuite" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,4,0">
                            <Border Background="#0C4A6E" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#0284C7" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🏢 SAMSUNG MTP / AT COMMAND CENTER" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="Bypasses Knox, FRP &amp; SetupWizard directly through USB MTP / Modem port without opening the phone." FontSize="10" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <Button Content="⚡ Samsung Reset FRP (MTP New Security 2024-2026)" Style="{StaticResource WizardActionButton}" Background="#0284C7" BorderBrush="#38BDF8" FontWeight="Bold" Click="OnSamsungNewSecurityFrpClicked" Margin="0,0,0,6"/>
                                    <Button Content="⚡ Samsung Reset FRP (MTP Legacy 2023)" Style="{StaticResource WizardActionButton}" Click="OnSamsungLegacyFrpClicked" Margin="0,0,0,6"/>
                                    <Button Content="📷 Enable ADB via QR Code / Camera (Android 13/14)" Style="{StaticResource WizardActionButton}" Click="OnSamsungQrCodeAdbClicked" Margin="0,0,0,6"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SAMSUNG UTILITIES:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,4,0,6"/>
                            <Button Content="📥 Reboot to Download Mode (Odin Mode)" Style="{StaticResource WizardActionButton}" Click="OnSamsungRebootDownloadClicked" Margin="0,0,0,6"/>
                            <Button Content="🔄 Reboot Device to Normal System" Style="{StaticResource WizardActionButton}" Click="OnSamsungRebootNormalClicked" Margin="0,0,0,6"/>
                            <Button Content="🛡️ Disable Factory Mode / Retail Demo" Style="{StaticResource WizardActionButton}" Click="OnSamsungDisableDemoClicked" Margin="0,0,0,6"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PANEL 3: XIAOMI MI ACCOUNT & FASTBOOT -->
                    <ScrollViewer x:Name="PanelXiaomiSuite" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,4,0">
                            <Border Background="#431407" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#EA580C" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⚡ XIAOMI / REDMI / POCO CLOUD SUITE" FontSize="13" FontWeight="Bold" Foreground="#F97316"/>
                                    <TextBlock Text="Anti-Relock engine: disables finddevice cloud triggers and neutralizes Mi Account locks safely." FontSize="10" Foreground="#FED7AA" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <Button Content="🔒 Safe Mi Account Bypass (Anti-Relock Armed)" Style="{StaticResource WizardActionButton}" Background="#EA580C" BorderBrush="#F97316" FontWeight="Bold" Click="OnXiaomiSafeMiAccountClicked" Margin="0,0,0,6"/>
                                    <Button Content="⚡ Fastboot 1-Click FRP Partition Wipe" Style="{StaticResource WizardActionButton}" Click="OnXiaomiFastbootFrpClicked" Margin="0,0,0,6"/>
                                    <Button Content="📲 Recovery Sideload Assistant (Format Data)" Style="{StaticResource WizardActionButton}" Click="OnXiaomiSideloadFormatClicked" Margin="0,0,0,6"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="FASTBOOT UTILITIES &amp; EDL SWITCH:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,4,0,6"/>
                            <Button Content="🔌 Fastboot to EDL 9008 1-Click Switch" Style="{StaticResource WizardActionButton}" Click="OnXiaomiRebootEdlClicked" Margin="0,0,0,6"/>
                            <Button Content="🛡️ Check Anti-Rollback (ARB) Protection" Style="{StaticResource WizardActionButton}" Click="OnXiaomiCheckArbClicked" Margin="0,0,0,6"/>
                            <Button Content="🔓 Request Fastboot Bootloader Unlock" Style="{StaticResource WizardActionButton}" Click="OnXiaomiUnlockBlClicked" Margin="0,0,0,6"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PANEL 4: DIRECT PARTITIONS WIPE (MTK / EDL / UNISOC) -->
                    <ScrollViewer x:Name="PanelDirectWipeSuite" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,4,0">
                            <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🛠️ DIRECT HARDWARE PARTITION WIPER" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                                    <TextBlock Text="Zero-fills security partition headers directly in BROM or EDL 9008 mode." FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <Button Content="⚡ Wipe FRP Partition (frp / persistent / config)" Style="{StaticResource WizardActionButton}" Background="#065F46" BorderBrush="#10B981" FontWeight="Bold" Click="OnDirectWipeFrpClicked" Margin="0,0,0,6"/>
                                    <Button Content="🧹 Safe Userdata Format (Keep Encrypted Media)" Style="{StaticResource WizardActionButton}" Click="OnDirectSafeFormatClicked" Margin="0,0,0,6"/>
                                    <Button Content="🔄 Erase Misc Partition (Exit Fastboot / Recovery Loop)" Style="{StaticResource WizardActionButton}" Click="OnDirectEraseMiscClicked" Margin="0,0,0,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PANEL 5: PAYJOY & FINTECH MDM LEASE KILLER -->
                    <ScrollViewer x:Name="PanelFinTechSuite" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,4,0">
                            <Border Background="#3B0764" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#7C3AED" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🛡️ FINTECH &amp; MDM LEASE KILLER" FontSize="13" FontWeight="Bold" Foreground="#A855F7"/>
                                    <TextBlock Text="Terminates Device Policy Manager controllers, rent-to-own financial lease agents, and cloud lock hooks." FontSize="10" Foreground="#E9D5FF" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <Button Content="🚫 Remove PayJoy Lease Access &amp; Status" Style="{StaticResource WizardActionButton}" Background="#7C3AED" BorderBrush="#A855F7" FontWeight="Bold" Click="OnFinTechPayJoyClicked" Margin="0,0,0,6"/>
                                    <Button Content="🛡️ Bypass Samsung Knox Guard (KG State Locked)" Style="{StaticResource WizardActionButton}" Click="OnFinTechKnoxGuardClicked" Margin="0,0,0,6"/>
                                    <Button Content="🏢 Remove Google Enterprise / DPM Work Profile" Style="{StaticResource WizardActionButton}" Click="OnFinTechGoogleEnterpriseClicked" Margin="0,0,0,6"/>
                                    <Button Content="💳 Remove DMI Finance / Creditas Cloud Lock" Style="{StaticResource WizardActionButton}" Click="OnFinTechDmiFinanceClicked" Margin="0,0,0,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- RIGHT PANEL: LIVE STEPPER & EXECUTION CONSOLE -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- 4-Stage Stepper -->
                        <RowDefinition Height="Auto"/>
                        <!-- Console Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Console Box -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- STEPPER -->
                    <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtStep1Icon" Text="①" FontSize="14" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                <TextBlock Text="Detection" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtStep2Icon" Text="②" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Handshake" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtStep3Icon" Text="③" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Exploit / Wipe" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtStep4Icon" Text="④" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Reboot" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CONSOLE HEADER -->
                    <DockPanel Grid.Row="1" Margin="2,0,2,4">
                        <TextBlock Text="LIVE PROTOCOL EXECUTION CONSOLE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="📋 Copy" Style="{StaticResource WizardActionButton}" Padding="8,3" FontSize="10" Click="OnCopyLogClicked" Margin="0,0,4,0"/>
                            <Button Content="🧹 Clear" Style="{StaticResource WizardActionButton}" Padding="8,3" FontSize="10" Click="OnClearLogClicked"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- CONSOLE LOG BOX -->
                    <Border Grid.Row="2" Background="#060A14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="8">
