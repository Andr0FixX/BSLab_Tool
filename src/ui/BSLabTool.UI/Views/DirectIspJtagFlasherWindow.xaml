<Window x:Class="BSLabTool.UI.Views.DirectIspJtagFlasherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — Direct ISP eMMC / UFS JTAG &amp; Chip-Level Boot Repair Suite"
        Width="1120" Height="700" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <LinearGradientBrush x:Key="JtagBorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EC4899" Offset="0.0"/>
            <GradientStop Color="#A855F7" Offset="0.5"/>
            <GradientStop Color="#00FFA3" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PinkPurpleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EC4899" Offset="0.0"/>
            <GradientStop Color="#A855F7" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#111B30"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#EC4899"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberPrimaryButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#BE185D"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#F472B6"/>
        </Style>

        <Style x:Key="CyberSuccessButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#34D399"/>
        </Style>
    </Window.Resources>

    <!-- Outer Chrome Window Border -->
    <Border Background="#040711" BorderBrush="{StaticResource JtagBorderGlow}" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#EC4899" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>  <!-- Header Bar -->
                <RowDefinition Height="*"/>    <!-- Main Split: Hardware Bus vs Pinout & Memory -->
                <RowDefinition Height="140"/>  <!-- Hardware Protocol Stream Log -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER BAR -->
            <Border Grid.Row="0" Background="#080E1C" CornerRadius="11,11,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#101D38" BorderBrush="#EC4899" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🔬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BS LAB TOOL™ PRO" FontWeight="Black" FontSize="12" Foreground="#F8FAFC"/>
                                <Border Background="{StaticResource PinkPurpleGradient}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="DIRECT ISP eMMC / UFS JTAG" FontWeight="Black" FontSize="9" Foreground="#02040A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Hardware ISP Pinouts, Live Voltage Guard, Raw Bootloader Repair &amp; RPMB Clean" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Voltage & Bus Guard Pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#101D38" BorderBrush="#EC4899" BorderThickness="1" CornerRadius="20" Padding="14,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotPowerStatus" Width="8" Height="8" Fill="#00FFA3" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtPowerStatus" Text="ISP BUS POWER: 1.8V VCCQ / 2.8V VCC (GUARD: ARMED)" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Click="OnCloseClicked" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#EF4444" Content="✕" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 2. MAIN SPLIT -->
            <Border Grid.Row="1" Background="#060B16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/> <!-- Left: Hardware Interface & Power -->
                        <ColumnDefinition Width="*"/>   <!-- Right: 6-Pin Wiring & Memory Health -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: HARDWARE BUS & VOLTAGE CONTROLS -->
                    <Border Grid.Column="0" Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="1. HARDWARE HARDWARE INTERFACE" FontSize="11" FontWeight="Black" Foreground="#EC4899" Margin="0,0,0,8"/>

                            <!-- Box / Hardware Flasher Adapter -->
                            <TextBlock Text="Direct ISP Flasher Adapter:" FontSize="9.5" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbHardwareAdapter" Height="30" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,0,10">
                                <ComboBoxItem IsSelected="True">EasyJTAG Plus Box (USB 3.0 HS-SPI)</ComboBoxItem>
                                <ComboBoxItem>Medusa Pro II High-Speed JTAG</ComboBoxItem>
                                <ComboBoxItem>MiPI Tester Box UFS 3.1 Dual-Lane</ComboBoxItem>
                                <ComboBoxItem>Generic FTDI FT232H / High-Speed ISP Adapter</ComboBoxItem>
                            </ComboBox>

                            <!-- Bus Width Mode -->
                            <TextBlock Text="Bus Width &amp; Signal Protocol:" FontSize="9.5" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbBusWidth" Height="30" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,0,12">
                                <ComboBoxItem IsSelected="True">eMMC 1-Bit ISP (Direct Wire CMD, CLK, D0)</ComboBoxItem>
                                <ComboBoxItem>eMMC 4-Bit ISP High-Speed (D0-D3)</ComboBoxItem>
                                <ComboBoxItem>eMMC 8-Bit BGA Socket (Full Bus)</ComboBoxItem>
                                <ComboBoxItem>UFS 2.2 / 3.1 Dual-Lane High-Speed (Gear 4)</ComboBoxItem>
                            </ComboBox>

                            <!-- Voltage Regulators -->
                            <Border Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="VOLTAGE REGULATION &amp; TRIP GUARD" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="VCC (Core Power):" FontSize="9" Foreground="#94A3B8"/>
                                            <ComboBox x:Name="CmbVcc" Height="26" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="10.5">
                                                <ComboBoxItem>1.8V</ComboBoxItem>
                                                <ComboBoxItem IsSelected="True">2.8V (Standard)</ComboBoxItem>
                                                <ComboBoxItem>3.3V (High)</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="VCCQ (I/O Signal):" FontSize="9" Foreground="#94A3B8"/>
                                            <ComboBox x:Name="CmbVccq" Height="26" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="10.5">
                                                <ComboBoxItem IsSelected="True">1.8V (Safe ISP)</ComboBoxItem>
                                                <ComboBoxItem>2.8V</ComboBoxItem>
                                                <ComboBoxItem>3.3V</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Frequency Slider -->
                                    <Grid Margin="0,4,0,2">
                                        <TextBlock Text="Bus Clock Frequency (CLK):" FontSize="9" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtClockValue" Text="24 MHz (Safe ISP)" FontSize="9" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>
                                    <Slider x:Name="SliderClock" Minimum="1" Maximum="52" Value="24" TickFrequency="4" IsSnapToTickEnabled="True" Margin="0,2,0,4" ValueChanged="OnClockSliderChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Primary Connect Button -->
                            <Button x:Name="BtnConnectIsp" Click="OnConnectIspClicked" Style="{StaticResource CyberPrimaryButton}" Height="38" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,6,0"/>
                                    <TextBlock Text="CONNECT &amp; IDENTIFY eMMC/UFS CHIP" FontWeight="Black"/>
                                </StackPanel>
                            </Button>

                            <!-- Raw Repair Actions -->
                            <TextBlock Text="2. RAW BOOT REPAIR ACTIONS" FontSize="10" FontWeight="Bold" Foreground="#A855F7" Margin="0,4,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Click="OnReadDumpClicked" Content="💾 Backup Full Dump" Style="{StaticResource CyberButton}" Margin="0,0,3,0"/>
                                <Button Grid.Column="1" Click="OnWriteBootClicked" Content="🛠️ Write Boot1/Boot2" Style="{StaticResource CyberButton}" Margin="3,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Click="OnWipeRpmbClicked" Content="🛡️ Zero-Wipe RPMB" Style="{StaticResource CyberButton}" Margin="0,0,3,0"/>
                                <Button Grid.Column="1" Click="OnFactoryResetIspClicked" Content="🔄 ISP Factory Reset" Style="{StaticResource CyberButton}" Margin="3,0,0,0"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- RIGHT: 6-PIN WIRING RADAR & MEMORY HEALTH CARD -->
                    <Border Grid.Column="1" Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 6-Pin ISP Wiring Radar -->
                                <RowDefinition Height="*"/>    <!-- Chip Health & Partition Geometry -->
                            </Grid.RowDefinitions>

                            <!-- 6-PIN ISP WIRING RADAR -->
                            <Border Grid.Row="0" Background="#040814" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="6-PIN HARDWARE ISP CONTINUITY RADAR" FontSize="11" FontWeight="Black" Foreground="#00F0FF" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Text="LINE RESISTANCE: NORMAL" FontSize="9.5" Foreground="#00FFA3" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>

                                    <!-- 6 Pins Grid -->
                                    <UniformGrid Columns="6">
                                        <Border Background="#181008" BorderBrush="#F97316" BorderThickness="1.5" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="CMD" FontWeight="Black" FontSize="11" Foreground="#F97316" HorizontalAlignment="Center"/>
                                                <TextBlock Text="10K Pull-up" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                <TextBlock Text="✓ OK" FontSize="9" FontWeight="Bold" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#08141C" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="CLK" FontWeight="Black" FontSize="11" Foreground="#00F0FF" HorizontalAlignment="Center"/>
                                                <TextBlock Text="50Ω Match" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                <TextBlock Text="✓ OK" FontSize="9" FontWeight="Bold" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#081814" BorderBrush="#00FFA3" BorderThickness="1.5" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="D0 (Data)" FontWeight="Black" FontSize="11" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Line 1" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                <TextBlock Text="✓ OK" FontSize="9" FontWeight="Bold" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1C0A0A" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="VCC" FontWeight="Black" FontSize="11" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                                <TextBlock Text="2.8V Core" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                <TextBlock Text="✓ LIVE" FontSize="9" FontWeight="Bold" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1C1808" BorderBrush="#EAB308" BorderThickness="1.5" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="VCCQ" FontWeight="Black" FontSize="11" Foreground="#EAB308" HorizontalAlignment="Center"/>
                                                <TextBlock Text="1.8V I/O" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                <TextBlock Text="✓ LIVE" FontSize="9" FontWeight="Bold" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#101827" BorderBrush="#64748B" BorderThickness="1.5" CornerRadius="6" Padding="8,6">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="GND" FontWeight="Black" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Common" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                <TextBlock Text="✓ GROUND" FontSize="9" FontWeight="Bold" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                </StackPanel>
                            </Border>

                            <!-- MEMORY CHIP INFO & PARTITION GEOMETRY -->
                            <Border Grid.Row="1" Background="#040814" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="CHIP METADATA &amp; PARTITION GEOMETRY" FontSize="11" FontWeight="Black" Foreground="#A855F7" Margin="0,0,0,8"/>

                                        <Border Background="#091020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtChipModel" Text="Samsung KM5V8001DM-B621 (128 GB UFS 3.1)" FontSize="13" FontWeight="Black" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtCid" Text="CID: 1501004B4D355638303031444D000189" FontSize="10" Foreground="#38BDF8" FontFamily="JetBrains Mono, Consolas" Margin="0,2,0,0"/>
                                                    <TextBlock x:Name="TxtHealth" Text="Smart Health: Type A: 0% - 10% Used • Type B: 0% - 10% Used [VERY HEALTHY]" FontSize="10" Foreground="#00FFA3" FontWeight="Bold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Partition Table -->
                                        <TextBlock Text="PHYSICAL BOOT BLOCKS:" FontSize="9.5" Foreground="#94A3B8" Margin="0,4,0,4"/>
                                        <UniformGrid Columns="4" Margin="0,0,0,4">
                                            <Border Background="#091020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="BOOT 1" FontSize="9" FontWeight="Bold" Foreground="#00F0FF"/>
                                                    <TextBlock Text="4,096 KB (Raw)" FontSize="8.5" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#091020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="BOOT 2" FontSize="9" FontWeight="Bold" Foreground="#00F0FF"/>
                                                    <TextBlock Text="4,096 KB (Raw)" FontSize="8.5" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#091020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="RPMB" FontSize="9" FontWeight="Bold" Foreground="#EC4899"/>
                                                    <TextBlock Text="4,096 KB (Crypt)" FontSize="8.5" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#091020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6">
                                                <StackPanel>
                                                    <TextBlock Text="USER AREA" FontSize="9" FontWeight="Bold" Foreground="#00FFA3"/>
                                                    <TextBlock Text="121.84 GB (Ext4)" FontSize="8.5" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- 3. BOTTOM LOG CONSOLE -->
            <Border Grid.Row="2" Background="#080E1C" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="DIRECT ISP HARDWARE COMMUNICATION &amp; JTAG LOG STREAM" FontSize="10" FontWeight="Bold" Foreground="#EC4899" FontFamily="JetBrains Mono, Consolas"/>
                        <TextBlock Text="HS-SPI CONTROLLER: READY" FontSize="10" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas" Grid.Column="1"/>
                    </Grid>

                    <TextBox x:Name="TxtJtagLog" Grid.Row="1" Background="#030712" Foreground="#38BDF8" BorderBrush="#1E293B"
                             FontFamily="JetBrains Mono, Consolas" FontSize="11"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
