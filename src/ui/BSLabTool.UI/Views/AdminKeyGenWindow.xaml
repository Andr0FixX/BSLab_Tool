<Window x:Class="BSLabTool.UI.Views.AdminKeyGenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — Master HWID Activation &amp; KeyGen Suite"
        Width="820" Height="620" MinWidth="750" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <LinearGradientBrush x:Key="GoldBorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFB800" Offset="0.0"/>
            <GradientStop Color="#00F0FF" Offset="0.5"/>
            <GradientStop Color="#00FFA3" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CyanEmeraldGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00F0FF" Offset="0.0"/>
            <GradientStop Color="#00FFA3" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#111B30"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberPrimaryButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#FFB800"/>
            <Setter Property="Foreground" Value="#02040A"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FFB800"/>
        </Style>
    </Window.Resources>

    <!-- Outer Chrome Window Border -->
    <Border Background="#040711" BorderBrush="{StaticResource GoldBorderGlow}" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#FFB800" BlurRadius="25" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>  <!-- Header Bar -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
                <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER BAR -->
            <Border Grid.Row="0" Background="#080E1C" CornerRadius="11,11,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#101D38" BorderBrush="#FFB800" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🔑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BS LAB TOOL™ PRO — MASTER HWID ACTIVATION SUITE" FontWeight="Black" FontSize="12" Foreground="#F8FAFC"/>
                            <TextBlock Text="Official RSA-2048 Cryptographic Licensing &amp; Key Generator" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Click="OnCloseClicked" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#EF4444" Content="✕" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY: DUAL TAB LAYOUT (ADMIN GENERATOR vs CLIENT ACTIVATION) -->
            <Border Grid.Row="1" Background="#060B16" Padding="20">
                <TabControl Background="Transparent" BorderThickness="0">
                    
                    <!-- TAB 1: ADMIN KEYGEN -->
                    <TabItem Header="🔑 ADMIN KEY GENERATOR" Style="{x:Null}" Foreground="#00F0FF" FontWeight="Bold" FontSize="12">
                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Client Name & HWID -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Client / Workshop Name:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtClientName" Text="Ali Mobile Lab (Lahore)" Height="34" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" Padding="8,7"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Client Machine HWID:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtClientHwid" Height="34" Background="#111B30" Foreground="#00F0FF" BorderBrush="#334155" FontSize="11" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas" Padding="8,7"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Tier & Expiry -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="License Tier:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbTier" Height="34" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" VerticalContentAlignment="Center" SelectionChanged="OnTierSelectionChanged">
                                        <ComboBoxItem IsSelected="True">ENTERPRISE LIFETIME (Unlimited)</ComboBoxItem>
                                        <ComboBoxItem>PROFESSIONAL (1 Year - 365 Days)</ComboBoxItem>
                                        <ComboBoxItem>WORKSHOP (6 Months - 180 Days)</ComboBoxItem>
                                        <ComboBoxItem>TRIAL PASS (30 Days)</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="Duration (Days):" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtDays" Text="9999" Height="34" Background="#111B30" Foreground="#00FFA3" BorderBrush="#334155" FontSize="11" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas" Padding="8,7"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <Button Click="OnGenerateKeyClicked" Style="{StaticResource CyberPrimaryButton}" Height="34">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" Margin="0,0,6,0"/>
                                            <TextBlock Text="GENERATE KEY"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Output Header -->
                            <TextBlock Grid.Row="2" Text="CRYPTOGRAPHIC ACTIVATION KEY (BASE64 SIGNED):" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas" Margin="0,0,0,6"/>

                            <!-- Output TextBox & Copy Buttons -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="TxtGeneratedKey" Grid.Row="0" Background="#030712" Foreground="#00FFA3" BorderBrush="#1E293B"
                                         FontFamily="JetBrains Mono, Consolas" FontSize="11"
                                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Click="OnCopyKeyClicked" Content="📋 Copy Key" Style="{StaticResource CyberButton}" Margin="0,0,8,0"/>
                                    <Button Click="OnCopyWhatsAppMsgClicked" Content="💬 Copy WhatsApp Message" Style="{StaticResource CyberButton}" Margin="0,0,8,0"/>
                                    <Button Click="OnExportLicFileClicked" Content="💾 Export license.lic" Style="{StaticResource CyberButton}"/>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- TAB 2: CLIENT ACTIVATION -->
                    <TabItem Header="🛡️ CLIENT ACTIVATION STATUS" Style="{x:Null}" Foreground="#94A3B8" FontWeight="Bold" FontSize="12">
                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Local HWID Display -->
                            <Border Grid.Row="0" Background="#070D1A" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="YOUR LOCAL MACHINE HARDWARE ID (HWID):" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtLocalHwid" Text="BSLAB-8A8E-E8BB-708F" FontSize="15" FontWeight="Black" Foreground="#00F0FF" FontFamily="JetBrains Mono, Consolas"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Click="OnCopyLocalHwidClicked" Content="📋 Copy HWID" Style="{StaticResource CyberButton}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Current Activation Status -->
                            <Border Grid.Row="1" Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="CURRENT LICENSE DETAILS:" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtActiveLicenseSummary" Text="Status: ACTIVE // Registered To: Syed Bisharat Ali (Lead Architect) // Tier: ENTERPRISE LIFETIME" FontSize="11" Foreground="#F8FAFC" LineHeight="20"/>
                                </StackPanel>
                            </Border>

                            <!-- Enter New Key Section -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="Paste New Activation Key to Activate / Renew:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtInputActivationKey" Height="80" Background="#030712" Foreground="#CBD5E1" BorderBrush="#334155" FontSize="11" FontFamily="JetBrains Mono, Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
                            </StackPanel>

                            <!-- Apply Activation Button -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="OnLoadLicFileClicked" Content="📂 Browse license.lic" Style="{StaticResource CyberButton}" Margin="0,0,8,0"/>
                                <Button Click="OnApplyActivationClicked" Content="⚡ Activate Software" Style="{StaticResource CyberPrimaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- 3. FOOTER BAR -->
            <Border Grid.Row="2" Background="#080E1C" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="CRYPTOGRAPHIC ENGINE: HMAC-SHA256 • TAMPER PROOF HWID BINDING" FontSize="10" Foreground="#64748B" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                    <TextBlock Text="OFFICIAL ADMIN SECURITY CONSOLE" FontSize="10" Foreground="#00FFA3" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas" Grid.Column="1"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>