<Window x:Class="BSLabTool.UI.Views.OfficialFirmwareDownloaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — High-Speed Official Stock Firmware Downloader &amp; ROM Center"
        Width="1060" Height="680" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <LinearGradientBrush x:Key="RomBorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00F0FF" Offset="0.0"/>
            <GradientStop Color="#A855F7" Offset="0.5"/>
            <GradientStop Color="#00FFA3" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CyanBlueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00F0FF" Offset="0.0"/>
            <GradientStop Color="#3B82F6" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#111B30"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberPrimaryButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
        </Style>

        <Style x:Key="CyberSuccessButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#34D399"/>
        </Style>
    </Window.Resources>

    <!-- Outer Chrome Window Border -->
    <Border Background="#040711" BorderBrush="{StaticResource RomBorderGlow}" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>  <!-- Header Bar -->
                <RowDefinition Height="*"/>    <!-- Main Body -->
                <RowDefinition Height="130"/>  <!-- Live Log / Terminal -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER BAR -->
            <Border Grid.Row="0" Background="#080E1C" CornerRadius="11,11,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#101D38" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="📥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BS LAB TOOL™ PRO" FontWeight="Black" FontSize="12" Foreground="#F8FAFC"/>
                                <Border Background="{StaticResource CyanBlueGradient}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="STOCK ROM CENTER" FontWeight="Black" FontSize="9" Foreground="#02040A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="High-Speed Multi-Threaded Official Firmware Downloader &amp; Auto-Unpacker" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- CDN Status Pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#101D38" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="20" Padding="14,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotCdnStatus" Width="8" Height="8" Fill="#00FFA3" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtCdnStatus" Text="OFFICIAL SERVER MIRRORS: CONNECTED &amp; FAST (1 Gbps CDN)" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Click="OnCloseClicked" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#EF4444" Content="✕" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY -->
            <Border Grid.Row="1" Background="#060B16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/> <!-- Left: Query & Search Parameters -->
                        <ColumnDefinition Width="*"/>   <!-- Right: Firmware Details & Turbo Download Engine -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: SEARCH PANEL -->
                    <Border Grid.Column="0" Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="SEARCH OFFICIAL STOCK ROM" FontSize="12" FontWeight="Black" Foreground="#00F0FF" Margin="0,0,0,12"/>

                            <!-- Brand Selection -->
                            <TextBlock Text="Device OEM / Manufacturer:" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbBrand" Height="32" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,0,10" SelectionChanged="OnBrandChanged">
                                <ComboBoxItem IsSelected="True">Samsung (Official FOTA Server Mirror)</ComboBoxItem>
                                <ComboBoxItem>Xiaomi / Redmi / POCO (Fastboot TGZ)</ComboBoxItem>
                                <ComboBoxItem>Infinix / Tecno / itel (Transsion PAC/Scatter)</ComboBoxItem>
                                <ComboBoxItem>Oppo / Realme (OFP / OZIP Flash Pack)</ComboBoxItem>
                                <ComboBoxItem>Vivo / iQOO (PD Fastboot / Recovery)</ComboBoxItem>
                                <ComboBoxItem>OnePlus (OxygenOS Direct OTA ZIP)</ComboBoxItem>
                            </ComboBox>

                            <!-- Model Input -->
                            <TextBlock Text="Model Number / Codenames:" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtModel" Text="SM-S928B" Height="32" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="12" FontWeight="Bold" Padding="8,6" Margin="0,0,0,10"/>

                            <!-- CSC / Region Selector -->
                            <TextBlock Text="Region / CSC / Operator Code:" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbRegion" Height="32" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,0,14">
                                <ComboBoxItem IsSelected="True">PAK — Pakistan (Open Market)</ComboBoxItem>
                                <ComboBoxItem>KSA — Saudi Arabia</ComboBoxItem>
                                <ComboBoxItem>UAE — United Arab Emirates (XSG)</ComboBoxItem>
                                <ComboBoxItem>IN — India (INS / INU)</ComboBoxItem>
                                <ComboBoxItem>EUX — Europe Open / Global</ComboBoxItem>
                                <ComboBoxItem>TUR — Turkey</ComboBoxItem>
                                <ComboBoxItem>EGY — Egypt</ComboBoxItem>
                            </ComboBox>

                            <!-- Search Button -->
                            <Button x:Name="BtnCheckFirmware" Click="OnCheckFirmwareClicked" Style="{StaticResource CyberPrimaryButton}" Height="36" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Margin="0,0,6,0"/>
                                    <TextBlock Text="CHECK LATEST OFFICIAL FIRMWARE" FontWeight="Black"/>
                                </StackPanel>
                            </Button>

                            <!-- Download Options -->
                            <Border Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="DOWNLOAD OPTIONS" FontSize="10" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkAutoDecrypt" Content="Auto-Decrypt Samsung AES-128" IsChecked="True" Foreground="#F8FAFC" FontSize="10.5" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkAutoUnpack" Content="Auto-Extract Images (boot, super, modem)" IsChecked="True" Foreground="#F8FAFC" FontSize="10.5" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkVerifyHash" Content="Verify SHA-256 / MD5 Checksum" IsChecked="True" Foreground="#F8FAFC" FontSize="10.5" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkMultiThread" Content="16x High-Speed Chunk Threads" IsChecked="True" Foreground="#00FFA3" FontWeight="Bold" FontSize="10.5"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- RIGHT: FIRMWARE DETAILS & PROGRESS ENGINE -->
                    <Border Grid.Column="1" Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Firmware Metadata Header Card -->
                                <RowDefinition Height="Auto"/> <!-- Technical Specs Grid -->
                                <RowDefinition Height="*"/>    <!-- Download Progress View -->
                            </Grid.RowDefinitions>

                            <!-- Metadata Banner -->
                            <Border Grid.Row="0" Background="#0C1428" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="#0284C7" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtBadgeOs" Text="ANDROID 14 • ONE UI 6.1" FontSize="9" FontWeight="Black" Foreground="#F8FAFC"/>
                                            </Border>
                                            <Border Background="#059669" CornerRadius="3" Padding="6,1">
                                                <TextBlock Text="OFFICIAL SIGNED" FontSize="9" FontWeight="Black" Foreground="#F8FAFC"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtRomTitle" Text="Samsung Galaxy S24 Ultra (SM-S928B) — S928BXXU1AXCA" FontSize="14" FontWeight="Black" Foreground="#F8FAFC"/>
                                        <TextBlock x:Name="TxtRomFilenames" Text="File: SM-S928B_PAK_S928BXXU1AXCA_fac.zip (Size: 7.84 GB)" FontSize="10.5" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Quick Mirror Badge -->
                                    <Border Grid.Column="1" Background="#101D38" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DIRECT CDN SPEED" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="⚡ UP TO 100 MB/s" FontSize="11" FontWeight="Black" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Specs Grid -->
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                                <Border Background="#0A1020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="PDA / BUILD" FontSize="9" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtPda" Text="S928BXXU1AXCA" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" FontFamily="JetBrains Mono, Consolas"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A1020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="CSC / SALES" FontSize="9" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtCsc" Text="S928BOXM1AXCA" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" FontFamily="JetBrains Mono, Consolas"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A1020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="SECURITY PATCH" FontSize="9" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtPatch" Text="2026-11-01" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" FontFamily="JetBrains Mono, Consolas"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A1020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="BINARY BIT (REV)" FontSize="9" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtBinary" Text="U1 (Bit 1)" FontSize="11" FontWeight="Bold" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Download Progress Engine -->
                            <Border Grid.Row="2" Background="#0A1020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel VerticalAlignment="Center">
                                    
                                    <!-- Speed and Percent Row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtDownloadProgressPct" Text="0.0%" FontSize="22" FontWeight="Black" Foreground="#00F0FF" FontFamily="JetBrains Mono, Consolas"/>
                                            <TextBlock x:Name="TxtDownloadSpeed" Text="• 0.0 MB/s (16 Threads)" FontSize="12" Foreground="#00FFA3" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="JetBrains Mono, Consolas"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDownloadedBytes" Grid.Column="1" Text="0.00 GB / 7.84 GB" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>

                                    <!-- Modern Glowing Progress Bar -->
                                    <ProgressBar x:Name="PrgDownload" Height="14" Value="0" Maximum="100" Background="#040814" Foreground="#00F0FF" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,16"/>

                                    <!-- Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnStartDownload" Click="OnStartDownloadClicked" Style="{StaticResource CyberSuccessButton}" Height="38" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🚀" Margin="0,0,6,0"/>
                                                <TextBlock Text="START TURBO DOWNLOAD" FontWeight="Black"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnPauseDownload" Click="OnPauseDownloadClicked" Style="{StaticResource CyberButton}" Content="⏸️ PAUSE / RESUME" Height="38" Margin="0,0,6,0" Grid.Column="1"/>

                                        <Button x:Name="BtnOpenFolder" Click="OnOpenFolderClicked" Style="{StaticResource CyberButton}" Content="📂 OPEN DOWNLOADS FOLDER" Height="38" Grid.Column="2"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- 3. BOTTOM LOG CONSOLE -->
            <Border Grid.Row="2" Background="#080E1C" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="OFFICIAL ROM DOWNLOAD ENGINE &amp; UNPACKER STREAM" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="JetBrains Mono, Consolas"/>
                        <TextBlock Text="STORAGE PATH: C:\BSLab_Tool\FirmwareVault\" FontSize="10" Foreground="#64748B" FontFamily="JetBrains Mono, Consolas" Grid.Column="1"/>
                    </Grid>

                    <TextBox x:Name="TxtRomLog" Grid.Row="1" Background="#030712" Foreground="#38BDF8" BorderBrush="#1E293B"
                             FontFamily="JetBrains Mono, Consolas" FontSize="11"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
