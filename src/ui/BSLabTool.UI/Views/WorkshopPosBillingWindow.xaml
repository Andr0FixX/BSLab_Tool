<Window x:Class="BSLabTool.UI.Views.WorkshopPosBillingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — Workshop POS, Job Ticket &amp; Customer Invoice Generator"
        Width="1100" Height="700" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <LinearGradientBrush x:Key="PosBorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00FFA3" Offset="0.0"/>
            <GradientStop Color="#00F0FF" Offset="0.5"/>
            <GradientStop Color="#A855F7" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="EmeraldCyanGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFA3" Offset="0.0"/>
            <GradientStop Color="#00F0FF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#111B30"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00FFA3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberSuccessButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#34D399"/>
        </Style>

        <Style x:Key="CyberWhatsAppButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#128C7E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#25D366"/>
        </Style>
    </Window.Resources>

    <!-- Outer Window Chrome -->
    <Border Background="#040711" BorderBrush="{StaticResource PosBorderGlow}" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#00FFA3" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>  <!-- Header Bar -->
                <RowDefinition Height="*"/>    <!-- Main Form & Thermal Preview Split -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER BAR -->
            <Border Grid.Row="0" Background="#080E1C" CornerRadius="11,11,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#101D38" BorderBrush="#00FFA3" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🧾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BS LAB TOOL™ PRO" FontWeight="Black" FontSize="12" Foreground="#F8FAFC"/>
                                <Border Background="{StaticResource EmeraldCyanGradient}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="WORKSHOP POS &amp; INVOICE" FontWeight="Black" FontSize="9" Foreground="#02040A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Repair Job Tickets, Thermal Invoices, Barcodes &amp; Customer WhatsApp Dispatcher" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ticket Counter Pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#101D38" BorderBrush="#00FFA3" BorderThickness="1" CornerRadius="20" Padding="14,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ACTIVE TICKET: " FontSize="10" FontWeight="Bold" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                            <TextBlock x:Name="TxtTicketPill" Text="BS-2026-1049" FontSize="10" FontWeight="Black" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Click="OnCloseClicked" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#EF4444" Content="✕" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 2. MAIN SPLIT: INPUT FORM (LEFT) vs THERMAL RECEIPT PREVIEW (RIGHT) -->
            <Border Grid.Row="1" Background="#060B16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="540"/> <!-- Left: Ticket & Customer Input Form -->
                        <ColumnDefinition Width="*"/>   <!-- Right: 80mm Thermal Receipt Live Preview -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: REPAIR TICKET INPUT FORM -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                        <StackPanel Margin="0,0,6,0">
                            
                            <!-- Workshop Branding Details -->
                            <Border Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="1. WORKSHOP / LAB DETAILS" FontSize="11" FontWeight="Black" Foreground="#00FFA3" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Shop / Lab Name:" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox x:Name="TxtShopName" Text="BS LAB GSM CARE &amp; UNLOCK CLINIC" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" FontWeight="Bold" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Shop Phone / Helpline:" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox x:Name="TxtShopPhone" Text="+92 300 0000000" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Shop Address / Location:" FontSize="9.5" Foreground="#94A3B8"/>
                                    <TextBox x:Name="TxtShopAddress" Text="Shop #24, First Floor, Madina Electronic Market, Rawalpindi" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="10.5" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Customer & Device Information -->
                            <Border Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="2. CUSTOMER &amp; DEVICE INFO" FontSize="11" FontWeight="Black" Foreground="#00F0FF" Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Customer Name:" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox x:Name="TxtCustomerName" Text="Syed Bisharat Ali" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" FontWeight="Bold" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Customer WhatsApp Number:" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox x:Name="TxtCustomerPhone" Text="923001234567" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" FontWeight="Bold" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Device Model / Brand:" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox x:Name="TxtDeviceModel" Text="Samsung Galaxy S24 Ultra (SM-S928B)" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="IMEI / Serial Number:" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox x:Name="TxtDeviceImei" Text="354892109847291" Height="28" Background="#111B30" Foreground="#00FFA3" BorderBrush="#334155" FontSize="11" FontFamily="JetBrains Mono, Consolas" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Reported Fault / Problem:" FontSize="9.5" Foreground="#94A3B8"/>
                                    <TextBox x:Name="TxtFaultDescription" Text="FRP Google Account Locked after Hard Reset + Screen Glass Scratch" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="10.5" Padding="6,4" Margin="0,0,0,6" TextChanged="OnFormInputChanged"/>

                                    <TextBlock Text="Device Physical Condition / Remarks:" FontSize="9.5" Foreground="#94A3B8"/>
                                    <TextBox x:Name="TxtCondition" Text="Back cover fine, minor edge scratches, battery 85%, SIM tray present" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="10.5" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Financials & Job Status -->
                            <Border Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="3. BILLING, ADVANCE &amp; STATUS" FontSize="11" FontWeight="Black" Foreground="#A855F7" Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Total Cost (Rs / $):" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox x:Name="TxtTotalCost" Text="4500" Height="28" Background="#111B30" Foreground="#00FFA3" BorderBrush="#334155" FontSize="12" FontWeight="Black" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                            <TextBlock Text="Advance Paid:" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox x:Name="TxtAdvancePaid" Text="1500" Height="28" Background="#111B30" Foreground="#38BDF8" BorderBrush="#334155" FontSize="12" FontWeight="Black" Padding="6,4" TextChanged="OnFormInputChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Balance Due:" FontSize="9.5" Foreground="#EF4444" FontWeight="Bold"/>
                                            <TextBox x:Name="TxtBalanceDue" Text="3000" IsReadOnly="True" Height="28" Background="#180C14" Foreground="#EF4444" BorderBrush="#7F1D1D" FontSize="12" FontWeight="Black" Padding="6,4"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Repair Job Status:" FontSize="9.5" Foreground="#94A3B8"/>
                                            <ComboBox x:Name="CmbJobStatus" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" VerticalContentAlignment="Center" SelectionChanged="OnStatusChanged">
                                                <ComboBoxItem IsSelected="True">🟡 RECEIVED (Under Diagnosis)</ComboBoxItem>
                                                <ComboBoxItem>🔵 IN PROGRESS (Software / Flashing)</ComboBoxItem>
                                                <ComboBoxItem>🟢 READY FOR PICKUP (Work Complete)</ComboBoxItem>
                                                <ComboBoxItem>✅ DELIVERED TO CUSTOMER</ComboBoxItem>
                                                <ComboBoxItem>❌ CANCELLED / RETURNED</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="OnNewTicketClicked" Content="➕ NEW TICKET" Style="{StaticResource CyberButton}" Height="28" VerticalAlignment="Bottom"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- Action Triggers -->
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Click="OnPrintThermalClicked" Style="{StaticResource CyberSuccessButton}" Height="38" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨️" Margin="0,0,6,0"/>
                                        <TextBlock Text="PRINT 80mm RECEIPT" FontWeight="Black"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Click="OnSendWhatsAppClicked" Style="{StaticResource CyberWhatsAppButton}" Height="38" Margin="2,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💬" Margin="0,0,6,0"/>
                                        <TextBlock Text="SEND WHATSAPP" FontWeight="Black"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Click="OnSaveTicketClicked" Style="{StaticResource CyberButton}" Content="💾 SAVE TICKET" Height="38" Margin="4,0,0,0"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: THERMAL RECEIPT LIVE VISUAL PREVIEW -->
                    <Border Grid.Column="1" Background="#03060E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="80mm THERMAL RECEIPT PREVIEW" FontSize="10" FontWeight="Black" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                                <TextBlock Text="ESC/POS COMPATIBLE" FontSize="9" Foreground="#64748B" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas"/>
                            </Grid>

                            <!-- White Simulated Thermal Paper Roll -->
                            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="4" Padding="16" HorizontalAlignment="Center" Width="360">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="15" Opacity="0.5"/>
                                </Border.Effect>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtThermalReceipt" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                             FontFamily="Courier New, Consolas" FontSize="11.5" FontWeight="SemiBold"
                                             IsReadOnly="True" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
