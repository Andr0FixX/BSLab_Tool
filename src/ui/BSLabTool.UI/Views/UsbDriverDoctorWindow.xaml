<Window x:Class="BSLabTool.UI.Views.UsbDriverDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — 1-Click USB Driver Doctor &amp; UsbDK / LibUSB Filter Manager"
        Width="1050" Height="700" MinWidth="850" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Neon Gradient Brushes -->
        <LinearGradientBrush x:Key="BorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0.0"/>
            <GradientStop Color="#10B981" Offset="0.5"/>
            <GradientStop Color="#6366F1" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CyanGreenGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0.0"/>
            <GradientStop Color="#10B981" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C3AED" Offset="0.0"/>
            <GradientStop Color="#A855F7" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Modern Action Button Style -->
        <Style x:Key="DoctorActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Giant Button Style -->
        <Style x:Key="DoctorGiantButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CyanGreenGradient}"/>
            <Setter Property="Foreground" Value="#0B132B"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#10B981" Opacity="0.35" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Neon Border -->
    <Border CornerRadius="12" BorderThickness="1.5" BorderBrush="{StaticResource BorderGlow}" Background="#0B132B" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#00E5FF" Opacity="0.3" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="46"/>
                <!-- Telemetry & Driver Health Banner -->
                <RowDefinition Height="64"/>
                <!-- Main Workspace (Driver Checklist Cards + Live Execution Console) -->
                <RowDefinition Height="*"/>
                <!-- Bottom Info Bar -->
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- ================================================================ -->
            <!-- ROW 0: CUSTOM TITLE BAR                                           -->
            <!-- ================================================================ -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="12,12,0,0" MouseDown="OnTitleBarMouseDown" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔌" FontSize="18" Foreground="#00E5FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BS LAB TOOL PRO" FontSize="14" FontWeight="ExtraBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#059669" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="USB DRIVER DOCTOR &amp; FILTER LATCH" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="MTK VCOM • Qualcomm 9008 • Samsung Modem • Unisoc • UsbDK • LibUSB" FontSize="10" Foreground="#64748B"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Width="30" Height="26" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" Click="OnMinimizeClicked" Cursor="Hand"/>
                        <Button Content="✕" Width="30" Height="26" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="OnCloseClicked" Cursor="Hand" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- ROW 1: LIVE DRIVER HEALTH STATUS BANNER                           -->
            <!-- ================================================================ -->
            <Border Grid.Row="1" Background="#131F37" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0">
                            <TextBlock Text="🩺" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtDriverHealthBadge" Text="SYSTEM DRIVER ENVIRONMENT: READY" FontWeight="ExtraBold" FontSize="11" Foreground="#00E5FF" Margin="0,0,8,0"/>
                                <Border Background="#166534" CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="PROTECTED" FontSize="8.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows Driver Store &amp; USB Filter Health Monitor • Zero Disconnection Policy" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔄 Rescan Drivers" Style="{StaticResource DoctorActionButton}" Click="OnScanDriversClicked" Margin="0,0,8,0"/>
                        <Button Content="🖥️ Device Manager" Style="{StaticResource DoctorActionButton}" Click="OnOpenDevMgrClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- ROW 2: MAIN WORKSPACE (LEFT ACTIONS + RIGHT LOG)                  -->
            <!-- ================================================================ -->
            <Grid Grid.Row="2" Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500"/> <!-- Driver Cards & Action Buttons -->
                    <ColumnDefinition Width="*"/>   <!-- Live Execution Console -->
                </Grid.ColumnDefinitions>

                <!-- LEFT: DRIVER CARDS & ACTIONS -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                    <StackPanel>
                        <!-- 1-CLICK MASTER INSTALLER -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚀 1-CLICK MASTER WORKSHOP DRIVER INSTALLER" FontSize="12.5" FontWeight="ExtraBold" Foreground="#10B981"/>
                                <TextBlock Text="Installs and stages all official signed OEM drivers (MTK, Qualcomm, Samsung, Unisoc, ADB) into Windows DriverStore silently via pnputil." FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                <Button Content="⚡ INSTALL ALL 7 OEM DRIVERS (1-CLICK)" Style="{StaticResource DoctorGiantButton}" Click="OnInstallAllDriversClicked" Margin="0,0,0,6"/>
                                <TextBlock Text="Requires Administrator Elevation • 100% Offline Safe" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- LIBUSB & USBDK FILTER LATCH (SOLVES BROM DISCONNECT) -->
                        <Border Background="#2E1065" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#7C3AED" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="🛡️ BROM DISCONNECTION FIX (LIBUSB &amp; USBDK)" FontSize="11.5" FontWeight="Bold" Foreground="#C084FC" VerticalAlignment="Center"/>
                                    <Border Background="#4C1D95" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                        <TextBlock Text="PORT STABILIZER" FontSize="8" FontWeight="Bold" Foreground="#E9D5FF"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="Fixes the 2-second Preloader disconnection loop on Oppo, Realme, Xiaomi, and Vivo MTK devices." FontSize="10" Foreground="#DDD6FE" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🔒 Latch LibUSB Filter (MTK BROM)" Style="{StaticResource DoctorActionButton}" Background="#7C3AED" BorderBrush="#A855F7" FontWeight="Bold" Click="OnLatchLibUsbFilterClicked" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="🔓 Remove LibUSB Filter (Standard)" Style="{StaticResource DoctorActionButton}" Click="OnRemoveLibUsbFilterClicked" Margin="4,0,0,0"/>
                                </Grid>

                                <Button Content="📦 Install UsbDk 64-bit Core Engine (MSI)" Style="{StaticResource DoctorActionButton}" Click="OnInstallUsbDkClicked"/>
                            </StackPanel>
                        </Border>

                        <!-- INDIVIDUAL DRIVER INSTALLERS -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📦 INDIVIDUAL HARDWARE DRIVERS:" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="MediaTek CDC &amp; VCOM" Style="{StaticResource DoctorActionButton}" Tag="mtk" Click="OnInstallSingleDriverClicked" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="Qualcomm QDLoader 9008" Style="{StaticResource DoctorActionButton}" Tag="qualcomm" Click="OnInstallSingleDriverClicked" Margin="4,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Samsung Mobile USB Modem" Style="{StaticResource DoctorActionButton}" Tag="samsung" Click="OnInstallSingleDriverClicked" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="Unisoc / SPRD U2S Diag" Style="{StaticResource DoctorActionButton}" Tag="unisoc" Click="OnInstallSingleDriverClicked" Margin="4,0,0,0"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Google Android ADB / Fastboot" Style="{StaticResource DoctorActionButton}" Tag="adb_fastboot" Click="OnInstallSingleDriverClicked" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="Huawei Handset &amp; COM 1.0" Style="{StaticResource DoctorActionButton}" Tag="huawei" Click="OnInstallSingleDriverClicked" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- WORKSHOP UTILITIES -->
                        <Border Background="#162032" CornerRadius="8" Padding="12" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🛠️ WORKSHOP PORT UTILITIES:" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🧹 Clean Ghost COM Ports" Style="{StaticResource DoctorActionButton}" Click="OnCleanGhostPortsClicked" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="🔄 Restart USB Host Controllers" Style="{StaticResource DoctorActionButton}" Click="OnRestartUsbControllersClicked" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT: LIVE EXECUTION CONSOLE -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Console Box -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,4">
                        <TextBlock Text="DRIVER INSTALLATION &amp; PNPUTIL LOG" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="📋 Copy" Style="{StaticResource DoctorActionButton}" Padding="8,3" FontSize="10" Click="OnCopyLogClicked" Margin="0,0,4,0"/>
                            <Button Content="🧹 Clear" Style="{StaticResource DoctorActionButton}" Padding="8,3" FontSize="10" Click="OnClearLogClicked"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#060A14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="8">
                        <TextBox x:Name="TxtConsoleLog" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontFamily="Consolas, Lucida Console, Courier New" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ -->
            <!-- ROW 3: BOTTOM STATUS BAR                                          -->
            <!-- ================================================================ -->
            <Border Grid.Row="3" Background="#0F172A" CornerRadius="0,0,12,12" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="BS LAB TOOL PRO V2.5 • WORKSHOP DRIVER AUTOMATION ENGINE • ZERO DISCONNECTION" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="PNP MONITOR: " FontSize="9.5" Foreground="#64748B"/>
                        <TextBlock Text="READY" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
