<Window x:Class="BSLabTool.UI.Views.AutoUpdaterDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — Software Update &amp; Cloud Synchronizer"
        Width="700" Height="530" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Neon Gradient Brushes -->
        <LinearGradientBrush x:Key="GoldBorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFB800" Offset="0.0"/>
            <GradientStop Color="#00F0FF" Offset="0.5"/>
            <GradientStop Color="#00FFA3" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CyanEmeraldGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00F0FF" Offset="0.0"/>
            <GradientStop Color="#00FFA3" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#111B30"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberPrimaryButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#00F0FF"/>
            <Setter Property="Foreground" Value="#02040A"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
        </Style>
    </Window.Resources>

    <!-- Outer Chrome Window Border -->
    <Border Background="#040711" BorderBrush="{StaticResource GoldBorderGlow}" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#FFB800" BlurRadius="25" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>  <!-- Header Bar -->
                <RowDefinition Height="Auto"/> <!-- Version Info Ribbon -->
                <RowDefinition Height="*"/>    <!-- Changelog & Release Notes -->
                <RowDefinition Height="Auto"/> <!-- Progress Bar & Download Controls -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER BAR -->
            <Border Grid.Row="0" Background="#080E1C" CornerRadius="11,11,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#101D38" BorderBrush="#FFB800" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🔄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="BS LAB TOOL™ PRO — AUTO-UPDATER &amp; CLOUD SYNC" FontWeight="Black" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="OnCloseClicked" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#EF4444" Content="✕" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 2. VERSION INFO BANNER -->
            <Border Grid.Row="1" Background="#060B16" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CURRENT VERSION: " FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtCurrentVersion" Text="v2.5.0-PRO" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas"/>
                            <TextBlock Text="  ➔  LATEST RELEASE: " FontSize="11" Foreground="#94A3B8" FontWeight="Bold" Margin="8,0,0,0"/>
                            <TextBlock x:Name="TxtLatestVersion" Text="v2.5.0 (STABLE PRODUCTION)" FontSize="11" Foreground="#00FFA3" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtReleaseDate" Text="Release Tag: v2.5.0 • Digitally Signed (SHA-256) • RFC 3161 Timestamped" FontSize="10" Foreground="#64748B" FontFamily="JetBrains Mono, Consolas"/>
                    </StackPanel>

                    <!-- Status Pill -->
                    <Border Grid.Column="1" Background="#101D38" BorderBrush="#00FFA3" BorderThickness="1" CornerRadius="20" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#00FFA3" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatusBadge" Text="UP TO DATE" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. CHANGELOG VIEWER -->
            <Border Grid.Row="2" Background="#050914" Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="WHAT'S NEW IN THIS RELEASE (CHANGELOG):" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" FontFamily="JetBrains Mono, Consolas" Margin="0,0,0,8"/>

                    <Border Grid.Row="1" Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtChangelog" Foreground="#CBD5E1" FontSize="11" LineHeight="19" TextWrapping="Wrap" FontFamily="Plus Jakarta Sans, Segoe UI"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. BOTTOM DOWNLOAD & INSTALL CONTROLS -->
            <Border Grid.Row="3" Background="#060B16" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Progress Info -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtDownloadStatus" Text="Ready to check or download latest package." FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                        <TextBlock x:Name="TxtDownloadSpeed" Text="" FontSize="10" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas" Grid.Column="1"/>
                    </Grid>

                    <!-- Progress Bar & Buttons -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="ProgressDownload" Height="8" Value="0" Maximum="100" Foreground="{StaticResource CyanEmeraldGradient}" Background="#111B30" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="OnCheckUpdatesClicked" Content="Check Online" Style="{StaticResource CyberButton}" Margin="0,0,8,0"/>
                            <Button x:Name="BtnDownloadUpdate" Click="OnDownloadUpdateClicked" Content="⚡ Download Update" Style="{StaticResource CyberPrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>