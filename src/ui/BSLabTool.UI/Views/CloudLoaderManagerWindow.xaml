<Window x:Class="BSLabTool.UI.Views.CloudLoaderManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — Cloud Loader &amp; TestPoint Auto-Downloader"
        Width="1050" Height="700" MinWidth="850" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Neon Gradient Brushes -->
        <LinearGradientBrush x:Key="BorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#818CF8" Offset="0.5"/>
            <GradientStop Color="#0284C7" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CloudBlueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0.0"/>
            <GradientStop Color="#38BDF8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#059669" Offset="0.0"/>
            <GradientStop Color="#10B981" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Modern Action Button Style -->
        <Style x:Key="CloudActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Download Action Button Style -->
        <Style x:Key="CloudDownloadButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GreenGradient}"/>
            <Setter Property="Foreground" Value="#0B132B"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Neon Border -->
    <Border CornerRadius="12" BorderThickness="1.5" BorderBrush="{StaticResource BorderGlow}" Background="#0B132B" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#38BDF8" Opacity="0.3" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="46"/>
                <!-- Cloud Catalog Status Banner -->
                <RowDefinition Height="64"/>
                <!-- Main Workspace (Catalog Cards + Live Downloader Console) -->
                <RowDefinition Height="*"/>
                <!-- Bottom Status Bar -->
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- ================================================================ -->
            <!-- ROW 0: CUSTOM TITLE BAR                                           -->
            <!-- ================================================================ -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="12,12,0,0" MouseDown="OnTitleBarMouseDown" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="☁️" FontSize="18" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BS LAB TOOL PRO" FontSize="14" FontWeight="ExtraBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CLOUD LOADER &amp; OTA VAULT" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Dynamic Brand DAs • Qualcomm Firehoses • Unisoc PAC • 4K TestPoints" FontSize="10" Foreground="#64748B"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Width="30" Height="26" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" Click="OnMinimizeClicked" Cursor="Hand"/>
                        <Button Content="✕" Width="30" Height="26" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="OnCloseClicked" Cursor="Hand" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- ROW 1: CLOUD REPOSITORY STATUS BANNER                             -->
            <!-- ================================================================ -->
            <Border Grid.Row="1" Background="#131F37" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0">
                            <TextBlock Text="🌐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtCloudSourceBadge" Text="OFFICIAL CLOUD REPOSITORY: GITHUB RELEASES" FontWeight="ExtraBold" FontSize="11" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                <Border Background="#166534" CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="SYNCED" FontSize="8.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Target Directory: c:\BSLab_Tool\resources\loaders • High-Speed SSL CDN" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔄 Check for Cloud Updates" Style="{StaticResource CloudActionButton}" Click="OnCheckUpdatesClicked" Margin="0,0,8,0"/>
                        <Button Content="📥 Download All Packages" Style="{StaticResource CloudDownloadButton}" Click="OnDownloadAllClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- ROW 2: MAIN WORKSPACE                                             -->
            <!-- ================================================================ -->
            <Grid Grid.Row="2" Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="540"/> <!-- Packages List -->
                    <ColumnDefinition Width="*"/>   <!-- Live Download Progress & Log -->
                </Grid.ColumnDefinitions>

                <!-- LEFT: CLOUD PACKAGES SCROLLVIEW -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                    <StackPanel>
                        <!-- PACKAGE 1: MTK BRAND DAS -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📶" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MediaTek Android 15 Brand DAs (2026 Pack)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Oppo/Realme MT6768, Redmi 14C/15C Android 15, Infinix, Tecno DAs" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,2"/>
                                    <TextBlock Text="Size: ~45 MB • Status: Ready / Verified" FontSize="9" Foreground="#38BDF8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="⬇️ Download" Style="{StaticResource CloudDownloadButton}" Tag="MTK_DAS" Click="OnDownloadPackageClicked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- PACKAGE 2: QUALCOMM FIREHOSE LOADERS -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔌" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Qualcomm Snapdragon Firehose Vault (eMMC/UFS)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="SM6225, SM6375, SM7325, SM8450, SM8475 Raw Programmers" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,2"/>
                                    <TextBlock Text="Size: ~38 MB • Status: Ready / Verified" FontSize="9" Foreground="#38BDF8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="⬇️ Download" Style="{StaticResource CloudDownloadButton}" Tag="QC_FIREHOSE" Click="OnDownloadPackageClicked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- PACKAGE 3: UNISOC PAC & FDL LOADERS -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚡" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Unisoc Tanggula SC9863A / T606 / T616 PAC Loaders" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Universal FDL1, FDL2 and Samsung SPL-LDR Bootloaders" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,2"/>
                                    <TextBlock Text="Size: ~24 MB • Status: Ready / Verified" FontSize="9" Foreground="#38BDF8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="⬇️ Download" Style="{StaticResource CloudDownloadButton}" Tag="UNISOC_LOADERS" Click="OnDownloadPackageClicked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- PACKAGE 4: 4K HARDWARE TESTPOINTS PACK -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔬" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Interactive TestPoints &amp; ISP Pinouts 4K Photo Pack" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="High-res motherboards schematics for 85+ Xiaomi, Samsung, Oppo, Vivo" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,2"/>
                                    <TextBlock Text="Size: ~65 MB • Status: Ready / Verified" FontSize="9" Foreground="#38BDF8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="⬇️ Download" Style="{StaticResource CloudDownloadButton}" Tag="TESTPOINT_PACK" Click="OnDownloadPackageClicked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- PACKAGE 5: SAMSUNG PIT & EXTRACTOR ENGINES -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🏢" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Samsung PIT Database &amp; LZ4 Ultra Decompressor" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Exynos 850/1280/1380/1480 PIT files and fast multithreaded unpacker" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,2"/>
                                    <TextBlock Text="Size: ~18 MB • Status: Ready / Verified" FontSize="9" Foreground="#38BDF8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="⬇️ Download" Style="{StaticResource CloudDownloadButton}" Tag="SAMSUNG_PIT" Click="OnDownloadPackageClicked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT: LIVE DOWNLOAD PROGRESS & LOG -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Progress Bar Card -->
                        <RowDefinition Height="Auto"/> <!-- Console Header -->
                        <RowDefinition Height="*"/>    <!-- Console Box -->
                    </Grid.RowDefinitions>

                    <!-- PROGRESS CARD -->
                    <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="TxtDownloadTaskTitle" Text="Standby — Select package to download" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock x:Name="TxtDownloadPercent" Text="0%" FontSize="11" FontWeight="ExtraBold" Foreground="#38BDF8" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="PbDownload" Height="8" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Value="0" Maximum="100" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBlock x:Name="TxtDownloadSpeed" Text="Speed: 0 KB/s" FontSize="9" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtDownloadBytes" Text="0 MB / 0 MB" FontSize="9" Foreground="#64748B" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- CONSOLE HEADER -->
                    <DockPanel Grid.Row="1" Margin="2,0,2,4">
                        <TextBlock Text="DOWNLOAD &amp; EXTRACT LOG" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="📋 Copy" Style="{StaticResource CloudActionButton}" Padding="8,3" FontSize="10" Click="OnCopyLogClicked" Margin="0,0,4,0"/>
                            <Button Content="🧹 Clear" Style="{StaticResource CloudActionButton}" Padding="8,3" FontSize="10" Click="OnClearLogClicked"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- CONSOLE BOX -->
                    <Border Grid.Row="2" Background="#060A14" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="8">
                        <TextBox x:Name="TxtConsoleLog" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontFamily="Consolas, Lucida Console, Courier New" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ -->
            <!-- ROW 3: BOTTOM STATUS BAR                                          -->
            <!-- ================================================================ -->
            <Border Grid.Row="3" Background="#0F172A" CornerRadius="0,0,12,12" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="BS LAB TOOL PRO V2.5 • DYNAMIC CLOUD LOADER MANAGER • SSL HIGH-SPEED CDN" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="STORAGE HEALTH: " FontSize="9.5" Foreground="#64748B"/>
                        <TextBlock Text="ALL REPOSITORIES READY" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
