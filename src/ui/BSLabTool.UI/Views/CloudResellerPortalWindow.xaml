<Window x:Class="BSLabTool.UI.Views.CloudResellerPortalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — Cloud Credits, User Profile &amp; Reseller Hub"
        Width="1080" Height="680" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <LinearGradientBrush x:Key="CloudBorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#818CF8" Offset="0.5"/>
            <GradientStop Color="#00FFA3" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CyanIndigoGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#818CF8" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#111B30"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberPrimaryButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
        </Style>

        <Style x:Key="CyberSuccessButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#34D399"/>
        </Style>
    </Window.Resources>

    <!-- Outer Chrome Window Border -->
    <Border Background="#040711" BorderBrush="{StaticResource CloudBorderGlow}" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#38BDF8" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>  <!-- Header Bar -->
                <RowDefinition Height="*"/>    <!-- Main Body: Profile & Wallet vs Reseller Panel -->
                <RowDefinition Height="40"/>   <!-- Bottom Cloud Gateway Bar -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER BAR -->
            <Border Grid.Row="0" Background="#080E1C" CornerRadius="11,11,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#101D38" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="☁️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BS LAB TOOL™ PRO" FontWeight="Black" FontSize="12" Foreground="#F8FAFC"/>
                                <Border Background="{StaticResource CyanIndigoGradient}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="CLOUD CREDITS &amp; RESELLER HUB" FontWeight="Black" FontSize="9" Foreground="#02040A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Live Cloud Wallet, Server Auth API Gateway &amp; Sub-Account Management" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Server Connection Pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#101D38" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="20" Padding="14,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#00FFA3" Margin="0,0,6,0"/>
                            <TextBlock Text="CLOUD AUTH GATEWAY: ONLINE (LATENCY: 22ms)" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Click="OnCloseClicked" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#EF4444" Content="✕" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY -->
            <Border Grid.Row="1" Background="#060B16" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/> <!-- Left: User Profile & Wallet -->
                        <ColumnDefinition Width="*"/>   <!-- Right: Auth Services & Reseller Management -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: PROFILE & WALLET CARD -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        
                        <!-- User Identity Card -->
                        <Border Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Avatar -->
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,12,0">
                                        <TextBlock Text="SB" FontSize="18" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Syed Bisharat Ali" FontSize="14" FontWeight="Black" Foreground="#F8FAFC"/>
                                            <Border Background="#0284C7" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                                <TextBlock Text="VERIFIED" FontSize="8.5" FontWeight="Black" Foreground="#F8FAFC"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="ROLE: Master Distributor &amp; Reseller" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" Margin="0,2,0,0"/>
                                        <TextBlock Text="USER ID: BSLAB-USR-99204" FontSize="9" Foreground="#64748B" FontFamily="JetBrains Mono, Consolas"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Hardware Bound Pill -->
                                <Border Background="#0C1428" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="BOUND HWID:" FontSize="9" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Text="B92F-A081-3E4C-7190" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>
                                </Border>

                                <Border Background="#0C1428" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                    <Grid>
                                        <TextBlock Text="LICENSE EXPIRY:" FontSize="9" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Text="2036-11-24 (LIFETIME 10Y)" FontSize="9" FontWeight="Bold" Foreground="#00FFA3" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Cloud Credit Wallet -->
                        <Border Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="CLOUD SERVER WALLET" FontSize="11" FontWeight="Black" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                
                                <Border Background="#0A1224" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="AVAILABLE BALANCE" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtCreditBalance" Text="4,850 CREDITS" FontSize="26" FontWeight="Black" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                                            <TextBlock Text="≈ $485.00 USD Value" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Click="OnRefreshBalanceClicked" Content="🔄" ToolTip="Refresh Wallet Balance" HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Style="{StaticResource CyberButton}"/>
                                    </Grid>
                                </Border>

                                <!-- Top-Up Options -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OnBuyCreditsWhatsAppClicked" Content="💬 Buy via WhatsApp" Style="{StaticResource CyberSuccessButton}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Click="OnBuyCreditsCryptoClicked" Content="🪙 Buy via USDT / Card" Style="{StaticResource CyberPrimaryButton}" Margin="4,0,0,0"/>
                                </Grid>

                                <!-- Auto-Deduct Disclaimer -->
                                <TextBlock Text="* Server credits are only consumed upon verified successful remote authorization. Zero credit loss on server failure." FontSize="8.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- RIGHT: SERVER AUTH SERVICES & RESELLER TOOLS -->
                    <Border Grid.Column="1" Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Server Pricing & Status Grid -->
                                <RowDefinition Height="*"/>    <!-- Sub-Account & Auth Log Tabs -->
                            </Grid.RowDefinitions>

                            <!-- Server Services Pricing Cards -->
                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                                
                                <Border Background="#0C1428" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Xiaomi Auth" FontSize="10.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Ellipse Width="6" Height="6" Fill="#00FFA3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="15 Credits / Phone" FontSize="12" FontWeight="Black" Foreground="#00F0FF" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Text="HyperOS EDL 9008" FontSize="9" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0C1428" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Knox Guard" FontSize="10.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Ellipse Width="6" Height="6" Fill="#00FFA3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="25 Credits / Unlock" FontSize="12" FontWeight="Black" Foreground="#A855F7" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Text="Samsung KG Cloud Clean" FontSize="9" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0C1428" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="MTK Cloud DA" FontSize="10.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Ellipse Width="6" Height="6" Fill="#00FFA3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="5 Credits / Handshake" FontSize="12" FontWeight="Black" Foreground="#38BDF8" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Text="Dimensity 9300 BROM" FontSize="9" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0C1428" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Apple Check" FontSize="10.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Ellipse Width="6" Height="6" Fill="#00FFA3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="2 Credits / Query" FontSize="12" FontWeight="Black" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Text="FMI / Clean / Lost GSX" FontSize="9" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>

                            <!-- Sub-Account & Reseller Management -->
                            <Border Grid.Row="1" Background="#040814" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Title & Transfer Form -->
                                        <RowDefinition Height="*"/>    <!-- Sub-Account Table -->
                                    </Grid.RowDefinitions>

                                    <!-- Top Form: Quick Sub-Account Credit Transfer -->
                                    <Border Grid.Row="0" Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Sub-Account Username / Client HWID:" FontSize="9.5" Foreground="#94A3B8"/>
                                                <TextBox x:Name="TxtSubAccountTarget" Text="tech_ali_lahore" Height="28" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" Padding="6,4"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Credits to Transfer:" FontSize="9.5" Foreground="#94A3B8"/>
                                                <TextBox x:Name="TxtTransferCredits" Text="100" Height="28" Background="#111B30" Foreground="#00FFA3" BorderBrush="#334155" FontSize="11" FontWeight="Bold" Padding="6,4"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Click="OnTransferCreditsClicked" Content="⚡ TRANSFER CREDITS" Style="{StaticResource CyberPrimaryButton}" Height="28" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>

                                    <!-- Reseller Sub-Accounts Table -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="REGISTERED SUB-ACCOUNTS &amp; CLIENT TECHNICIANS" FontSize="10.5" FontWeight="Black" Foreground="#818CF8" Margin="0,0,0,8"/>
                                            
                                            <!-- Row 1 -->
                                            <Border Background="#091020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="tech_ali_lahore" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                        <TextBlock Text="Lahore Electronics Mall" FontSize="9" Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="HWID: B821-49F1-0A92-CC31" FontSize="10" Foreground="#64748B" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="250 Credits" FontSize="11" FontWeight="Black" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Click="OnTopUpSubAccountClicked" Content="+ Add" Style="{StaticResource CyberButton}" Height="24" Padding="8,2" FontSize="10"/>
                                                </Grid>
                                            </Border>

                                            <!-- Row 2 -->
                                            <Border Background="#091020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="gsm_doctor_karachi" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                        <TextBlock Text="Saddar Star City Mall" FontSize="9" Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="HWID: C409-771B-9430-18D2" FontSize="10" Foreground="#64748B" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="640 Credits" FontSize="11" FontWeight="Black" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Click="OnTopUpSubAccountClicked" Content="+ Add" Style="{StaticResource CyberButton}" Height="24" Padding="8,2" FontSize="10"/>
                                                </Grid>
                                            </Border>

                                            <!-- Row 3 -->
                                            <Border Background="#091020" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="rawalpindi_repair_lab" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                        <TextBlock Text="Madina Market RWP" FontSize="9" Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="HWID: A910-5321-78AA-412E" FontSize="10" Foreground="#64748B" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="120 Credits" FontSize="11" FontWeight="Black" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Click="OnTopUpSubAccountClicked" Content="+ Add" Style="{StaticResource CyberButton}" Height="24" Padding="8,2" FontSize="10"/>
                                                </Grid>
                                            </Border>

                                        </StackPanel>
                                    </ScrollViewer>

                                </Grid>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- 3. BOTTOM CLOUD GATEWAY BAR -->
            <Border Grid.Row="2" Background="#080E1C" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CLOUD PROTOCOL: RESTful JSON / WSS TLS 1.3 • ENDPOINT: https://auth.bslabtool.com/v1" FontSize="9.5" Foreground="#64748B" FontFamily="JetBrains Mono, Consolas"/>
                    <TextBlock Grid.Column="1" Text="SESSION ID: 7F01-9A4B-EC12-8802 (ENCRYPTED)" FontSize="9.5" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
