<Window x:Class="BSLabTool.UI.Views.VirtualDeviceSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS LAB TOOL™ PRO — Virtual Phone Hardware Simulator &amp; Playground"
        Width="1080" Height="680" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <LinearGradientBrush x:Key="SimBorderGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A855F7" Offset="0.0"/>
            <GradientStop Color="#00F0FF" Offset="0.5"/>
            <GradientStop Color="#00FFA3" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleCyanGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#A855F7" Offset="0.0"/>
            <GradientStop Color="#00F0FF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#111B30"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberPrimaryButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#A855F7"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderBrush" Value="#C084FC"/>
        </Style>
    </Window.Resources>

    <!-- Outer Chrome Window Border -->
    <Border Background="#040711" BorderBrush="{StaticResource SimBorderGlow}" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#A855F7" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>  <!-- Header Bar -->
                <RowDefinition Height="*"/>    <!-- Main Split: Controls vs Virtual Phone -->
                <RowDefinition Height="140"/>  <!-- Virtual USB Bus Telemetry -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER BAR -->
            <Border Grid.Row="0" Background="#080E1C" CornerRadius="11,11,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#101D38" BorderBrush="#A855F7" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🧪" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BS LAB TOOL™ PRO" FontWeight="Black" FontSize="12" Foreground="#F8FAFC"/>
                                <Border Background="{StaticResource PurpleCyanGradient}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="HARDWARE SIMULATOR" FontWeight="Black" FontSize="9" Foreground="#02040A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Virtual Device Testing Sandbox &amp; Interactive Sales Demonstration" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Simulator Live Status Pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#101D38" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="20" Padding="14,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotSimStatus" Width="8" Height="8" Fill="#00FFA3" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtSimStatus" Text="VIRTUAL USB BUS: CONNECTED &amp; EMULATING (COM4: EDL 9008)" FontSize="10" FontWeight="Bold" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Click="OnCloseClicked" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#EF4444" Content="✕" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 2. MAIN SPLIT: CONTROLS (LEFT) vs VIRTUAL PHONE (RIGHT) -->
            <Border Grid.Row="1" Background="#060B16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/> <!-- Left: Configuration & State Triggers -->
                        <ColumnDefinition Width="*"/>   <!-- Right: Virtual Screen & Bezel -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: CONTROLS & STATE CONTROLLERS -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        
                        <!-- Device Preset Selector -->
                        <Border Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Select Virtual Phone Preset:" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbVirtualModel" Height="32" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" VerticalContentAlignment="Center" SelectionChanged="OnVirtualModelChanged">
                                    <ComboBoxItem IsSelected="True">Samsung Galaxy S24 Ultra (SM-S928B)</ComboBoxItem>
                                    <ComboBoxItem>Xiaomi Redmi Note 13 Pro 5G (garnet)</ComboBoxItem>
                                    <ComboBoxItem>Infinix Note 30 Pro (Helio G99 MT6789)</ComboBoxItem>
                                    <ComboBoxItem>Oppo Reno 10 Pro+ 5G (Snapdragon 8+ Gen 1)</ComboBoxItem>
                                    <ComboBoxItem>Vivo V29 5G (SM7325 Diag 9001)</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Mode Selector -->
                        <Border Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Hardware Connection Mode:" FontSize="11" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbVirtualMode" Height="32" Background="#111B30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11" VerticalContentAlignment="Center" SelectionChanged="OnVirtualModeChanged">
                                    <ComboBoxItem IsSelected="True">⚡ MTP / Setup Wizard Screen</ComboBoxItem>
                                    <ComboBoxItem>🔢 Samsung Factory Test Mode (*#0*#)</ComboBoxItem>
                                    <ComboBoxItem>🔌 Qualcomm EDL 9008 (Blank Screen)</ComboBoxItem>
                                    <ComboBoxItem>⚙️ MediaTek BROM / Preloader Mode</ComboBoxItem>
                                    <ComboBoxItem>🚀 Fastboot / Bootloader Interface</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Hardware State Injectors -->
                        <Border Background="#070D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Simulate Hardware Exploits &amp; Locks:" FontSize="11" FontWeight="Bold" Foreground="#00FFA3" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OnTriggerFrpLockClicked" Content="Set FRP Locked" Style="{StaticResource CyberButton}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Click="OnTriggerFrpBypassClicked" Content="⚡ 1-Click FRP Bypass" Style="{StaticResource CyberPrimaryButton}" Margin="4,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OnTriggerKnoxLockClicked" Content="Set KG Locked" Style="{StaticResource CyberButton}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Click="OnTriggerKnoxBypassClicked" Content="🛡️ Wipe Knox Guard" Style="{StaticResource CyberButton}" Margin="4,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OnTriggerCorruptNvramClicked" Content="Corrupt NVRAM" Style="{StaticResource CyberButton}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Click="OnTriggerRestoreQcnClicked" Content="📶 Calibrate Radio" Style="{StaticResource CyberButton}" Margin="4,0,0,0"/>
                                </Grid>

                                <Button Click="OnRebootVirtualPhoneClicked" Content="🔄 Soft / Watchdog Reboot Phone" Style="{StaticResource CyberButton}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- RIGHT: VIRTUAL SMARTPHONE BEZEL & SCREEN -->
                    <Border Grid.Column="1" Background="#040814" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="14" Padding="20">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            
                            <!-- Smartphone Outer Frame (Curved Bezel) -->
                            <Border Width="300" Height="440" Background="#0C1220" BorderBrush="#334155" BorderThickness="3.5" CornerRadius="36" Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.8"/>
                                </Border.Effect>

                                <!-- Inner Screen Glass -->
                                <Border x:Name="ScreenGlass" Background="#050811" CornerRadius="28" ClipToBounds="True">
                                    <Grid>
                                        <!-- Top Speaker & Camera Punchhole -->
                                        <Ellipse Width="10" Height="10" Fill="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Panel.ZIndex="10"/>

                                        <!-- Status Bar (Clock, Battery, Network) -->
                                        <Grid VerticalAlignment="Top" Margin="16,10,16,0" Panel.ZIndex="5">
                                            <TextBlock Text="12:45" FontSize="9" FontWeight="Bold" Foreground="#F8FAFC" FontFamily="JetBrains Mono, Consolas"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtSimNetwork" Text="📶 5G" FontSize="9" Foreground="#00FFA3" Margin="0,0,6,0" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Text="🔋 88%" FontSize="9" Foreground="#F8FAFC" FontFamily="JetBrains Mono, Consolas"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- SCREEN STATE VIEWPORT (DYNAMIC CONTENT) -->
                                        <Grid x:Name="PanelScreenContent" Margin="16,36,16,16">
                                            
                                            <!-- STATE 1: NORMAL UNLOCKED HOME SCREEN -->
                                            <StackPanel x:Name="ScreenNormal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="12:45" FontSize="36" FontWeight="Light" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Tuesday, 24 November" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                                
                                                <Border Background="#101D38" BorderBrush="#00FFA3" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,16">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="✓ DEVICE UNLOCKED" FontSize="11" FontWeight="Bold" Foreground="#00FFA3" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="FRP: Cleared • KG: Completed" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Swipe up to unlock" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- STATE 2: FRP GOOGLE LOCK SCREEN -->
                                            <StackPanel x:Name="ScreenFrpLocked" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBlock Text="Verify your account" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="This device was reset. To continue, sign in with a Google Account that was previously synced on this device." FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                                                <Border Background="#1E293B" CornerRadius="6" Height="28" Padding="8,4">
                                                    <TextBlock Text="Email or phone" FontSize="10" Foreground="#64748B"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- STATE 3: KNOX GUARD FINANCE LOCK SCREEN -->
                                            <StackPanel x:Name="ScreenKnoxLocked" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="⚠️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBlock Text="PHONE LOCKED" FontSize="15" FontWeight="Black" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="This phone is locked due to an outstanding installment payment. Please contact your loan provider (PayJoy)." FontSize="9" Foreground="#FCA5A5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                                                <Border Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                    <TextBlock Text="EMERGENCY CALL ONLY" FontSize="9" FontWeight="Bold" Foreground="#FEE2E2" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- STATE 4: SAMSUNG *#0*# FACTORY TEST MODE -->
                                            <StackPanel x:Name="ScreenTestMode" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="Samsung Factory Test Mode" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="3" Rows="4" Margin="4">
                                                    <Button Content="Red" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                    <Button Content="Green" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                    <Button Content="Blue" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                    <Button Content="Receiver" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                    <Button Content="Vibration" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                    <Button Content="Dimming" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                    <Button Content="Mega Cam" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                    <Button Content="Sensor" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                    <Button Content="Touch" Style="{StaticResource CyberButton}" Margin="2" Padding="4" FontSize="9"/>
                                                </UniformGrid>
                                            </StackPanel>

                                            <!-- STATE 5: FASTBOOT MODE -->
                                            <StackPanel x:Name="ScreenFastboot" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="FASTBOOT" FontSize="26" FontWeight="Black" Foreground="#00FFA3" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Text="PRODUCT_NAME: garnet" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas" HorizontalAlignment="Center"/>
                                                <TextBlock Text="VARIANT: SM_ UFS" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas" HorizontalAlignment="Center"/>
                                                <TextBlock Text="BOOTLOADER VERSION: v2.5" FontSize="10" Foreground="#94A3B8" FontFamily="JetBrains Mono, Consolas" HorizontalAlignment="Center"/>
                                                <TextBlock Text="SECURE BOOT: ENABLED" FontSize="10" Foreground="#00F0FF" FontFamily="JetBrains Mono, Consolas" HorizontalAlignment="Center"/>
                                                <TextBlock Text="DEVICE STATE: LOCKED" FontSize="10" Foreground="#EF4444" FontFamily="JetBrains Mono, Consolas" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                <TextBlock Text="Press Power Key to Select" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- 3. BOTTOM: VIRTUAL USB BUS TELEMETRY STREAM -->
            <Border Grid.Row="2" Background="#080E1C" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="VIRTUAL USB PACKET BUS // LOOPBACK PACKET MONITOR" FontSize="10" FontWeight="Bold" Foreground="#A855F7" FontFamily="JetBrains Mono, Consolas"/>
                        <TextBlock Text="STATUS: LIVE EMULATION" FontSize="10" Foreground="#00FFA3" FontFamily="JetBrains Mono, Consolas" Grid.Column="1"/>
                    </Grid>

                    <TextBox x:Name="TxtBusLog" Grid.Row="1" Background="#030712" Foreground="#38BDF8" BorderBrush="#1E293B"
                             FontFamily="JetBrains Mono, Consolas" FontSize="11"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>